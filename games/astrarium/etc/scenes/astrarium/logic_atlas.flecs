using flecs.script
using flecs.script.math
using box.app
using state
using assets

async {
  while true {
    const e = await SelectStar
    atlas_sel = e.star
  }
}

async {
  while true {
    const e = await HoldStarted
    await delay(e.until - AppStatus[AppStatus].elapsed)
    if atlas_holding && e.serial == atlas_hold_serial {
      atlas_holding = false
      emit Awaken()
    }
  }
}

async {
  while true {
    await Awaken
    const s = atlas_sel[Star]
    const open = s.from < 0 ? true : atlas_awake[s.from]
    if !atlas_awake[s.id] && open && hero_points > 0 {
      hero_points -= 1
      atlas_awake[s.id] = true
      atlas_fresh = s.id
      star_bonus[s.stat] += s.amount
      atlas_count[s.band] += 1
      emit StatsChanged()
      if s.keystone {
        show_banner(s.name, "{band_name(s.band)} answers")
      }
    }
  }
}

async {
  while true {
    await Realign
    hero_points += atlas_count[0] + atlas_count[1] + atlas_count[2] + atlas_count[3]
    atlas_awake = {}
    atlas_fresh = -1
    atlas_count = {}
    star_bonus = {}
    emit StatsChanged()
  }
}
