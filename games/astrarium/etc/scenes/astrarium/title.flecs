using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.layout
using box.text
using box.picking
using box.input
using box.transition
using box.movement

const title_letters = ["A", "S", "T", "R", "A", "R", "I", "U", "M"]

template TitleGlyph {
  prop index: i32 = 0

  const shown = title_go
  const delay = 0.25 + index * 0.085

  LayoutItem: {width: {mode: Fixed, value: 92}, height: {mode: Fixed, value: 110}}
  Layout: {}

  glow {
    const t = match shown { true: 0.26; _: 0.0 }
    Position: {0, 0, -1}
    Rect: {190, 220}
    Image: {texture: tex_halo}
    Rgb: {ui_gold.r * 0.32, ui_gold.g * 0.24, ui_gold.b * 0.14}
    BlendMode: Additive
    Opacity: {t}
    Transition: [Opacity: {duration: 1.6, delay: delay, timing_function: EaseOut}]
    box.spatial.SpatialIgnore
  }

  glyph {
    const y = match shown { true: 0; _: 26 }
    const k = match shown { true: 1; _: 1.32 }
    const a = match shown { true: 1; _: 0 }
    const e = match shown { true: 0.34; _: 3.2 }
    Position: {0, y, 1}
    Scale: {k, k, 1}
    Opacity: {a}
    Text: {value: title_letters[index], size: 92, font: font_display}
    Rgb: ui_pale
    Emissive: {strength: e, color: {255, 186, 92}}
    Transition: [
      Position: {duration: 1.1, delay: delay, timing_function: EaseOut},
      Scale: {duration: 1.1, delay: delay, timing_function: EaseOut},
      Opacity: {duration: 0.8, delay: delay, timing_function: EaseOut},
      Emissive: {duration: 1.8, delay: delay, timing_function: EaseOut}
    ]
    box.spatial.SpatialIgnore
  }
}

template TitleRule {
  const w = match title_go { true: 1; _: 0.02 }
  const a = match title_go { true: 1; _: 0 }

  LayoutItem: {width: {mode: Fixed, value: 560}, height: {mode: Fixed, value: 34}}
  Layout: {}

  art {
    Position: {0, 0, 0}
    Rect: {560, 35}
    Image: {texture: tex_divider}
    Rgb: ui_gold
    Scale: {w, 1, 1}
    Opacity: {a}
    Transition: [
      Scale: {duration: 1.4, delay: 1.0, timing_function: EaseInOut},
      Opacity: {duration: 0.6, delay: 1.0}
    ]
    box.spatial.SpatialIgnore
  }
}

template TitleFade {
  prop delay: f32 = 1.4
  prop rise: f32 = 14

  const a = match title_go { true: 1; _: 0 }
  const y = match title_go { true: 0; _: 0 - rise }

  LayoutItem: {y: y}
  Opacity: {a}
  Transition: [
    Opacity: {duration: 0.9, delay: delay, timing_function: EaseOut},
    Position: {duration: 0.9, delay: delay, timing_function: EaseOut}
  ]
}

template TitleEntryFace {
  prop label: string = ""
  prop hover: bool = false
  prop down: bool = false

  const lit = match hover { true: 1; _: 0 }
  const k = match down { true: 0.97; _: 1 }

  Layout: {}
  LayoutItem: {width: {mode: Fixed, value: 340}, height: {mode: Fixed, value: 50}}
  Scale: {k, k, 1}
  Transition: [Scale: {duration: 0.08}]
  box.spatial.SpatialIgnore

  band {
    Position: {0, 0, 0}
    Rect: {340, 50}
    Image: {texture: tex_halo}
    Rgb: {ui_gold.r * 0.45, ui_gold.g * 0.36, ui_gold.b * 0.2}
    BlendMode: Additive
    Scale: {match hover { true: 1; _: 0.6 }, 1, 1}
    Opacity: {lit}
    Transition: [
      Opacity: {duration: 0.22, timing_function: EaseOut},
      Scale: {duration: 0.3, timing_function: EaseOut}
    ]
    box.spatial.SpatialIgnore
  }

  left {
    Position: {match hover { true: -122; _: -96 }, 0, 1}
    Rotation: {0, 0, PI / 4}
    Rect: {7, 7}
    Rgb: ui_pale
    Emissive: {strength: 1.2, color: {255, 190, 100}}
    Opacity: {lit}
    Transition: [
      Position: {duration: 0.26, timing_function: EaseOut},
      Opacity: {duration: 0.2}
    ]
    box.spatial.SpatialIgnore
  }

  right {
    Position: {match hover { true: 122; _: 96 }, 0, 1}
    Rotation: {0, 0, PI / 4}
    Rect: {7, 7}
    Rgb: ui_pale
    Emissive: {strength: 1.2, color: {255, 190, 100}}
    Opacity: {lit}
    Transition: [
      Position: {duration: 0.26, timing_function: EaseOut},
      Opacity: {duration: 0.2}
    ]
    box.spatial.SpatialIgnore
  }

  name {
    Position: {0, 2, 2}
    Text: {value: label, size: 22, font: font_display}
    if hover {
      Rgb: {255, 248, 226}
      Emissive: {strength: 0.5, color: {255, 200, 120}}
    } else {
      Rgb: ui_gold
      Emissive: {strength: 0, color: {255, 200, 120}}
    }
    Transition: [Rgb: {duration: 0.18}, Emissive: {duration: 0.18}]
    box.spatial.SpatialIgnore
  }
}

template TitleEntry {
  prop label: string = ""
  prop op: i32 = 0

  mut hover = false
  mut down = false

  Interactive
  Cursor: {CursorPointer}
  Layout: {}
  LayoutItem: {width: {mode: Fixed, value: 340}, height: {mode: Fixed, value: 50}}
  Rect: {1, 1}
  Rgb: {0, 0, 0}
  BlendMode: Additive

  TitleEntryFace face(label: label, hover: hover, down: down)

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.press(this)
      down = true
      await on.release(this)
      down = false
    }
  }

  async {
    while true {
      await on.click(this)
      rq_op = op
      await ui.changed(rq)
    }
  }
}

template TitleShade {
  prop v: VAlign = Top
  prop y: f32 = 0
  prop w: f32 = 1200
  prop h: f32 = 400
  prop strength: f32 = 0.7

  LayoutItem: {h: Center, v: v, y: y, width: {mode: Fixed, value: w}, height: {mode: Fixed, value: h}}
  Rect: {1, 1}
  Image: {texture: tex_halo}
  Rgb: {0, 0, 0}
  Opacity: {strength}
  box.spatial.SpatialIgnore
}

template Title {
  const on_screen = screen == SCREEN_TITLE
  const a = match on_screen { true: 1; _: 0 }
  const k = match on_screen { true: 1; _: 1.12 }

  LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
  Layout: {}
  Opacity: {a}
  Scale: {k, k, 1}
  Transition: [
    Opacity: {duration: 0.7, timing_function: EaseInOut},
    Scale: {duration: 0.9, timing_function: EaseInOut}
  ]

  if !on_screen {
    box.spatial.SpatialIgnore
  }

  TitleShade shade_top(v: Top, y: 60, w: 1500, h: 480, strength: 0.72)
  TitleShade shade_menu(v: Bottom, y: -40, w: 960, h: 460, strength: 0.86)

  column {
    LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
    Layout: {direction: Column, h: Center}

    top_gap {
      LayoutItem: {height: {mode: Fixed, value: 96}}
    }

    overline {
      TitleFade: {delay: 0.2}
      Layout: {direction: Row, h: Center, v: Middle}
      Caption line(text: "An Atlas of Drowned Stars", size: 20, color: ui_text, font: font_italic)
    }

    word {
      Layout: {direction: Row, h: Center, v: Middle}
      for i in 0..9 {
        TitleGlyph "g_{i}"(index: i)
      }
    }

    TitleRule rule()

    gap {
      LayoutItem: {height: {mode: Grow}}
    }

    menu {
      TitleFade: {delay: 1.5}
      Layout: {direction: Column, h: Center, spacing: 2}
      TitleEntry begin(label: "Open the Atlas", op: OP_BEGIN)
      TitleEntry armory(label: "The Armory", op: OP_ARMORY)
      TitleEntry rites(label: "Rites", op: OP_RITES)
    }

    footer {
      TitleFade: {delay: 2}
      Layout: {direction: Row, padding: {16, 22, 0, 0}, h: Center}
      Caption line(text: "", size: 13, color: ui_muted, font: font_italic)
    }
  }
}
