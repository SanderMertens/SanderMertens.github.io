using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.particle
using box.transition
using box.types
using state
using assets

assets {
  template Burst {
    prop hue: rgb = {255, 255, 255}
    prop count: i32 = 70
    prop slow: f32 = 40
    prop fast: f32 = 260
    prop size: f32 = 5
    prop life: f32 = 1
    prop lift: f32 = 60

    ParticleEmitter: {
      max: count + 10,
      rate: 0,
      shape: EmitterSphere,
      radius: 12,
      direction: {0, 1, 0},
      spread: 75,
      speed: {slow, fast},
      lifetime: {life * 0.4, life},
      size: {size * 0.4, size},
      color: hue,
      color_variance: {40, 40, 40},
      opacity: {0.7, 1},
      seed: count,
      linger: true
    }
    ParticleForces: {gravity: {0, lift, 0}, drag: 2.2, turbulence: 90, turbulence_scale: 0.03}
    ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.006}
    ParticleCurves: {
      opacity: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 0.5}, {1, 0}]}
      size: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 0.7}, {1, 0.1}]}
    }
    ParticleBurst: {count: count, at: 0}
  }

  template CastFx : OneShot {
    prop spell: i32 = 0

    const hue: Rgb = {spell_r(spell), spell_g(spell), spell_b(spell)}
    const x = (spell - 2.5) * 80

    Position: {x, 0, 0}

    Burst sparks(hue: {hue.r, hue.g, hue.b}, count: 70) { Position: {0, 0, 0} }
    Shock ring(hue: hue, size: 190)
    Pop glow(hue: hue, size: 210)
  }

  template FallingStar {
    Position: {260, 500, 0}
    ParticleEmitter: {
      max: 150,
      rate: 0,
      shape: EmitterBox,
      extents: {860, 10, 0},
      direction: {-0.4, -1, 0},
      spread: 2,
      speed: {620, 1040},
      lifetime: {0.9, 1.5},
      size: {1, 2.6},
      color: {255, 232, 186},
      color_variance: {0, 16, 40},
      opacity: {0.35, 0.95},
      seed: 3,
      linger: true
    }
    ParticleForces: {gravity: {0, 0, 0}}
    ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.042}
    ParticleCurves: {
      opacity: {keys: [{0, 0}, {0.33333334, 1}, {0.6666667, 0.9}, {1, 0}]}
      size: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 0.8}, {1, 0.3}]}
    }
    ParticleBurst: {count: 16, at: 0.08, repeat: 7}
  }

  template ScreenFlash : OneShot {
    prop hue: Rgb = {255, 240, 200}

    const a = go ? 0 : 0.16

    Position: {0, 0, -5}
    Rect: {4000, 4000}
    Rgb: {hue.r * 0.5, hue.g * 0.5, hue.b * 0.5}
    BlendMode: Additive
    Opacity: {a}
    Transition: [Opacity: {duration: 1.3, timing_function: EaseOut}]
  }

  template LevelFx {
    Position: {0, 0, 0}

    Burst sparks(hue: {255, 214, 140}, count: 180, slow: 120, fast: 620, size: 6, life: 1.5, lift: 30) {
      Position: {0, 240, 0}
    }

    ring {
      Position: {0, 240, 0}
      Shock a(hue: {255, 226, 170}, size: 560)
      Pop b(hue: {255, 196, 110}, size: 620)
    }
  }

  template FxLayer {
    fx {
      Scene: {}

      ScreenCamera camera()

      root {
        ScreenRoot: {}
        Layout: {}

        deck_anchor {
          LayoutItem: {h: Center, v: Bottom, y: 57, width: {mode: Fixed, value: 1}, height: {mode: Fixed, value: 1}}

          if fx_cast_serial > 0 {
            CastFx "cast_{fx_cast_serial}"(spell: fx_cast)
          }
        }
      }

      if fx_cast == 4 && fx_cast_serial > 0 {
        group {
          Position: {0, 0, 0}
          FallingStar "fall_{fx_cast_serial}"()
          ScreenFlash "flash_{fx_cast_serial}"()
        }
      }

      if fx_level_serial > 0 {
        LevelFx "level_{fx_level_serial}"()
      }
    }

    fx_view {
      bloom { box.effects.Bloom: {intensity: 0.9, threshold: 0.4, threshold_softness: 0.3} }

      View: {
        camera: fx.camera,
        order: 4,
        lighting: {enabled: false},
        culling: {enabled: false},
        effects: [{enabled: true, effect: bloom}]
      }
    }
  }
}
