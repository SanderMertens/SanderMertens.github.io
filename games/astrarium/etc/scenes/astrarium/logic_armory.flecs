using flecs.script
using flecs.script.math
using box.app

async {
  while true {
    const e = await Equip
    eq[e.item[Item].slot] = e.item
    emit StatsChanged()
    emit HoverChanged()
  }
}

async {
  while true {
    const e = await Metal
    rite_metal = e.index
    if e.index == 0 {
      ui_gold = {232, 199, 122}
      ui_pale = {255, 238, 196}
      ui_dim = {122, 104, 68}
    } else if e.index == 1 {
      ui_gold = {158, 210, 240}
      ui_pale = {226, 244, 255}
      ui_dim = {74, 110, 140}
    } else {
      ui_gold = {240, 148, 162}
      ui_pale = {255, 222, 226}
      ui_dim = {130, 72, 86}
    }
  }
}
