using flecs.script
using flecs.script.math
using box.app
using state
using assets

async {
  while true {
    await StatsChanged
    mut gear: i32[4] = {}
    for s in 0..4 {
      const e = eq[s]
      if e != 0 {
        const a = e[Item]
        gear = [gear[0] + a.might, gear[1] + a.ward, gear[2] + a.haste, gear[3] + a.aether]
      }
    }
    stat_might = 30 + star_bonus[0] + gear[0]
    stat_ward = 24 + star_bonus[1] + gear[1]
    stat_haste = 18 + star_bonus[2] + gear[2]
    stat_aether = 26 + star_bonus[3] + gear[3]
    hero_hp_max = 200 + stat_ward * 1.3
    hero_mp_max = 210 + stat_aether * 1.4
  }
}
