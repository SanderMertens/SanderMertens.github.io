using flecs.script
using flecs.script.math
using box.app

async {
  while true {
    const e = await Cast
    const i = e.spell
    if !spell_cooling[i] && hero_mp >= spell_cost(i) && hero_hp > spell_blood(i) {
      hero_mp -= spell_cost(i)
      hero_hp -= spell_blood(i)
      if i == 1 {
        hero_hp = min(hero_hp_max, hero_hp + 60)
      } else if i == 2 {
        aegis_on = true
        aegis_serial += 1
        emit AegisRaised(serial: aegis_serial, until: AppStatus[AppStatus].elapsed + 8)
      } else if i == 4 {
        hero_dust += 250 + stat_might * 2
      } else if i == 5 {
        hero_mp = min(hero_mp_max, hero_mp + 90)
      }
      spell_cooling[i] = true
      emit Cooldown(spell: i, seconds: spell_cooldown(i) * haste_scale(stat_haste))
      hero_xp += spell_xp(i) * (1 + stat_might * 0.006)
      fx_cast = i
      fx_cast_serial += 1
      check_afford()
      check_level()
    }
  }
}

template SpellTimer {
  prop index: i32 = 0

  async {
    while true {
      const e = await Cooldown
      if e.spell == index {
        await delay(e.seconds)
        spell_cooling[index] = false
      }
    }
  }
}

spell_timers {
  for i in 0..6 {
    SpellTimer "timer_{i}"(index: i)
  }
}
