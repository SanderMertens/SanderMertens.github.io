using flecs.script
using flecs.script.math
using box.app
using state
using assets

async {
  mut last_focus: entity = 0
  while true {
    await HoverChanged
    const shown = armory_hover
    const focus = armory_hovering ? shown : eq[0]
    mut delta: i32[4] = {}
    if armory_hovering {
      const h = shown[Item]
      const held = eq[h.slot]
      if held != 0 && held != shown {
        const w = held[Item]
        delta = [h.might - w.might, h.ward - w.ward, h.haste - w.haste, h.aether - w.aether]
      }
    }
    preview = delta
    if focus != 0 && focus != last_focus {
      const f = focus[Item]
      last_focus = focus
      relic_model = f.slot
      relic_r = f.model_hue.r
      relic_g = f.model_hue.g
      relic_b = f.model_hue.b
      relic_name = f.name
      relic_line = "{rarity_name(f.rarity)} {slot_name(f.slot)}"
      relic_serial += 1
    }
  }
}

async {
  while true {
    const e = await HoverLeft
    if e.item == armory_hover {
      armory_hovering = false
      armory_tip_on = false
      emit HoverChanged()
    }
  }
}
