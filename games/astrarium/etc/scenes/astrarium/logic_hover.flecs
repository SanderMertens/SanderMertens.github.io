using flecs.script
using flecs.script.math
using box.app

async {
  while true {
    await on.change(hover_dirty)
    const hovering = armory_hovering
    const shown = armory_hover
    if hovering {
      var_focus = shown
    } else {
      var_focus = eq_0
    }
    if hovering {
      const h = shown[Item]
      const held = eq_of(h.slot, eq_0, eq_1, eq_2, eq_3)
      if held != 0 && held != shown {
        const w = held[Item]
        preview_might = h.might - w.might
        preview_ward = h.ward - w.ward
        preview_haste = h.haste - w.haste
        preview_aether = h.aether - w.aether
      } else {
        preview_might = 0
        preview_ward = 0
        preview_haste = 0
        preview_aether = 0
      }
    } else {
      preview_might = 0
      preview_ward = 0
      preview_haste = 0
      preview_aether = 0
    }
    if var_focus != 0 && var_focus != last_focus {
      const f = var_focus[Item]
      last_focus = var_focus
      relic_model = f.slot
      relic_r = f.model_hue.r
      relic_g = f.model_hue.g
      relic_b = f.model_hue.b
      relic_name = f.name
      relic_line = "{rarity_name(f.rarity)} {slot_name(f.slot)}"
      relic_serial = relic_serial + 1
    }
  }
}

async {
  while true {
    await on.change(hover_left)
    if armory_left == armory_hover {
      armory_hovering = false
      armory_tip_on = false
      await ui.changed(hover_dirty)
    }
  }
}
