fn bool_f(b: bool) -> f32 {
  b ? 1 : 0
}

fn has_bit(mask: i32, i: i32) -> bool {
  (mask >> i) % 2 == 1
}

fn dest_name(i: i32) -> string {
  match i { 0: "ORO BASIN"; 1: "VEIL OF NAUR"; _: "CINDER YARD" }
}

fn dest_code(i: i32) -> string {
  match i { 0: "ORO-4"; 1: "NAU-7"; _: "CIN-2" }
}

fn radio_signal(t: f32) -> f32 {
  1 - min(abs(t - 0.62) * 9, 1)
}

fn breaker_name(i: i32) -> string {
  match i {
    0: "GALLEY"
    1: "O2 PMP"
    2: "SCRUB"
    3: "AFT LT"
    4: "FWD LT"
    5: "WINCH"
    6: "SCOPE"
    7: "ASSAY"
    8: "CARGO"
    9: "HOIST"
    10: "BILGE"
    _: "TOLL XP"
  }
}

fn help_text(s: i32) -> string {
  match s {
    0: "SPACE next step  |  click the red guard, then the switch  |  1-6 views  |  right drag look  |  H hide"
    1: "SPACE next step  |  hold IGNITE on the center stack  |  1-6 views  |  right drag look  |  H hide"
    2: "SPACE next step  |  pick a destination on the nav scope or the hologram  |  WASD fly  |  H hide"
    3: "SPACE next step  |  drag the red JUMP handle toward you  |  H hide"
    _: "H hide"
  }
}
