// The sound of the dust merchant: script only, on the components of box.audio (docs/audio.md).
//
// - Buses: ui for the controls, world for the engine and cabin_verb, the reverb of the cabin,
//   which world sends to; music for the track. All of them go into the master.
// - The controls of widgets.flecs play the synth sounds below from their input handlers, the
//   same async blocks that flip and turn them, each with a pitch variance so that no two clicks
//   are the same.
// - The engine is a looping synth drone at a fixed pitch, placed on the starboard engine pod
//   behind the cabin, so it pans and changes level as the camera moves between the stations.
//   Its level follows the main bus and the reactor; its pitch does not follow eng_rpm.
// - The music is assets/dust_merchant_loop.ogg, a loop of 32 seconds that make_music.py renders
//   with the synth of box from music_score.flecs.
//
// Included after state.flecs, whose muts the engine reads, and before widgets.flecs, whose
// controls play the sounds.
using flecs.script
using box.transform
using box.audio
using state
using assets

assets {
  cabin_verb {
    AudioBus: {output: master, kind: AudioChannelReturn, effects: [cabin_verb]}
    Reverb: {decay: 0.75, damping: 0.6, predelay: 0.008, size: 0.25}
  }
  world {
    AudioBus: {output: master, kind: AudioChannelSfx, sends: [{bus: cabin_verb, level: 0.28}]}
  }
  ui { AudioBus: {output: master, kind: AudioChannelSfx, volume: 0.55} }
  music { AudioBus: {output: master, volume: 0.45} }

  // A toggle switch: a hard snap of noise over a falling tick and the knock of its body
  prefab SfxToggle {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 21, pitch_variance: 0.08, level_variance: 0.12}
    SynthEnvelope: {attack: 0.0005, decay: 0.04}
    SynthFilter: {kind: SynthHighPass, cutoff: 600, resonance: 0.15}
    snap {
      SynthOscillator: {wave: SynthNoise, level: 0.5}
      SynthEnvelope: {attack: 0.0005, decay: 0.012}
    }
    tick {
      SynthOscillator: {wave: SynthTriangle, frequency: 2600, frequency_end: 1400, sweep: 0.02, level: 0.45}
      SynthEnvelope: {attack: 0.0005, decay: 0.025}
    }
    knock { SynthOscillator: {wave: SynthSine, frequency: 1100, frequency_end: 700, sweep: 0.04, level: 0.35} }
  }

  // The red guard of the main switch, a plastic lid that flops open or shut
  prefab SfxGuard {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 22, pitch_variance: 0.06, level_variance: 0.1}
    SynthEnvelope: {attack: 0.001, decay: 0.07}
    SynthFilter: {kind: SynthBandPass, cutoff: 950, resonance: 0.3}
    rub { SynthOscillator: {wave: SynthNoise, level: 0.7} }
    thud { SynthOscillator: {wave: SynthTriangle, frequency: 520, frequency_end: 300, sweep: 0.06, level: 0.4} }
  }

  // The detent of a knob or a lever, a tiny bright tick
  prefab SfxDetent {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 23, pitch_variance: 0.12, level_variance: 0.2}
    SynthEnvelope: {attack: 0.0005, decay: 0.008}
    SynthFilter: {kind: SynthHighPass, cutoff: 2500}
    grit { SynthOscillator: {wave: SynthNoise, level: 0.4} }
    ping { SynthOscillator: {wave: SynthSine, frequency: 3400, level: 0.3} }
  }

  // A cap button going down or coming up, soft and short
  prefab SfxButton {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 24, pitch_variance: 0.06, level_variance: 0.1}
    SynthEnvelope: {attack: 0.001, decay: 0.03}
    SynthFilter: {kind: SynthLowPass, cutoff: 2200}
    pad { SynthOscillator: {wave: SynthNoise, level: 0.4} }
    tone { SynthOscillator: {wave: SynthSine, frequency: 720, frequency_end: 480, sweep: 0.03, level: 0.45} }
  }

  // A circuit breaker popping out or pushed back in: a clack
  prefab SfxBreaker {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 25, pitch_variance: 0.07, level_variance: 0.1}
    SynthEnvelope: {attack: 0.0005, decay: 0.035}
    SynthFilter: {kind: SynthBandPass, cutoff: 1500, resonance: 0.3}
    clack { SynthOscillator: {wave: SynthNoise, level: 0.7} }
    body { SynthOscillator: {wave: SynthSquare, frequency: 900, frequency_end: 400, sweep: 0.025, level: 0.22} }
  }

  // A hand slapping the radio: a dull thump
  prefab SfxThump {
    AudioOutput: {bus: ui}
    SynthSound: {seed: 26, pitch_variance: 0.05, level_variance: 0.1}
    SynthEnvelope: {attack: 0.001, decay: 0.14}
    SynthFilter: {kind: SynthLowPass, cutoff: 600}
    boom { SynthOscillator: {wave: SynthSine, frequency: 130, frequency_end: 60, sweep: 0.09, level: 0.8} }
    slap {
      SynthOscillator: {wave: SynthNoise, level: 0.5}
      SynthEnvelope: {attack: 0.001, decay: 0.04}
    }
  }

  // The engine: a low saw and its fifth through a resonant lowpass, a faint whine and a rumble of
  // noise. It loops one pass of 60 seconds; the edges of 2 ms where a pass restarts are a gap the
  // lowpass smooths over.
  prefab EngineHum {
    SynthSound: {seed: 11}
    SynthEnvelope: {attack: 0.002, sustain: 1, hold: 59.99, release: 0.002}
    SynthFilter: {kind: SynthLowPass, cutoff: 380, resonance: 0.35}
    base { SynthOscillator: {wave: SynthSaw, frequency: 46, level: 0.5} }
    fifth { SynthOscillator: {wave: SynthSquare, frequency: 69.3, level: 0.16} }
    whine { SynthOscillator: {wave: SynthTriangle, frequency: 368, level: 0.05} }
    rumble { SynthOscillator: {wave: SynthNoise, level: 0.22} }
  }
}

// The ears are the camera of rig.flecs. Without a listener the camera of the first view would
// hear, and the screens render their own views before the main one.
camera { AudioListener }

dust_merchant {
  engine_sound {
    Position: {3.1, 0.6, 3.8}
    AudioSource: {sound: assets.EngineHum, loop: true, volume: 0.3 + 0.2 * bool_f(bus) + 0.3 * bool_f(reactor_on)}
    AudioOutput: {bus: assets.world}
    AudioSpatial: {min_distance: 1.5, max_distance: 30}
  }

  music_track {
    AudioStream: {path: "etc/scenes/dust_merchant/assets/dust_merchant_loop.ogg"}
    AudioOutput: {bus: assets.music}
  }
}
