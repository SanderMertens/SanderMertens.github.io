template SparkBurst {
  ParticleEmitter: {
    max: 160, rate: 0, shape: EmitterSphere, radius: 0.012, direction: {0, -1, 0.4}, spread: 62,
    speed: {0.5, 2.6}, lifetime: {0.25, 1.1}, size: {0.0022, 0.0066}, color: {255, 190, 92},
    color_variance: {0, 40, 40}, opacity: {0.8, 1}, seed: spark_serial, linger: true
  }
  ParticleForces: {gravity: {0, -5.8, 0}, drag: 0.5}
  ParticleCollision: {ground: true, height: 0.02, bounce: 0.46, friction: 0.3}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.03}
  ParticleCurves: {
    opacity: {keys: [{0, 1}, {0.33333334, 1}, {0.6666667, 0.7}, {1, 0}]}
    color: {keys: [
      {0, {255, 240, 200}},
      {0.33333334, {255, 190, 90}},
      {0.6666667, {255, 120, 50}},
      {1, {180, 50, 20}}
    ]}
  }
  ParticleBurst: {count: 130, at: 0}
  PointLight: {intensity: 1.4, range: 2.2}
  Rgb: {255, 190, 110}
  ParticleLight: {
    intensity: 1.4
    curve: {keys: [{0, 1}, {0.33333334, 0.5}, {0.6666667, 0.2}, {1, 0}]}
    period: 0.7
  }
}

template CabinMotes {
  Position: {0, 1.3, -1.0}
  ParticleEmitter: {
    max: 700, rate: 90, shape: EmitterBox, extents: {1.3, 0.8, 0.55}, direction: {0, 0, 0},
    speed: {0, 0}, lifetime: {5, 10}, size: {0.0014, 0.0038}, color: {255, 226, 186},
    opacity: {0.2, 0.7}, seed: 77
  }
  ParticleForces: {gravity: {0, 0, 0}, turbulence: 0.03, drag: 0.6}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, lit: 1}
  ParticleCurves: {opacity: {keys: [{0, 0}, {0.33333334, 1}, {0.6666667, 1}, {1, 0}]}}
  SpatialIgnore
}

prefab VoidRing { Torus: {radius: 17, tube: 12, segments: 48, rings: 16} }

template VoidDust {
  const jumping = warp && !in_tunnel
  const push = 6 + kn[KN_THROTTLE] * 60 + bool_f(jumping) * 900

  Position: {0, 1.4, -70}
  Rotation: {PI / 2, 0, 0}
  ParticleEmitter: {
    max: 1600, rate: match in_tunnel { true: 0; _: 36 + kn[KN_THROTTLE] * 260 + bool_f(jumping) * 1400 }, shape: EmitterMesh, source: VoidRing,
    direction: {0, 1, 0}, spread: 0, speed: {push, push * 1.3},
    lifetime: {110 / push, 150 / push}, size: {0.03, 0.08}, color: {214, 228, 255}, opacity: {0.2, 0.7}, seed: 12
  }
  ParticleForces: {gravity: {0, 0, 0}}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: match jumping { true: 0.16; _: 0.018 }}
  SpatialIgnore
}

template VentSmoke {
  Position: {0.36, 2.2, -0.1}
  ParticleEmitter: {
    max: 180, rate: match smoke { true: 46; _: 0 }, shape: EmitterSphere, radius: 0.03, direction: {0, -1, 0}, spread: 30,
    speed: {0.05, 0.22}, lifetime: {1.4, 3.2}, size: {0.05, 0.13}, color: {150, 146, 140}, opacity: {0.12, 0.3}, seed: 9
  }
  ParticleForces: {gravity: {0, -0.03, 0}, turbulence: 0.18, drag: 0.5}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAlpha, softness: 0.05, lit: 0.8}
  ParticleCurves: {
    size: {keys: [{0, 0.4}, {0.33333334, 1}, {0.6666667, 1.6}, {1, 2.4}]}
    opacity: {keys: [{0, 0}, {0.33333334, 1}, {0.6666667, 0.6}, {1, 0}]}
  }
  SpatialIgnore
}

template CargoLeak {
  prop side: f32 = 1

  Position: {side * pod_x(0.62), pod_top(0.62, side, 0, 0.32).y, pod_z(0.62)}
  ParticleEmitter: {
    max: 240, rate: match in_tunnel { true: 0; _: 16 }, shape: EmitterSphere, radius: 0.03, direction: {side * 0.3, 0.35, 1}, spread: 13,
    speed: {0.24, 0.62}, lifetime: {3, 6.5}, size: {0.03, 0.09}, color: {196, 128, 66}, color_variance: {20, 20, 12}, opacity: {0.16, 0.34}, seed: 41
  }
  ParticleForces: {gravity: {0, 0, 0}, turbulence: 0.08, drag: 0.05}
  ParticleAppearance: {shape: ParticleCircle, blend: ParticleAlpha, softness: 0.05, lit: 0.9}
  ParticleCurves: {
    size: {keys: [{0, 0.5}, {0.33333334, 1}, {0.6666667, 1.7}, {1, 2.6}]}
    opacity: {keys: [{0, 0}, {0.33333334, 1}, {0.6666667, 0.7}, {1, 0}]}
  }
  SpatialIgnore
}

CargoLeak cargo_leak(side: 1)

CabinMotes motes()
VoidDust void_dust()
VentSmoke vent_smoke()

sparks_at {
  Position: {0.36, 2.15, -0.14}
  if spark_serial > 0 {
    SparkBurst "burst_{spark_serial}"() { Position: {0, 0, 0} }
  }
}

template ShutterPlate {
  prop s0: f32 = 0
  prop s1: f32 = 1
  prop t0: f32 = -1
  prop t1: f32 = 1
  prop lag: f32 = 0

  const shut = sw[SW_SHUTTER] && bus
  const size = match shut { true: 1; _: 0.001 }
  const hub = hull_pt((s0 + s1) / 2, (t0 + t1) / 2)

  Position: {hub.x, hub.y, hub.z}
  Scale: {size, size, size}
  Transition: [Scale: {duration: 0.42, delay: lag, timing_function: EaseInOut}]
  plate : HullPlate {
    Position: {0, 0, 0}
    HullPatch: {s0: s0, s1: s1, t0: t0, t1: t1, lift: -0.02, origin: {hub.x, hub.y, hub.z}}
    TextureTransform: {scale_x: 1, scale_y: 1}
    Rgb: {110, 106, 94}
    SpatialIgnore
  }
}

template Blinds {
  for k in 0..HULL_RINGS {
    for j in 0..HULL_ARCS {
      if !pane_solid(k, j) {
        ShutterPlate "plate_{k}_{j}"(
          s0: ring_s(k), s1: ring_s(k + 1),
          t0: arc_t(j), t1: arc_t(j + 1),
          lag: k * 0.09 + abs(j - 2.5) * 0.03
        )
      }
    }
  }
}

Blinds blinds()

export mut hint_ink: f32 = 1

template HelpLine {
  ui {
    Scene: {}
    camera { Position: {0, 0, 100}; Camera: {ortho: true, ortho_scale: 1} }
    root {
      LayoutFill: {surface: window}
      Layout: {}
      if help_on {
        line {
          LayoutItem: {h: Center, v: Bottom, y: 14}
          Layout: {padding: {7, 7, 14, 14}, h: Center, v: Middle}
          Rect: {1, 1}
          Rgb: {6, 6, 6}
          Opacity: {0.74}
          Border: {radius: 4}
          words {
            Text: {value: help_text(stage), size: 15, font: font_mono}
            Rgb: {226, 214, 186}
          }
        }
      }
    }
  }
  ui_view {
    View: {camera: ui.camera, order: 5, lighting: {enabled: false}, culling: {enabled: false}}
  }
}

HelpLine help_line()
