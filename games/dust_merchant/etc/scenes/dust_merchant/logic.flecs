using flecs.script
using flecs.script.math
using box.app
using box.input

fn approach(v: f32, target: f32, rate: f32) -> f32 {
  v + (target - v) * clamp(rate, 0, 1)
}

fn fract(x: f64) -> f64 {
  x - floor(x)
}

fn igniting_shake(b: bool) -> f32 {
  match b { true: 0.12; _: 0 }
}

event Engage()

const STATION_X: f32[6] = [-0.38, -0.34, 0.08, 0.34, -0.72, -0.14]
const STATION_Y: f32[6] = [1.36, 1.0, 1.04, 1.02, 1.02, 1.3]
const STATION_Z: f32[6] = [0.12, -0.28, -0.06, -0.24, -0.12, 1.28]
const STATION_PITCH: f32[6] = [-0.22, -0.46, -0.72, -0.36, -0.32, 1.02]
const STATION_YAW: f32[6] = [-0.06, 0, -0.34, -0.7, 0.72, 0.02]
const TURN: f32 = 2 * PI

async {
  mut last: f64 = AppStatus[AppStatus].elapsed
  mut cam_x: f32 = STATION_X[0]
  mut cam_y: f32 = STATION_Y[0]
  mut cam_z: f32 = STATION_Z[0]
  mut cam_pitch: f32 = STATION_PITCH[0]
  mut cam_yaw: f32 = STATION_YAW[0]
  mut pan_x: f32 = 0
  mut pan_y: f32 = 0
  while true {
    await next_frame()
    const now = AppStatus[AppStatus].elapsed
    const fixed_step = App[App].delta_time
    const step = match fixed_step > 0 { true: fixed_step; _: clamp(now - last, 0.001, 0.1) }
    last = now
    clock = clock + step
    dt = step
    if fract(clock * 2.6) < 0.5 != blink {
      blink = !blink
    }
    if fract(clock * 0.9) < 0.5 != slow_blink {
      slow_blink = !slow_blink
    }

    const want_flood = bool_f(bus) * (0.25 + bool_f(sw[SW_CABIN]) * 0.75)
    if abs(flood - want_flood) > 0.002 {
      flood = approach(flood, want_flood, step * 2.2)
    }
    const want_volts = bool_f(bus) * (0.68 + reactor * 0.1)
    if abs(bus_volts - want_volts) > 0.002 {
      bus_volts = approach(bus_volts, want_volts, step * 4)
    }
    const want_rpm = reactor * (0.28 + kn[KN_THROTTLE] * 0.66)
    if abs(eng_rpm - want_rpm) > 0.003 {
      eng_rpm = approach(eng_rpm, want_rpm, step * 1.3)
    }
    const want_temp = reactor * (0.3 + kn[KN_THROTTLE] * 0.35) + bool_f(fault) * 0.3
    if abs(eng_temp - want_temp) > 0.003 {
      eng_temp = approach(eng_temp, want_temp, step * 0.4)
    }

    if igniting && bus && reactor < 1 {
      reactor = min(reactor + step * 0.42, 1)
    } else if !igniting && !reactor_on && reactor > 0 {
      reactor = max(reactor - step * 0.5, 0)
    }
    if reactor >= 0.999 && !reactor_on {
      reactor_on = true
      if stage < STAGE_READY {
        stage = STAGE_READY
      }
    }

    if stage == STAGE_READY && course >= 0 && course != here {
      plot = min(plot + step * 0.5, 1)
      if plot >= 1 {
        stage = STAGE_PLOTTED
      }
    }

    if stage == STAGE_PLOTTED && kn[KN_JUMP] > 0.92 {
      kn[KN_JUMP] = 0
      emit Engage()
    }

    if in_tunnel {
      scroll = scroll + step * 3.4
      trip_units = trip_units + floor(step * 140 + 1)
    } else if eng_rpm > 0.05 {
      if fract(clock * 3.5 * eng_rpm) < step * 3.5 * eng_rpm {
        trip_units = trip_units + 1
      }
    }

    if stage <= STAGE_PLOTTED {
      const roll_in = bool_f(actions.roll_r[ActionState].down) - bool_f(actions.roll_l[ActionState].down)
      const pitch_in = bool_f(actions.nose_u[ActionState].down) - bool_f(actions.nose_d[ActionState].down)
      if roll_in != 0 {
        attitude_roll = attitude_roll + roll_in * step * 0.42
      }
      if pitch_in != 0 {
        attitude_pitch = clamp(attitude_pitch + pitch_in * step * 0.3, -0.72, 0.72)
      }
      attitude_yaw = attitude_yaw + step * 0.004
    } else {
      attitude_roll = approach(attitude_roll - round(attitude_roll / TURN) * TURN, 0, step * 2.4)
      attitude_pitch = approach(attitude_pitch, 0, step * 2.4)
      attitude_yaw = approach(attitude_yaw - round(attitude_yaw / TURN) * TURN, 0, step * 2.4)
    }
    sky_roll = attitude_roll
    sky_pitch = attitude_pitch
    sky_yaw = attitude_yaw

    const m = Input[Input].mouse
    if actions.look[ActionState].down {
      look_yaw = clamp(look_yaw - m.delta.x * 0.0034, -1.7, 1.7)
      look_pitch = clamp(look_pitch - m.delta.y * 0.0034, -1.0, 1.0)
    }
    const at = m.normalized
    const want_pan_x = (0.5 - at.x) * 0.17
    const want_pan_y = (0.5 - at.y) * 0.1
    pan_x = approach(pan_x, want_pan_x, step * 3)
    pan_y = approach(pan_y, want_pan_y, step * 3)

    eye_fov = approach(eye_fov, fov_want, step * 5)

    const v = view
    const blend = step * 5
    cam_x = approach(cam_x, STATION_X[v], blend)
    cam_y = approach(cam_y, STATION_Y[v], blend)
    cam_z = approach(cam_z, STATION_Z[v], blend)
    cam_pitch = approach(cam_pitch, STATION_PITCH[v], blend)
    cam_yaw = approach(cam_yaw, STATION_YAW[v], blend)
    const rumble = shake + reactor * 0.004 + igniting_shake(igniting)
    eye_x = cam_x - pan_x * 0.12 + perlin2(clock * 23, 3.1) * rumble * 0.05
    eye_y = cam_y + pan_y * 0.08 + perlin2(clock * 27, 9.4) * rumble * 0.05 + sin(clock * 0.8) * 0.0022
    eye_z = cam_z
    eye_yaw = cam_yaw + pan_x + look_yaw + perlin2(clock * 19, 5.5) * rumble * 0.02
    eye_pitch = cam_pitch + pan_y + look_pitch + perlin2(clock * 21, 2.2) * rumble * 0.02
    eye_roll = perlin2(clock * 16, 7.7) * rumble * 0.03 + attitude_roll * 0.02
  }
}

async {
  while true {
    const e = await Flipped
    if e.sig == SW_MAIN {
      if sw[SW_MAIN] {
        bus = true
        stage = STAGE_BUS
        lamp_test = true
        sw[SW_CABIN] = true
        sw[SW_GYRO] = true
        sw[SW_COOL] = true
        sw[SW_FUEL_A] = true
        sw[SW_FUEL_B] = true
        sw[SW_HUD] = true
        sw[SW_HOLO] = true
        sw[SW_FANS] = true
        sw[SW_HEAT] = true
      } else {
        bus = false
        stage = STAGE_COLD
        reactor_on = false
        crt_nav = false
        crt_sys = false
        crt_com = false
        boot_lines = 0
        course = -1
        plot = 0
      }
    }
  }
}

async {
  while true {
    await next_frame()
    if bus && !crt_sys {
      await delay(0.5)
      crt_sys = bus
      for i in 0..8 {
        await delay(0.22)
        boot_lines = i
      }
      lamp_test = false
      await delay(0.3)
      crt_nav = bus
      await delay(0.45)
      crt_com = bus
    }
  }
}

async {
  while true {
    await on.pressed(actions.ignite)
    igniting = true
    await on.released(actions.ignite)
    igniting = false
  }
}

async {
  while true {
    const e = await PickCourse
    if stage >= STAGE_READY && stage <= STAGE_PLOTTED && e.dest != here {
      course = e.dest
      plot = 0
      stage = STAGE_READY
    }
  }
}

async {
  while true {
    await on.pressed(actions.view_a)
    view = 0
    look_yaw = 0
    look_pitch = 0
  }
}
async {
  while true {
    await on.pressed(actions.view_b)
    view = 1
    look_yaw = 0
    look_pitch = 0
  }
}
async {
  while true {
    await on.pressed(actions.view_c)
    view = 2
    look_yaw = 0
    look_pitch = 0
  }
}
async {
  while true {
    await on.pressed(actions.view_d)
    view = 3
    look_yaw = 0
    look_pitch = 0
  }
}
async {
  while true {
    await on.pressed(actions.view_e)
    view = 4
    look_yaw = 0
    look_pitch = 0
  }
}
async {
  while true {
    await on.pressed(actions.view_f)
    view = 5
    look_yaw = 0
    look_pitch = 0
  }
}

async {
  while true {
    await on.pressed(actions.help)
    help_on = !help_on
  }
}

async {
  while true {
    await on.pressed(actions.caution)
    if fault {
      fault = false
      smoke = false
      coolant = max(coolant, 0.62)
    }
  }
}

async {
  while true {
    await Engage
    stage = STAGE_CHARGING
    const dest = course
    jump_level = 0
    for i in 0..22 {
      await delay(0.1)
      shake = i * 0.017
      flood = flood * 0.975
    }
    attitude_roll = 0
    attitude_pitch = 0
    attitude_yaw = 0
    warp = true
    star_mode = STARS_STREAK
    fov_want = 82
    await delay(0.72)
    flash = 1
    in_tunnel = true
    tunnel_on = true
    star_mode = STARS_HIDDEN
    stage = STAGE_TUNNEL
    shake = 0.5
    await delay(0.2)
    flash = 0
    await delay(1.7)
    here = dest
    com_shown = 0
    await delay(3)
    shake = 0.62
    warp = false
    await delay(0.22)
    flash = 1
    tunnel_on = false
    in_tunnel = false
    star_mode = STARS_SNAP
    fov_want = 62
    course = -1
    plot = 0
    stage = STAGE_READY
    await next_frame()
    star_mode = STARS_REST
    await delay(0.12)
    flash = 0
    fov_want = 70
    for i in 0..14 {
      await delay(0.09)
      shake = 0.5 - i * 0.034
    }
    shake = 0
    fault = true
    smoke = true
    coolant = 0.22
    spark_serial = spark_serial + 1
  }
}

async {
  while true {
    await on.pressed(actions.step)
    if stage == STAGE_COLD && !sw[SW_MAIN] {
      sw[SW_MAIN] = true
      const snap = box.audio.play(SfxToggle, 0.8)
      emit Flipped(sig: SW_MAIN)
    } else if stage == STAGE_BUS {
      igniting = true
      await delay(2.6)
      igniting = false
    } else if stage == STAGE_READY && (course < 0 || course == here) {
      emit PickCourse(dest: (here + 1) % 3)
    } else if stage == STAGE_PLOTTED {
      emit Engage()
    }
    if fault {
      fault = false
      smoke = false
      coolant = max(coolant, 0.62)
    }
  }
}

async {
  while true {
    const e = await Flipped
    if e.sig == SW_SPARE_D && sw[SW_SPARE_D] {
      spark_serial = spark_serial + 1
    }
  }
}

async {
  while true {
    await delay(0.62)
    const live = crt_com && radio_signal(kn[KN_TUNE]) > 0.72 && !in_tunnel
    if live && com_shown < 7 {
      com_shown = com_shown + 1
    } else if !live && com_shown > 0 {
      com_shown = 0
    }
  }
}

async {
  while true {
    await Whack
    if bus && stage <= STAGE_PLOTTED {
      kn[KN_TUNE] = 0.62
      crt_com = false
      shake = 0.16
      await delay(0.09)
      crt_com = bus
      await delay(0.12)
      shake = 0
    }
  }
}

async {
  while true {
    await on.pressed(actions.clear_course)
    if stage >= STAGE_READY && stage <= STAGE_PLOTTED {
      course = -1
      plot = 0
      stage = STAGE_READY
    }
  }
}

async {
  while true {
    await on.pressed(actions.trim_zero)
    if stage <= STAGE_PLOTTED {
      attitude_roll = 0
      attitude_pitch = 0
    }
  }
}
