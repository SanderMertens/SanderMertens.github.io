hl_phaser {
  Phaser: {stages: 4, rate: 0.22, depth: 0.6, center: 700, feedback: 0.35, mix: 0.4}
}

harbor_kit {
  AudioBus: {output: harbor, volume: 0.8, sends: [{bus: room, level: 0.3}]}
  AudioMeter: {}
}

hl_keys {
  Track: {instrument: hl_keys_inst, swing: 0.334, humanize: {timing: 6, velocity: 0.08}}
  AudioBus: {output: harbor, volume: 1.1, effects: [hl_phaser], sends: [{bus: room, level: 0.25}]}
  AudioMeter: {}
