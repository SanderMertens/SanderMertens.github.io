using box.audio

prefab hl_rhodes {
  SynthSound: {level_variance: 0.04}
  SynthEnvelope: {attack: 0.003, decay: 1.6, sustain: 0.3, release: 0.4, curve: 4}
  SynthLfo: {rate: 4.2, amplitude: 0.16, random_phase: true}
  body {
    SynthOscillator: {frequency: 440, level: 0.3}
    warmth {
      SynthOscillator: {frequency: 440, modulation: SynthPhase, index: 1.5}
      SynthEnvelope: {attack: 0.003, decay: 0.7, sustain: 0.15, release: 0.3, curve: 3}
    }
  }
  tine {
    SynthOscillator: {frequency: 440, level: 0.08}
    SynthEnvelope: {attack: 0.001, decay: 0.35, curve: 4}
    strike {
      SynthOscillator: {frequency: 6160, modulation: SynthPhase, index: 2}
      SynthEnvelope: {attack: 0.001, decay: 0.06}
    }
  }
}

prefab hl_upright {
  SynthSound: {seed: 11, level_variance: 0.06}
  SynthEnvelope: {attack: 0.002, decay: 0.4, sustain: 0.85, release: 0.12, curve: 3}
  SynthFilter: {kind: SynthLowPass, cutoff: 1100}
  string {
    SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.8}
    SynthString: {decay: 1.8, brightness: 0.22, hardness: 0.35}
  }
  thump {
    SynthOscillator: {frequency: 440, level: 0.25}
    SynthEnvelope: {attack: 0.004, decay: 0.45, curve: 4}
  }
}

prefab hl_vibraphone {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.002, decay: 2.4, release: 0.5, curve: 5}
  SynthLfo: {rate: 5.5, amplitude: 0.3}
  bar {
    SynthOscillator: {frequency: 440, level: 0.32}
    bright {
      SynthOscillator: {frequency: 1760, modulation: SynthPhase, index: 1.2}
      SynthEnvelope: {attack: 0.001, decay: 0.25, curve: 3}
    }
  }
  overtone {
    SynthOscillator: {frequency: 1760, level: 0.04}
    SynthEnvelope: {attack: 0.001, decay: 0.4, curve: 4}
  }
}

prefab hl_kick_drum {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.002, decay: 0.38, curve: 4}
  SynthFilter: {kind: SynthLowPass, cutoff: 1800}
  tone { SynthOscillator: {frequency: 120, frequency_end: 46, sweep: 0.07, level: 0.55} }
  felt {
    SynthOscillator: {wave: SynthNoise, level: 0.15}
    SynthEnvelope: {attack: 0.001, decay: 0.012}
  }
}

prefab hl_brush {
  SynthSound: {seed: 4, level_variance: 0.15}
  SynthEnvelope: {attack: 0.008, decay: 0.22, curve: 3}
  SynthFilter: {kind: SynthBandPass, cutoff: 2600, resonance: 0.15}
  swish { SynthOscillator: {wave: SynthNoise, level: 0.7} }
  head {
    SynthOscillator: {wave: SynthTriangle, frequency: 210, frequency_end: 170, sweep: 0.05, level: 0.3}
    SynthEnvelope: {attack: 0.001, decay: 0.07, curve: 3}
  }
}

prefab hl_hat {
  SynthSound: {seed: 8, level_variance: 0.2}
  SynthEnvelope: {attack: 0.001, decay: 0.05, curve: 3}
  SynthFilter: {kind: SynthHighPass, cutoff: 7000, resonance: 0.1}
  SynthOscillator: {wave: SynthNoise, level: 0.45}
}

hl_keys_inst { Instrument: {sound: hl_rhodes} }
hl_bass_inst { Instrument: {sound: hl_upright} }
hl_vibes_inst { Instrument: {sound: hl_vibraphone, velocity_curve: 1.5} }
hl_kick_inst { Instrument: {sound: hl_kick_drum, gate: false} }
hl_brush_inst { Instrument: {sound: hl_brush, gate: false} }
hl_hat_inst { Instrument: {sound: hl_hat, gate: false} }

