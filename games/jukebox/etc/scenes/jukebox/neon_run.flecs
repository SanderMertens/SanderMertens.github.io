const NR: f32 = 1000

neon_kit {
  AudioBus: {output: neon, volume: 0.8}
  AudioMeter: {}
}

nr_kick {
  Track: {instrument: nr_kick_inst}
  AudioBus: {output: neon_kit}
  drop { ClipPlacement: {clip: nr_four_floor, start: NR + 16, duration: 48, loop: true} }
}

nr_snare {
  Track: {instrument: nr_snare_inst}
  AudioBus: {output: neon_kit, volume: 0.65, sends: [{bus: plate, level: 0.5}]}
  roll { ClipPlacement: {clip: nr_snare_roll, start: NR + 12, gain: 0.8} }
  drop { ClipPlacement: {clip: nr_backbeat, start: NR + 16, duration: 48, loop: true} }
}

nr_hats {
  Track: {instrument: nr_hat_inst}
  AudioBus: {output: neon_kit, volume: 0.5, pan: 0.1}
  drop { ClipPlacement: {clip: nr_sixteenths, start: NR + 16, duration: 48, loop: true} }
}

nr_duck {
  Compressor: {threshold: -20, ratio: 3, attack: 0.003, release: 0.2, knee: 6, sidechain: nr_kick}
  AudioMeter: {}
}

nr_wide {
  Chorus: {voices: 3, rate: 0.5, depth: 4, delay: 14, spread: 1, mix: 0.35}
}

nr_pad {
  Track: {instrument: nr_pad_inst}
  AudioBus: {output: neon, volume: 0.8, effects: [nr_duck, nr_wide], sends: [{bus: hall, level: 0.2}]}
  AudioMeter: {}
  chords { ClipPlacement: {clip: nr_pad_chords, start: NR, duration: 64, loop: true} }
}

nr_bass {
  Track: {instrument: nr_bass_inst}
  AudioBus: {output: neon, volume: 0.8}
  AudioMeter: {}
  drop { ClipPlacement: {clip: nr_bass_octaves, start: NR + 16, duration: 48, loop: true} }
}

nr_sweep {
  AudioFilter: {cutoff: sweep, resonance: 0.35, slope: SynthSlope24}
}

nr_echo {
  Delay: {sync: 0.75, feedback: 0.35, mix: 0.25, damping: 3000, ping_pong: true}
}

nr_arp {
  Track: {instrument: nr_arp_inst}
  AudioBus: {output: neon, volume: 0.55, effects: [nr_sweep, nr_echo]}
  AudioMeter: {}
  line { ClipPlacement: {clip: nr_arp_line, start: NR, duration: 64, loop: true} }
}

nr_lead {
  Track: {instrument: nr_lead_inst}
  AudioBus: {output: neon, volume: 0.6, sends: [{bus: echo, level: 0.3}, {bus: plate, level: 0.2}]}
  AudioMeter: {}
  hook { ClipPlacement: {clip: nr_hook, start: NR + 32} }
}
