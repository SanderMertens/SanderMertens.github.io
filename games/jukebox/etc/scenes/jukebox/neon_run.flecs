using box.audio

prefab nr_supersaw {
  SynthSound: {seed: 3}
  SynthEnvelope: {attack: 0.3, decay: 0.5, sustain: 0.75, release: 0.8, curve: 2.5, attack_curve: 1.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 2400, resonance: 0.15, slope: SynthSlope24}
  SynthLfo: {wave: SynthLfoTriangle, rate: 0.15, cutoff: 0.3}
  saw {
    SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.2}
    SynthUnison: {voices: 5, detune: 28, width: 0.9}
  }
  air {
    SynthOscillator: {wave: SynthSaw, frequency: 880, level: 0.06}
    SynthUnison: {voices: 3, detune: 16, width: 1}
  }
}

prefab nr_pulse {
  SynthSound: {seed: 6}
  SynthEnvelope: {attack: 0.002, decay: 0.16, sustain: 0.25, release: 0.08, curve: 4}
  SynthFilter: {kind: SynthLowPass, cutoff: 2600, resonance: 0.3}
  SynthFilterEnvelope: {decay: 0.12, amount: 1.4}
  SynthLfo: {wave: SynthLfoSine, rate: 0.35, pulse_width: 0.18}
  SynthOscillator: {wave: SynthSquare, frequency: 440, level: 0.28, pulse_width: 0.3}
}

prefab nr_bass_synth {
  SynthSound: {}
  SynthEnvelope: {attack: 0.003, decay: 0.2, sustain: 0.6, release: 0.06, curve: 3}
  SynthFilter: {kind: SynthLowPass, cutoff: 260, resonance: 0.35, slope: SynthSlope24}
  SynthFilterEnvelope: {decay: 0.16, sustain: 0.1, release: 0.06, amount: 2.6}
  saw { SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.38} }
  sub { SynthOscillator: {wave: SynthSquare, frequency: 220, level: 0.22} }
}

prefab nr_glide_lead {
  SynthSound: {}
  SynthGlide: {time: 0.07, legato: true, channel: 2}
  SynthEnvelope: {attack: 0.012, decay: 0.3, sustain: 0.7, release: 0.35, curve: 2.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 3200, resonance: 0.2}
  SynthLfo: {rate: 5.6, delay: 0.25, fade: 0.3, pitch: 18}
  saw {
    SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.22}
    SynthUnison: {voices: 3, detune: 12, width: 0.4}
  }
  body { SynthOscillator: {wave: SynthSquare, frequency: 220, level: 0.1} }
}

prefab nr_kick_drum {
  SynthSound: {}
  SynthEnvelope: {attack: 0.001, decay: 0.42, curve: 4}
  tone { SynthOscillator: {frequency: 160, frequency_end: 42, sweep: 0.08, level: 0.7} }
  click {
    SynthOscillator: {wave: SynthNoise, level: 0.25}
    SynthEnvelope: {attack: 0.0005, decay: 0.006}
  }
}

prefab nr_snare_drum {
  SynthSound: {seed: 12, level_variance: 0.08}
  SynthEnvelope: {attack: 0.001, decay: 0.24, curve: 4}
  SynthFilter: {kind: SynthHighPass, cutoff: 180}
  rattle {
    SynthOscillator: {wave: SynthNoise, level: 0.55}
    SynthEnvelope: {attack: 0.001, decay: 0.22, curve: 4}
  }
  head {
    SynthOscillator: {wave: SynthTriangle, frequency: 220, frequency_end: 165, sweep: 0.06, level: 0.45}
    SynthEnvelope: {attack: 0.001, decay: 0.1, curve: 3}
  }
}

prefab nr_hat {
  SynthSound: {seed: 21, level_variance: 0.1}
  SynthEnvelope: {attack: 0.0005, decay: 0.035, curve: 3}
  SynthFilter: {kind: SynthHighPass, cutoff: 8500, resonance: 0.15}
  SynthOscillator: {wave: SynthNoise, level: 0.4}
}

nr_pad_inst { Instrument: {sound: nr_supersaw} }
nr_arp_inst { Instrument: {sound: nr_pulse} }
nr_bass_inst { Instrument: {sound: nr_bass_synth} }
nr_lead_inst { Instrument: {sound: nr_glide_lead} }
nr_kick_inst { Instrument: {sound: nr_kick_drum, gate: false} }
nr_snare_inst { Instrument: {sound: nr_snare_drum, gate: false} }
nr_hat_inst { Instrument: {sound: nr_hat, gate: false} }

