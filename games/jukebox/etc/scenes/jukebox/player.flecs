using flecs.script
using flecs.script.math
using box.audio
using box.input

jukebox_actions {
  pick_harbor { Action: {description: "Play Harbor Lights"}; Binding: {key: Num3} }
  pick_neon { Action: {description: "Play Neon Run"}; Binding: {key: Num2} }
  pick_lantern { Action: {description: "Play Lantern Waltz"}; Binding: {key: Num4} }
  pick_orbit { Action: {description: "Play Distant Orbit"}; Binding: {key: Num1} }
  play { Action: {description: "Play or pause"}; Binding: {key: Space} }
  crash { Action: {description: "Crash on the next bar"}; Binding: {key: C} }
}

prefab jb_crash {
  AudioOutput: {bus: sfx}
  SynthSound: {seed: 43, level_variance: 0.05}
  SynthEnvelope: {attack: 0.001, decay: 2.2, curve: 5}
  SynthFilter: {kind: SynthHighPass, cutoff: 2600, resonance: 0.1}
  wash { SynthOscillator: {wave: SynthNoise, level: 0.45} }
  bell {
    SynthOscillator: {frequency: 3170, level: 0.08, feedback: 0.9}
    SynthEnvelope: {attack: 0.001, decay: 1.2, curve: 5}
    shimmer { SynthOscillator: {frequency: 4470, modulation: SynthRing, index: 1} }
  }
}

low_pass_filter {
  AudioFilter: {kind: SynthLowPass, cutoff: low_pass_cutoff, slope: SynthSlope24}
}

high_pass_filter {
  AudioFilter: {kind: SynthHighPass, cutoff: high_pass_cutoff, slope: SynthSlope24}
}

box {
  audio {
    master {
      AudioBus: {effects: [high_pass_filter, low_pass_filter]}
      AudioMeter: {}
    }
  }
}

$ {
  Transport: {
    tempo: SONG_TEMPO[song], beats_per_bar: SONG_BPB[song], beat_unit: 4,
    position: SONG_START[song], loop: true,
    loop_start: SONG_START[song], loop_end: SONG_START[song] + SONG_BEATS[song]
  }
  Transport = {playing: playing}
}

const LANES = [
  orbit_pad, orbit_bass, orbit_bells, orbit_melody, orbit, orbit,
  neon_kit, nr_bass, nr_pad, nr_arp, nr_lead, neon,
  harbor_kit, hl_bass, hl_keys, hl_vibes, harbor, harbor,
  lantern_kit, lw_bass, lw_harp, lw_strings, lw_flute, lw_glock
]

proc pick(n: i32) {
  song = n
  playing = true
}

async {
  while true {
    await on.pressed(jukebox_actions.pick_harbor)
    pick(2)
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.pick_neon)
    pick(1)
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.pick_lantern)
    pick(3)
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.play)
    playing = !playing
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.crash)
    const c = box.audio.play_quantized(jb_crash, 0.7, Bar)
  }
}

async {
  while true {
    const t = Transport[Transport]
    const b = t.position - SONG_START[song]
    beat = b

    for i in 0..6 {
      const e = LANES[song * 6 + i]
      const m = e[AudioMeter]
      const rms = max(max(m.rms_left, m.rms_right), 0.00001)
      levels[i] = clamp((20 * log10(rms) + 48) / 48, 0, 1)
    }

    const mm = box.audio.master[AudioMeter]
    master_l = clamp((20 * log10(max(mm.rms_left, 0.00001)) + 48) / 48, 0, 1)
    master_r = clamp((20 * log10(max(mm.rms_right, 0.00001)) + 48) / 48, 0, 1)
    glow = clamp((20 * log10(max(max(mm.peak_left, mm.peak_right), 0.00001)) + 30) / 30, 0, 1)

    const open = 300 * pow(2, 5 * clamp(b / 16, 0, 1))
    if abs(open - sweep) > sweep * 0.01 {
      sweep = open
    }

    await next_frame()
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.pick_orbit)
    pick(0)
  }
}
