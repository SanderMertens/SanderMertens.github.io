using flecs.script
using flecs.script.math
using box.audio
using box.input
using box.material

jukebox_actions {
  play { Action: {description: "Play or pause"}; Binding: {key: Space} }
  crash { Action: {description: "Crash on the next bar"}; Binding: {key: C} }
}

prefab jb_crash {
  AudioOutput: {bus: sfx}
  SynthSound: {seed: 43, level_variance: 0.05}
  SynthEnvelope: {attack: 0.001, decay: 2.2, curve: 5}
  SynthFilter: {kind: SynthHighPass, cutoff: 2600, resonance: 0.1}
  wash { SynthOscillator: {wave: SynthNoise, level: 0.45} }
  bell {
    SynthOscillator: {frequency: 3170, level: 0.08, feedback: 0.9}
    SynthEnvelope: {attack: 0.001, decay: 1.2, curve: 5}
    shimmer { SynthOscillator: {frequency: 4470, modulation: SynthRing, index: 1} }
  }
}

box {
  audio {
    master {
      AudioMeter: {}
    }
  }
}

$ {
  AudioSettings: {master_volume: volume_level / 100}
  AudioSong: {file: "etc/scenes/jukebox/songs/{SONGS[song].file}.flecs"}
  Transport = {playing: playing}
}

async {
  while true {
    await on.pressed(jukebox_actions.play)
    playing = !playing
  }
}

async {
  while true {
    await on.pressed(jukebox_actions.crash)
    const c = box.audio.play_quantized(jb_crash, 0.7, Bar)
  }
}

async {
  while true {
    const t = Transport[Transport]
    const s = Song[Song]
    const se: entity = Song
    const status = AudioSongStatus[AudioSongStatus]
    const b = t.position
    beat = b
    song_beats = max(s.beats, 1)

    const ready = status.state == SongReady
    if loaded != ready {
      loaded = ready
    }

    const shows = playing && ready && se.has(Rgb)
    if lit != shows {
      lit = shows
    }

    if shows {
      const c = se[Rgb]
      if color.r != c.r || color.g != c.g || color.b != c.b {
        color = c
      }
    } else if color.r != IDLE.r || color.g != IDLE.g || color.b != IDLE.b {
      color = IDLE
    }

    const mm = box.audio.master[AudioMeter]
    master_level[0] = clamp((20 * log10(max(mm.rms_left, 0.00001)) + 48) / 48, 0, 1)
    master_level[1] = clamp((20 * log10(max(mm.rms_right, 0.00001)) + 48) / 48, 0, 1)
    glow = clamp((20 * log10(max(max(mm.peak_left, mm.peak_right), 0.00001)) + 30) / 30, 0, 1)

    await next_frame()
  }
}
