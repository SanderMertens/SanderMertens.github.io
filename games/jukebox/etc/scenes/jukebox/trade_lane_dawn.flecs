using box.audio

box { audio { master {} } }

lane_space_eq {
  Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 240}, {kind: AudioEqHighCut, frequency: 6200}]}
}

lane_echo_eq {
  Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 400}]}
}

lane_space {
  AudioBus: {output: box.audio.master, kind: AudioChannelReturn, volume: 0.8 * reverb_level / 100, effects: [lane_space, lane_space_eq]}
  Reverb: {decay: 5.8, damping: 0.38, predelay: 0.075, size: 0.95}
}

lane_echo {
  AudioBus: {output: box.audio.master, kind: AudioChannelReturn, volume: 0.48, effects: [lane_echo, lane_echo_eq]}
  Delay: {sync: 1.5, feedback: 0.34, mix: 1, damping: 2400, ping_pong: true}
}

lane {
  AudioBus: {output: box.audio.master, volume: 0.85}
  AudioMeter: {}
}

lane_choirs { AudioBus: {output: lane, sends: [{bus: lane_space, level: 0.65}]}; AudioMeter: {} }
lane_strings { AudioBus: {output: lane, sends: [{bus: lane_space, level: 0.4}]}; AudioMeter: {} }
lane_horns { AudioBus: {output: lane, sends: [{bus: lane_space, level: 0.55}]}; AudioMeter: {} }
lane_engine { AudioBus: {output: lane}; AudioMeter: {} }
lane_signals { AudioBus: {output: lane, sends: [{bus: lane_space, level: 0.3}, {bus: lane_echo, level: 0.42}]}; AudioMeter: {} }
lane_motion { AudioBus: {output: lane, sends: [{bus: lane_space, level: 0.22}]}; AudioMeter: {} }

