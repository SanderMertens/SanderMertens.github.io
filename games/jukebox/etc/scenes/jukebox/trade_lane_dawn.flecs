  SynthFilter: {kind: SynthLowPass, cutoff: 2800, resonance: 0.08}
  SynthLfo: {rate: 0.11, amplitude: 0.13, cutoff: 0.18, random_phase: true}
  fundamental { SynthOscillator: {frequency: 440, level: 0.11}; SynthUnison: {voices: 3, detune: 5, width: 0.7} }
