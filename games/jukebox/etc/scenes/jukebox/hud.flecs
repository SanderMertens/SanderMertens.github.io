using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text
using box.input
using box.picking
using box.ui
using box.widgets

const PANEL_W: f32 = 320
const METER_H: f32 = 110

template SongButton {
  prop index: i32 = 0
  prop action: entity = 0
  mut hover = false

  const selected = playing && song == index
  const r = SONG_R[index]
  const g = SONG_G[index]
  const b = SONG_B[index]

  ActionTrigger: {action: action}
  Layout: {direction: Row, spacing: 10, padding: {7, 7, 10, 10}, v: Middle}
  LayoutItem: {width: {mode: Grow}}
  Rect: {1, 1}

  if selected {
    Rgb: {r * 0.25, g * 0.25, b * 0.25}
    Border: {radius: 6, width: 2, color: {r, g, b, 255}}
  } else if hover {
    Rgb: {44, 48, 62}
    Border: {radius: 6, width: 2, color: {r * 0.6, g * 0.6, b * 0.6, 255}}
  } else {
    Rgb: {30, 33, 44}
    Border: {radius: 6, width: 2, color: {30, 33, 44, 255}}
  }

  key {
    Text: {value: "{index + 1}", size: 15}
    Rgb: {r, g, b}
  }

  title {
    Text: {value: SONG_TITLE[index], size: 17}
    Rgb: {240, 240, 245}
  }

  gap {
    LayoutItem: {width: {mode: Grow}}
  }

  tempo {
    Text: {value: "{SONG_TEMPO[index]:.0} bpm", size: 13}
    Rgb: {150, 155, 175}
  }

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
    }
  }
}

const R = SONG_R[song]
const G = SONG_G[song]
const B = SONG_B[song]

box {
  ui {
    theme {
      UiTheme = {accent: {R, G, B}, text: {240, 240, 245}, text_muted: {170, 175, 195}, font_size: 13}
    }
  }
}

hud {
  Scene: {}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  screen {
    LayoutFill: {surface: window}
    Layout: {}
    FocusScope

    panel {
      InputBlocker
      Layout: {direction: Column, spacing: 10, padding: {14, 14, 16, 16}}
      LayoutItem: {h: Left, v: Middle, x: 16, width: {mode: Fixed, value: PANEL_W}}
      Rect: {1, 1}
      Rgb: {14, 16, 24}
      Opacity: {0.92}
      Border: {width: 1, radius: 10, color: {R * 0.6, G * 0.6, B * 0.6, 255}}

      title {
        Text: {value: "JUKEBOX", size: 24}
        Rgb: {R, G, B}
      }

      orbit_button {
        SongButton: {index: 0, action: jukebox_actions.pick_orbit}
      }

      neon_button {
        SongButton: {index: 1, action: jukebox_actions.pick_neon}
      }

      harbor_button {
        SongButton: {index: 2, action: jukebox_actions.pick_harbor}
      }

      lantern_button {
        SongButton: {index: 3, action: jukebox_actions.pick_lantern}
      }

      lane_button {
        SongButton: {index: 4, action: jukebox_actions.pick_lane}
      }

      now {
        Layout: {direction: Column, spacing: 4, padding: {6, 0, 0, 0}}
        LayoutItem: {width: {mode: Grow}}

        state {
          if playing {
            Text: {value: "NOW PLAYING", size: 12}
            Rgb: {R, G, B}
          } else {
            Text: {value: "PAUSED", size: 12}
            Rgb: {150, 155, 175}
          }
        }

        song_title {
          Text: {value: SONG_TITLE[song], size: 20}
          Rgb: {245, 245, 250}
        }

        progress {
          Layout: {}
          LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 6}}

          rail {
            LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 6}}
            Rect: {1, 1}
            Rgb: {36, 40, 52}
            Border: {radius: 3}
          }

          fill {
            LayoutItem: {h: Left, width: {mode: Fixed, value: max(6, clamp(beat / SONG_BEATS[song], 0, 1) * (PANEL_W - 32))}, height: {mode: Fixed, value: 6}}
            Rect: {1, 1}
            Rgb: {R, G, B}
            Border: {radius: 3}
          }
        }
      }

      meters {
        Layout: {direction: Row, spacing: 6, padding: {8, 0, 0, 0}, v: Bottom}
        LayoutItem: {width: {mode: Grow}}

        lanes {
          Layout: {direction: Row, spacing: 6, v: Bottom}

          for i in 0..6 {
            if i < LANE_COUNT[song] {
              "lane_{i}" {
                Layout: {direction: Column, spacing: 4, h: Center}
                LayoutItem: {width: {mode: Fixed, value: 32}}

                well {
                  Layout: {}
                  LayoutItem: {h: Center, width: {mode: Fixed, value: 16}, height: {mode: Fixed, value: METER_H}}
                  Rect: {1, 1}
                  Rgb: {30, 33, 44}
                  Border: {radius: 3}

                  level {
                    LayoutItem: {v: Bottom, width: {mode: Grow}, height: {mode: Fixed, value: max(2, levels[i] * METER_H)}}
                    Rect: {1, 1}
                    Rgb: {R, G, B}
                    Border: {radius: 3}
                  }
                }

                name {
                  Text: {value: LANE_NAME[song * 6 + i], size: 11}
                  Rgb: {170, 175, 195}
                }
              }
            }
          }
        }

        gap {
          LayoutItem: {width: {mode: Grow}}
        }

        master_left {
          Layout: {direction: Column, spacing: 4, h: Center}
          LayoutItem: {width: {mode: Fixed, value: 16}}

          well {
            Layout: {}
            LayoutItem: {h: Center, width: {mode: Fixed, value: 10}, height: {mode: Fixed, value: METER_H}}
            Rect: {1, 1}
            Rgb: {30, 33, 44}
            Border: {radius: 3}

            level {
              LayoutItem: {v: Bottom, width: {mode: Grow}, height: {mode: Fixed, value: max(2, master_l * METER_H)}}
              Rect: {1, 1}
              Rgb: {235, 235, 240}
              Border: {radius: 3}
            }
          }

          name {
            Text: {value: "L", size: 11}
            Rgb: {170, 175, 195}
          }
        }

        master_right {
          Layout: {direction: Column, spacing: 4, h: Center}
          LayoutItem: {width: {mode: Fixed, value: 16}}

          well {
            Layout: {}
            LayoutItem: {h: Center, width: {mode: Fixed, value: 10}, height: {mode: Fixed, value: METER_H}}
            Rect: {1, 1}
            Rgb: {30, 33, 44}
            Border: {radius: 3}

            level {
              LayoutItem: {v: Bottom, width: {mode: Grow}, height: {mode: Fixed, value: max(2, master_r * METER_H)}}
              Rect: {1, 1}
              Rgb: {235, 235, 240}
              Border: {radius: 3}
            }
          }

          name {
            Text: {value: "R", size: 11}
            Rgb: {170, 175, 195}
          }
        }
      }

      fx {
        Layout: {direction: Column, spacing: 8, padding: {4, 0, 0, 0}}
        LayoutItem: {width: {mode: Grow}}

        Slider low_pass(label: "Low-pass", width: PANEL_W - 32, min: 20, max: 20000, step: 0, value: low_pass_cutoff, unit: " Hz")
        Slider high_pass(label: "High-pass", width: PANEL_W - 32, min: 20, max: 20000, step: 0, value: high_pass_cutoff, unit: " Hz")
        Slider reverb(label: "Reverb", width: PANEL_W - 32, min: 0, max: 200, step: 1, value: reverb_level, unit: "%")
      }
    }
  }
}

hud_view {
  View: {camera: hud.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

async {
  while true {
    await on.change(hud.screen.panel.fx)
    low_pass_cutoff = hud.screen.panel.fx.low_pass[Slider.mut].current
    high_pass_cutoff = hud.screen.panel.fx.high_pass[Slider.mut].current
    reverb_level = hud.screen.panel.fx.reverb[Slider.mut].current
  }
}
