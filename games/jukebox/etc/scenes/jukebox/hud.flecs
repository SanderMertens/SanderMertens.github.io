using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.layout
using box.text
using box.input
using box.picking
using box.ui
using box.widgets
using box.audio

const PANEL_W: f32 = 320

template SongButton : HeadlessButton {
  prop index: i32 = 0

  const selected = song == index
  const active = selected && lit

  Layout: {direction: Row, spacing: 10, padding: {7, 7, 10, 10}, v: Middle}
  LayoutItem: {width: {mode: Grow}}
  Rect: {1, 1}

  if active {
    Rgb: {color.r * 0.25, color.g * 0.25, color.b * 0.25}
    Border: {radius: 6, width: 2, color: {color.r, color.g, color.b, 255}}
  } else if hover {
    Rgb: {44, 48, 62}
    Border: {radius: 6, width: 2, color: {80, 85, 105, 255}}
  } else {
    Rgb: {30, 33, 44}
    Border: {radius: 6, width: 2, color: selected ? {80, 85, 105, 255} : {30, 33, 44, 255}}
  }

  number {
    Text: {value: "{index + 1}", size: 15}
    Rgb: active ? color : IDLE
  }

  title {
    Text: {value: SONGS[index].title, size: 17}
    Rgb: {240, 240, 245}
  }

  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        if playing && song == index {
          playing = false
        } else {
          song = index
          playing = true
        }
      }
    }
  }
}

box {
  ui {
    theme {
      UiTheme = {accent: color, text: {240, 240, 245}, text_muted: {170, 175, 195}, font_size: 13}
    }
  }
}

hud {
  Scene: {}

  camera {
    Position: {0, 0, 100}
    Camera: {ortho: true, ortho_scale: 1}
  }

  screen {
    LayoutFill: {surface: window}
    Layout: {}
    FocusScope

    panel {
      InputBlocker
      Layout: {direction: Column, spacing: 10, padding: {14, 14, 16, 16}}
      LayoutItem: {h: Left, v: Middle, x: 16, width: {mode: Fixed, value: PANEL_W}}
      Rect: {1, 1}
      Rgb: {14, 16, 24}
      Opacity: {0.92}
      Border: {width: 1, radius: 10, color: {color.r * 0.6, color.g * 0.6, color.b * 0.6, 255}}

      title {
        Text: {value: "JUKEBOX", size: 24}
        Rgb: color
      }

      songs {
        Layout: {direction: Column, spacing: 4}
        LayoutItem: {width: {mode: Grow}}

        for i in 0..SONGS.count() {
          "song_{i}" { SongButton: {index: i} }
        }
      }

      now {
        Layout: {direction: Column, spacing: 4, padding: {6, 0, 0, 0}}
        LayoutItem: {width: {mode: Grow}}

        state {
          if lit {
            Text: {value: "NOW PLAYING", size: 12}
            Rgb: color
          } else if playing && !loaded {
            Text: {value: "LOADING", size: 12}
            Rgb: {150, 155, 175}
          } else {
            Text: {value: "PAUSED", size: 12}
            Rgb: {150, 155, 175}
          }
        }

        song_title {
          Text: {value: "{Song[Song].title}", size: 20}
          Rgb: {245, 245, 250}
        }

        progress {
          Layout: {}
          LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 6}}

          rail {
            LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 6}}
            Rect: {1, 1}
            Rgb: {36, 40, 52}
            Border: {radius: 3}
          }

          fill {
            LayoutItem: {h: Left, width: {mode: Fixed, value: max(6, clamp(beat / song_beats, 0, 1) * (PANEL_W - 32))}, height: {mode: Fixed, value: 6}}
            Rect: {1, 1}
            Rgb: color
            Border: {radius: 3}
          }
        }
      }

      fx {
        Layout: {direction: Column, spacing: 8, padding: {4, 0, 0, 0}}
        LayoutItem: {width: {mode: Grow}}

        Slider volume(label: "Volume", width: PANEL_W - 32, min: 0, max: 100, step: 1, value: volume_level, unit: "%")
        Slider reverb(label: "Reverb", width: PANEL_W - 32, min: 0, max: 200, step: 1, value: reverb_level, unit: "%")
      }
    }
  }
}

hud_view {
  View: {camera: hud.camera, lighting: {enabled: false}, culling: {enabled: false}}
}

async {
  while true {
    await on.change(hud.screen.panel.fx)
    volume_level = hud.screen.panel.fx.volume[Slider.mut].current
    reverb_level = hud.screen.panel.fx.reverb[Slider.mut].current
  }
}
