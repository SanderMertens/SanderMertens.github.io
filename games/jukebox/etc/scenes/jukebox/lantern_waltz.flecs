using box.audio

prefab lw_harp_string {
  SynthSound: {seed: 17, level_variance: 0.08}
  SynthFilter: {kind: SynthLowPass, cutoff: 4200, resonance: 0.05}
  pluck {
    SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.42}
    SynthString: {decay: 1.8, brightness: 0.45, hardness: 0.55}
  }
  board {
    SynthOscillator: {frequency: 440, level: 0.08}
    SynthEnvelope: {attack: 0.004, decay: 0.9, curve: 4.5}
  }
}

prefab lw_pizz {
  SynthSound: {seed: 23, level_variance: 0.06}
  SynthFilter: {kind: SynthLowPass, cutoff: 1400}
  pluck {
    SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.7}
    SynthString: {decay: 1.3, brightness: 0.2, hardness: 0.3}
  }
  body {
    SynthOscillator: {frequency: 440, level: 0.2}
    SynthEnvelope: {attack: 0.005, decay: 0.5, curve: 4}
  }
}

prefab lw_bowed {
  SynthSound: {seed: 5}
  SynthEnvelope: {attack: 0.7, decay: 0.6, sustain: 0.8, release: 1.1, curve: 2.5, attack_curve: 1.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 1500, resonance: 0.1, slope: SynthSlope24}
  SynthLfo: {rate: 0.2, random_phase: true, cutoff: 0.3, amplitude: 0.1}
  section {
    SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.12}
    SynthUnison: {voices: 5, detune: 16, width: 0.75}
    SynthLfo: {rate: 5, delay: 0.4, fade: 0.6, random_phase: true, pitch: 8}
  }
  warmth { SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.08} }
}

prefab lw_wood_flute {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.06, decay: 0.25, sustain: 0.6, release: 0.3, curve: 2.5, attack_curve: 1.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 2800, resonance: 0.1}
  SynthLfo: {rate: 5.2, delay: 0.2, fade: 0.3, random_phase: true, pitch: 14, amplitude: 0.08}
  tone { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.42} }
  reed { SynthOscillator: {wave: SynthTriangle, frequency: 440.9, level: 0.14} }
  breath { SynthOscillator: {wave: SynthNoise, level: 0.03}; SynthEnvelope: {attack: 0.02, decay: 0.12} }
  octave { SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.05} }
}

prefab lw_glock_bar {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.001, decay: 1.6, curve: 6}
  SynthOscillator: {frequency: 440, level: 0.25}
  ping {
    SynthOscillator: {frequency: 1540, modulation: SynthPhase, index: 2.5}
    SynthEnvelope: {attack: 0.001, decay: 0.15}
  }
}

prefab lw_frame_drum {
  SynthSound: {seed: 31, level_variance: 0.1}
  SynthEnvelope: {attack: 0.002, decay: 0.4, curve: 4}
  skin { SynthOscillator: {frequency: 115, frequency_end: 72, sweep: 0.12, level: 0.6} }
  slap {
    SynthOscillator: {wave: SynthNoise, level: 0.2}
    SynthEnvelope: {attack: 0.001, decay: 0.05}
  }
  SynthFilter: {kind: SynthLowPass, cutoff: 1600}
}

prefab lw_shaker_egg {
  SynthSound: {seed: 37, level_variance: 0.15}
  SynthEnvelope: {attack: 0.018, decay: 0.07, curve: 2}
  SynthFilter: {kind: SynthHighPass, cutoff: 5200}
  SynthOscillator: {wave: SynthNoise, level: 0.35}
}

lw_harp_inst { Instrument: {sound: lw_harp_string, gate: false} }
lw_bass_inst { Instrument: {sound: lw_pizz, gate: false} }
lw_strings_inst { Instrument: {sound: lw_bowed} }
lw_flute_inst { Instrument: {sound: lw_wood_flute} }
lw_glock_inst { Instrument: {sound: lw_glock_bar, gate: false} }
lw_drum_inst { Instrument: {sound: lw_frame_drum, gate: false} }
lw_shaker_inst { Instrument: {sound: lw_shaker_egg, gate: false} }

