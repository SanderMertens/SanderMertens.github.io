const LW: f32 = 2000

lantern_kit {
  AudioBus: {output: lantern, volume: 0.7, sends: [{bus: hall, level: 0.25}]}
  AudioMeter: {}
}

lw_drum {
  Track: {instrument: lw_drum_inst}
  AudioBus: {output: lantern_kit}
  first { ClipPlacement: {clip: lw_drum_soft, start: LW, duration: 48, loop: true} }
  second { ClipPlacement: {clip: lw_drum_full, start: LW + 48, duration: 48, loop: true} }
}

lw_shaker {
  Track: {instrument: lw_shaker_inst}
  AudioBus: {output: lantern_kit, volume: 0.5, pan: 0.2}
  second { ClipPlacement: {clip: lw_shake, start: LW + 48, duration: 48, loop: true} }
}

lw_bass {
  Track: {instrument: lw_bass_inst}
  AudioBus: {output: lantern, volume: 0.85, sends: [{bus: hall, level: 0.15}]}
  AudioMeter: {}
  first { ClipPlacement: {clip: lw_oom, start: LW} }
  second { ClipPlacement: {clip: lw_oom, start: LW + 48} }
}

lw_harp {
  Track: {instrument: lw_harp_inst}
  AudioBus: {output: lantern, volume: 0.75, sends: [{bus: hall, level: 0.3}]}
  AudioMeter: {}
  first { ClipPlacement: {clip: lw_pah_pah, start: LW} }
  second { ClipPlacement: {clip: lw_pah_pah, start: LW + 48} }
}

lw_strings {
  Track: {instrument: lw_strings_inst}
  AudioBus: {output: lantern, volume: 0.55, sends: [{bus: hall, level: 0.45}]}
  AudioMeter: {}
  second { ClipPlacement: {clip: lw_strings_chords, start: LW + 48} }
}

lw_flute {
  Track: {instrument: lw_flute_inst}
  AudioBus: {output: lantern, volume: 0.7, pan: -0.1, sends: [{bus: hall, level: 0.35}]}
  AudioMeter: {}
  first { ClipPlacement: {clip: lw_air, start: LW} }
  second { ClipPlacement: {clip: lw_air, start: LW + 48} }
}

lw_glock {
  Track: {instrument: lw_glock_inst}
  AudioBus: {output: lantern, volume: 0.5, pan: 0.3, sends: [{bus: hall, level: 0.4}, {bus: echo, level: 0.15}]}
  AudioMeter: {}
  second { ClipPlacement: {clip: lw_air, start: LW + 48, transpose: 12, gain: 0.6} }
}
