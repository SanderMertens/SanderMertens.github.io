using box.audio
using box.material
// AETHERWAKE — entirely original instrumental, 154 BPM, B minor.
// 96 bars. All melodic hooks use SIMULTANEOUS 3- or 4-note voicings.
// Harmony across 8 bars: Bm9(2) / Dmaj9/A(2) / Gmaj7#11(2) / Em9(1) / F#7sus4->F#7(1).
// Intro bars 0-8 | Groove 8-16 | Drop I 16-32 | Trance 32-40
// Breakdown 40-56 | Build 56-64 | Drop II 64-80 | Trance lift 80-88 | Outro 88-96
// Original synths and notes, no external samples or vocals.
box { audio { Song { Rgb: {95, 138, 196} } } }
assets {
  aw_master_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 27}, {kind: AudioEqPeak, frequency: 280, gain: -1.6, q: 1.1}, {kind: AudioEqHighShelf, frequency: 9000, gain: 1.0, q: 0.8}] } }
  aw_master_glue { Compressor: {threshold: -16, ratio: 2.1, attack: 0.020, release: 0.2, knee: 4, makeup: 0.0, mix: 0.65} }
  aw_mix { AudioBus: {output: master, volume: 0.88, kind: AudioChannelGroup, effects: [aw_master_eq, aw_master_glue]}; AudioMeter: {} }
  aw_reverb_hp { AudioFilter: {kind: SynthHighPass, cutoff: 240} }
  aw_echo_hp { AudioFilter: {kind: SynthHighPass, cutoff: 315} }
  aw_hall { AudioBus: {output: aw_mix, volume: 0.37, kind: AudioChannelReturn, effects: [aw_hall, aw_reverb_hp]}; Reverb: {decay: 3.3, damping: 0.55, predelay: 0.035, size: 0.86, mix: 1} }
  aw_delay { AudioBus: {output: aw_mix, volume: 0.34, kind: AudioChannelReturn, effects: [aw_delay, aw_echo_hp]}; Delay: {sync: 0.75, feedback: 0.34, mix: 1, ping_pong: true, damping: 4800} }
  aw_drums { AudioBus: {output: aw_mix, volume: 0.80, kind: AudioChannelGroup}; AudioMeter: {} }
  aw_music_lp { AudioFilter: {kind: SynthLowPass, cutoff: 14000, resonance: 0.09} }
  aw_music { AudioBus: {output: aw_mix, volume: 0.78, kind: AudioChannelGroup, effects: [aw_music_lp]}; AudioMeter: {} }
  aw_kick_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 26}, {kind: AudioEqPeak, frequency: 61, gain: 1.2, q: 1.1}, {kind: AudioEqPeak, frequency: 260, gain: -2, q: 0.85}]} }
