  AudioBus: {output: hzn_drum_bus, volume: 0.96}
  AudioMeter: {}
  hzn_kick_p00 { ClipPlacement: {clip: hzn_clip_kick, start: 64, duration: 128, loop: true} }
  hzn_kick_p01 { ClipPlacement: {clip: hzn_clip_kick, start: 272, duration: 144, loop: true} }
