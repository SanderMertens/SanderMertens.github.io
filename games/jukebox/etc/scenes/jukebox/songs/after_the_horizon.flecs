// AFTER THE HORIZON — Arrangement Remix (motif-led / two-stage EDM drops).
// Rebuild of the section hierarchy: new syncopated chord stabs, choral pads,
// independent bass responses, rim/tom percussion, sweep/crash transitions,
// dramatic 72-bar and 88-bar drops, and automated musical-bus lowpass sweeps.
// No lead instrument: all pitched foreground is chords, bass, or soundscape.
// Original project format and all synthesized (no external samples).
// 122 BPM, F# minor, 112 bars, instrumental. No external sample files.
// Arrangement: bars 0-16 intro | 16-32 groove | 32-48 hook | 48-64 breakdown
//              64-72 build | 72-84 drop A | 84-88 break / rebuild |
//              88-96 drop B | 96-104 halftime response | 104-112 outro.
// Usage in the host: audio song /path/to/after_the_horizon_arrangement_remix.flecs ; audio play
using box.audio
using box.material
const hzn_tempo = 122
const hzn_bar = 4
box { audio { Song { Rgb: {82, 161, 191} } } }

// Mixer and effect routing.
hzn_glue { Compressor: {threshold: -15.5, ratio: 2.0, attack: 0.025, release: 0.22, knee: 5, makeup: 0.5, mix: 0.76} }
hzn_master_shelf { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 26}, {kind: AudioEqPeak, frequency: 285, gain: -2.0, q: 1.1}, {kind: AudioEqHighShelf, frequency: 8200, gain: 1.3, q: 0.707}, {kind: AudioEqOff, frequency: 16000}]} }
hzn_mix {
  AudioBus: {output: master, volume: 0.84, kind: AudioChannelGroup, effects: [hzn_master_shelf, hzn_glue]}
  AudioMeter: {}
}
hzn_hall_hp { AudioFilter: {kind: SynthHighPass, cutoff: 240, resonance: 0.08, slope: SynthSlope24} }
hzn_echo_hp { AudioFilter: {kind: SynthHighPass, cutoff: 275, resonance: 0.06, slope: SynthSlope12} }
hzn_hall {
  AudioBus: {output: hzn_mix, volume: 0.66, kind: AudioChannelReturn, effects: [hzn_hall, hzn_hall_hp]}
  Reverb: {decay: 4.1, damping: 0.51, predelay: 0.045, size: 0.91, mix: 1, shimmer: 0.08, shimmer_pitch: 12}
}
hzn_echo {
  AudioBus: {output: hzn_mix, volume: 0.52, kind: AudioChannelReturn, effects: [hzn_echo, hzn_echo_hp]}
  Delay: {sync: 0.75, feedback: 0.43, mix: 1, ping_pong: true, damping: 4900}
}
hzn_drum_sculpt { TransientShaper: {attack: 0.24, sustain: -0.12} }
hzn_drum_sat { Saturator: {drive: 0.13, mode: SaturatorTanh, mix: 0.7, low_cut: 35, high_cut: 14500} }
hzn_drum_bus {
  AudioBus: {output: hzn_mix, volume: 0.76, kind: AudioChannelGroup, effects: [hzn_drum_sculpt, hzn_drum_sat]}
  AudioMeter: {}
}
hzn_bass_hp { AudioFilter: {kind: SynthHighPass, cutoff: 28, resonance: 0.06, slope: SynthSlope24} }
hzn_bass_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 27}, {kind: AudioEqPeak, frequency: 245, gain: -3.3, q: 1.1}, {kind: AudioEqHighCut, frequency: 900}, {kind: AudioEqOff, frequency: 16000}]} }
hzn_bass_lp { AudioFilter: {kind: SynthLowPass, cutoff: 640, resonance: 0.10, slope: SynthSlope24} }
// Growl occupies the mid-bass above the sub rather than muddying the kick fundamental.
hzn_growl_hp { AudioFilter: {kind: SynthHighPass, cutoff: 118, resonance: 0.10, slope: SynthSlope24} }
hzn_growl_lp { AudioFilter: {kind: SynthLowPass, cutoff: 1900, resonance: 0.29, slope: SynthSlope24} }
hzn_growl_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 112}, {kind: AudioEqPeak, frequency: 280, gain: -2.7, q: 1.15}, {kind: AudioEqPeak, frequency: 950, gain: 2.0, q: 0.85}, {kind: AudioEqHighCut, frequency: 6200}]} }
hzn_growl_sat { Saturator: {drive: 0.37, asymmetry: 0.13, mode: SaturatorTube, mix: 0.83, low_cut: 110, high_cut: 6000} }
hzn_growl_gate { PatternGate: {steps: [0.4, 1, 0.7, 0.95, 0.45, 1, 0.75, 0.35, 0.45, 1, 0.8, 0.95, 0.4, 1, 0.75, 0.55], length: 16, rate: 0.25, swing: 0.04, attack: 0.004, release: 0.065, gate: 0.84, floor: -13, mix: 0.5} }
hzn_pad_hp { AudioFilter: {kind: SynthHighPass, cutoff: 175, resonance: 0.07, slope: SynthSlope24} }
hzn_pad_gate { PatternGate: {steps: [1, 0.22, 0.7, 0.25, 0.9, 0.28, 0.78, 0.25, 1, 0.22, 0.67, 0.3, 0.9, 0.28, 0.72, 0.4], length: 16, rate: 0.25, attack: 0.009, release: 0.105, gate: 0.77, floor: -17, mix: 0} }
hzn_kick_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 27}, {kind: AudioEqPeak, frequency: 57, gain: 1.4, q: 1.2}, {kind: AudioEqPeak, frequency: 270, gain: -1.6, q: 1.1}, {kind: AudioEqHighShelf, frequency: 5500, gain: 0.8, q: 0.707}]} }
hzn_pad_lp { AudioFilter: {kind: SynthLowPass, cutoff: 2800, resonance: 0.14} }
hzn_pad_chorus { Chorus: {voices: 3, rate: 0.23, depth: 5, delay: 17, mix: 0.48, spread: 0.85} }
hzn_arp_filter { AudioFilter: {kind: SynthLowPass, cutoff: 4300, resonance: 0.36} }
hzn_arp_phaser { Phaser: {stages: 6, rate: 0.12, depth: 0.6, center: 1100, feedback: 0.15, mix: 0.37, stereo: 0.65} }
hzn_haze_filter { AudioFilter: {kind: SynthHighPass, cutoff: 310, resonance: 0.06} }
hzn_riser_filter { AudioFilter: {kind: SynthHighPass, cutoff: 180, resonance: 0.32} }
hzn_riser_wobble { AudioModulator: {target: hzn_riser_filter, component: AudioFilter, member: "cutoff",
  wave: AudioModTriangle, scale: AudioModOctaves, depth: 1, sync: 0.25} }

// Air-pad tone stays in the upper-midrange, away from kick and bass fundamentals.
hzn_air_hp { AudioFilter: {kind: SynthHighPass, cutoff: 290, resonance: 0.06, slope: SynthSlope12} }
hzn_air_lp { AudioFilter: {kind: SynthLowPass, cutoff: 3850, resonance: 0.08, slope: SynthSlope12} }
hzn_air_chorus { Chorus: {voices: 2, rate: 0.19, depth: 3.5, delay: 16, mix: 0.35, spread: 0.7} }


// Collective musical bus filter: DJ-style sweeps apply to chords, pads, and motifs
// while the kick and sub remain dry, so the drops regain real full-band punch.
hzn_music_lp { AudioFilter: {kind: SynthLowPass, cutoff: 15500, resonance: 0.16, slope: SynthSlope24} }
hzn_music_bus {
  AudioBus: {output: hzn_mix, volume: 0.95, kind: AudioChannelGroup, effects: [hzn_music_lp]}
  AudioMeter: {}
}
// An additional filter is automated separately on the new harmonic stabs.
hzn_stab_hp { AudioFilter: {kind: SynthHighPass, cutoff: 250, resonance: 0.08, slope: SynthSlope24} }
hzn_stab_lp { AudioFilter: {kind: SynthLowPass, cutoff: 3400, resonance: 0.28, slope: SynthSlope24} }
hzn_stab_chorus { Chorus: {voices: 2, rate: 0.17, depth: 2.2, delay: 12, mix: 0.26, spread: 0.6} }
hzn_choir_hp { AudioFilter: {kind: SynthHighPass, cutoff: 280, resonance: 0.05, slope: SynthSlope12} }
hzn_choir_lp { AudioFilter: {kind: SynthLowPass, cutoff: 4500, resonance: 0.14, slope: SynthSlope12} }
hzn_choir_chorus { Chorus: {voices: 3, rate: 0.14, depth: 5, delay: 23, mix: 0.50, spread: 0.95} }
hzn_rim_hp { AudioFilter: {kind: SynthHighPass, cutoff: 800, resonance: 0.06} }
hzn_tom_lp { AudioFilter: {kind: SynthLowPass, cutoff: 3900, resonance: 0.14} }
hzn_crash_hp { AudioFilter: {kind: SynthHighPass, cutoff: 2200, resonance: 0.06} }

