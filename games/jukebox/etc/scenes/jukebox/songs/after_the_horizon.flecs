// AFTER THE HORIZON — original atmospheric melodic-house composition.
// Compatible with the box.audio Flecs Song spec supplied by the user.
// 122 BPM, F# minor, 112 bars, instrumental. No external sample files.
// Arrangement: 0-16 intro | 16-32 groove | 32-48 hook | 48-64 breakdown
//              64-72 build | 72-96 main drop | 96-104 response | 104-112 outro.
// Usage in the host: audio song /path/to/after_the_horizon.flecs ; audio play
using box.audio
using box.material
const hzn_tempo = 122
const hzn_bar = 4
box { audio { Song { Rgb: {82, 161, 191} } } }

// Mixer and effect routing.
hzn_glue { Compressor: {threshold: -16, ratio: 2.2, attack: 0.018, release: 0.22, knee: 5, makeup: 1, mix: 0.8} }
hzn_master_shelf { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 26}, {kind: AudioEqPeak, frequency: 300, gain: -1.6, q: 0.9}, {kind: AudioEqHighShelf, frequency: 8200, gain: 1.3, q: 0.707}, {kind: AudioEqOff, frequency: 16000}]} }
hzn_mix {
  AudioBus: {output: master, volume: 0.84, kind: AudioChannelGroup, effects: [hzn_master_shelf, hzn_glue]}
  AudioMeter: {}
}
hzn_hall {
  AudioBus: {output: hzn_mix, volume: 0.66, kind: AudioChannelReturn, effects: [hzn_hall]}
  Reverb: {decay: 4.1, damping: 0.51, predelay: 0.045, size: 0.91, mix: 1, shimmer: 0.08, shimmer_pitch: 12}
}
hzn_echo {
  AudioBus: {output: hzn_mix, volume: 0.52, kind: AudioChannelReturn, effects: [hzn_echo]}
  Delay: {sync: 0.75, feedback: 0.43, mix: 1, ping_pong: true, damping: 4900}
}
hzn_drum_sculpt { TransientShaper: {attack: 0.24, sustain: -0.12} }
hzn_drum_sat { Saturator: {drive: 0.13, mode: SaturatorTanh, mix: 0.7, low_cut: 35, high_cut: 14500} }
hzn_drum_bus {
  AudioBus: {output: hzn_mix, volume: 0.72, kind: AudioChannelGroup, effects: [hzn_drum_sculpt, hzn_drum_sat]}
  AudioMeter: {}
}
hzn_bass_lp { AudioFilter: {kind: SynthLowPass, cutoff: 1150, resonance: 0.18, slope: SynthSlope24} }
hzn_pad_lp { AudioFilter: {kind: SynthLowPass, cutoff: 2800, resonance: 0.14} }
hzn_pad_chorus { Chorus: {voices: 3, rate: 0.23, depth: 5, delay: 17, mix: 0.48, spread: 0.85} }
hzn_arp_filter { AudioFilter: {kind: SynthLowPass, cutoff: 4300, resonance: 0.36} }
hzn_arp_phaser { Phaser: {stages: 6, rate: 0.12, depth: 0.6, center: 1100, feedback: 0.15, mix: 0.37, stereo: 0.65} }
hzn_lead_eq { Equalizer: {bands: [{kind: AudioEqLowCut, frequency: 190}, {kind: AudioEqPeak, frequency: 2000, gain: 1.8, q: 1.1}, {kind: AudioEqHighShelf, frequency: 8000, gain: 1.2}, {kind: AudioEqOff, frequency: 16000}]} }
hzn_lead_chorus { Chorus: {voices: 2, rate: 0.38, depth: 2.6, delay: 14, mix: 0.31, spread: 0.85} }
hzn_haze_filter { AudioFilter: {kind: SynthHighPass, cutoff: 310, resonance: 0.06} }
hzn_riser_filter { AudioFilter: {kind: SynthHighPass, cutoff: 180, resonance: 0.32} }
hzn_riser_wobble { AudioModulator: {target: hzn_riser_filter, component: AudioFilter, member: "cutoff",
  wave: AudioModTriangle, scale: AudioModOctaves, depth: 1, sync: 0.25} }

