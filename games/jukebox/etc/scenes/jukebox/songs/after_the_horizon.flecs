// Kick is declared first so its output can key the bass compressor.
hzn_bass_duck { Compressor: {threshold: -25, ratio: 5.2, attack: 0.004, release: 0.18, sidechain: hzn_kick_track} }
hzn_bass_track {
  Track: {instrument: hzn_bass_inst, swing: 0.01, swing_grid: TrackSwing16}
