// Song arrangement.
hzn_kick_track {
  Track: {instrument: hzn_kick_inst}
  AudioBus: {output: hzn_drum_bus, volume: 1.0, effects: [hzn_kick_eq]}
  AudioMeter: {}
  hzn_kick_p00 { ClipPlacement: {clip: hzn_clip_kick, start: 64, duration: 128, loop: true} }
  hzn_kick_p01 { ClipPlacement: {clip: hzn_clip_kick_half, start: 256, duration: 8, loop: true, gain: 0.54} }
