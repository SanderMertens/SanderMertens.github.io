      SynthEnvelope: {attack: 0.001, decay: 0.55, curve: 3.5, key_scale: 0.5}
      SynthPitchEnvelope: {amount: 5, decay: 0.12, curve: 3}
    }
    mode {
      SynthOscillator: {wave: SynthSine, frequency: 175, level: 0.22}
      SynthEnvelope: {attack: 0.001, decay: 0.18, curve: 4, key_scale: 0.5}
      SynthPitchEnvelope: {amount: 5, decay: 0.08, curve: 3}
    }
    stick {
      SynthOscillator: {wave: SynthNoise, level: 0.3}
      SynthEnvelope: {attack: 0.0005, decay: 0.012, curve: 3}
    }
  }

  prefab dk_ride_sound {
    SynthSound: {seed: 7, level_variance: 0.05}
    SynthEnvelope: {attack: 0.001, decay: 1.65, curve: 4}
    SynthFilter: {kind: SynthHighPass, cutoff: 3100}
    m1 { SynthOscillator: {wave: SynthSquare, frequency: 287, level: 0.1} }
    m2 { SynthOscillator: {wave: SynthSquare, frequency: 431, level: 0.1} }
    m3 { SynthOscillator: {wave: SynthSquare, frequency: 513, level: 0.1} }
    m4 { SynthOscillator: {wave: SynthSquare, frequency: 653, level: 0.1} }
    m5 { SynthOscillator: {wave: SynthSquare, frequency: 769, level: 0.1} }
    m6 { SynthOscillator: {wave: SynthSquare, frequency: 1021, level: 0.1} }
    ping {
      SynthOscillator: {wave: SynthSine, frequency: 3100, level: 0.23}
      SynthEnvelope: {attack: 0.001, decay: 0.35, curve: 3}
      bell { SynthOscillator: {frequency: 4371, modulation: SynthPhase, index: 2.2} }
    }
  }

  prefab dk_crash_sound {
    SynthSound: {seed: 8, level_variance: 0.04}
    SynthEnvelope: {attack: 0.002, decay: 2.05, curve: 3}
    SynthFilter: {kind: SynthHighPass, cutoff: 2200}
    m1 { SynthOscillator: {wave: SynthSquare, frequency: 245, level: 0.09} }
    m2 { SynthOscillator: {wave: SynthSquare, frequency: 367, level: 0.09} }
    m3 { SynthOscillator: {wave: SynthSquare, frequency: 459, level: 0.09} }
    m4 { SynthOscillator: {wave: SynthSquare, frequency: 611, level: 0.09} }
    m5 { SynthOscillator: {wave: SynthSquare, frequency: 692, level: 0.09} }
    wash {
      SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.6}
      SynthUnison: {voices: 3, detune: 0, width: 0.9}
    }
    splash {
      SynthOscillator: {wave: SynthNoise, level: 0.6}
      SynthEnvelope: {attack: 0.001, decay: 0.18, curve: 4}
      SynthUnison: {voices: 2, detune: 0, width: 0.7}
    }
  }

  dk_kick_inst { Instrument: {sound: dk_kick_sound, root: 36, gate: false} }
  dk_snare_inst { Instrument: {sound: dk_snare_sound, root: 38, gate: false} }
  dk_hat_inst { Instrument: {sound: dk_hat_sound, root: 42, gate: false, spread: 0.15, spread_mode: InstrumentSpreadRandom} }
  dk_open_hat_inst { Instrument: {sound: dk_open_hat_sound, root: 46, gate: false} }
  dk_clap_inst { Instrument: {sound: dk_clap_sound, root: 39, gate: false} }
  dk_tom_inst { Instrument: {sound: dk_tom_sound, root: 45, gate: false, spread: 0.7} }
  dk_ride_inst { Instrument: {sound: dk_ride_sound, root: 51, gate: false} }
  dk_crash_inst { Instrument: {sound: dk_crash_sound, root: 49, gate: false} }


  // Additional low-level acoustic-style articulations for quiet moments and ghost texture.
