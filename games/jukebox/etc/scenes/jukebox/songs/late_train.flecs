using box.audio
using box.material

// LATE TRAIN - LIVE POCKET
// 103 BPM, 4/4, 32 bars + final cymbal-tail bar.
// Sections: Intro 1-4 | Verse 5-12 | Hook 13-20 | Break 21-24 | Final Hook 25-32 | End 33.
// Every four-bar phrase is fully written out: hand-played velocity hierarchy,
// pulled snare backbeats, subtle timing changes, ghost notes and unique fills.
// All synths and editable notes live inside this single project.

box { audio { Song { Rgb: {255, 150, 60} } } }
assets {

  dk_room {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.24, effects: [dk_room]}
    Reverb: {decay: 0.72, damping: 0.65, predelay: 0.012, size: 0.30}
  }
  dk_drum_eq {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 30},
      {kind: AudioEqPeak, frequency: 360, gain: -2.3, q: 1}
    ]}
  }
  dk_drum_glue { Compressor: {threshold: -16, ratio: 2.4, attack: 0.026, release: 0.15, knee: 6, makeup: 1.12} }
  dk_drums {
    AudioBus: {output: master, volume: 0.78, effects: [dk_drum_eq, dk_drum_glue]}
    AudioMeter: {}
  }

  prefab dk_kick_sound {
    SynthSound: {seed: 1}
    SynthDrive: {drive: 0.23}
    SynthFilter: {kind: SynthLowPass, cutoff: 6200}
    body {
      SynthOscillator: {wave: SynthSine, frequency: 54, level: 0.92}
      SynthEnvelope: {attack: 0.001, decay: 0.39, curve: 3}
      SynthPitchEnvelope: {amount: 44, decay: 0.046, curve: 6}
    }
    click {
      SynthOscillator: {wave: SynthNoise, level: 0.22}
      SynthEnvelope: {attack: 0.0005, decay: 0.009, curve: 3}
    }
  }

  prefab dk_snare_sound {
    SynthSound: {seed: 2, level_variance: 0.065}
    SynthDrive: {drive: 0.19}
    SynthFilter: {kind: SynthHighPass, cutoff: 165}
    head {
      SynthOscillator: {wave: SynthSine, frequency: 183, level: 0.58}
      SynthEnvelope: {attack: 0.001, decay: 0.15, curve: 4}
      SynthPitchEnvelope: {amount: 7, decay: 0.03, curve: 4}
    }
    ring {
      SynthOscillator: {wave: SynthSine, frequency: 326, level: 0.17}
      SynthEnvelope: {attack: 0.001, decay: 0.07, curve: 4}
      SynthPitchEnvelope: {amount: 5, decay: 0.02, curve: 4}
    }
    wires {
      SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.5}
      SynthEnvelope: {attack: 0.001, decay: 0.205, curve: 5}
    }
  }

  prefab dk_hat_sound {
    SynthSound: {seed: 3, level_variance: 0.08}
    SynthEnvelope: {attack: 0.0005, decay: 0.070, curve: 5}
    SynthFilter: {kind: SynthHighPass, cutoff: 5700, resonance: 0.12, slope: SynthSlope24}
    m1 { SynthOscillator: {wave: SynthSquare, frequency: 205.3, level: 0.2} }
    m2 { SynthOscillator: {wave: SynthSquare, frequency: 304.4, level: 0.2} }
    m3 { SynthOscillator: {wave: SynthSquare, frequency: 369.6, level: 0.2} }
    m4 { SynthOscillator: {wave: SynthSquare, frequency: 522.7, level: 0.2} }
    m5 { SynthOscillator: {wave: SynthSquare, frequency: 540, level: 0.2} }
    m6 { SynthOscillator: {wave: SynthSquare, frequency: 800, level: 0.2} }
    air { SynthOscillator: {wave: SynthNoise, level: 0.29} }
  }

  prefab dk_open_hat_sound {
    SynthSound: {seed: 4, level_variance: 0.05}
    SynthEnvelope: {attack: 0.001, decay: 0.29, curve: 3}
    SynthFilter: {kind: SynthHighPass, cutoff: 5700, resonance: 0.12, slope: SynthSlope24}
    m1 { SynthOscillator: {wave: SynthSquare, frequency: 205.3, level: 0.2} }
    m2 { SynthOscillator: {wave: SynthSquare, frequency: 304.4, level: 0.2} }
    m3 { SynthOscillator: {wave: SynthSquare, frequency: 369.6, level: 0.2} }
    m4 { SynthOscillator: {wave: SynthSquare, frequency: 522.7, level: 0.2} }
    m5 { SynthOscillator: {wave: SynthSquare, frequency: 540, level: 0.2} }
    m6 { SynthOscillator: {wave: SynthSquare, frequency: 800, level: 0.2} }
    air { SynthOscillator: {wave: SynthNoise, level: 0.32} }
  }

  prefab dk_clap_sound {
    SynthSound: {seed: 5, level_variance: 0.08}
    SynthFilter: {kind: SynthBandPass, cutoff: 1200, resonance: 0.3}
    hand1 {
      SynthOscillator: {wave: SynthNoise, level: 1.3}
      SynthEnvelope: {attack: 0.0005, decay: 0.009, curve: 4}
    }
    hand2 {
      SynthOscillator: {wave: SynthNoise, level: 1.2}
      SynthEnvelope: {attack: 0.011, attack_curve: -16, decay: 0.009, curve: 4}
    }
    hand3 {
      SynthOscillator: {wave: SynthNoise, level: 1.2}
      SynthEnvelope: {attack: 0.021, attack_curve: -16, decay: 0.009, curve: 4}
    }
    tail {
      SynthOscillator: {wave: SynthNoise, level: 1.1}
      SynthEnvelope: {attack: 0.031, attack_curve: -16, decay: 0.2, curve: 4}
      SynthUnison: {voices: 2, detune: 0, width: 0.5}
    }
  }

  prefab dk_tom_sound {
    SynthSound: {seed: 6, level_variance: 0.04}
