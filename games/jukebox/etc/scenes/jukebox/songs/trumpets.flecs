using box.audio
using box.material

box { audio { Song { Rgb: {232, 172, 64} } } }
assets {

  tp_hall {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.32, effects: [tp_hall]}
    Reverb: {decay: 1.9, damping: 0.55, predelay: 0.022, size: 0.62}
  }
  tp_brass_glue { Compressor: {threshold: -15, ratio: 2.2, attack: 0.015, release: 0.18, knee: 8, makeup: 1} }
  tp_brass {
    AudioBus: {output: master, volume: 1.15, effects: [tp_brass_glue]}
    AudioMeter: {}
  }

  tp_trumpet_bell {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 100},
      {kind: AudioEqLowShelf, frequency: 450, gain: -3},
      {kind: AudioEqPeak, frequency: 1500, gain: 4.5, q: 0.7},
      {kind: AudioEqPeak, frequency: 3200, gain: 3, q: 0.9}
    ]}
  }

  tp_piccolo_bell {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 380},
      {kind: AudioEqPeak, frequency: 2600, gain: 3, q: 0.8},
      {kind: AudioEqHighShelf, frequency: 7000, gain: 1.5}
    ]}
  }

  tp_cornet_bell {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 80},
      {kind: AudioEqPeak, frequency: 1000, gain: 2, q: 0.8},
      {kind: AudioEqHighShelf, frequency: 4000, gain: -3}
    ]}
  }

  tp_flugel_bell {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 70},
      {kind: AudioEqLowShelf, frequency: 250, gain: 2},
      {kind: AudioEqHighShelf, frequency: 2500, gain: -4}
    ]}
  }

  tp_straight_mute {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 950},
      {kind: AudioEqLowCut, frequency: 750},
      {kind: AudioEqPeak, frequency: 1800, gain: 6, q: 1.6},
      {kind: AudioEqPeak, frequency: 4200, gain: 2.5, q: 1.2}
    ]}
  }

  tp_harmon_mute {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 1100, q: 0.8},
      {kind: AudioEqLowCut, frequency: 800},
      {kind: AudioEqPeak, frequency: 2000, gain: 4, q: 1.2},
      {kind: AudioEqHighShelf, frequency: 5000, gain: 3}
    ]}
  }
  tp_harmon_buzz { Saturator: {drive: 0.15, tone: 0.4, low_cut: 700, high_cut: 11000, mix: 0.7} }

  prefab tp_trumpet_sound {
    SynthSound: {seed: 11, level_variance: 0.03}
    SynthGlide: {time: 0.03, legato: true, channel: 1}
    SynthEnvelope: {attack: 0.03, attack_curve: 0.5, decay: 0.16, sustain: 0.78, release: 0.09, curve: 2}
    SynthPitchEnvelope: {amount: -0.8, decay: 0.06, curve: 2}
    SynthFilter: {kind: SynthLowPass, cutoff: 1500, resonance: 0.3, velocity: 4, keytrack: 0.35}
    SynthFilterEnvelope: {attack: 0.045, attack_curve: -1, decay: 0.3, sustain: 0.4, release: 0.15, amount: 1, velocity: 0.6}
    SynthLfo: {rate: 5.5, delay: 0.3, fade: 0.35, random_phase: true, pitch: 9, amplitude: 0.03, cutoff: 0.05}
    wander { SynthLfo: {wave: SynthLfoTriangle, rate: 0.6, random_phase: true, pitch: 2.5} }
    buzz {
      SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.08}
      bloom {
        SynthOscillator: {wave: SynthSine, frequency: 440, modulation: SynthPhase, index: 1.35, velocity: 1}
        SynthEnvelope: {attack: 0.05, attack_curve: -1, decay: 0.25, sustain: 0.85, release: 0.1, curve: 2}
      }
    }
    tongue {
      SynthOscillator: {wave: SynthNoise, level: 0.02}
      SynthEnvelope: {attack: 0.001, decay: 0.025, sustain: 0, release: 0.01, curve: 3}
      attack_force { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 2} }
    }
    breath { SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.0025} }
    breath_bloom { SynthModRoute: {source: SynthSourceMod, target: SynthTargetIndex, amount: 0.15} }
    breath_level { SynthModRoute: {source: SynthSourceMod, target: SynthTargetLevel, amount: 3} }
    breath_tone { SynthModRoute: {source: SynthSourceMod, target: SynthTargetCutoff, amount: 1.2} }
    push_level { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetLevel, amount: 1.5} }
    push_bloom { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetIndex, amount: 0.6} }
    push_tone { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetCutoff, amount: 0.8} }
  }

