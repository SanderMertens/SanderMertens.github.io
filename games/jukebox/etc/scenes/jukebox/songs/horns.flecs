using box.audio
using box.material

box { audio { Song { Rgb: {205, 150, 60} } } }
assets {

  hn_hall {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.7, effects: [hn_hall]}
    Reverb: {decay: 2.3, damping: 0.6, predelay: 0.028, size: 0.8}
  }
  hn_brass_eq {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 28},
      {kind: AudioEqPeak, frequency: 220, gain: -1.5, q: 0.9}
    ]}
  }
  hn_brass_glue { Compressor: {threshold: -10, ratio: 2, attack: 0.03, release: 0.25, knee: 8, makeup: 0} }
  hn_brass {
    AudioBus: {output: master, volume: 0.5, effects: [hn_brass_eq, hn_brass_glue]}
    AudioMeter: {}
  }

  hn_horn_tone {
    Equalizer: {bands: [
      {kind: AudioEqPeak, frequency: 400, gain: 3, q: 1},
      {kind: AudioEqHighShelf, frequency: 2000, gain: -6}
    ]}
  }
  hn_stopped_tone {
    Equalizer: {bands: [
      {kind: AudioEqLowShelf, frequency: 600, gain: -9},
      {kind: AudioEqPeak, frequency: 3000, gain: 4, q: 1.2}
    ]}
  }
  hn_trombone_tone { Equalizer: {bands: [{kind: AudioEqPeak, frequency: 550, gain: 3, q: 1.1}]} }
  hn_bass_trombone_tone { Equalizer: {bands: [{kind: AudioEqPeak, frequency: 420, gain: 3, q: 1}]} }
  hn_euphonium_tone {
    Equalizer: {bands: [
      {kind: AudioEqPeak, frequency: 380, gain: 2.5, q: 1},
      {kind: AudioEqHighShelf, frequency: 3000, gain: -3}
    ]}
  }
  hn_tuba_tone {
    Equalizer: {bands: [
      {kind: AudioEqPeak, frequency: 240, gain: 3, q: 1},
      {kind: AudioEqHighShelf, frequency: 2000, gain: -4}
    ]}
  }

  prefab hn_horn_sound {
    SynthSound: {seed: 11}
    SynthGlide: {time: 0.03, legato: true, channel: 11}
    SynthEnvelope: {attack: 0.05, decay: 0.2, sustain: 0.88, release: 0.14, curve: 2}
    SynthPitchEnvelope: {amount: -0.5, decay: 0.07, curve: 2}
    SynthFilter: {kind: SynthLowPass, cutoff: 650, resonance: 0.15, velocity: 3.7, keytrack: 0.5, drive: 0.25}
    SynthFilterEnvelope: {attack: 0.02, decay: 0.15, sustain: 0, release: 0.1, amount: 0.8, velocity: 1, curve: 2}
    hn_wander { SynthLfo: {rate: 0.23, pitch: 3, random_phase: true} }
    hn_bloom { SynthModRoute: {source: SynthSourceAmpEnvelope, target: SynthTargetCutoff, amount: 1} }
    hn_push { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 1.2} }
    hn_swell { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetLevel, amount: 3.5} }
    hn_swell_tone { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetCutoff, amount: 1.8} }
    hn_body {
      SynthOscillator: {wave: SynthSaw, frequency: 174.614, level: 0.04}
      SynthEnvelope: {attack: 0.06, decay: 0.2, sustain: 0.88, release: 0.14, curve: 2}
      hn_hard { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 5.5} }
    }
    hn_soft {
      SynthOscillator: {wave: SynthSaw, frequency: 174.614, level: 0.32}
      SynthEnvelope: {attack: 0.16, decay: 0.2, sustain: 0.88, release: 0.14, curve: 2}
      hn_gentle { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: -1} }
    }
    hn_core { SynthOscillator: {wave: SynthSine, frequency: 174.614, level: -0.1} }
    hn_air { SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.012} }
    hn_tongue {
      SynthOscillator: {wave: SynthNoise, level: 0.1}
      SynthEnvelope: {attack: 0.001, decay: 0.025, curve: 4}
      hn_tongue_hard { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 1.5} }
    }
  }

