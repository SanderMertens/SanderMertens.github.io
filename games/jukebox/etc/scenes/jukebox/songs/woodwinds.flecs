using box.audio
using box.material

box { audio { Song { Rgb: {176, 196, 112} } } }
assets {

  ww_hall {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.32, effects: [ww_hall]}
    Reverb: {decay: 1.9, damping: 0.55, predelay: 0.024, size: 0.8}
  }
  ww_winds_eq {
    Equalizer: {bands: [
      {kind: AudioEqLowCut, frequency: 35},
      {kind: AudioEqPeak, frequency: 3200, gain: -1, q: 0.8}
    ]}
  }
  ww_winds_glue { Compressor: {threshold: -14, ratio: 1.8, attack: 0.03, release: 0.3, knee: 8, makeup: 0.5} }
  ww_winds {
    AudioBus: {output: master, volume: 0.7, effects: [ww_winds_eq, ww_winds_glue]}
    AudioMeter: {}
  }

  prefab ww_flute_sound {
    SynthSound: {seed: 11, drift: 3}
    SynthGlide: {time: 0.018, legato: true, channel: 11}
    SynthEnvelope: {attack: 0.07, decay: 0.12, sustain: 0.85, release: 0.09, curve: 2}
    SynthFilter: {kind: SynthLowPass, cutoff: 7000, keytrack: 0.3, velocity: 1}
    SynthLfo: {rate: 5, delay: 0.22, fade: 0.4, pitch: 10, amplitude: 0.18, random_phase: true}
    ww_swell { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetLevel, amount: 0.7} }
    ww_tone {
      SynthOscillator: {wave: SynthSine, frequency: 523.25, level: 0.5}
      ww_turbulence { SynthOscillator: {wave: SynthNoise, color: SynthNoiseBrown, modulation: SynthRing, index: 0.2} }
    }
    ww_h2 {
      SynthOscillator: {wave: SynthSine, frequency: 1046.5, level: 0.11}
      ww_register { SynthModRoute: {source: SynthSourceKey, target: SynthTargetLevel, amount: -1.1} }
      ww_vib { SynthModRoute: {source: SynthSourceLfo1, target: SynthTargetLevel, amount: 0.8} }
      ww_force { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 2} }
      ww_press { SynthModRoute: {source: SynthSourcePressure, target: SynthTargetLevel, amount: 1.5} }
    }
    ww_h3 {
      SynthOscillator: {wave: SynthSine, frequency: 1569.75, level: 0.086}
      ww_register { SynthModRoute: {source: SynthSourceKey, target: SynthTargetLevel, amount: -0.77} }
    }
    ww_chiff {
      SynthOscillator: {wave: SynthSine, frequency: 1046.5, level: 0.15}
      SynthEnvelope: {attack: 0.004, decay: 0.05, curve: 3}
    }
    ww_tongue {
      SynthOscillator: {wave: SynthNoise, level: 0.2}
      SynthEnvelope: {attack: 0.002, decay: 0.035, curve: 3}
    }
    ww_edge {
      SynthOscillator: {wave: SynthSaw, frequency: 523.25, level: 0.02}
      ww_register { SynthModRoute: {source: SynthSourceKey, target: SynthTargetLevel, amount: -2} }
      ww_force { SynthModRoute: {source: SynthSourceVelocity, target: SynthTargetLevel, amount: 3} }
    }
    ww_breath {
      SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.045}
      SynthEnvelope: {attack: 0.02, sustain: 1, release: 0.07}
    }
  }

