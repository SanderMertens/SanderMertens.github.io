using box.audio
using box.material

box { audio { Song { Rgb: {130, 160, 255} } } }

assets {
  orbit_space {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: state.reverb_level / 100, effects: [orbit_space]}
    Reverb: {decay: 7, damping: 0.5, predelay: 0.06, size: 1}
  }

  orbit {
    AudioBus: {output: master, volume: 0.8}
    AudioMeter: {}
  }

  prefab orbit_cloud {
    SynthSound: {seed: 59}
    SynthEnvelope: {attack: 3, decay: 2, sustain: 0.75, release: 4}
    SynthFilter: {kind: SynthLowPass, cutoff: 1200, resonance: 0.08}
    SynthLfo: {rate: 0.07, random_phase: true, cutoff: 0.35, amplitude: 0.12}
    body {
      SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.22}
      SynthUnison: {voices: 3, detune: 9, width: 0.85}
    }
    air { SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.035} }
  }

  prefab orbit_floor {
    SynthSound: {}
    SynthEnvelope: {attack: 2, decay: 1, sustain: 0.8, release: 4}
    SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.32}
  }

  prefab orbit_signal {
    SynthSound: {seed: 61, level_variance: 0.04}
    SynthEnvelope: {attack: 1.8, decay: 10, curve: 0.6}
    SynthFilter: {kind: SynthLowPass, cutoff: 6500}
    body {
      SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.26}
      SynthUnison: {voices: 2, detune: 4, width: 0.65}
      overtone {
        SynthOscillator: {frequency: 1232, modulation: SynthPhase, index: 1.4}
        SynthEnvelope: {attack: 2.2, decay: 3.5, curve: 2}
      }
    }
    halo {
      SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.065}
      SynthEnvelope: {attack: 2.6, decay: 11, curve: 0.8}
      SynthUnison: {voices: 2, detune: 7, width: 1}
      SynthLfo: {rate: 0.16, random_phase: true, amplitude: 0.15}
    }
    glass {
      SynthOscillator: {wave: SynthSine, frequency: 1848, level: 0.035}
      SynthEnvelope: {attack: 2, decay: 2.8, curve: 2}
    }
  }

  prefab orbit_voice {
    SynthSound: {seed: 67, level_variance: 0.025}
    SynthEnvelope: {attack: 0.8, decay: 1.2, sustain: 0.7, release: 2.5}
    SynthFilter: {kind: SynthLowPass, cutoff: 2100, resonance: 0.12}
    SynthFilterEnvelope: {attack: 1.5, decay: 2, sustain: 0.25, release: 2, amount: 0.6}
    SynthLfo: {rate: 4.1, delay: 0.7, fade: 1.5, pitch: 5}
    reed {
      SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.24}
      SynthUnison: {voices: 3, detune: 6, width: 0.45}
    }
    breath {
      SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.045}
      SynthLfo: {rate: 0.13, random_phase: true, amplitude: 0.18}
    }
    warmth { SynthOscillator: {wave: SynthSine, frequency: 220, level: 0.05} }
  }

  orbit_voice_inst { Instrument: {sound: orbit_voice} }

  orbit_pad_inst { Instrument: {sound: orbit_cloud} }
  orbit_bass_inst { Instrument: {sound: orbit_floor} }
  orbit_bells_inst { Instrument: {sound: orbit_signal, gate: false} }

  prefab orbit_pad_notes {
    NoteClip: {length: 128, notes: [
      {start: 0, duration: 15, pitch: 52, velocity: 0.55, pan: -0.55},
      {start: 0, duration: 15, pitch: 59, velocity: 0.55, pan: -0.18},
      {start: 0, duration: 15, pitch: 62, velocity: 0.55, pan: 0.18},
      {start: 0, duration: 15, pitch: 66, velocity: 0.55, pan: 0.55},
      {start: 16, duration: 15, pitch: 48, velocity: 0.55, pan: -0.55},
      {start: 16, duration: 15, pitch: 55, velocity: 0.55, pan: -0.18},
      {start: 16, duration: 15, pitch: 59, velocity: 0.55, pan: 0.18},
      {start: 16, duration: 15, pitch: 62, velocity: 0.55, pan: 0.55},
      {start: 32, duration: 15, pitch: 55, velocity: 0.55, pan: -0.55},
      {start: 32, duration: 15, pitch: 57, velocity: 0.55, pan: -0.18},
      {start: 32, duration: 15, pitch: 62, velocity: 0.55, pan: 0.18},
      {start: 32, duration: 15, pitch: 66, velocity: 0.55, pan: 0.55},
      {start: 48, duration: 15, pitch: 50, velocity: 0.55, pan: -0.55},
      {start: 48, duration: 15, pitch: 57, velocity: 0.55, pan: -0.18},
      {start: 48, duration: 15, pitch: 59, velocity: 0.55, pan: 0.18},
      {start: 48, duration: 15, pitch: 64, velocity: 0.55, pan: 0.55},
      {start: 64, duration: 15, pitch: 52, velocity: 0.55, pan: -0.55},
      {start: 64, duration: 15, pitch: 55, velocity: 0.55, pan: -0.18},
      {start: 64, duration: 15, pitch: 59, velocity: 0.55, pan: 0.18},
      {start: 64, duration: 15, pitch: 66, velocity: 0.55, pan: 0.55},
      {start: 80, duration: 15, pitch: 48, velocity: 0.55, pan: -0.55},
      {start: 80, duration: 15, pitch: 55, velocity: 0.55, pan: -0.18},
      {start: 80, duration: 15, pitch: 62, velocity: 0.55, pan: 0.18},
      {start: 80, duration: 15, pitch: 64, velocity: 0.55, pan: 0.55},
      {start: 96, duration: 15, pitch: 45, velocity: 0.55, pan: -0.55},
      {start: 96, duration: 15, pitch: 52, velocity: 0.55, pan: -0.18},
      {start: 96, duration: 15, pitch: 59, velocity: 0.55, pan: 0.18},
      {start: 96, duration: 15, pitch: 62, velocity: 0.55, pan: 0.55},
      {start: 112, duration: 15, pitch: 50, velocity: 0.55, pan: -0.55},
      {start: 112, duration: 15, pitch: 57, velocity: 0.55, pan: -0.18},
      {start: 112, duration: 15, pitch: 62, velocity: 0.55, pan: 0.18},
      {start: 112, duration: 15, pitch: 64, velocity: 0.55, pan: 0.55}
    ]}
  }

  orbit_pad {
    Track: {instrument: orbit_pad_inst}
    AudioBus: {output: orbit, volume: 0.7, sends: [{bus: orbit_space, level: 0.65}]}
    AudioMeter: {}
    phrase { ClipPlacement: {clip: orbit_pad_notes, start: 0} }
  }

  prefab orbit_bass_notes {
    NoteClip: {length: 128, notes: [
      {start: 0, duration: 15, pitch: 40, velocity: 0.65},
      {start: 16, duration: 15, pitch: 36, velocity: 0.65},
      {start: 32, duration: 15, pitch: 43, velocity: 0.65},
      {start: 48, duration: 15, pitch: 38, velocity: 0.65},
      {start: 64, duration: 15, pitch: 40, velocity: 0.65},
      {start: 80, duration: 15, pitch: 36, velocity: 0.65},
      {start: 96, duration: 15, pitch: 33, velocity: 0.65},
      {start: 112, duration: 15, pitch: 38, velocity: 0.65}
    ]}
  }

  orbit_bass {
    Track: {instrument: orbit_bass_inst}
    AudioBus: {output: orbit, volume: 0.7, sends: [{bus: orbit_space, level: 0.15}]}
    AudioMeter: {}
    phrase { ClipPlacement: {clip: orbit_bass_notes, start: 0} }
  }

  prefab orbit_bells_notes {
    NoteClip: {length: 128, notes: [
      {start: 5, duration: 2, pitch: 78, velocity: 0.42, pan: -0.4},
      {start: 11.5, duration: 2, pitch: 74, velocity: 0.3, pan: 0.4},
      {start: 21, duration: 2, pitch: 74, velocity: 0.42, pan: 0.4},
      {start: 27.5, duration: 2, pitch: 71, velocity: 0.3, pan: -0.4},
      {start: 37, duration: 2, pitch: 78, velocity: 0.42, pan: -0.4},
      {start: 43.5, duration: 2, pitch: 74, velocity: 0.3, pan: 0.4},
      {start: 53, duration: 2, pitch: 76, velocity: 0.42, pan: 0.4},
      {start: 59.5, duration: 2, pitch: 71, velocity: 0.3, pan: -0.4},
      {start: 69, duration: 2, pitch: 78, velocity: 0.42, pan: -0.4},
      {start: 75.5, duration: 2, pitch: 71, velocity: 0.3, pan: 0.4},
      {start: 85, duration: 2, pitch: 76, velocity: 0.42, pan: 0.4},
      {start: 91.5, duration: 2, pitch: 74, velocity: 0.3, pan: -0.4},
      {start: 101, duration: 2, pitch: 74, velocity: 0.42, pan: -0.4},
      {start: 107.5, duration: 2, pitch: 71, velocity: 0.3, pan: 0.4},
      {start: 117, duration: 2, pitch: 76, velocity: 0.42, pan: 0.4},
      {start: 123.5, duration: 2, pitch: 74, velocity: 0.3, pan: -0.4}
    ]}
  }

  orbit_bells {
    Track: {instrument: orbit_bells_inst}
    AudioBus: {output: orbit, volume: 0.4, sends: [{bus: orbit_space, level: 0.45}]}
    AudioMeter: {}
    phrase { ClipPlacement: {clip: orbit_bells_notes, start: 0} }
  }

  prefab orbit_voice_notes {
    NoteClip: {length: 128, notes: [
      {start: 0, duration: 6, pitch: 64, velocity: 0.52, pan: -0.12},
      {start: 8, duration: 3, pitch: 66, velocity: 0.46, pan: -0.12},
      {start: 12, duration: 3, pitch: 62, velocity: 0.42, pan: -0.12},
      {start: 17, duration: 5, pitch: 64, velocity: 0.52, pan: -0.12},
      {start: 24, duration: 4, pitch: 59, velocity: 0.46, pan: -0.12},
      {start: 29, duration: 2, pitch: 62, velocity: 0.42, pan: -0.12},
      {start: 32, duration: 5, pitch: 62, velocity: 0.52, pan: -0.12},
      {start: 39, duration: 4, pitch: 66, velocity: 0.46, pan: -0.12},
      {start: 44, duration: 3, pitch: 69, velocity: 0.42, pan: -0.12},
      {start: 49, duration: 6, pitch: 64, velocity: 0.52, pan: -0.12},
      {start: 57, duration: 3, pitch: 62, velocity: 0.46, pan: -0.12},
      {start: 61, duration: 2, pitch: 59, velocity: 0.42, pan: -0.12},
      {start: 64, duration: 5, pitch: 67, velocity: 0.52, pan: -0.12},
      {start: 71, duration: 4, pitch: 66, velocity: 0.46, pan: -0.12},
      {start: 76, duration: 3, pitch: 64, velocity: 0.42, pan: -0.12},
      {start: 81, duration: 5, pitch: 64, velocity: 0.52, pan: -0.12},
      {start: 88, duration: 4, pitch: 67, velocity: 0.46, pan: -0.12},
      {start: 93, duration: 2, pitch: 62, velocity: 0.42, pan: -0.12},
      {start: 96, duration: 6, pitch: 64, velocity: 0.52, pan: -0.12},
      {start: 104, duration: 3, pitch: 62, velocity: 0.46, pan: -0.12},
      {start: 108, duration: 3, pitch: 59, velocity: 0.42, pan: -0.12},
      {start: 113, duration: 5, pitch: 62, velocity: 0.52, pan: -0.12},
      {start: 120, duration: 3, pitch: 64, velocity: 0.46, pan: -0.12},
      {start: 124, duration: 3, pitch: 66, velocity: 0.42, pan: -0.12}
    ]}
  }

  orbit_melody {
    Track: {instrument: orbit_voice_inst}
    AudioBus: {output: orbit, volume: 0.9, sends: [{bus: orbit_space, level: 0.4}]}
    AudioMeter: {}
    phrase { ClipPlacement: {clip: orbit_voice_notes, start: 0} }
  }

  $ {
    Song: {
      title: "Distant Orbit", tempo: 60, beats_per_bar: 4, beat_unit: 4, beats: 128,
      lanes: [
        {name: "Pad", bus: orbit_pad},
        {name: "Bass", bus: orbit_bass},
        {name: "Bells", bus: orbit_bells},
        {name: "Voice", bus: orbit_melody}
      ]
    }
  }
}
