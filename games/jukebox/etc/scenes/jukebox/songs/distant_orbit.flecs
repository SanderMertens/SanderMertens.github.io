orbit_pad_filter {
  AudioFilter: {cutoff: 1000, resonance: 0.1}
}

orbit_pad_chorus {
  Chorus: {voices: 3, rate: 0.12, depth: 4, delay: 18, spread: 1, mix: 0.3}
}

orbit_pad {
  Track: {instrument: orbit_pad_inst}
  AudioBus: {output: orbit, volume: 1.6, effects: [orbit_pad_filter, orbit_pad_chorus], sends: [{bus: orbit_space, level: 0.55}]}
  AudioMeter: {}
  phrase { ClipPlacement: {clip: orbit_pad_notes, start: 0} }
}

orbit_bass {
  Track: {instrument: orbit_bass_inst}
  AudioBus: {output: orbit, volume: 0.4, sends: [{bus: orbit_space, level: 0.12}]}
  AudioMeter: {}
  phrase { ClipPlacement: {clip: orbit_bass_notes, start: 0} }
}

orbit_bells_octave {
  PitchShifter: {semitones: 12, window: 60, mix: 0.18}
}

orbit_bells_echo {
  Delay: {sync: 1.5, feedback: 0.4, mix: 0.25, damping: 3500, ping_pong: true}
}

orbit_bells {
  Track: {instrument: orbit_bells_inst, humanize: {timing: 20, velocity: 0.1}}
  AudioBus: {output: orbit, volume: 2.3, effects: [orbit_bells_octave, orbit_bells_echo], sends: [{bus: orbit_space, level: 0.45}]}
  AudioMeter: {}
  phrase { ClipPlacement: {clip: orbit_bells_notes, start: 0} }
}

orbit_melody {
  Track: {instrument: orbit_voice_inst, humanize: {timing: 15}}
  AudioBus: {output: orbit, volume: 0.8, sends: [{bus: orbit_space, level: 0.4}, {bus: echo, level: 0.08}]}
  AudioMeter: {}
  phrase { ClipPlacement: {clip: orbit_voice_notes, start: 0} }
}

orbit_star_echo {
  Delay: {sync: 0.75, feedback: 0.45, mix: 0.35, damping: 5000, ping_pong: true}
}

orbit_star_haze {
  Reverb: {decay: 4, damping: 0.65, predelay: 0.03, size: 0.8, mix: 1}
}

orbit_stars {
  Track: {instrument: orbit_star_inst, humanize: {timing: 25, velocity: 0.2}}
  AudioBus: {output: orbit, volume: 0, effects: [orbit_star_echo, orbit_star_haze], sends: [{bus: orbit_space, level: 0.6}]}
  AudioMeter: {}
  sky { ClipPlacement: {clip: orbit_star_notes, start: 32, duration: 88, loop: true} }
}

orbit_bloom {
  AudioMacro: {}
  open { AudioMacroMap: {target: orbit_pad_filter, component: AudioFilter, member: "cutoff", min: 900, max: 5500, scale: AudioModOctaves} }
  rise { AudioMacroMap: {target: orbit_space, component: Reverb, member: "shimmer", min: 0.12, max: 0.42} }
  sky { AudioMacroMap: {target: orbit_stars, component: AudioBus, member: "volume", min: 0, max: 1.6, curve: 0.3} }
  ring { AudioMacroMap: {target: orbit_bells_octave, component: PitchShifter, member: "mix", min: 0.1, max: 0.32} }
}

orbit_wander {
  AudioModulator: {target: orbit_pad, component: AudioBus, member: "pan", depth: 0.3, sync: 32}
}

orbit_breathe {
  AudioModulator: {target: orbit_bloom, component: AudioMacro, member: "value", depth: 0.06, sync: 8}
}

prefab orbit_arc {
  AutomationClip: {target: orbit_bloom, component: AudioMacro, member: "value", length: 128,
    curve: {kind: CurveCatmullRom, keys: [{0, 0.05}, {24, 0.2}, {48, 0.5}, {72, 0.75}, {96, 1}, {110, 0.85}, {122, 0.3}, {128, 0.05}]}}
}

orbit_lanes {
  Track: {}
  arc { ClipPlacement: {clip: orbit_arc, start: 0} }
}

$ {
  Song: {
    title: "Distant Orbit", tempo: 60, beats_per_bar: 4, beat_unit: 4, beats: 128,
    lanes: [
      {name: "Pad", bus: orbit_pad},
      {name: "Bass", bus: orbit_bass},
      {name: "Bells", bus: orbit_bells},
      {name: "Voice", bus: orbit_melody},
      {name: "Stars", bus: orbit_stars}
    ]
  }
}
