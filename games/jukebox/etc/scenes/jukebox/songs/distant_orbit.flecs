using box.audio
using box.material

box { audio { Song { Rgb: {130, 160, 255} } } }

orbit_space {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: reverb_level / 100, effects: [orbit_space]}
  Reverb: {decay: 7, damping: 0.45, predelay: 0.06, size: 1, shimmer: 0.15}
}

orbit_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 30},
    {kind: AudioEqPeak, frequency: 280, gain: -2, q: 0.7},
    {kind: AudioEqHighShelf, frequency: 6000, gain: 3}
  ]}
}

orbit_glue {
  Compressor: {threshold: -20, ratio: 1.8, attack: 0.05, release: 0.4, knee: 10, makeup: 1}
}

orbit {
  AudioBus: {output: master, volume: 1.3, effects: [orbit_tone, orbit_glue]}
  AudioMeter: {}
}

prefab orbit_harmonics {
  Wavetable: {kind: WavetableHarmonics}
}

prefab orbit_cloud {
  SynthSound: {seed: 59, drift: 8, free_phase: true}
  SynthEnvelope: {attack: 3, decay: 2, sustain: 0.75, release: 4, attack_curve: 1}
  SynthFilter: {kind: SynthLowPass, cutoff: 2600, resonance: 0.08, keytrack: 0.3}
  SynthLfo: {rate: 0.05, random_phase: true, position: 5, amplitude: 0.1}
  body {
    SynthOscillator: {wave: SynthWavetable, frequency: 440, level: 0.2}
    SynthTable: {table: orbit_harmonics, position: 2, envelope: 6}
    SynthUnison: {voices: 3, detune: 9, width: 0.9}
  }
  air {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.03}
    SynthUnison: {voices: 2, detune: 12, width: 1}
  }
}

prefab orbit_floor {
  SynthSound: {seed: 60, drift: 3}
  SynthEnvelope: {attack: 2, decay: 1, sustain: 0.8, release: 4}
  SynthDrive: {drive: 0.25}
  SynthFilter: {kind: SynthLowPass, cutoff: 700, keytrack: 0.5}
  core { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.32} }
  grain { SynthOscillator: {wave: SynthTriangle, frequency: 880, level: 0.04} }
}

prefab orbit_signal {
  SynthSound: {seed: 61, level_variance: 0.04}
  SynthEnvelope: {attack: 1.8, decay: 10, curve: 0.6}
  SynthFilter: {kind: SynthLowPass, cutoff: 7500, velocity: 1}
  body {
    SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.26}
    SynthUnison: {voices: 2, detune: 4, width: 0.65}
    overtone {
      SynthOscillator: {frequency: 1232, modulation: SynthPhase, index: 1.6, velocity: 0.6}
      SynthEnvelope: {attack: 2.2, decay: 3.5, curve: 2}
    }
  }
  halo {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.065}
    SynthEnvelope: {attack: 2.6, decay: 11, curve: 0.8}
    SynthUnison: {voices: 2, detune: 7, width: 1}
    SynthLfo: {rate: 0.16, random_phase: true, amplitude: 0.15}
  }
  glass {
    SynthOscillator: {wave: SynthSine, frequency: 1848, level: 0.04}
    SynthEnvelope: {attack: 2, decay: 2.8, curve: 2}
  }
}

prefab orbit_voice {
  SynthSound: {seed: 67, level_variance: 0.025, drift: 5}
  SynthEnvelope: {attack: 0.5, decay: 1.5, sustain: 0.75, release: 2.5, attack_curve: 1}
  SynthFilter: {kind: SynthComb, tune: 2, feedback: -0.7, cutoff: 3500, keytrack: 0.5, velocity: 0.6}
  SynthFilterEnvelope: {attack: 0.08, decay: 1.2, sustain: 0.2, release: 2, amount: 0.8, curve: 2}
  vibrato { SynthLfo: {rate: 4.6, delay: 0.7, fade: 1.5, pitch: 9} }
  sway { SynthLfo: {rate: 0.15, random_phase: true, cutoff: 0.35} }
  pipe {
    SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.45}
    SynthUnison: {voices: 2, detune: 5, width: 0.3}
    reed {
      SynthOscillator: {frequency: 1320, modulation: SynthPhase, index: 0.8, velocity: 0.5}
      SynthEnvelope: {attack: 2.2, decay: 2, sustain: 0.5, release: 6, attack_curve: 1}
    }
  }
}

prefab orbit_star {
  SynthSound: {seed: 71, level_variance: 0.25, drift: 4}
  SynthFilter: {kind: SynthLowPass, cutoff: 9000, velocity: 1.5}
  pluck {
    SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.35}
    SynthString: {decay: 1.6, brightness: 0.8, hardness: 0.85, velocity: 0.5}
  }
  glint {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.06}
    SynthEnvelope: {attack: 0.1, decay: 0.9, curve: 4}
  }
}

orbit_pad_inst { Instrument: {sound: orbit_cloud, spread: 0.7} }
orbit_bass_inst { Instrument: {sound: orbit_floor} }
orbit_bells_inst { Instrument: {sound: orbit_signal, gate: false, spread: 0.5, spread_mode: InstrumentSpreadAlternate} }
orbit_voice_inst { Instrument: {sound: orbit_voice} }
orbit_star_inst { Instrument: {sound: orbit_star, gate: false, velocity_curve: 1.5, spread: 0.85, spread_mode: InstrumentSpreadRandom} }

