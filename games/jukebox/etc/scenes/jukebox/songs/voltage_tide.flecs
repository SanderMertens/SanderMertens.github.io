vt_rise_inst { Instrument: {sound: vt_rise_sound, gate: false} }

vt_pad_filter { AudioFilter: {cutoff: 1420, resonance: 0.075} }
vt_pad_chorus { Chorus: {voices: 3, rate: 0.17, depth: 5, delay: 18, spread: 1, mix: 0.28} }
// High-pass removes competing low mids; presence boost gets the hook in front of pads.
vt_lead_eq {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 155},
    {kind: AudioEqPeak, frequency: 360, gain: -1.7, q: 0.93},
    {kind: AudioEqPeak, frequency: 2600, gain: 2.0, q: 0.83},
    {kind: AudioEqHighShelf, frequency: 6700, gain: 1.05}
  ]}
}
vt_lead_motion { Chorus: {voices: 3, rate: 0.18, depth: 3.3, delay: 14, spread: 0.84, mix: 0.19} }
vt_lead_delay { Delay: {sync: 0.75, feedback: 0.24, mix: 0.17, damping: 5250, ping_pong: true} }
vt_lead_glue { Compressor: {threshold: -18, ratio: 1.7, attack: 0.023, release: 0.19, knee: 6, makeup: 0.4} }
vt_lead_color { AudioFilter: {cutoff: 5900, resonance: 0.035} }
vt_arp_delay { Delay: {sync: 0.75, feedback: 0.24, mix: 0.12, damping: 5800, ping_pong: true} }
vt_bell_delay { Delay: {sync: 1.5, feedback: 0.35, mix: 0.21, damping: 5400, ping_pong: true} }

