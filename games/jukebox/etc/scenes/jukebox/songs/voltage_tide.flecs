// Luminous lead: mono-centered triangle + harmonically rich, gently detuned wavetable,
// an articulate string/pluck onset, a soft octave sheen, and a slow-opening stereo body.
// The notes remain identical to Clear Signal; only the timbre/envelope changes.
prefab vt_lead_sound {
  SynthSound: {seed: 506, drift: 3.1, level_variance: 0.014}
  SynthEnvelope: {attack: 0.006, decay: 0.86, sustain: 0.64, release: 0.68}
  SynthDrive: {drive: 0.16}
  SynthFilter: {kind: SynthLowPass, cutoff: 7400, resonance: 0.10, keytrack: 0.36, velocity: 0.48}
  focus {
    SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.19}
  }
  color {
    SynthOscillator: {wave: SynthWavetable, frequency: 440, level: 0.25}
    SynthTable: {table: vt_harmonic_table, position: 4, envelope: 4}
    SynthUnison: {voices: 3, detune: 5, width: 0.58}
  }
  pick {
    SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.26}
    SynthString: {decay: 1.7, brightness: 0.76, hardness: 0.63, velocity: 0.67}
  }
  sheen {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.065}
    SynthEnvelope: {attack: 0.002, decay: 0.26, curve: 2.8}
  }
  bloom {
    SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.082}
    SynthEnvelope: {attack: 0.065, decay: 1.1, sustain: 0.50, release: 0.92}
    SynthUnison: {voices: 2, detune: 7, width: 0.73}
  }
}

