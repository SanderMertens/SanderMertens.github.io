using box.audio
using box.material

// VOLTAGE TIDE
// Original instrumental | 110 BPM | D minor / Bb / F / C, final F major | 100 bars (400 beats; 3:38)
// Intent: keep the luminous melodic hook; use drum-kit-inspired synthesis, humanized groove, layered intro and full-band buildups.
// Chapters: Introduction / Pulse / Hook / Reflection / Tension / Drop / Breakdown / Rebuild / Final Hook / Resolution.
box { audio { Song { Rgb: {88, 203, 245} } } }
vt_hall {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.24, effects: [vt_hall]}
  Reverb: {decay: 4.4, damping: 0.46, predelay: 0.06, size: 0.95, shimmer: 0.16}
}
vt_room {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.14, effects: [vt_room]}
  Reverb: {decay: 1.15, damping: 0.68, predelay: 0.013, size: 0.44, shimmer: 0.01}
}
vt_music_eq {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 28},
    {kind: AudioEqPeak, frequency: 280, gain: -1.7, q: 0.85},
    {kind: AudioEqHighShelf, frequency: 7200, gain: 1.2}
  ]}
}
vt_music_glue { Compressor: {threshold: -16, ratio: 2.0, attack: 0.036, release: 0.24, knee: 7, makeup: 0.9} }
vt_mix {
  AudioBus: {output: master, volume: 0.88, effects: [vt_music_eq, vt_music_glue]}
  AudioMeter: {}
}
vt_drum_eq {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 26},
    {kind: AudioEqPeak, frequency: 380, gain: -1.6, q: 1.15},
    {kind: AudioEqPeak, frequency: 2150, gain: 1.8, q: 0.92},
    {kind: AudioEqHighShelf, frequency: 6800, gain: 1.35}
  ]}
}
vt_drum_glue { Compressor: {threshold: -14, ratio: 2.9, attack: 0.019, release: 0.12, knee: 6, makeup: 0.95} }
vt_drum_bus {
  AudioBus: {output: vt_mix, volume: 0.86, effects: [vt_drum_eq, vt_drum_glue]}
  AudioMeter: {}
}

prefab vt_harmonic_table { Wavetable: {kind: WavetableHarmonics} }

prefab vt_pad_sound {
