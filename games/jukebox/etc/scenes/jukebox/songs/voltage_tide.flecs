// Two-stage spectral and spatial growth. Tight dry percussion stays outside this macro.
vt_energy {
  AudioMacro: {}
  bright { AudioMacroMap: {target: vt_pad_filter, component: AudioFilter, member: "cutoff", min: 810, max: 7900, scale: AudioModOctaves} }
  lead_brightness { AudioMacroMap: {target: vt_lead_color, component: AudioFilter, member: "cutoff", min: 2900, max: 8900, scale: AudioModOctaves} }
  width { AudioMacroMap: {target: vt_hall, component: Reverb, member: "shimmer", min: 0.08, max: 0.30} }
  bloom { AudioMacroMap: {target: vt_track_brass, component: AudioBus, member: "volume", min: 0.27, max: 0.70} }
}
vt_orbit {
  AudioModulator: {target: vt_track_horizon_pad, component: AudioBus, member: "pan", depth: 0.17, sync: 32}
}

prefab vt_energy_path {
  AutomationClip: {target: vt_energy, component: AudioMacro, member: "value", length: 400,
    curve: {kind: CurveCatmullRom, keys: [
      {0, 0.07}, {28, 0.24}, {32, 0.35}, {56, 0.52}, {64, 0.80},
      {120, 0.88}, {128, 0.11}, {150, 0.09}, {160, 0.24},
      {184, 0.46}, {192, 0.53}, {208, 0.73}, {216, 0.88}, {222, 1},
      {223, 0.10}, {224, 1}, {256, 0.99}, {284, 0.95},
      {288, 0.16}, {312, 0.24}, {320, 0.52}, {336, 0.78},
      {348, 0.96}, {350, 1}, {351, 0.08}, {352, 1}, {376, 1},
      {384, 0.54}, {394, 0.35}, {400, 0.09}
    ]}}
}
vt_automation {
  Track: {}
  arc { ClipPlacement: {clip: vt_energy_path, start: 0} }
}


// Host song metadata and lane ordering.
$ {
  Song: {
    title: "Voltage Tide", tempo: 110, beats_per_bar: 4, beat_unit: 4, beats: 400,
    lanes: [
      {name: "Horizon Pad", bus: vt_track_horizon_pad},
      {name: "Velvet String Pulses", bus: vt_track_strings},
      {name: "Motor Bass", bus: vt_track_motor_bass},
      {name: "Sub Floor", bus: vt_track_sub},
      {name: "Soft Plucked Ostinato", bus: vt_track_kinetic_arp},
      {name: "Luminous Lead / Main Hook", bus: vt_track_lead},
      {name: "Chorus / Sustained Harmony", bus: vt_track_lead_double},
      {name: "Brass Stabs", bus: vt_track_brass},
      {name: "Vocal Halo", bus: vt_track_halo},
      {name: "Glass Replies", bus: vt_track_bells},
      {name: "Kick / Tuned Sub & Click", bus: vt_track_kick},
      {name: "Snare / Shell & Noise Wires", bus: vt_track_snare_shell},
      {name: "Clap / Multi-burst Hands", bus: vt_track_clap_crack},
      {name: "Closed Hats / Swung Metal", bus: vt_track_closed_hat},
      {name: "Open Hats", bus: vt_track_open_hat},
      {name: "Toms / Tuned Fills", bus: vt_track_tom_fills},
      {name: "Crash / Noise Wash", bus: vt_track_crash},
      {name: "Ride / Groove & Build", bus: vt_track_ride},
      {name: "Riser / Critical Mass", bus: vt_track_riser},
      {name: "Drop / Extra Snare", bus: vt_track_downbeat_shell},
      {name: "Drop / Extra Clap", bus: vt_track_downbeat_clap},
      {name: "Drop / Extra Kick", bus: vt_track_downbeat_kick}
    ]
  }
}
