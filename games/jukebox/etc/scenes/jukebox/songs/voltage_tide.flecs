vt_track_horizon_pad {
  Track: {instrument: vt_pad_inst}
  AudioBus: {output: vt_mix, volume: 0.59, effects: [vt_pad_filter, vt_pad_chorus], sends: [{bus: vt_hall, level: 0.44}]}
  AudioMeter: {}
  part_1 { ClipPlacement: {clip: vt_pad_cycle, start: 0, duration: 128, loop: true} }
  part_2 { ClipPlacement: {clip: vt_pad_cycle, start: 128, duration: 64, loop: true} }
  part_3 { ClipPlacement: {clip: vt_pad_tension, start: 192} }
