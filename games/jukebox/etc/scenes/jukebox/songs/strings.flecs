using box.audio
using box.material

box { audio { Song { Rgb: {200, 140, 80} } } }
assets {

  st_hall {
    AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.32, effects: [st_hall]}
    Reverb: {decay: 2.3, damping: 0.45, predelay: 0.022, size: 0.85}
  }
  st_glue { Compressor: {threshold: -12, ratio: 2, attack: 0.03, release: 0.25, knee: 8} }
  st_strings {
    AudioBus: {output: master, volume: 0.66, effects: [st_glue]}
    AudioMeter: {}
