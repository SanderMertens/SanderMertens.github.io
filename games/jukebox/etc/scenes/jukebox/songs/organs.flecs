using box.audio
using box.material

box { audio { Song { Rgb: {196, 92, 112} } } }

og_church {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.85 * reverb_level / 100, effects: [og_church]}
  Reverb: {decay: 5.5, damping: 0.55, predelay: 0.05, size: 1}
}

og_club {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.7 * reverb_level / 100, effects: [og_club]}
  Reverb: {decay: 1.3, damping: 0.6, predelay: 0.015, size: 0.45}
}

og_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 24},
    {kind: AudioEqPeak, frequency: 250, gain: -1.5, q: 0.8}
  ]}
}
og_glue { Compressor: {threshold: -14, ratio: 2, attack: 0.03, release: 0.3, knee: 8} }
og_organs {
  AudioBus: {output: master, volume: 0.75, effects: [og_tone, og_glue]}
  AudioMeter: {}
}

