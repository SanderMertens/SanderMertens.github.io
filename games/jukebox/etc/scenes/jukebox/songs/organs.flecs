og_tonewheel_leslie { Rotary: {speed: 0, drive: 0.35, balance: 0.1} }
og_track_tonewheel {
  Track: {instrument: og_tonewheel, humanize: {timing: 5}}
  AudioBus: {output: og_organs, volume: 0.65, effects: [og_tonewheel_leslie], sends: [{bus: og_club, level: 0.35}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_gospel, start: 0} }
  og_tutti { ClipPlacement: {clip: og_hymn_wheel, start: 112, gain: 0.55} }
}

og_jazz_leslie { Rotary: {speed: 0, drive: 0.5, balance: 0.25} }
og_track_jazz {
  Track: {instrument: og_jazz, swing: 0.3, humanize: {timing: 6}}
  AudioBus: {output: og_organs, volume: 1, effects: [og_jazz_leslie], sends: [{bus: og_club, level: 0.3}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_jazz_line, start: 16} }
  og_tutti { ClipPlacement: {clip: og_hymn_stabs, start: 128, gain: 0.5} }
}

og_combo_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 120},
    {kind: AudioEqPeak, frequency: 2200, gain: 2.5, q: 0.9}
  ]}
}
og_track_combo {
  Track: {instrument: og_combo, humanize: {timing: 5}}
  AudioBus: {output: og_organs, volume: 0.55, pan: 0.2, effects: [og_combo_tone], sends: [{bus: og_club, level: 0.4}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_combo_riff, start: 32} }
  og_tutti { ClipPlacement: {clip: og_hymn_combo, start: 128, gain: 0.4} }
}

og_track_flute {
  Track: {instrument: og_flute, humanize: {timing: 4}}
  AudioBus: {output: og_organs, volume: 0.4, pan: -0.15, sends: [{bus: og_church, level: 0.55}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_flute_tune, start: 48} }
  og_tutti { ClipPlacement: {clip: og_hymn_melody, start: 128, offset: 16, transpose: 12, gain: 0.6} }
}

og_track_principal {
  Track: {instrument: og_principal, humanize: {timing: 4}}
  AudioBus: {output: og_organs, volume: 0.35, sends: [{bus: og_church, level: 0.6}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_chorale, start: 64} }
  og_tutti { ClipPlacement: {clip: og_hymn_inner, start: 112} }
}

og_reed_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 70},
    {kind: AudioEqPeak, frequency: 1400, gain: 2.5, q: 1},
    {kind: AudioEqHighShelf, frequency: 6000, gain: -3}
  ]}
}
og_track_reed {
  Track: {instrument: og_reed, humanize: {timing: 4}}
  AudioBus: {output: og_organs, volume: 0.45, pan: 0.15, effects: [og_reed_tone], sends: [{bus: og_church, level: 0.55}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_fanfare, start: 80} }
  og_tutti { ClipPlacement: {clip: og_hymn_melody, start: 112, gain: 0.8} }
}

og_track_pedal {
  Track: {instrument: og_pedal, humanize: {timing: 4}}
  AudioBus: {output: og_organs, volume: 0.42, sends: [{bus: og_church, level: 0.4}]}
  AudioMeter: {}
  og_solo { ClipPlacement: {clip: og_pedal_walk, start: 96} }
  og_tutti { ClipPlacement: {clip: og_hymn_bass, start: 112} }
}

prefab og_leslie_switch {
  AutomationClip: {target: og_tonewheel_leslie, component: Rotary, member: "speed", length: 144,
    curve: {kind: CurveLinear, keys: [
      {0, 0}, {7.99, 0}, {8, 1}, {15.99, 1}, {16, 0},
      {127.99, 0}, {128, 1}, {144, 1}
    ]}}
}
og_automation {
  Track: {}
  og_leslie { ClipPlacement: {clip: og_leslie_switch, start: 0} }
}

$ {
  Song: {
    title: "Organs", tempo: 88, beats_per_bar: 4, beat_unit: 4, beats: 144,
    lanes: [
      {name: "Tonewheel & Leslie", bus: og_track_tonewheel},
      {name: "Jazz Percussion", bus: og_track_jazz},
      {name: "Combo Organ", bus: og_track_combo},
      {name: "Flute Pipes", bus: og_track_flute},
      {name: "Principal", bus: og_track_principal},
      {name: "Reed Pipes", bus: og_track_reed},
      {name: "Pedal", bus: og_track_pedal}
    ]
  }
