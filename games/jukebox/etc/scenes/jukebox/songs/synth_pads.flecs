using box.audio
using box.material

box { audio { Song { Rgb: {170, 110, 255} } } }

pd_space {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.8 * reverb_level / 100, effects: [pd_space]}
  Reverb: {decay: 4.5, damping: 0.5, predelay: 0.04, size: 0.95, shimmer: 0.08}
}

pd_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 32},
    {kind: AudioEqPeak, frequency: 300, gain: -2, q: 0.8},
    {kind: AudioEqHighShelf, frequency: 7000, gain: 2}
  ]}
}
pd_glue { Compressor: {threshold: -16, ratio: 2, attack: 0.04, release: 0.35, knee: 10} }
pd_pads {
  AudioBus: {output: master, volume: 1, effects: [pd_tone, pd_glue]}
  AudioMeter: {}
}

prefab pd_harmonics { Wavetable: {kind: WavetableHarmonics} }
prefab pd_pulses { Wavetable: {kind: WavetablePulse} }

prefab pd_warm_sound {
  SynthSound: {seed: 101, drift: 6, free_phase: true}
  SynthEnvelope: {attack: 0.9, decay: 1.5, sustain: 0.85, release: 2.2, attack_curve: 1}
  SynthFilter: {kind: SynthLowPass, cutoff: 750, resonance: 0.22, slope: SynthSlope24, model: SynthFilterLadder, keytrack: 0.4, drive: 0.2}
  SynthFilterEnvelope: {attack: 1.4, decay: 2.5, sustain: 0.45, release: 2, amount: 1.4}
  SynthLfo: {rate: 0.18, random_phase: true, cutoff: 0.25}
  saw {
    SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.3}
    SynthUnison: {voices: 5, detune: 16, width: 0.85}
  }
  low {
    SynthOscillator: {wave: SynthSaw, frequency: 220, level: 0.12}
    SynthUnison: {voices: 3, detune: 9, width: 0.5}
  }
}

prefab pd_pulse_sound {
  SynthSound: {seed: 102, drift: 4, free_phase: true}
  SynthEnvelope: {attack: 0.35, decay: 1, sustain: 0.8, release: 1.6}
  SynthFilter: {kind: SynthLowPass, cutoff: 1900, resonance: 0.15, keytrack: 0.5}
  SynthLfo: {wave: SynthLfoTriangle, rate: 0.35, random_phase: true, pulse_width: 0.38}
  wide {
    SynthOscillator: {wave: SynthSquare, frequency: 440, level: 0.22, pulse_width: 0.5}
    SynthUnison: {voices: 3, detune: 7, width: 0.7}
  }
  thin {
    SynthOscillator: {wave: SynthSquare, frequency: 880, level: 0.06, pulse_width: 0.3}
    SynthEnvelope: {attack: 0.8, decay: 1, sustain: 0.7, release: 1.6}
  }
}

prefab pd_glass_sound {
  SynthSound: {seed: 103, drift: 3, level_variance: 0.03}
  SynthEnvelope: {attack: 0.25, decay: 2.5, sustain: 0.6, release: 3}
  SynthFilter: {kind: SynthLowPass, cutoff: 9000, velocity: 1}
  SynthLfo: {rate: 3.2, random_phase: true, amplitude: 0.12}
  bell {
    SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.3}
    SynthUnison: {voices: 2, detune: 5, width: 0.8}
    ping {
      SynthOscillator: {frequency: 1540, modulation: SynthPhase, index: 2.2, velocity: 0.6}
      SynthEnvelope: {attack: 0.01, decay: 1.6, sustain: 0.15, release: 2, curve: 3}
    }
  }
  shine {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.07}
    SynthEnvelope: {attack: 1.2, decay: 2, sustain: 0.8, release: 3}
    SynthUnison: {voices: 2, detune: 9, width: 1}
  }
}

prefab pd_morph_sound {
  SynthSound: {seed: 104, drift: 5, free_phase: true}
  SynthEnvelope: {attack: 1.6, decay: 2, sustain: 0.85, release: 2.8, attack_curve: 1}
  SynthFilter: {kind: SynthLowPass, cutoff: 5000, keytrack: 0.3}
  SynthLfo: {wave: SynthLfoTriangle, sync: 8, position: 9}
  sweep {
    SynthOscillator: {wave: SynthWavetable, frequency: 440, level: 0.22}
    SynthTable: {table: pd_harmonics, position: 2, envelope: 8}
    SynthUnison: {voices: 4, detune: 12, width: 1}
  }
  grain {
    SynthOscillator: {wave: SynthWavetable, frequency: 880, level: 0.07}
    SynthTable: {table: pd_pulses, position: 3, envelope: 6}
    SynthUnison: {voices: 2, detune: 8, width: 0.6}
  }
}

prefab pd_choir_sound {
  SynthSound: {seed: 105, drift: 7, level_variance: 0.04, free_phase: true}
  SynthEnvelope: {attack: 0.8, decay: 1.2, sustain: 0.9, release: 1.8, attack_curve: 1}
  SynthFilter: {kind: SynthFormant, vowel: 3, resonance: 0.35}
  SynthLfo: {rate: 0.11, random_phase: true, vowel: 1.3}
  vibrato { SynthLfo: {rate: 4.8, delay: 0.5, fade: 1.2, random_phase: true, pitch: 7} }
  voices {
    SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.38}
    SynthUnison: {voices: 4, detune: 11, width: 0.75}
  }
  breath { SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, level: 0.03} }
}

prefab pd_air_sound {
  SynthSound: {seed: 106, drift: 4}
  SynthEnvelope: {attack: 1.4, decay: 1.5, sustain: 0.85, release: 2.6, attack_curve: 1}
  SynthFilter: {kind: SynthComb, feedback: 0.93, cutoff: 7000, keytrack: 0.3}
  SynthLfo: {rate: 0.21, random_phase: true, amplitude: 0.25}
  breath { SynthOscillator: {wave: SynthNoise, color: SynthNoisePink, frequency: 440, level: 0.9} }
  hum { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.05} }
}

pd_warm { Instrument: {sound: pd_warm_sound, velocity_curve: 1.3} }
pd_pulse { Instrument: {sound: pd_pulse_sound, velocity_curve: 1.3} }
pd_glass { Instrument: {sound: pd_glass_sound, spread: 0.4, spread_mode: InstrumentSpreadAlternate} }
pd_morph { Instrument: {sound: pd_morph_sound, spread: 0.3, spread_mode: InstrumentSpreadAlternate} }
pd_choir { Instrument: {sound: pd_choir_sound, spread: 0.5, spread_mode: InstrumentSpreadAlternate} }
pd_air { Instrument: {sound: pd_air_sound, spread: 0.6, spread_mode: InstrumentSpreadAlternate} }

