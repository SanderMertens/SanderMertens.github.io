pd_warm_chorus { Chorus: {voices: 3, rate: 0.15, depth: 4, delay: 16, spread: 1, mix: 0.25} }
pd_track_warm {
  Track: {instrument: pd_warm, humanize: {timing: 8, velocity: 0.04}}
  AudioBus: {output: pd_pads, volume: 0.9, effects: [pd_warm_chorus], sends: [{bus: pd_space, level: 0.35}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_chords, start: 0} }
  pd_tutti { ClipPlacement: {clip: pd_warm_tutti, start: 96} }
}

pd_pulse_phaser { Phaser: {stages: 6, rate: 0.12, feedback: 0.45, mix: 0.5} }
pd_track_pulse {
  Track: {instrument: pd_pulse, humanize: {timing: 8, velocity: 0.04}}
  AudioBus: {output: pd_pads, volume: 0.9, effects: [pd_pulse_phaser], sends: [{bus: pd_space, level: 0.3}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_chords, start: 16} }
  pd_tutti { ClipPlacement: {clip: pd_pulse_tutti, start: 96} }
}

pd_glass_echo { Delay: {sync: 0.75, feedback: 0.38, mix: 0.22, damping: 4500, ping_pong: true} }
pd_track_glass {
  Track: {instrument: pd_glass, humanize: {timing: 12, velocity: 0.06}}
  AudioBus: {output: pd_pads, volume: 0.9, effects: [pd_glass_echo], sends: [{bus: pd_space, level: 0.5}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_high_chords, start: 32} }
  pd_tutti { ClipPlacement: {clip: pd_glass_tutti, start: 96} }
}

pd_track_morph {
  Track: {instrument: pd_morph, humanize: {timing: 8, velocity: 0.04}}
  AudioBus: {output: pd_pads, volume: 0.9, sends: [{bus: pd_space, level: 0.4}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_chords, start: 48} }
  pd_tutti { ClipPlacement: {clip: pd_morph_tutti, start: 96} }
}

pd_choir_chorus { Chorus: {voices: 3, rate: 0.2, depth: 3, delay: 14, spread: 0.9, mix: 0.3} }
pd_track_choir {
  Track: {instrument: pd_choir, humanize: {timing: 15, velocity: 0.05}}
  AudioBus: {output: pd_pads, volume: 0.8, effects: [pd_choir_chorus], sends: [{bus: pd_space, level: 0.45}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_triads, start: 64} }
  pd_tutti { ClipPlacement: {clip: pd_choir_tutti, start: 96} }
}

pd_track_air {
  Track: {instrument: pd_air, humanize: {timing: 10, velocity: 0.04}}
  AudioBus: {output: pd_pads, volume: 1.7, sends: [{bus: pd_space, level: 0.55}]}
  AudioMeter: {}
  pd_solo { ClipPlacement: {clip: pd_air_notes, start: 80} }
  pd_tutti { ClipPlacement: {clip: pd_air_tutti, start: 96} }
}

$ {
  Song: {
    title: "Synth Pads", tempo: 80, beats_per_bar: 4, beat_unit: 4, beats: 128,
    lanes: [
      {name: "Warm Analog", bus: pd_track_warm},
      {name: "Pulse", bus: pd_track_pulse},
      {name: "Glass", bus: pd_track_glass},
      {name: "Evolving", bus: pd_track_morph},
      {name: "Choir", bus: pd_track_choir},
      {name: "Air", bus: pd_track_air}
    ]
  }
}
