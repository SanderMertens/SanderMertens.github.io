using box.audio
using box.material

// STARFALL: BEYOND THE ORBIT
// Original companion composition to "Distant Orbit".
// 96 BPM | E minor -> E major final resolution | 96 bars | 4:00
// Journey: Transmission / Ignition / Flight / Silence / Ascent / Supernova / Afterglow / Finale / Dawn

box { audio { Song { Rgb: {255, 155, 91} } } }

starfall_space {
  AudioBus: {output: master, kind: AudioChannelReturn, volume: 0.28, effects: [starfall_space]}
  Reverb: {decay: 6.5, damping: 0.48, predelay: 0.045, size: 1, shimmer: 0.22}
}

starfall_tone {
  Equalizer: {bands: [
    {kind: AudioEqLowCut, frequency: 28},
    {kind: AudioEqPeak, frequency: 260, gain: -2, q: 0.8},
    {kind: AudioEqHighShelf, frequency: 7600, gain: 1.5}
  ]}
}

starfall_glue {
  Compressor: {threshold: -17, ratio: 2.2, attack: 0.035, release: 0.28, knee: 8, makeup: 1}
}

starfall_mix {
  AudioBus: {output: master, volume: 0.9, effects: [starfall_tone, starfall_glue]}
  AudioMeter: {}
}

prefab starfall_harmonics { Wavetable: {kind: WavetableHarmonics} }

prefab starfall_pad_sound {
  SynthSound: {seed: 201, drift: 9, free_phase: true}
  SynthEnvelope: {attack: 1.5, decay: 1.4, sustain: 0.82, release: 4}
  SynthFilter: {kind: SynthLowPass, cutoff: 2400, resonance: 0.07, keytrack: 0.35}
  body {
    SynthOscillator: {wave: SynthWavetable, frequency: 440, level: 0.17}
    SynthTable: {table: starfall_harmonics, position: 3, envelope: 6}
    SynthUnison: {voices: 4, detune: 9, width: 0.9}
  }
  air {
    SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.038}
    SynthUnison: {voices: 2, detune: 12, width: 1}
    SynthLfo: {rate: 0.075, random_phase: true, amplitude: 0.1}
  }
}

