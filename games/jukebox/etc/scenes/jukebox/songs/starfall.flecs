starfall_pad_inst { Instrument: {sound: starfall_pad_sound, spread: 0.7} }
starfall_strings_inst { Instrument: {sound: starfall_string_sound, spread: 0.72} }
starfall_bass_inst { Instrument: {sound: starfall_bass_sound} }
starfall_sub_inst { Instrument: {sound: starfall_sub_sound} }
starfall_arp_inst { Instrument: {sound: starfall_arp_sound, gate: false, spread: 0.7, spread_mode: InstrumentSpreadAlternate} }
starfall_lead_inst { Instrument: {sound: starfall_lead_sound, spread: 0.26} }
starfall_wide_inst { Instrument: {sound: starfall_wide_sound, spread: 0.8} }
starfall_bell_inst { Instrument: {sound: starfall_bell_sound, gate: false, spread: 0.6, spread_mode: InstrumentSpreadAlternate} }
starfall_spark_inst { Instrument: {sound: starfall_spark_sound, gate: false, spread: 0.95, spread_mode: InstrumentSpreadRandom} }
starfall_counter_inst { Instrument: {sound: starfall_counter_sound} }
starfall_brass_inst { Instrument: {sound: starfall_brass_sound, spread: 0.65} }
starfall_choir_inst { Instrument: {sound: starfall_choir_sound, spread: 0.76} }
starfall_kick_inst { Instrument: {sound: starfall_kick_sound, gate: false} }
starfall_snare_inst { Instrument: {sound: starfall_snare_sound, gate: false} }
starfall_hat_inst { Instrument: {sound: starfall_hat_sound, gate: false} }
starfall_tom_inst { Instrument: {sound: starfall_tom_sound, gate: false} }
starfall_impact_inst { Instrument: {sound: starfall_impact_sound, gate: false} }
starfall_tick_inst { Instrument: {sound: starfall_hat_sound, gate: false} }

starfall_pad_filter { AudioFilter: {cutoff: 1150, resonance: 0.07} }
starfall_pad_chorus { Chorus: {voices: 3, rate: 0.14, depth: 4, delay: 17, spread: 1, mix: 0.32} }
starfall_lead_delay { Delay: {sync: 0.75, feedback: 0.23, mix: 0.20, damping: 4800, ping_pong: true} }
starfall_arp_delay { Delay: {sync: 0.75, feedback: 0.28, mix: 0.15, damping: 5200, ping_pong: true} }
starfall_bell_delay { Delay: {sync: 1.5, feedback: 0.4, mix: 0.26, damping: 4000, ping_pong: true} }

