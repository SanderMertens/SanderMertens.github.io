// All sound sources route to the same mastering bus.
starfall_track_celestial_pad {
  Track: {instrument: starfall_pad_inst}
  AudioBus: {output: starfall_mix, volume: 0.75, effects: [starfall_pad_filter, starfall_pad_chorus], sends: [{bus: starfall_space, level: 0.45}]}
  AudioMeter: {}
  part_1 { ClipPlacement: {clip: starfall_pad_progression, start: 0, duration: 352, loop: true} }
  part_2 { ClipPlacement: {clip: starfall_pad_final, start: 352} }
}

