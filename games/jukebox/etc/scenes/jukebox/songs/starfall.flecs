// One macro controls the orchestra's spectral opening across all nine acts.
starfall_bloom {
  AudioMacro: {}
  sunlight { AudioMacroMap: {target: starfall_pad_filter, component: AudioFilter, member: "cutoff", min: 850, max: 6200, scale: AudioModOctaves} }
  horizon { AudioMacroMap: {target: starfall_space, component: Reverb, member: "shimmer", min: 0.11, max: 0.38} }
  particles { AudioMacroMap: {target: starfall_track_star_particles, component: AudioBus, member: "volume", min: 0.13, max: 0.58} }
}

starfall_analog_sway {
  AudioModulator: {target: starfall_track_celestial_pad, component: AudioBus, member: "pan", depth: 0.24, sync: 32}
}

prefab starfall_dynamics {
  AutomationClip: {target: starfall_bloom, component: AudioMacro, member: "value", length: 384,
    curve: {kind: CurveCatmullRom, keys: [
      {0, 0.06}, {24, 0.17}, {32, 0.28}, {56, 0.50}, {64, 0.65},
      {96, 0.83}, {124, 0.87}, {128, 0.17}, {152, 0.13},
      {160, 0.22}, {176, 0.35}, {188, 0.74}, {192, 1},
      {240, 0.98}, {256, 0.25}, {280, 0.14}, {288, 1},
      {344, 1}, {352, 0.72}, {368, 0.43}, {380, 0.16}, {384, 0.04}
    ]}}
}

starfall_automation { Track: {}
  journey { ClipPlacement: {clip: starfall_dynamics, start: 0} }
}

$ {
  Song: {
    title: "Starfall - Beyond the Orbit", tempo: 96, beats_per_bar: 4, beat_unit: 4, beats: 384,
    lanes: [
      {name: "Celestial Pad", bus: starfall_track_celestial_pad},
      {name: "Orchestral Strings", bus: starfall_track_orchestral_strings},
      {name: "Deep Bass", bus: starfall_track_deep_bass},
      {name: "Sub Foundation", bus: starfall_track_sub_foundation},
      {name: "Crystal Arpeggios", bus: starfall_track_crystal_arpeggios},
      {name: "Lead / The Signal", bus: starfall_track_lead___the_signal},
      {name: "Wide Lead Harmony", bus: starfall_track_wide_lead_harmony},
      {name: "Glass Bells", bus: starfall_track_glass_bells},
      {name: "Star Particles", bus: starfall_track_star_particles},
      {name: "High Countermelody", bus: starfall_track_high_countermelody},
      {name: "Brass Horizon", bus: starfall_track_brass_horizon},
      {name: "Vocal Halo", bus: starfall_track_vocal_halo},
      {name: "Kick", bus: starfall_track_kick},
      {name: "Snare", bus: starfall_track_snare},
      {name: "Hi-Hat", bus: starfall_track_hi_hat},
      {name: "Rushing Hats", bus: starfall_track_rushing_hats},
      {name: "Cinematic Toms", bus: starfall_track_cinematic_toms},
      {name: "Impact Cymbal", bus: starfall_track_impact_cymbal},
      {name: "Riser / Countdown", bus: starfall_track_riser___countdown},
      {name: "Last Light", bus: starfall_track_last_light}
    ]
  }
}
