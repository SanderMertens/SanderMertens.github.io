include mossvale/state
include mossvale/geo
include mossvale/materials
include mossvale/props
include mossvale/town
include mossvale/targets
include mossvale/npcs
include mossvale/player
include mossvale/quests
include mossvale/fx
include mossvale/world
include mossvale/hud
include mossvale/dev
include mossvale/music

using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.light
using box.effects
using box.surface
using box.atmosphere

window { Surface: {width: 1600, height: 960, vsync: true} }

mv_contact { Gtao: {radius: 0.8, final_value_power: 1.8} }
mv_bloom { Bloom: {intensity: 0.14, threshold: 1.1, threshold_softness: 0.5} }
mv_exposure { AutoExposure: {min_log_luma: -10.8, exposure_compensation: 0.35} }
mv_film { Tonemap: {auto_exposure: mv_exposure, operator_: TonyMcMapface} }
mv_edges { Smaa: {} }

mv_sun {
  DirectionalLight: {intensity: 2.6 * PI}
  Rgb: {255, 244, 226}
}

mv_sky {
  if hour > 19 || hour < 5.5 {
    AmbientLight: {sky: {90, 110, 190}, ground: {40, 40, 60}, intensity: 1.1}
  } else if hour > 17.5 {
    AmbientLight: {sky: {190, 150, 140}, ground: {100, 80, 60}, intensity: 0.55}
  } else {
    AmbientLight: {sky: {150, 170, 205}, ground: {96, 86, 64}, intensity: 0.4}
  }
  Atmosphere: {
    sun: mv_sun,
    units_per_km: 400,
    rayleigh: {scale_height: 8, scattering_scale: 2.0},
    mie: {scale_height: 1.4, anisotropy: 0.76, scattering_scale: 2.2, tint: {255, 232, 200}},
    ozone_scale: 3,
    ground_albedo: {96, 130, 70},
    sun_disk_intensity: 10,
    sun_radius: 0.75
  }
  TimeOfDay: {hour: hour, day_of_year: 170, latitude: 48, north: 160, sun: mv_sun}
  HeightFog: {density: 0.004, falloff: 0.07, base_height: -2, max_opacity: 0.4, atmosphere: mv_sky}
}

mv_view {
  View: {
    camera: mv_rig.arm.camera,
    clear: {enabled: true, color: {150, 178, 210, 255}},
    lighting: {
      enabled: true,
      reflections: true,
      atmosphere: true,
      environment: {source: mv_sky, intensity: 0.6, background: false}
    },
    shadows: {
      enabled: true,
      cascades: 3,
      resolution: 2048,
      max_distance: 90,
      split_lambda: 0.7,
      depth_bias: 2,
      normal_offset: 2,
      filter_size: 3,
      fade: 0.2,
      blend: 0.1
    },
    culling: {enabled: true, occlusion: true, min_dimension_px: 2},
    effects: [
      {effect: mv_contact},
      {effect: mv_sky},
      {effect: mv_bloom},
      {effect: mv_film},
      {effect: mv_edges}
    ]
  }
}

async {
  while true {
    await on.pressed(mv_actions.TalkKey)
    if game_state == 0 {
      emit StartGame()
    } else if game_state == 2 && clock > ending_t + 12 {
      game_state = 1
      say("The festival goes on into the night. Wander as long as you like.")
    }
  }
}
