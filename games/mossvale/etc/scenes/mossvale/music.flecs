using flecs.script
using flecs.script.math
using box.audio

export mut music_bar: i32 = 0

template Flute {
  prop f: f32 = 440
  AudioOutput: {bus: mv_music}
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.06, decay: 0.25, sustain: 0.55, hold: 0.22, release: 0.5, curve: 2.5, attack_curve: 1.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 2600, resonance: 0.1}
  SynthLfo: {rate: 5.2, delay: 0.2, fade: 0.3, random_phase: true, pitch: 14, amplitude: 0.08}
  tone { SynthOscillator: {wave: SynthSine, frequency: f, level: 0.42} }
  reed { SynthOscillator: {wave: SynthTriangle, frequency: f * 1.002, level: 0.14} }
  breath { SynthOscillator: {wave: SynthNoise, level: 0.025}; SynthEnvelope: {attack: 0.02, decay: 0.12} }
  octave { SynthOscillator: {wave: SynthSine, frequency: f * 2, level: 0.05} }
}

// A harp: a gut string plucked with a finger, which rings out on its own, over a soft sine
// for the body of the soundboard
template Harp {
  prop f: f32 = 220
  AudioOutput: {bus: mv_music}
  SynthSound: {level_variance: 0.1}
  SynthFilter: {kind: SynthLowPass, cutoff: 3500, resonance: 0.05}
  pluck { SynthOscillator: {wave: SynthPluck, frequency: f, level: 0.45}; SynthString: {decay: 2.2, brightness: 0.35, hardness: 0.45} }
  body { SynthOscillator: {wave: SynthSine, frequency: f, level: 0.12}; SynthEnvelope: {attack: 0.004, decay: 1.2, curve: 4.5} }
}

template Strings {
  prop a: f32 = 196
  prop b: f32 = 246.94
  prop c: f32 = 293.66
  AudioOutput: {bus: mv_music}
  SynthSound: {seed: 5}
  SynthEnvelope: {attack: 0.9, decay: 0.6, sustain: 0.7, hold: 1.2, release: 1.4}
  SynthFilter: {kind: SynthLowPass, cutoff: 900, resonance: 0.12}
  SynthFilterEnvelope: {attack: 1.8, sustain: 1, hold: 2.3, amount: 0.637}
  SynthLfo: {rate: 0.23, fade: 1.2, random_phase: true, cutoff: 0.3, amplitude: 0.12}
  low {
    SynthOscillator: {wave: SynthSaw, frequency: a, level: 0.09}
    SynthUnison: {voices: 3, detune: 12, width: 0.6}
  }
  mid {
    SynthOscillator: {wave: SynthSaw, frequency: b, level: 0.08}
    SynthUnison: {voices: 3, detune: 12, width: 0.8}
    SynthLfo: {wave: SynthLfoTriangle, rate: 0.37, fade: 0.8, phase: 0.5, pitch: 7}
  }
  high { SynthOscillator: {wave: SynthTriangle, frequency: c, level: 0.14} }
  shimmer {
    SynthOscillator: {wave: SynthSine, frequency: a * 2, level: 0.05}
    SynthUnison: {voices: 2, detune: 7, width: 1}
  }
}

template Bass {
  prop f: f32 = 98
  AudioOutput: {bus: mv_music}
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.01, decay: 1.0, curve: 3}
  SynthFilter: {kind: SynthLowPass, cutoff: 200, resonance: 0.2}
  SynthFilterEnvelope: {decay: 0.5, amount: 1.322}
  body { SynthOscillator: {wave: SynthTriangle, frequency: f, level: 0.45} }
  sub { SynthOscillator: {wave: SynthSine, frequency: f, level: 0.4} }
}

prefab MvKick {
  AudioOutput: {bus: mv_music}
  SynthSound: {}
  SynthEnvelope: {attack: 0.002, decay: 0.25}
  SynthFilter: {kind: SynthLowPass, cutoff: 2000}
  tone { SynthOscillator: {wave: SynthSine, frequency: 140, frequency_end: 48, sweep: 0.09, level: 0.7} }
}

prefab MvTamb {
  AudioOutput: {bus: mv_music}
  SynthSound: {seed: 9, level_variance: 0.25}
  SynthEnvelope: {attack: 0.001, decay: 0.07}
  SynthFilter: {kind: SynthHighPass, cutoff: 6000, resonance: 0.2}
  SynthOscillator: {wave: SynthNoise, level: 0.35}
}

mv_score {
  Flute fl_g4(f: 392)
  Flute fl_a4(f: 440)
  Flute fl_b4(f: 493.88)
  Flute fl_c5(f: 523.25)
  Flute fl_d5(f: 587.33)
  Flute fl_e5(f: 659.25)
  Flute fl_fs5(f: 739.99)
  Flute fl_g5(f: 783.99)
  Flute fl_a5(f: 880)
  Flute fl_fs4(f: 369.99)

  Harp hp_c3(f: 130.81)
  Harp hp_d3(f: 146.83)
  Harp hp_e3(f: 164.81)
  Harp hp_g3(f: 196)
  Harp hp_a3(f: 220)
  Harp hp_b3(f: 246.94)
  Harp hp_c4(f: 261.63)
  Harp hp_d4(f: 293.66)
  Harp hp_e4(f: 329.63)
  Harp hp_fs4(f: 369.99)
  Harp hp_g4(f: 392)
  Harp hp_a4(f: 440)

  Strings st_g(a: 196, b: 246.94, c: 293.66)
  Strings st_em(a: 164.81, b: 246.94, c: 329.63)
  Strings st_c(a: 130.81, b: 196, c: 329.63)
  Strings st_d(a: 146.83, b: 220, c: 369.99)
  Strings st_am(a: 220, b: 261.63, c: 329.63)

  Bass bs_g(f: 98)
  Bass bs_e(f: 82.41)
  Bass bs_c(f: 65.41)
  Bass bs_d(f: 73.42)
  Bass bs_a(f: 110)
}

const MV_FLUTE = [mv_score.fl_g4, mv_score.fl_a4, mv_score.fl_b4, mv_score.fl_c5, mv_score.fl_d5, mv_score.fl_e5, mv_score.fl_fs5, mv_score.fl_g5, mv_score.fl_a5, mv_score.fl_fs4]
const MV_STRINGS = [mv_score.st_g, mv_score.st_em, mv_score.st_c, mv_score.st_d, mv_score.st_am]
const MV_BASS = [mv_score.bs_g, mv_score.bs_e, mv_score.bs_c, mv_score.bs_d, mv_score.bs_a]
const MV_ARP = [
  mv_score.hp_g3, mv_score.hp_b3, mv_score.hp_d4, mv_score.hp_g4,
  mv_score.hp_e3, mv_score.hp_b3, mv_score.hp_e4, mv_score.hp_g4,
  mv_score.hp_c3, mv_score.hp_g3, mv_score.hp_c4, mv_score.hp_e4,
  mv_score.hp_d3, mv_score.hp_a3, mv_score.hp_d4, mv_score.hp_fs4,
  mv_score.hp_a3, mv_score.hp_c4, mv_score.hp_e4, mv_score.hp_a4
]
const MV_PATTERN = [0, 1, 2, 3, 2, 1, 2, 1]
const MV_CHORDS = [0, 1, 2, 3, 0, 1, 4, 3, 2, 0, 4, 1, 2, 0, 3, 3]
const MV_MELODY = [
  4, -1, 2, -1, 0, -1, 2, -1,
  5, -1, -1, 4, 2, -1, -1, -1,
  3, -1, 5, -1, 7, -1, 5, -1,
  4, -1, -1, -1, 1, -1, -1, -1,
  2, -1, 4, -1, 7, -1, 6, -1,
  5, -1, 4, -1, 2, -1, 0, -1,
  1, -1, 3, -1, 5, -1, 4, 3,
  4, -1, -1, -1, -1, -1, -1, -1,
  5, -1, 7, -1, 5, -1, 3, -1,
  4, -1, 2, -1, 0, -1, -1, -1,
  3, -1, 5, -1, 8, -1, 7, -1,
  7, -1, -1, 5, -1, -1, 2, -1,
  5, -1, -1, 7, 6, -1, 5, -1,
  4, -1, 2, -1, 4, -1, 7, -1,
  6, -1, 5, -1, 4, -1, 1, -1,
  9, -1, -1, -1, -1, -1, -1, -1
]

async {
  while game_state == 0 {
    await delay(0.2)
  }
  await delay(1.5)
  mut loop_n: i32 = 0
  while true {
    for bar in 0..16 {
      music_bar = bar
      const festive = game_state == 2
      const forest = pz < WALL_N1 && game_state == 1
      const step = match festive { true: 0.25; _: 0.33 }
      const chord = MV_CHORDS[bar]
      const melody_on = loop_n % 3 != 1 || festive
      for beat in 0..8 {
        if beat == 0 {
          const s = box.audio.play(MV_STRINGS[chord], match forest { true: 0.9; _: 0.7 })
          const b = box.audio.play(MV_BASS[chord], 0.75)
        }
        if beat == 4 && !forest {
          const b2 = box.audio.play(MV_BASS[chord], 0.45)
        }
        if !forest || beat % 2 == 0 {
          const h = box.audio.play(MV_ARP[chord * 4 + MV_PATTERN[beat]], match beat % 2 { 0: 0.55; _: 0.38 })
        }
        if melody_on && !forest {
          const n = MV_MELODY[bar * 8 + beat]
          if n >= 0 {
            const m = box.audio.play(MV_FLUTE[n], 0.62)
          }
        }
        if festive {
          if beat % 4 == 0 {
            const k = box.audio.play(MvKick, 0.6)
          }
          const t = box.audio.play(MvTamb, match beat % 2 { 0: 0.25; _: 0.45 })
        }
        await delay(step)
      }
    }
    loop_n += 1
  }
}
