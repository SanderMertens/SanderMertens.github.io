using flecs.script
using flecs.script.math
using box.audio

export mut music_on = false

const music_festive = game_state == 2
const music_forest = pz < WALL_N1 && game_state == 1

prefab MvFlute {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.06, decay: 0.25, sustain: 0.55, hold: 0.22, release: 0.5, curve: 2.5, attack_curve: 1.5}
  SynthFilter: {kind: SynthLowPass, cutoff: 2600, resonance: 0.1}
  SynthLfo: {rate: 5.2, delay: 0.2, fade: 0.3, random_phase: true, pitch: 14, amplitude: 0.08}
  tone { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.42} }
  reed { SynthOscillator: {wave: SynthTriangle, frequency: 440 * 1.002, level: 0.14} }
  breath { SynthOscillator: {wave: SynthNoise, level: 0.025}; SynthEnvelope: {attack: 0.02, decay: 0.12} }
  octave { SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.05} }
}

// A harp: a gut string plucked with a finger, which rings out on its own, over a soft sine
// for the body of the soundboard
prefab MvHarp {
  SynthSound: {level_variance: 0.1}
  SynthFilter: {kind: SynthLowPass, cutoff: 3500, resonance: 0.05}
  pluck { SynthOscillator: {wave: SynthPluck, frequency: 440, level: 0.45}; SynthString: {decay: 2.2, brightness: 0.35, hardness: 0.45} }
  body { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.12}; SynthEnvelope: {attack: 0.004, decay: 1.2, curve: 4.5} }
}

template MvStrings {
  prop layer: i32 = 0
  SynthSound: {seed: 5}
  SynthEnvelope: {attack: 0.9, decay: 0.6, sustain: 0.7, hold: 1.2, release: 1.4}
  SynthFilter: {kind: SynthLowPass, cutoff: 900, resonance: 0.12}
  SynthFilterEnvelope: {attack: 1.8, sustain: 1, hold: 2.3, amount: 0.637}
  SynthLfo: {rate: 0.23, fade: 1.2, random_phase: true, cutoff: 0.3, amplitude: 0.12}
  if layer == 0 {
    low {
      SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.09}
      SynthUnison: {voices: 3, detune: 12, width: 0.6}
    }
    shimmer {
      SynthOscillator: {wave: SynthSine, frequency: 880, level: 0.05}
      SynthUnison: {voices: 2, detune: 7, width: 1}
    }
  } else if layer == 1 {
    mid {
      SynthOscillator: {wave: SynthSaw, frequency: 440, level: 0.08}
      SynthUnison: {voices: 3, detune: 12, width: 0.8}
      SynthLfo: {wave: SynthLfoTriangle, rate: 0.37, fade: 0.8, phase: 0.5, pitch: 7}
    }
  } else {
    high { SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.14} }
  }
}

MvStrings mv_strings_low(layer: 0)
MvStrings mv_strings_mid(layer: 1)
MvStrings mv_strings_high(layer: 2)

prefab MvBass {
  SynthSound: {level_variance: 0.05}
  SynthEnvelope: {attack: 0.01, decay: 1.0, curve: 3}
  SynthFilter: {kind: SynthLowPass, cutoff: 200, resonance: 0.2}
  SynthFilterEnvelope: {decay: 0.5, amount: 1.322}
  body { SynthOscillator: {wave: SynthTriangle, frequency: 440, level: 0.45} }
  sub { SynthOscillator: {wave: SynthSine, frequency: 440, level: 0.4} }
}

prefab MvKick {
  SynthSound: {}
  SynthEnvelope: {attack: 0.002, decay: 0.25}
  SynthFilter: {kind: SynthLowPass, cutoff: 2000}
  tone { SynthOscillator: {wave: SynthSine, frequency: 140, frequency_end: 48, sweep: 0.09, level: 0.7} }
}

prefab MvTamb {
  SynthSound: {seed: 9, level_variance: 0.25}
  SynthEnvelope: {attack: 0.001, decay: 0.07}
  SynthFilter: {kind: SynthHighPass, cutoff: 6000, resonance: 0.2}
  SynthOscillator: {wave: SynthNoise, level: 0.35}
}

mv_band {
  flute { Instrument: {sound: MvFlute, velocity_curve: 1, gate: false} }
  harp { Instrument: {sound: MvHarp, velocity_curve: 1, gate: false} }
  strings_low { Instrument: {sound: mv_strings_low, velocity_curve: 1, gate: false} }
  strings_mid { Instrument: {sound: mv_strings_mid, velocity_curve: 1, gate: false} }
  strings_high { Instrument: {sound: mv_strings_high, velocity_curve: 1, gate: false} }
  bass { Instrument: {sound: MvBass, velocity_curve: 1, gate: false} }
  kick { Instrument: {sound: MvKick, velocity_curve: 1, gate: false} }
  tamb { Instrument: {sound: MvTamb, velocity_curve: 1, gate: false} }
}

