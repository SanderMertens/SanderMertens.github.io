const MV_LAYER: string[] = ["low", "mid", "high"]
const MV_STRING_INST = [mv_band.strings_low, mv_band.strings_mid, mv_band.strings_high]
const MV_STRING_PARTS = [mv_strings_low_part, mv_strings_mid_part, mv_strings_high_part]

$ {
  Transport: {beats_per_bar: 4, beat_unit: 4, loop: true, loop_start: 0, loop_end: 192}
  Transport = {tempo: music_festive ? 120 : 90}
  Transport = {playing: music_on}
}

mv_tracks {
  for i in 0..3 {
    "strings_{MV_LAYER[i]}" {
      Track: {instrument: MV_STRING_INST[i]}
      AudioBus: {output: mv_music}
      bars { ClipPlacement: {clip: MV_STRING_PARTS[i], start: 0, duration: 192, loop: true, gain: music_forest ? 0.9 : 0.7} }
    }
  }

  bass {
    Track: {instrument: mv_band.bass}
    AudioBus: {output: mv_music}
    down { ClipPlacement: {clip: mv_bass_part, start: 0, duration: 192, loop: true, gain: 0.75} }
    if !music_forest {
      push { ClipPlacement: {clip: mv_bass_push_part, start: 0, duration: 192, loop: true, gain: 0.45} }
    }
  }

  harp {
    Track: {instrument: mv_band.harp}
    AudioBus: {output: mv_music}
    down { ClipPlacement: {clip: mv_harp_down_part, start: 0, duration: 192, loop: true} }
    if !music_forest {
      off { ClipPlacement: {clip: mv_harp_off_part, start: 0, duration: 192, loop: true} }
    }
  }

  flute {
    Track: {instrument: mv_band.flute}
    AudioBus: {output: mv_music}
    if !music_forest {
      first { ClipPlacement: {clip: mv_melody_part, start: 0} }
      third { ClipPlacement: {clip: mv_melody_part, start: 128} }
    }
    if music_festive {
      second { ClipPlacement: {clip: mv_melody_part, start: 64} }
    }
  }

  kick {
    Track: {instrument: mv_band.kick}
    AudioBus: {output: mv_music}
    if music_festive {
      beat { ClipPlacement: {clip: mv_kick_part, start: 0, duration: 192, loop: true} }
    }
  }

  tamb {
    Track: {instrument: mv_band.tamb}
    AudioBus: {output: mv_music}
    if music_festive {
      beat { ClipPlacement: {clip: mv_tamb_part, start: 0, duration: 192, loop: true} }
    }
  }
}

async {
  await StartGame
  await delay(1.5)
  music_on = true
}
