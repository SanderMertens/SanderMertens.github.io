template GreatLantern : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  prop lit_id: i32 = 0
  prop q: i32 = 0
  const up = ts[id] > 0
  const lit = ts[lit_id] > 0
  const shown = qs[q] >= QS_OPEN
  Position: {x, match shown { true: 0; _: -8 }, z}
  frame_a : MvTimber { Position: {-2, 3, 0}; Box: {0.3, 6, 0.3} }
  frame_b : MvTimber { Position: {2, 3, 0}; Box: {0.3, 6, 0.3} }
  bar : MvTimber { Position: {0, 6.1, 0}; Box: {4.4, 0.3, 0.3} }
  lantern {
    if up {
      Position: {0, 4.4, 0}
    } else {
      Position: {0, 0, 0}
    }
    Transition: [Position: {duration: 2.5, timing_function: EaseInOut}]
    if lit {
      paper : MvGlow { Position: {0, 0.9, 0}; Scale: {1, 1.25, 1}; Sphere: {radius: 0.9, segments: 14, smooth: true} }
      light { Position: {0, 0.9, 0}; PointLight: {intensity: 30, range: 30}; Rgb: {255, 200, 130} }
    } else {
      paper : MvClothRed { Position: {0, 0.9, 0}; Scale: {1, 1.25, 1}; Sphere: {radius: 0.9, segments: 14, smooth: true} }
    }
    top : MvGold { Position: {0, 2.05, 0}; Cylinder: {length: 0.2, radius: 0.35, segments: 10} }
    bottom : MvGold { Position: {0, -0.2, 0}; Cylinder: {length: 0.2, radius: 0.35, segments: 10} }
  }
  async {
    while qs[q] < QS_OPEN { await delay(0.5) }
    block_rect(x - 2.2, z - 0.3, x - 1.8, z + 0.3)
    block_rect(x + 1.8, z - 0.3, x + 2.2, z + 0.3)
  }
}

template FairyShroom : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  const well = ts[id] > 0
  Position: {x, 0, z}
  if well {
    stem : MvPetalWhite { Position: {0, 0.45, 0}; Cylinder: {length: 0.9, radius: 0.16, segments: 8} }
    cap { Position: {0, 0.9, 0}; Scale: {1, 0.7, 1}; HemiSphere: {radius: 0.65, segments: 12}; Rgb: {150, 90, 220}; Emissive: {strength: 1.2, color: {170, 110, 255}} }
    for k in 0..4 {
      const a = k * 1.57 + id
      "spot_{k}" : MvPetalWhite { Position: {sin(a) * 0.4, 1.1, cos(a) * 0.4}; Sphere: {radius: 0.07, segments: 5} }
    }
    glow { Position: {0, 1.2, 0}; PointLight: {intensity: 1.5, range: 5}; Rgb: {180, 120, 255} }
  } else {
    stem : MvAsh { Position: {0, 0.15, 0}; Rotation: {0.5, id, 0.3}; Cylinder: {length: 0.35, radius: 0.08, segments: 6} }
    cap : MvAsh { Position: {0.08, 0.25, 0.08}; Rotation: {0.9, id, 0}; Scale: {1, 0.5, 1}; HemiSphere: {radius: 0.25, segments: 8} }
  }
}

template Wisp {
  prop i: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  mut up = false
  const got = mote_got[i]
  if !got {
    Position: {x, match up { true: 1.6; _: 1.0 }, z}
    Transition: [Position: {duration: 1.3, timing_function: EaseInOut}]
    orb : MvSpirit { Position: {0, 0, 0}; Sphere: {radius: 0.22, segments: 10, smooth: true} }
    light { Position: {0, 0, 0}; PointLight: {intensity: 2, range: 5}; Rgb: {160, 220, 255} }
    glitter {
      Position: {0, 0, 0}
      ParticleEmitter: {max: 24, rate: 8, shape: EmitterSphere, radius: 0.35, direction: {0, 1, 0}, spread: 60, speed: {0.2, 0.5}, lifetime: {0.8, 1.5}, size: {0.05, 0.1}, opacity: {0.8, 1}, color: {180, 230, 255}, seed: i}
      ParticleAppearance: {blend: ParticleAdditive}
    }
  }
  async {
    while !mote_got[i] {
      up = !up
      await delay(1.3)
    }
  }
  async {
    m_x[i] = x
    m_z[i] = z
    while !mote_got[i] {
      await delay(0.1)
      if game_state == 1 && dist2(px, pz, x, z) < 1.6 * 1.6 {
        mote_got[i] = true
        emit Mote(i: i)
      }
    }
  }
}
