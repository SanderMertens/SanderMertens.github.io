}

template VineBridge : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  const built = ts[id] > 0
  Position: {x, 0, z}
  stub_a : MvOldWood { Position: {-5.2, 0.25, 0}; Box: {2.2, 0.3, 3.2} }
  stub_b : MvOldWood { Position: {5.2, 0.25, 0}; Box: {2.2, 0.3, 3.2} }
  post_a : MvTimber { Position: {-4.2, 0.8, 1.5}; Box: {0.25, 1.4, 0.25} }
  post_b : MvTimber { Position: {-4.2, 0.8, -1.5}; Box: {0.25, 1.4, 0.25} }
  post_c : MvTimber { Position: {4.2, 0.8, 1.5}; Box: {0.25, 1.4, 0.25} }
  post_d : MvTimber { Position: {4.2, 0.8, -1.5}; Box: {0.25, 1.4, 0.25} }
  if built {
    deck : MvLeafDark { Position: {0, 0.3, 0}; Box: {8.6, 0.3, 3.0} }
    for i in 0..9 {
      "plank_{i}" : MvWood { Position: {-4 + i, 0.47, 0}; Box: {0.7, 0.06, 2.8} }
    }
    rail_a : MvLeaf { Position: {0, 1.2, 1.5}; Rotation: {0, 0, HALF_PI}; Cylinder: {length: 8.6, radius: 0.12, segments: 6} }
    rail_b : MvLeaf { Position: {0, 1.2, -1.5}; Rotation: {0, 0, HALF_PI}; Cylinder: {length: 8.6, radius: 0.12, segments: 6} }
    for i in 0..5 {
      "flower_a_{i}" : MvPetalPink { Position: {-3.6 + i * 1.8, 1.3, 1.55}; Sphere: {radius: 0.14, segments: 6} }
      "flower_b_{i}" : MvPetalYellow { Position: {-2.7 + i * 1.8, 1.3, -1.55}; Sphere: {radius: 0.14, segments: 6} }
    }
  } else {
    plank_a : MvOldWood { Position: {-2.4, 0.0, 0.4}; Rotation: {0.2, 0.3, 0.3}; Box: {2.6, 0.15, 0.6} }
    plank_b : MvOldWood { Position: {1.5, -0.1, -0.6}; Rotation: {-0.2, -0.4, 0.1}; Box: {2.0, 0.15, 0.5} }
  }
  async {
    while !world_ready { await next_frame() }
    if ts[id] > 0 {
      unblock_rect(x - 6, z - 1.4, x + 6, z + 1.4)
    }
    while true {
      const e = await Progress
      if e.id == id {
        unblock_rect(x - 6, z - 1.4, x + 6, z + 1.4)
      }
    }
  }
}

