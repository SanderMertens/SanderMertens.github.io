template Fountain : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  const full = ts[id] > 0
  Position: {x, 0, z}
  step : MvStone { Position: {0, 0.1, 0}; Cylinder: {length: 0.2, radius: 3.5, segments: 32}; TextureTransform: {9, 0.15, 0, 0} }
  basin : MvStone { Position: {0, 0.55, 0}; Tube: {length: 0.7, radius: 3.0, thickness: 0.35, segments: 32}; TextureTransform: {8, 0.35, 0, 0} }
  rim : MvStone { Position: {0, 0.93, 0}; Torus: {radius: 2.83, tube: 0.2, segments: 40, rings: 6, smooth: true}; Rgb: {214, 206, 190}; TextureTransform: {8, 0.5, 0, 0} }
  floor_ : MvDarkStone { Position: {0, 0.25, 0}; Cylinder: {length: 0.1, radius: 2.7, segments: 28}; TextureTransform: {1.8, 1.8, 0, 0} }
  plinth : MvStone { Position: {0, 0.5, 0}; Cylinder: {length: 0.6, radius: 0.7, segments: 12}; TextureTransform: {2, 0.4, 0, 0} }
  column : MvStone { Position: {0, 0.5, 0}; Scale: {1.6, 1.0, 1.6}; Lathe: {profile: MvPostShape, cap_start: true, segments: 14, rings: 10}; Rgb: {214, 206, 190}; TextureTransform: {2, 2, 0, 0} }
  bowl : MvStone { Position: {0, 2.0, 0}; Lathe: {profile: MvBasinShape, cap_start: true, segments: 28, rings: 10}; Rgb: {214, 206, 190}; TextureTransform: {4, 1, 0, 0} }
  bowl_top : MvStone { Position: {0, 2.42, 0}; Scale: {0.45, 0.6, 0.45}; Lathe: {profile: MvBasinShape, cap_start: true, segments: 20, rings: 8}; Rgb: {214, 206, 190}; TextureTransform: {3, 1, 0, 0} }
  finial : MvStone { Position: {0, 2.7, 0}; Sphere: {radius: 0.16, segments: 12, smooth: true}; Rgb: {214, 206, 190} }
  for k in 0..4 {
    const a = k * HALF_PI + 0.785
    "spout_{k}" : MvBrass { Position: {cos(a) * 0.7, 0.75, sin(a) * 0.7}; Rotation: {0, 0 - a, 0}; Scale: {1, 1, 1}; Box: {0.32, 0.12, 0.12}; Bevel: {radius: 0.04, segments: 1} }
    "moss_{k}" : MvLeafDark { Position: {cos(a + 0.4) * 2.9, 0.98, sin(a + 0.4) * 2.9}; Scale: {0.5, 0.15, 0.35}; Sphere: {radius: 0.5, segments: 8, smooth: true} }
    "flower_pot_{k}" { Position: {cos(a) * 3.35, 0.2, sin(a) * 3.35}; Lathe: {profile: MvPotShape, cap_start: true, segments: 12, rings: 6}; Rgb: {186, 98, 64}; PbrMaterial: {roughness: 0.85} }
    "flower_bush_{k}" : MvLeaf { Position: {cos(a) * 3.35, 0.65, sin(a) * 3.35}; Sphere: {radius: 0.24, segments: 10, smooth: true} }
  }
  if full {
    water : MvWater { Position: {0, 0.82, 0}; Cylinder: {length: 0.05, radius: 2.68, segments: 32}; TextureTransform: {2, 2, 0, 0} }
    bowl_water : MvWater { Position: {0, 2.38, 0}; Cylinder: {length: 0.03, radius: 1.1, segments: 24} }
    for k in 0..4 {
      const a = k * HALF_PI + 0.785
      "stream_{k}" {
        Position: {cos(a) * 0.86, 0.75, sin(a) * 0.86}
        ParticleEmitter: {max: 40, rate: 30, shape: EmitterSphere, radius: 0.03, direction: {cos(a), 0.3, sin(a)}, spread: 6, speed: {1.2, 1.5}, lifetime: {0.3, 0.45}, size: {0.06, 0.1}, opacity: {0.5, 0.8}, acceleration: {0, -9, 0}, color: {210, 235, 255}, seed: 80 + k}
      }
    }
    jet {
      Position: {0, 2.9, 0}
      ParticleEmitter: {max: 160, rate: 70, shape: EmitterSphere, radius: 0.1, direction: {0, 1, 0}, spread: 22, speed: {2.5, 3.5}, lifetime: {0.8, 1.2}, size: {0.08, 0.14}, opacity: {0.6, 0.9}, acceleration: {0, -9, 0}, color: {200, 230, 255}, seed: 77}
    }
  }
  async { block_disc(x, z, 3.2) }
}

