template Beacon : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  mut fl = false
  const lit = ts[id] > 0
  Position: {x, 0, z}
  base : MvStone { Position: {0, 0.4, 0}; Cylinder: {length: 0.8, radius: 1.1, segments: 10} }
  bowl : MvBrass { Position: {0, 1.1, 0}; Frustum: {length: 0.6, radius_bottom: 0.6, radius_top: 1.0, segments: 12} }
  if lit {
    flame : MvFlame { Scale: {match fl { true: 1.06; _: 0.94 }, match fl { true: 1.18; _: 0.88 }, match fl { true: 1.06; _: 0.94 }}; Transition: [Scale: {duration: 0.14}]; Position: {0, 2.0, 0}; Cone: {length: 1.6, radius: 0.7, segments: 10} }
    light { Position: {0, 3, 0}; PointLight: {intensity: 14, range: 22}; Rgb: {255, 190, 110} }
    sparks {
      Position: {0, 1.8, 0}
      ParticleEmitter: {max: 60, rate: 20, shape: EmitterSphere, radius: 0.5, direction: {0, 1, 0}, spread: 18, speed: {1.5, 3}, lifetime: {0.6, 1.3}, size: {0.08, 0.18}, opacity: {0.8, 1}, color: {255, 190, 90}, color_variance: {0, 40, 30}, seed: 31}
      ParticleAppearance: {blend: ParticleAdditive}
    }
  }
  async { block_disc(x, z, 1.1) }
  async {
    while true {
      await delay(0.12 + fract(x * 0.7 + clock * 3.1) * 0.12)
      fl = !fl
    }
  }
}

