template Boulder : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  prop to_x: f32 = 0
  prop to_z: f32 = 0
  mut air = false
  const moved = ts[id] > 0
  rock {
    if moved {
      Position: {to_x - x, 0, to_z - z}
    } else {
      Position: {0, 0, 0}
    }
    Transition: [Position: {duration: 2.4, timing_function: EaseInOut}]
    lift {
      if air {
        Position: {0, 3, 0}
      } else {
        Position: {0, 0, 0}
      }
      Transition: [Position: {duration: 1.1, timing_function: EaseInOut}]
      stone : MvRock { Position: {0, 1.1, 0}; Rotation: {id, id * 2, 0}; Scale: {1.5, 1.1, 1.3}; IcoSphere: {radius: 1.2, segments: 1} }
      chip : MvDarkStone { Position: {0.9, 0.5, 0.6}; IcoSphere: {radius: 0.5, segments: 0} }
    }
  }
  async {
    while !world_ready { await next_frame() }
    block_disc(x, z, 1.8)
    while true {
      const e = await Progress
      if e.id == id {
        air = true
        unblock_rect(x - 2, z - 2, x + 2, z + 2)
        await delay(1.3)
        air = false
      }
    }
  }
}

template Sheep : Target {
  prop id: i32 = 0
  prop x: f32 = 0
  prop z: f32 = 0
  prop to_x: f32 = 0
  prop to_z: f32 = 0
  mut air = false
  mut graze = false
  const home = ts[id] > 0
  sheep {
    if home {
      Position: {to_x - x, 0, to_z - z}
      Rotation: {0, id * 1.7, 0}
    } else {
      Position: {0, 0, 0}
      Rotation: {0, id * 2.3, 0}
    }
    Transition: [Position: {duration: 3.0, timing_function: EaseInOut}]
    lift {
      if air {
        Position: {0, 4, 0}
      } else {
        Position: {0, 0, 0}
      }
      Transition: [Position: {duration: 1.2, timing_function: EaseInOut}]
      body : MvWool { Position: {0, 0.78, 0}; Scale: {0.95, 0.8, 1.25}; Sphere: {radius: 0.55, segments: 14, smooth: true} }
      for k in 0..9 {
        const a = k * 0.698 + id
        "puff_{k}" : MvWool { Position: {sin(a) * 0.42, 0.85 + fract(a * 1.7) * 0.25, cos(a) * 0.58}; Sphere: {radius: 0.24 + fract(a) * 0.08, segments: 10, smooth: true} }
      }
      top_puff : MvWool { Position: {0, 1.18, 0}; Scale: {1, 0.7, 1.4}; Sphere: {radius: 0.3, segments: 10, smooth: true} }
      head {
        Position: {0, match graze && !air { true: 0.55; _: 0.92 }, 0.72}
        Rotation: {match graze && !air { true: 0.9; _: 0.3 }, 0, 0}
        Transition: [Position: {duration: 0.6}, Rotation: {duration: 0.6}]
        face_ : MvDark { Position: {0, 0, 0.06}; Scale: {0.8, 0.9, 1.25}; Sphere: {radius: 0.2, segments: 12, smooth: true}; Rgb: {50, 44, 42} }
        tuft : MvWool { Position: {0, 0.16, -0.02}; Sphere: {radius: 0.15, segments: 10, smooth: true} }
        ear_a : MvDark { Position: {-0.19, 0.08, -0.02}; Rotation: {0, 0, 0.5}; Scale: {1.6, 0.5, 0.8}; Sphere: {radius: 0.08, segments: 8, smooth: true}; Rgb: {50, 44, 42} }
        ear_b : MvDark { Position: {0.19, 0.08, -0.02}; Rotation: {0, 0, -0.5}; Scale: {1.6, 0.5, 0.8}; Sphere: {radius: 0.08, segments: 8, smooth: true}; Rgb: {50, 44, 42} }
        eye_a : MvPetalWhite { Position: {-0.1, 0.05, 0.2}; Sphere: {radius: 0.035, segments: 6, smooth: true} }
        eye_b : MvPetalWhite { Position: {0.1, 0.05, 0.2}; Sphere: {radius: 0.035, segments: 6, smooth: true} }
        pupil_a : MvDark { Position: {-0.1, 0.05, 0.228}; Sphere: {radius: 0.018, segments: 5} }
        pupil_b : MvDark { Position: {0.1, 0.05, 0.228}; Sphere: {radius: 0.018, segments: 5} }
      }
      tail : MvWool { Position: {0, 0.95, -0.72}; Sphere: {radius: 0.12, segments: 8, smooth: true} }
      for l in 0..4 {
        const lx = match l % 2 { 0: -0.25; _: 0.25 }
        const lz = match l < 2 { true: -0.35; _: 0.35 }
        "leg_{l}" : MvDark { Position: {lx, 0.24, lz}; Capsule: {length: 0.32, radius: 0.06, segments: 6, smooth: true}; Rgb: {50, 44, 42} }
        "hoof_{l}" : MvDark { Position: {lx, 0.04, lz + 0.02}; Cylinder: {length: 0.08, radius: 0.07, segments: 8}; Rgb: {30, 26, 24} }
      }
    }
  }
  async {
    while true {
      const e = await Progress
      if e.id == id {
        air = true
        await delay(1.8)
        air = false
      }
    }
  }
  async {
    while true {
      await delay(1.5 + fract(id * 0.61 + clock * 0.3) * 3)
      graze = !graze
    }
  }
}

template RoofCat : Target {
