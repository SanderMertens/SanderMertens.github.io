event Talk(npc: i32)
event Mote(i: i32)
event Impact(spell: i32, x: f32, z: f32)
event Fizzle(x: f32, z: f32)

fn fract(v: f64) -> f64 {
  v - floor(v)
}

fn hash(i: f64) -> f64 {
  fract(sin(i * 12.9898 + 4.1414) * 43758.5453)
}

fn hash2(x: f64, z: f64) -> f64 {
  fract(sin(x * 12.9898 + z * 78.233) * 43758.5453)
}

fn bool_f(b: bool) -> f32 {
  match b { true: 1; _: 0 }
}

fn dist2(ax: f64, az: f64, bx: f64, bz: f64) -> f64 {
  (ax - bx) * (ax - bx) + (az - bz) * (az - bz)
}

fn cell(x: f64, z: f64) -> i32 {
  (floor(z) + GRID_HALF) * GRID_N + floor(x) + GRID_HALF
}

fn wrap_angle(a: f64) -> f64 {
  a - floor((a + PI) / (2 * PI)) * 2 * PI
}

fn spell_name(s: i32) -> string {
  match s {
    1: "Spark"
    2: "Splash"
    3: "Gust"
    4: "Bloom"
    5: "Frost"
    6: "Lift"
    _: ""
  }
}

fn spell_cost(s: i32) -> f32 {
  match s {
    1: 8
    2: 10
    3: 12
    4: 14
    5: 14
    6: 16
    _: 0
  }
}

fn spell_blurb(s: i32) -> string {
  match s {
    1: "A spark of flame. Lights lamps, ovens and braziers, and burns away weeds."
    2: "A splash of water. Waters thirsty plants and puts out fires."
    3: "A gust of wind. Turns sails, dries cloth, scatters leaves, fog and pests."
    4: "A breath of spring. Makes plants grow and wilted things green again."
    5: "A touch of winter. Freezes water and chills whatever needs cooling."
    6: "A lifting charm. Raises heavy things and carries them where they belong."
    _: ""
  }
}

fn spell_r(s: i32) -> f32 {
  match s { 1: 255; 2: 90; 3: 200; 4: 120; 5: 170; 6: 200; _: 255 }
}

fn spell_g(s: i32) -> f32 {
  match s { 1: 150; 2: 170; 3: 235; 4: 220; 5: 230; 6: 140; _: 255 }
}

fn spell_b(s: i32) -> f32 {
  match s { 1: 50; 2: 255; 3: 225; 4: 90; 5: 255; 6: 255; _: 255 }
}

fn npc_name(n: i32) -> string {
  match n {
    0: "Elder Bram"
    1: "Pella the Baker"
    2: "Mira the Herbalist"
    3: "Dorn the Smith"
    4: "Rosa of the Sleepy Toad"
    5: "Little Tam"
    6: "Farmer Oswin"
    7: "Granny Maud"
    8: "Gareth the Woodcutter"
    9: "Fennick the Hermit"
    10: "Old Lou"
    11: "Gruff the Miner"
    12: "Ada the Shepherd"
    _: ""
  }
}

fn rank_name(done: i32) -> string {
  match done >= 22 {
    true: "Archmage of Mossvale"
    _: match done >= 16 {
      true: "Village Wizard"
      _: match done >= 10 {
        true: "Hedge Mage"
        _: match done >= 4 {
          true: "Journeyman"
          _: "Apprentice"
        }
      }
    }
  }
}

