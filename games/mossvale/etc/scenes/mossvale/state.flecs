proc block_rect(x0: f32, z0: f32, x1: f32, z1: f32) {
  for z in floor(z0)..ceil(z1) {
    for x in floor(x0)..ceil(x1) {
      if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
        blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = true
      }
    }
  }
}

proc unblock_rect(x0: f32, z0: f32, x1: f32, z1: f32) {
  for z in floor(z0)..ceil(z1) {
    for x in floor(x0)..ceil(x1) {
      if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
        blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = false
      }
    }
  }
}

proc block_disc(cx: f32, cz: f32, r: f32) {
  for z in floor(cz - r)..ceil(cz + r) {
    for x in floor(cx - r)..ceil(cx + r) {
      if (x + 0.5 - cx) * (x + 0.5 - cx) + (z + 0.5 - cz) * (z + 0.5 - cz) <= r * r {
        if x >= -GRID_HALF && x < GRID_HALF && z >= -GRID_HALF && z < GRID_HALF {
          blocked[(z + GRID_HALF) * GRID_N + x + GRID_HALF] = true
        }
      }
    }
  }
}

proc say(text: string) {
  toast = text
  toast_until = clock + 4.5
}

proc announce(title: string, sub: string) {
  banner = title
  banner_sub = sub
  banner_until = clock + 4.5
}
