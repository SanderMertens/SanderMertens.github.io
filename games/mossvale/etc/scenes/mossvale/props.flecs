prefab mv_flicker {
  AnimationClip: {duration: 1.1}
  sx { AnimationTrack: {component: Scale, member: "x", curve: {kind: CurveCatmullRom, keys: [{0, 1}, {0.14, 1.06}, {0.3, 0.94}, {0.42, 1.05}, {0.6, 0.95}, {0.74, 1.06}, {0.92, 0.94}, {1.1, 1}]}} }
  sy { AnimationTrack: {component: Scale, member: "y", curve: {kind: CurveCatmullRom, keys: [{0, 1}, {0.14, 1.18}, {0.3, 0.88}, {0.42, 1.14}, {0.6, 0.9}, {0.74, 1.18}, {0.92, 0.88}, {1.1, 1}]}} }
  sz { AnimationTrack: {component: Scale, member: "z", curve: {kind: CurveCatmullRom, keys: [{0, 1}, {0.14, 1.06}, {0.3, 0.94}, {0.42, 1.05}, {0.6, 0.95}, {0.74, 1.06}, {0.92, 0.94}, {1.1, 1}]}} }
}

