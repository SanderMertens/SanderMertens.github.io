  tilt { AnimationTrack: {component: Rotation, member: "x", curve: {keys: [{0, 0.3}, {2.5, 0.3}, {3.1, 0.9}, {5.5, 0.9}, {6.1, 0.3}, {7, 0.3}, {7.6, 0.9}, {8.4, 0.9}, {9, 0.3}]}} }
}

