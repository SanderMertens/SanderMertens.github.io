fn impact_y(s: i32) -> f32 {
  match s { 6: 0.3; 3: 0.8; _: 0.7 }
}

async {
  while true {
    const e = await Impact
    const y = impact_y(e.spell)
    if e.spell == SP_SPARK {
      const b = box.particle.burst_at(SparkBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxSpark, {e.x, y, e.z}, 0.9)
    } else if e.spell == SP_SPLASH {
      const b = box.particle.burst_at(SplashBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxSplash, {e.x, y, e.z}, 0.9)
    } else if e.spell == SP_GUST {
      const b = box.particle.burst_at(GustBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxGust, {e.x, y, e.z}, 0.9)
    } else if e.spell == SP_BLOOM {
      const b = box.particle.burst_at(BloomBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxBloom, {e.x, y, e.z}, 0.8)
    } else if e.spell == SP_FROST {
      const b = box.particle.burst_at(FrostBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxFrost, {e.x, y, e.z}, 0.8)
    } else if e.spell == SP_LIFT {
      const b = box.particle.burst_at(LiftBurst, {e.x, y, e.z}, 1)
      const a = box.audio.play_at(SfxLift, {e.x, y, e.z}, 0.8)
    }
  }
}

async {
  while true {
    await CastReq
    if !casting {
      const a = box.audio.play(SfxCast, 0.5)
    }
  }
}

async {
  while true {
    const e = await Fizzle
    const b = box.particle.burst_at(FizzleBurst, {e.x, 2.4, e.z}, 1)
    const a = box.audio.play(SfxFizzle, 0.6)
  }
}

async {
  while true {
    await Talk
    const a = box.audio.play(SfxTalk, 0.6)
  }
}

async {
  while true {
    await Advance
    const a = box.audio.play(SfxTalk, 0.5)
  }
}

async {
  while true {
    const e = await Mote
    const b = box.particle.burst_at(MoteBurst, {px, 1.2, pz}, 1)
    const a = box.audio.play(SfxMote, 0.8)
  }
}

async {
  while true {
    await QuestDone
    const fx = box.particle.burst_at(QuestBurst, {px, 0.4, pz}, 1)
    const a = box.audio.play(jingle_c5, 0.7)
    await delay(0.12)
    const b = box.audio.play(jingle_e5, 0.7)
    await delay(0.12)
    const c = box.audio.play(jingle_g5, 0.7)
    await delay(0.12)
    const d = box.audio.play(jingle_c6, 0.8)
  }
}

async {
  while true {
    await Learn
    const fx = box.particle.burst_at(LearnBurst, {px, 1.5, pz}, 1)
    await delay(0.7)
    const a = box.audio.play(jingle_g5, 0.7)
    await delay(0.15)
    const b = box.audio.play(jingle_a5, 0.7)
    await delay(0.15)
    const c = box.audio.play(jingle_d6, 0.8)
  }
}

async {
  while true {
    await Ending
    await delay(3)
    for i in 0..40 {
      const ox = (hash(i * 31) - 0.5) * 30
      const oz = (hash(i * 17) - 0.5) * 20 - 6
      const oy = 14 + hash(i * 7) * 8
      const fx = box.particle.burst_at(Firework, {ox, oy, oz}, 1)
      const boom = box.audio.play(SfxSpark, 0.6)
      await delay(0.25 + hash(i * 3) * 0.5)
    }
  }
}

