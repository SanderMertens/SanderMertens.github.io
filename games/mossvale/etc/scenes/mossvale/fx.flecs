  air { SynthOscillator: {wave: SynthNoise, level: 0.18} }
}

prefab SfxSelect {
  AudioOutput: {bus: mv_ui}
  SynthSound: {pitch_variance: 0.02}
  SynthEnvelope: {attack: 0.002, decay: 0.12}
  SynthFilter: {kind: SynthLowPass, cutoff: 4000}
  ting { SynthOscillator: {wave: SynthTriangle, frequency: 1320, level: 0.25} }
  bell { SynthOscillator: {wave: SynthSine, frequency: 1980, level: 0.12} }
}

mv_water_sounds {
  for i in 0..9 {
    const zz = -88 + i * 22
    "river_{i}" {
      Position: {river_x(zz), 0.5, zz}
      AudioSource: {sound: SfxWater, loop: true, volume: 0.5}
      AudioSpatial: {min_distance: 4, max_distance: 22}
    }
  }
  lake_a {
    Position: {LAKE_X + 8, 0.5, LAKE_Z + 6}
    AudioSource: {sound: SfxWater, loop: true, volume: 0.3}
    AudioSpatial: {min_distance: 8, max_distance: 30}
  }
  wind {
    AudioSource: {sound: SfxWind, loop: true, volume: 0.6}
  }
}

async {
  mut last_step: i32 = 0
  while true {
    await next_frame()
    if moving {
      const k = floor(walk_phase / PI)
      if k != last_step {
        last_step = k
        const a = box.audio.play(SfxStep, match sprinting { true: 0.55; _: 0.4 })
      }
    }
  }
}

async {
  while true {
    await delay(1.2 + hash(clock * 3.7) * 3.5)
    if game_state >= 1 {
      const night = hour > 19 || hour < 6
      const ox = (hash(clock * 1.3) - 0.5) * 24
      const oz = (hash(clock * 2.1) - 0.5) * 16
      if night {
        for i in 0..3 {
          const c = box.audio.play_at(SfxCricket, {px + ox, 0.3, pz + oz}, 0.5)
          await delay(0.06)
        }
      } else if pz > WALL_N1 + 2 || hash(clock) > 0.5 {
        if hash(clock * 5.1) > 0.45 {
          const n = 2 + floor(hash(clock * 7.7) * 3)
          for i in 0..n {
            const c = box.audio.play_at(SfxBirdA, {px + ox, 3, pz + oz}, 0.6)
            await delay(0.11 + hash(i + clock) * 0.06)
          }
        } else {
          const c = box.audio.play_at(SfxBirdB, {px + ox, 3, pz + oz}, 0.5)
          await delay(0.3)
          const d = box.audio.play_at(SfxBirdB, {px + ox, 3, pz + oz}, 0.4)
        }
      }
    }
  }
}

async {
  while true {
    await PickSpell
    const a = box.audio.play(SfxSelect, 0.5)
  }
}
