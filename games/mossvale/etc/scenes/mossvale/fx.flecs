template Note {
  prop f: f32 = 440
  prop len: f32 = 0.5
  AudioOutput: {bus: mv_ui}
  SynthSound: {}
  SynthEnvelope: {attack: 0.01, decay: 0.1, sustain: 0.6, hold: len, release: 0.35}
  SynthFilter: {kind: SynthLowPass, cutoff: 3600, resonance: 0.15}
  lead { SynthOscillator: {wave: SynthTriangle, frequency: f, level: 0.35} }
  air { SynthOscillator: {wave: SynthSine, frequency: f * 2, level: 0.1} }
}

Note jingle_c5(f: 523.25, len: 0.08)
Note jingle_e5(f: 659.25, len: 0.08)
Note jingle_g5(f: 783.99, len: 0.08)
Note jingle_c6(f: 1046.5, len: 0.4)
Note jingle_a5(f: 880, len: 0.08)
Note jingle_d6(f: 1174.66, len: 0.5)

