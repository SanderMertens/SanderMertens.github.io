using flecs.script
using flecs.script.math
using box.transform
using box.transition
using box.light
using box.geometry
using box.material
using box.particle
using state
using assets

mossvale {
  ground : MvGrassGround { Position: {0, -0.5, 0}; Box: {GROUND_SPAN, 1, GROUND_SPAN} }

  water {
    river_bank : MvSand { Position: {0, 0, 0}; Sweep: {path: MV_RIVER, profile: MvRoadProfile, scale: {8.8, 0.03}, rings: 256}; TextureMapping: {mode: MappingObject, size: 5}; TextureTransform: {1, 1, 0, 0} }
    river : MvWater { Position: {0, 0, 0}; Sweep: {path: MV_RIVER, profile: MvRoadProfile, scale: {6.2, 0.06}, rings: 256}; TextureMapping: {mode: MappingObject, size: 8}; TextureTransform: {1, 1, 0, 0} }
    lake_bank : MvSand { Position: {LAKE_X, 0.019, LAKE_Z}; Cylinder: {length: 0.01, radius: LAKE_R + 1.8, segments: 48}; TextureTransform: {(LAKE_R + 1.8) * 2 / 5, (LAKE_R + 1.8) * 2 / 5, 0, 0} }
    lake_shallow : MvSand { Position: {LAKE_X, 0.031, LAKE_Z}; Cylinder: {length: 0.01, radius: LAKE_R + 0.6, segments: 48}; Rgb: {200, 196, 150}; TextureTransform: {(LAKE_R + 0.6) * 2 / 5, (LAKE_R + 0.6) * 2 / 5, 0, 0} }
    lake : MvWater { Position: {LAKE_X, 0.047, LAKE_Z}; Cylinder: {length: 0.01, radius: LAKE_R, segments: 48}; TextureTransform: {LAKE_R * 2 / 5, LAKE_R * 2 / 5, 0, 0} }
    lake_deep : MvDeepWater { Position: {LAKE_X, 0.052, LAKE_Z}; Cylinder: {length: 0.01, radius: LAKE_R - 5, segments: 40}; TextureTransform: {(LAKE_R - 5) * 2 / 5, (LAKE_R - 5) * 2 / 5, 0, 0} }
    lake_glints {
      Position: {LAKE_X, 0.2, LAKE_Z}
      ParticleEmitter: {max: 60, rate: 14, shape: EmitterDisc, radius: LAKE_R - 1, direction: {0, 1, 0}, speed: {0, 0.05}, lifetime: {0.6, 1.4}, size: {0.15, 0.3}, opacity: {0.6, 1}, color: {255, 250, 230}, seed: 61}
      ParticleAppearance: {blend: ParticleAdditive}
      ParticleCurves: {opacity: {keys: [{0, 0}, {0.5, 1}, {1, 0}]}}
    }
    for i in 0..12 {
      const zz = -90 + i * 16
      "river_glint_{i}" {
        Position: {river_x(zz), 0.2, zz}
        ParticleEmitter: {max: 16, rate: 4, shape: EmitterBox, extents: {2.4, 0, 7}, direction: {0, 0, 1}, speed: {0.6, 1.2}, lifetime: {0.6, 1.4}, size: {0.12, 0.25}, opacity: {0.6, 1}, color: {255, 250, 230}, seed: 70 + i}
        ParticleAppearance: {blend: ParticleAdditive}
        ParticleCurves: {opacity: {keys: [{0, 0}, {0.5, 1}, {1, 0}]}}
      }
      "river_rock_{i}" : MvRock { Position: {river_x(zz) + match i % 2 { 0: 3.6; _: -3.6 }, 0.15, zz + 3}; Rotation: {i, i, 0}; Scale: {0.7, 0.4, 0.6}; IcoSphere: {radius: 1, segments: 0} }
    }
    isle_sand : MvSand { Position: {ISLE_X, 0.15, ISLE_Z}; Cylinder: {length: 0.3, radius: ISLE_R + 0.6, segments: 24} }
    isle : MvGrass { Position: {ISLE_X, 0.2, ISLE_Z}; Cylinder: {length: 0.4, radius: ISLE_R, segments: 24} }
  }

  forest {
    for j in 0..19 {
      for i in 0..39 {
        if tree_here(i, j) {
          const h = hash2(i * 3.3, j * 7.1)
          Tree "t_{i}_{j}"(seed: h, kind: h < 0.4 ? 1 : h > 0.92 ? 3 : h > 0.8 ? 2 : 0, s: 1.15) {
            Position: {tree_x(i, j), 0, tree_z(i, j)}
          }
        }
      }
    }
    for i in 0..44 {
      const x = -40 + i * 3.1
      if abs(x - road_x(-33)) > 4 {
        Bush "hedge_a_{i}"(seed: i * 0.13, s: 1.6) { Position: {x, 0, -31.2} }
      }
    }
    for i in 0..30 {
      const a = i * 0.7
      Mushroom "m_{i}"(s: 1 + fract(a) * 0.8) { Position: {-38 + fract(a * 3.7) * 130, 0, -90 + fract(a * 1.3) * 45} }
    }
  }

  hills {
    for j in 0..14 {
      for i in 0..29 {
        if rock_here(i, j) {
          const h = hash2(i * 1.3, j * 2.7)
          const wall = rock_z(i, j) < WALL_S1 + 1
          Rock "r_{i}_{j}"(seed: h, s: wall ? 1.7 + h * 0.6 : 1.1 + h * 0.8) { Position: {rock_x(i, j), 0, rock_z(i, j)} }
        }
      }
    }
    for j in 0..14 {
      for i in 0..29 {
        const x = rock_x(i, j) + 2.2
        const z = rock_z(i, j) + 1.6
        const h = hash2(i * 5.3, j * 1.9)
        if h > 0.86 && !hills_clear(x, z) && z > WALL_S1 + 2 && x < 92 && z < 92 {
          Tree "p_{i}_{j}"(seed: h, kind: 1, s: 0.9) { Position: {x, 0, z} }
        }
      }
    }
    for i in 0..44 {
      const x = -40 + i * 3.1
      if abs(x - road_x(33)) > 4 {
        "cliff_{i}" : MvCliff { Position: {x, 0.8, 32.5 + fract(i * 0.37) * 2}; Rotation: {0, i, 0}; Scale: {2.2, 1.4 + fract(i * 0.61), 1.6}; IcoSphere: {radius: 1, segments: 0} }
      }
    }
  }

  square_detail {
    Position: {SQ_X, 0, SQ_Z}
    band_w : MvStone { Position: {-7.6, 0.061, 0}; Box: {6.8, 0.01, 1.0}; TextureMapping: {mode: MappingWorld, size: TILE_FLAGS} }
    band_e : MvStone { Position: {7.6, 0.061, 0}; Box: {6.8, 0.01, 1.0}; TextureMapping: {mode: MappingWorld, size: TILE_FLAGS} }
    band_n : MvStone { Position: {0, 0.061, -4.7}; Box: {1.0, 0.01, 3.0}; TextureMapping: {mode: MappingWorld, size: TILE_FLAGS} }
    band_s : MvStone { Position: {0, 0.061, 4.7}; Box: {1.0, 0.01, 3.0}; TextureMapping: {mode: MappingWorld, size: TILE_FLAGS} }
    ring_a : MvStone { Position: {0, 0.062, 0}; Tube: {length: 0.01, radius: 4.6, thickness: 0.45, segments: 48}; TextureMapping: {mode: MappingWorld, size: TILE_FLAGS} }
  }

  road_edges {
    for i in 0..58 {
      const zz = -82 + i * 3
      const side = match i % 2 { 0: 1; _: -1 }
      if !in_village(road_x(zz), zz) && hash(i * 9.1) > 0.3 {
        "ns_stone_{i}" : MvRock { Position: {road_x(zz) + side * (3.3 + hash(i) * 0.4), 0.12, zz}; Rotation: {i, i * 2, 0}; Scale: {0.4, 0.25, 0.35}; IcoSphere: {radius: 1, segments: 0} }
      }
    }
    for i in 0..50 {
      const xx = -58 + i * 3
      const side = match i % 2 { 0: 1; _: -1 }
      if !in_village(xx, road_z(xx)) && abs(xx - river_x(0)) > 6 && hash(i * 5.3) > 0.3 {
        "ew_stone_{i}" : MvRock { Position: {xx, 0.12, road_z(xx) + side * (3.3 + hash(i) * 0.4)}; Rotation: {i, i * 3, 0}; Scale: {0.4, 0.25, 0.35}; IcoSphere: {radius: 1, segments: 0} }
      }
    }
    for i in 0..116 {
      const zz = -84 + i * 1.5 + hash(i * 0.7) * 0.8
      const side = match i % 2 { 0: 1; _: -1 }
      if !in_village(road_x(zz), zz) && hash(i * 1.9 + 4) > 0.35 {
        Tuft "ns_tuft_{i}"(seed: hash(i * 2.3)) { Position: {road_x(zz) + side * (2.6 + hash(i * 3.7) * 1.2), 0, zz} }
      }
    }
    for i in 0..100 {
      const xx = -58 + i * 1.5 + hash(i * 0.9) * 0.8
      const side = match i % 2 { 0: 1; _: -1 }
      if !in_village(xx, road_z(xx)) && abs(xx - river_x(0)) > 6 && hash(i * 2.9 + 1) > 0.35 {
        Tuft "ew_tuft_{i}"(seed: hash(i * 1.7)) { Position: {xx, 0, road_z(xx) + side * (2.6 + hash(i * 5.1) * 1.2)} }
      }
    }
  }

  meadow {
    for i in 0..320 {
      const x = -40 + hash(i * 1.37 + 11) * 134
      const z = -29 + hash(i * 2.53 + 17) * 58
      if !on_road(x, z) && !in_village(x, z) && abs(x - river_x(z)) > 5 {
        Tuft "gt_{i}"(seed: hash(i * 3.1)) { Position: {x, 0, z} }
      }
    }
    for i in 0..140 {
      const x = -40 + hash(i * 1.7) * 134
      const z = -29 + hash(i * 2.9 + 3) * 58
      if !on_road(x, z) && !in_village(x, z) && !in_farm(x, z) && !in_river(x, z) && abs(x - river_x(z)) > 4 {
        if i % 3 == 0 {
          Flowers "f_{i}"(seed: hash(i)) { Position: {x, 0, z} }
        } else {
          Tuft "g_{i}"(seed: hash(i)) { Position: {x, 0, z} }
        }
      }
    }
    for i in 0..60 {
      const x = -96 + hash(i * 4.1) * 50
      const z = -94 + hash(i * 3.3 + 1) * 188
      if !near_lake(x, z, 2.5) && abs(x - river_x(z)) > 5 && !(abs(z - road_z(x)) < 3) && dist2(x, z, -78, 44) > 64 {
        if i % 4 == 0 {
          Tree "wt_{i}"(seed: hash(i * 7), kind: match i % 8 { 0: 2; _: 0 }) { Position: {x, 0, z} }
        } else if i % 4 == 1 {
          Bush "wb_{i}"(seed: hash(i * 5)) { Position: {x, 0, z} }
        } else {
          Flowers "wf_{i}"(seed: hash(i * 3)) { Position: {x, 0, z} }
        }
      }
    }
    for i in 0..24 {
      const a = i * 0.26
      const r = LAKE_R + 0.6 + fract(i * 0.37) * 1.2
      if !(abs(sin(a) * r + LAKE_Z - 4) < 3 && cos(a) > 0) {
        Reeds "reeds_{i}"(seed: i * 0.31) { Position: {LAKE_X + cos(a) * r, 0, LAKE_Z + sin(a) * r} }
      }
    }
    for i in 0..18 {
      const x = -36 + i * 7.5 + hash(i) * 3
      if x < 92 && abs(x - road_x(0)) > 6 && !(x > -36 && x < 30) {
        Tree "edge_n_{i}"(seed: hash(i * 2), kind: 0) { Position: {x, 0, -27 + hash(i * 3) * 2} }
      }
    }
  }

  border {
    for i in 0..56 {
      const t = i * 3.6 - 100
      Tree "bn_{i}"(seed: hash(i), kind: 1, s: 1.3) { Position: {t, 0, -99 - hash(i * 3) * 4} }
      Tree "bs_{i}"(seed: hash(i + 9), kind: 1, s: 1.3) { Position: {t, 0, 99 + hash(i * 5) * 4} }
      Tree "be_{i}"(seed: hash(i + 17), kind: match i % 3 { 0: 1; _: 0 }, s: 1.3) { Position: {99 + hash(i * 7) * 4, 0, t} }
      Tree "bw_{i}"(seed: hash(i + 23), kind: match i % 3 { 0: 1; _: 0 }, s: 1.3) { Position: {-99 - hash(i * 11) * 4, 0, t} }
    }
    for i in 0..24 {
      const a = i * 0.2618
      "mount_{i}" : MvHillGrass { Position: {cos(a) * 170, -18, sin(a) * 170}; Rotation: {0, i, 0}; Scale: {50, 40 + hash(i) * 30, 50}; IcoSphere: {radius: 1, segments: 3, smooth: true}; Rgb: {150 + hash(i * 2) * 20, 162, 96}; TextureTransform: {8, 5, 0, 0} }
    }
  }

  village {
    Well well(x: -29.4, z: -13.6)
    Stall stall_a(x: 8.6, z: -6.0, cloth: 0, rot: -0.3)
    Stall stall_b(x: -7.0, z: -6.2, cloth: 1, rot: 0.3)
    Stall stall_c(x: -7.6, z: -11.2, cloth: 2, rot: 0.5)
    Bench bench_a { Position: {-2.4, 0.06, -3.6}; Rotation: {0, 3.14, 0} }
    Bench bench_b { Position: {4.6, 0.06, -3.6}; Rotation: {0, 3.14, 0} }
    Bench bench_c { Position: {-26.4, 0.06, -11.4}; Rotation: {0, 3.14, 0} }
    Bench bench_d { Position: {-4.0, 0.05, 15.4}; Rotation: {0, 3.14, 0} }
    Signpost sign_v { Position: {11.8, 0, 3.6} }
    Barrel barrel_a { Position: {-25.2, 0.05, -3.9} }
    Barrel barrel_b { Position: {19.2, 0.05, 3.8} }
    Barrel barrel_c { Position: {-12.8, 0.05, -3.9} }
    Crate crate_a { Position: {12.8, 0.05, -3.9} }
    Crate crate_b(s: 0.5) { Position: {12.9, 0.75, -3.9} }
    Crate crate_c { Position: {-35.4, 0, 11.0}; Rotation: {0, 0.4, 0} }
    Woodpile smithy_wood { Position: {14.4, 0, 11.4}; Rotation: {0, HALF_PI, 0} }
    anvil : MvIron { Position: {13.6, 0.5, 3.7}; Box: {1.0, 0.5, 0.5} }
    anvil_base : MvDarkStone { Position: {13.6, 0.25, 3.7}; Box: {0.6, 0.4, 0.4} }
    HayBale yard_hay { Position: {29.0, 0.02, 4.8}; Rotation: {0, 0.3, 0} }
    Cart cart_a { Position: {31.0, 0, -3.8}; Rotation: {0, 0.2, 0} }
    Fence garden_n_a(len: 5.4) { Position: {-35.8, 0, 16.5} }
    Fence garden_n_b(len: 5.8) { Position: {-28.4, 0, 16.5} }
    Fence garden_s(len: 13) { Position: {-32, 0, 27.5} }
    Fence garden_w(len: 11) { Position: {-38.5, 0, 22}; Rotation: {0, HALF_PI, 0} }
    Fence garden_e(len: 11) { Position: {-25.5, 0, 22}; Rotation: {0, HALF_PI, 0} }
    Fence yard_e(len: 7.6) { Position: {30.6, 0, 7.6}; Rotation: {0, HALF_PI, 0} }
    Fence yard_s(len: 10.4) { Position: {25.4, 0, 11.4} }
    Tree v_tree_a(seed: 0.31, kind: 0) { Position: {-33.5, 0, -28.6} }
    Tree v_tree_b(seed: 0.57, kind: 2) { Position: {-13, 0, -28.8} }
    Tree v_tree_c(seed: 0.73, kind: 0) { Position: {9, 0, -28.4} }
    Tree v_tree_d(seed: 0.11, kind: 3) { Position: {25, 0, -28.8} }
    Tree v_tree_e(seed: 0.23, kind: 0) { Position: {-20, 0, 29.0} }
    Tree v_tree_f(seed: 0.47, kind: 2) { Position: {1.4, 0, 29.2} }
    Tree v_tree_g(seed: 0.83, kind: 0) { Position: {17, 0, 29.4} }
    Tree v_tree_h(seed: 0.64, kind: 0) { Position: {-36.6, 0, 30.2} }
    Bush v_bush_a(seed: 0.12) { Position: {-24.4, 0, -23.6} }
    Bush v_bush_b(seed: 0.52) { Position: {12.4, 0, -23.4} }
    Bush v_bush_c(seed: 0.33) { Position: {19.4, 0, 24.0} }
    Bush v_bush_d(seed: 0.78) { Position: {-8.4, 0, 24.2} }
    Bush v_bush_e(seed: 0.91) { Position: {-36.6, 0, -24.0} }
    Flowers v_flow_a(seed: 0.2) { Position: {-14.6, 0, 15.8} }
    Flowers v_flow_b(seed: 0.6) { Position: {10.2, 0, -17.0} }
    Flowers v_flow_c(seed: 0.8) { Position: {-20.4, 0, -3.8} }
    Flowers v_flow_d(seed: 0.4) { Position: {-30.4, 0, 3.8} }
    Flowers v_flow_e(seed: 0.7) { Position: {23.4, 0, -3.8} }
    Flowers v_flow_f(seed: 0.15) { Position: {-1.0, 0, 23.6} }
    for i in 0..18 {
      const ang = i * 2.4
      const gx = match i % 6 { 0: -34.0; 1: -19.0; 2: 4.0; 3: 18.0; 4: -6.0; _: 27.0 }
      const gz = match i % 3 { 0: -23.8; 1: 23.8; _: 28.6 }
      Tuft "v_tuft_{i}"(seed: hash(i * 2.1)) { Position: {gx + cos(ang) * 1.6, 0, gz + sin(ang) * 0.6} }
    }
  }

  farm {
    for i in 0..13 {
      const z = -28 + i * 4.6
      if abs(z - road_z(33)) > 3.5 {
        Fence "west_fence_{i}"(len: 4.6) { Position: {33, 0, z + 2.3}; Rotation: {0, HALF_PI, 0} }
      }
    }
    wheat_field : MvWheat { Position: {50, 0.03, -25}; Box: {20, 0.06, 6} }
    for i in 0..10 {
      "wheat_{i}" : MvWheat { Position: {41 + i * 2, 0.5, -25}; Box: {1.2, 1.0, 5.5} }
    }
    Scarecrow scarecrow { Position: {47.5, 0, 12.5} }
    HayBale hay_a { Position: {72, 0, -8}; Rotation: {0, 0.4, 0} }
    HayBale hay_b { Position: {73.5, 0, -6} }
    Cart farm_cart { Position: {58, 0, -6}; Rotation: {0, -0.4, 0} }
    Pen chicken_pen(w: 6, d: 5) { Position: {40, 0, -6} }
    for i in 0..5 {
      "chick_{i}" { Position: {38.5 + fract(i * 0.71) * 3, 0.25, -7 + fract(i * 0.37) * 2.5}; Scale: {1, 1, 1.2}; Sphere: {radius: 0.25, segments: 8}; Rgb: {250, 248, 240}; PbrMaterial: {roughness: 0.9} }
    }
    for i in 0..6 {
      Tree "orchard_{i}"(seed: 0.5 + i * 0.07, kind: 0, s: 0.75) { Position: {86 + (i % 2) * 5, 0, -24 + floor(i / 2) * 5} }
    }
  }

  lakeside {
    Dock dock(x: -59, z: 4, len: 7)
    Boat boat_a { Position: {-62.5, 0.05, 0.5}; Rotation: {0, 1.4, 0} }
    Woodpile camp_wood { Position: {-17, 0, -65}; Rotation: {0, 0.4, 0} }
    Tower stargazer(x: -77.5, z: -9.5)
    Barrel lou_barrel { Position: {-53, 0, 9} }
    Crate lou_crate { Position: {-52, 0, 10.5} }
    Signpost sign_w { Position: {-49, 0, -3.5} }
  }

  shrine {
    for i in 0..9 {
      const a = i * 0.698 + 0.2
      if abs(sin(a) * 9.5 + 8) > 2.5 || cos(a) > 0 {
        "menhir_{i}" : MvStone { Position: {18 + cos(a) * 9.5, 1.3, -80 + sin(a) * 9.5}; Rotation: {0.05 * sin(i), a, 0.06 * cos(i)}; Box: {1.0, 2.6 + fract(i * 0.37) * 1.2, 0.7} }
      }
    }
    altar : MvStone { Position: {18, 0.45, -80}; Box: {2.4, 0.9, 1.4} }
    altar_top : MvDarkStone { Position: {18, 0.95, -80}; Box: {2.6, 0.12, 1.6} }
    crystal { Position: {18, 1.6, -80}; Rotation: {0, 0.6, 0}; Scale: {1, 2, 1}; IcoSphere: {radius: 0.35, segments: 0}; Rgb: {170, 220, 255}; Emissive: {strength: 2, color: {140, 210, 255}} }
  }

  forest_detail {
    for i in 0..36 {
      const x = -38 + hash(i * 3.9 + 1) * 130
      const z = -92 + hash(i * 7.3 + 4) * 50
      if !on_ns_road(x, z) && x < 92 {
        "fern_{i}" {
          Position: {x, 0, z}
          Rotation: {0, i, 0}
          for k in 0..5 {
            const a = k * 1.256
            "frond_{k}" : MvLeafLight { Position: {sin(a) * 0.35, 0.3, cos(a) * 0.35}; Rotation: {cos(a) * 0.9, 0, 0 - sin(a) * 0.9}; Scale: {0.4, 1, 0.12}; Cone: {length: 0.9, radius: 0.5, segments: 4} }
          }
        }
      }
    }
    for i in 0..9 {
      const x = -36 + hash(i * 5.7 + 3) * 126
      const z = -90 + hash(i * 2.9 + 8) * 46
      if !on_ns_road(x, z) && !forest_clear(x, z) {
        "log_{i}" : MvBark { Position: {x, 0.35, z}; Rotation: {0, i * 1.3, HALF_PI}; Cylinder: {length: 3 + hash(i) * 2, radius: 0.35, segments: 8} }
      }
    }
  }

  hill_flowers {
    for i in 0..70 {
      const x = -38 + hash(i * 2.7 + 9) * 128
      const z = 42 + hash(i * 4.9 + 1) * 50
      if !hills_clear(x, z) || pasture_spot(x, z) {
        "hf_{i}" {
          Position: {x, 0, z}
          for k in 0..4 {
            const a = i + k * 1.57
            "s_{k}" : MvLeaf { Position: {sin(a) * 0.3, 0.12, cos(a) * 0.3}; Box: {0.04, 0.24, 0.04} }
            "b_{k}" : MvPetalYellow { Position: {sin(a) * 0.3, 0.26, cos(a) * 0.3}; Sphere: {radius: 0.08, segments: 5} }
          }
        }
      }
    }
  }

  south {
    Pen sheep_pen(w: 10, d: 8) { Position: {-16, 0, 56} }
    MineMouth mine(x: 30, z: 51)
    quarry_pit : MvCliff { Position: {14, -0.2, 73}; Scale: {5, 1, 3}; IcoSphere: {radius: 1, segments: 1} }
    quarry_rock_a : MvRock { Position: {38, 1.0, 72}; Scale: {3, 2, 2.5}; IcoSphere: {radius: 1, segments: 0} }
    quarry_blocks {
      for i in 0..4 {
        "b_{i}" : MvStone { Position: {29 + i * 1.6, 0.6, 72}; Box: {1.2, 1.2, 1.2} }
      }
    }
    Tower watch(x: -30, z: 86)
    Signpost sign_s { Position: {7.8, 0, 30.0} }
  }

  targets {
    Hearth hearth(id: 0, q: Q_HEARTH, sp: SP_SPARK, x: -5.0, z: 18.8, hint: "The hearth needs fire. Choose Spark with 1.")

    const lx = [-9.0, 10.6, -9.0, 10.6, -5.0, 2.6]
    const lz = [-4.0, -4.0, -13.8, -13.8, -14.4, -14.4]
    for i in 0..6 {
