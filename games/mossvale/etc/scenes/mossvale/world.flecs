async {
  for z in 0..200 {
    for x in 0..200 {
      const wx = x - 100 + 0.5
      const wz = z - 100 + 0.5
      if in_water(wx, wz) {
        blocked[z * GRID_N + x] = true
      }
    }
  }
  for j in 0..19 {
    for i in 0..39 {
      if tree_here(i, j) {
        block_disc(tree_x(i, j), tree_z(i, j), 0.7)
      }
    }
  }
  for j in 0..14 {
    for i in 0..29 {
      if rock_here(i, j) {
        block_disc(rock_x(i, j), rock_z(i, j), 1.2)
      }
    }
  }
  for i in 0..9 {
    const a = i * 0.698 + 0.2
    if abs(sin(a) * 9.5 + 8) > 2.5 || cos(a) > 0 {
      block_disc(18 + cos(a) * 9.5, -80 + sin(a) * 9.5, 0.6)
    }
  }
  block_rect(16.8, -80.8, 19.2, -79.2)
  block_rect(-48, WALL_N0, road_x(-36) - 3, WALL_N1)
  block_rect(road_x(-36) + 3, WALL_N0, 100, WALL_N1)
  block_rect(-48, WALL_S0, road_x(36) - 3, WALL_S1)
  block_rect(road_x(36) + 3, WALL_S0, 100, WALL_S1)
  world_ready = true
}
