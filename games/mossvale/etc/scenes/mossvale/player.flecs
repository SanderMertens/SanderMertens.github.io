mossvale {
  mage {
    Mage body() {
      Scale: {1.15, 1.15, 1.15}
    }
  }

  reticle {
    if aim_on && game_state == 1 && talk_npc < 0 {
      Position: {aim_x, 0.08, aim_z}
      ring { Position: {0, 0, 0}; Torus: {radius: 0.9, tube: 0.05, segments: 28, rings: 4}; Rgb: {spell_r(spell), spell_g(spell), spell_b(spell)}; Emissive: {strength: 1.5, color: {spell_r(spell), spell_g(spell), spell_b(spell)}}; NoShadow }
    }
  }

  target_ring {
    if aim_target >= 0 && game_state == 1 && talk_npc < 0 {
      Position: {t_x[aim_target], 0.1, t_z[aim_target]}
      ring { Position: {0, 0, 0}; Torus: {radius: 1.3, tube: 0.06, segments: 28, rings: 4}; Rgb: {255, 240, 200}; Emissive: {strength: 1.2, color: {255, 230, 170}}; NoShadow }
    }
  }

  orb {
    if orb_on {
      Position: {orb_x, orb_y, orb_z}
      ball { Position: {0, 0, 0}; Sphere: {radius: 0.25, segments: 10, smooth: true}; Rgb: {spell_r(orb_spell), spell_g(orb_spell), spell_b(orb_spell)}; Emissive: {strength: 5, color: {spell_r(orb_spell), spell_g(orb_spell), spell_b(orb_spell)}}; NoShadow }
      light { Position: {0, 0, 0}; PointLight: {intensity: 4, range: 7}; Rgb: {spell_r(orb_spell), spell_g(orb_spell), spell_b(orb_spell)} }
      trail {
        Position: {0, 0, 0}
        ParticleEmitter: {max: 60, rate: 120, shape: EmitterSphere, radius: 0.12, direction: {0, 0, 0}, speed: {0, 0.2}, lifetime: {0.2, 0.4}, size: {0.12, 0.22}, opacity: {0.7, 1}, color: {spell_r(orb_spell), spell_g(orb_spell), spell_b(orb_spell)}, seed: 3}
        ParticleAppearance: {blend: ParticleAdditive}
        ParticleCurves: {size: {keys: [{0, 1}, {1, 0.2}]}}
      }
    }
  }

  ambient_fx {
    const night = hour > 19 || hour < 5.5
    const forest = pz < WALL_N1
    const hills = pz > WALL_S0
    Position: {px, 0, pz}
    if game_state >= 1 {
      if night {
        fireflies {
          Position: {0, 1.2, -2}
          ParticleEmitter: {max: 60, rate: 5, shape: EmitterBox, extents: {16, 1, 11}, direction: {1, 0, 0}, spread: 180, speed: {0.2, 0.5}, lifetime: {3, 5}, size: {0.1, 0.16}, opacity: {1, 1}, color: {210, 255, 120}, color_variance: {20, 0, 30}, seed: 5}
          ParticleAppearance: {blend: ParticleAdditive}
          ParticleCurves: {opacity: {keys: [{0, 0}, {0.2, 1}, {0.35, 0.2}, {0.5, 1}, {0.7, 0.3}, {0.85, 1}, {1, 0}]}}
          ParticleMotion: {velocity_y: {keys: [{0, 0.2}, {0.25, -0.2}, {0.5, 0.25}, {0.75, -0.15}, {1, 0.1}]}}
        }
      } else if forest {
        leaves {
          Position: {0, 8, -2}
          ParticleEmitter: {max: 70, rate: 7, shape: EmitterBox, extents: {16, 1, 11}, direction: {0, -1, 0}, spread: 20, speed: {0.6, 1.0}, lifetime: {6, 9}, size: {0.14, 0.22}, opacity: {1, 1}, color: {200, 140, 60}, color_variance: {50, 50, 20}, seed: 7}
          ParticleAppearance: {lit: 0.7}
          ParticleMotion: {velocity_x: {keys: [{0, 0.6}, {0.25, -0.6}, {0.5, 0.6}, {0.75, -0.6}, {1, 0.6}]}}
          ParticleCurves: {opacity: {keys: [{0, 0}, {0.1, 1}, {0.9, 1}, {1, 0}]}}
        }
      } else if !hills {
        butterflies {
          Position: {0, 0.9, -2}
          ParticleEmitter: {max: 24, rate: 1.4, shape: EmitterBox, extents: {16, 0.4, 11}, direction: {1, 0, 0}, spread: 180, speed: {0.5, 1.0}, lifetime: {5, 8}, size: {0.18, 0.24}, opacity: {1, 1}, color: {240, 200, 120}, color_variance: {20, 60, 120}, seed: 9}
          ParticleAppearance: {lit: 0.6}
          ParticleMotion: {velocity_y: {keys: [{0, 0.5}, {0.08, -0.4}, {0.16, 0.5}, {0.24, -0.4}, {0.32, 0.5}, {0.4, -0.4}, {0.48, 0.5}, {0.56, -0.4}, {0.64, 0.5}, {0.72, -0.4}, {0.8, 0.5}, {0.9, -0.4}, {1, 0.3}]}}
          ParticleCurves: {opacity: {keys: [{0, 0}, {0.1, 1}, {0.9, 1}, {1, 0}]}}
        }
      }
    }
  }

  guide {
    const dx = obj_x - px
    const dz = obj_z - pz
    const far = dx * dx + dz * dz > 10 * 10
    if obj_on && far && game_state == 1 && talk_npc < 0 {
      Position: {px, 0.12, pz}
      Rotation: {0, atan2(dx, dz), 0}
      arrow {
        Position: {0, 0, 2.2}
        head { Position: {0, 0, 0.35}; Rotation: {HALF_PI, 0, 0}; Cone: {length: 0.7, radius: 0.38, segments: 3}; Rgb: {255, 214, 110}; Emissive: {strength: 1.6, color: {255, 200, 90}}; NoShadow }
        tail { Position: {0, 0, -0.25}; Box: {0.22, 0.04, 0.6}; Rgb: {255, 214, 110}; Emissive: {strength: 1.6, color: {255, 200, 90}}; NoShadow }
      }
    }
  }

  objective_beam {
    if obj_on && game_state == 1 {
      Position: {obj_x, 0, obj_z}
      gem {
        Position: {0, obj_npc ? -6 : 3.6, 0}
        Rotation: {0, clock * 1.5, 0}
        top_ { Position: {0, 0.3, 0}; Cone: {length: 0.6, radius: 0.35, segments: 4}; Rgb: {255, 220, 140}; Emissive: {strength: 2, color: {255, 210, 120}}; NoShadow }
        bot_ { Position: {0, -0.3, 0}; Rotation: {PI, 0, 0}; Cone: {length: 0.6, radius: 0.35, segments: 4}; Rgb: {255, 220, 140}; Emissive: {strength: 2, color: {255, 210, 120}}; NoShadow }
      }
      halo { Position: {0, 0.1, 0}; Torus: {radius: 1.6, tube: 0.07, segments: 32, rings: 4}; Rgb: {255, 220, 140}; Emissive: {strength: 1.5, color: {255, 210, 120}}; NoShadow }
    }
  }
}

camera {
  Position: {cam_x, 0, cam_z}
  arm {
    Rotation: {0 - cam_pitch, 0, 0}
    eye {
      Position: {0, 0, cam_dist}
      Camera: {fov: CAM_FOV, near_: 0.5, far_: 600}
    }
  }
}

async {
  mut last: f64 = AppStatus[AppStatus].elapsed
  mut orbit: f64 = 0
  mut nearest_t: f64 = 0
  while true {
    await next_frame()
    const now = AppStatus[AppStatus].elapsed
    const fixed = App[App].delta_time
    const d = fixed > 0 ? fixed : clamp(now - last, 0.001, 0.1)
    last = now
    dt = d
    clock += d

    const can_move = game_state == 1 && talk_npc < 0
    const mx = bool_f(state.mv_actions.MoveRight[ActionState].down) - bool_f(state.mv_actions.MoveLeft[ActionState].down)
    const mz = bool_f(state.mv_actions.MoveDown[ActionState].down) - bool_f(state.mv_actions.MoveUp[ActionState].down)
    const len = sqrt(mx * mx + mz * mz)

    if can_move && len > 0 {
      const run = state.mv_actions.Sprint[ActionState].down
      const speed = run ? 9.5 : 6
      const vx = mx / len * speed * d
      const vz = mz / len * speed * d
      const r: f64 = 0.38
      const nx = clamp(px + vx, 0 - BOUND, BOUND)
      if !blocked[cell(nx - r, pz - r)] && !blocked[cell(nx + r, pz - r)] && !blocked[cell(nx - r, pz + r)] && !blocked[cell(nx + r, pz + r)] {
        px = nx
      }
      const nz = clamp(pz + vz, 0 - BOUND, BOUND)
      if !blocked[cell(px - r, nz - r)] && !blocked[cell(px + r, nz - r)] && !blocked[cell(px - r, nz + r)] && !blocked[cell(px + r, nz + r)] {
        pz = nz
      }
      const want = atan2(mx, mz)
      if !casting {
        pyaw = pyaw + wrap_angle(want - pyaw) * min(1, d * 14)
      }
      walk_phase += d * speed * 1.4
      if !moving {
        moving = true
      }
      if sprinting != run {
        sprinting = run
      }
    } else if moving {
      moving = false
      walk_phase = 0
    }

    const title = game_state == 0
    if title {
      const ox = 14 * cos(orbit)
      const oz = 9 * sin(orbit)
      orbit += d * 0.8 / sqrt(ox * ox + oz * oz)
    }
    const ease = title ? 1 : min(1, d * 5)
    const tx = title ? -4 + sin(orbit) * 14 : px + sin(pyaw) * 1.5 * bool_f(moving)
    const tz = title ? 2 + cos(orbit) * 9 : pz + cos(pyaw) * 1.0 * bool_f(moving)
    if abs(cam_x - tx) > 0.002 || abs(cam_z - tz) > 0.002 {
      cam_x += (tx - cam_x) * ease
      cam_z += (tz - cam_z) * ease
    }

    if game_state == 1 && mana < mana_max {
      mana = min(mana_max, mana + d * 9)
    }

    const inp = Input[Input]
    const w = inp.size.x
    const h = inp.size.y
    const mpx = inp.mouse.position.x
    const mpy = inp.mouse.position.y
    const inside = w > 0 && h > 0 && mpx > 0 && mpy > 0 && mpx < w && mpy < h
    if inside {
      const gx = aim_ground_x(mpx, mpy, w, h, cam_x, cam_dist, cam_pitch, CAM_FOV)
      const gz = aim_ground_z(mpx, mpy, w, h, cam_z, cam_dist, cam_pitch, CAM_FOV)
      const ddx = gx - px
      const ddz = gz - pz
      const dl = sqrt(ddx * ddx + ddz * ddz)
      const k = dl > CAST_RANGE ? CAST_RANGE / dl : 1
      aim_x = px + ddx * k
      aim_z = pz + ddz * k
      if !aim_on {
        aim_on = true
      }
    } else if aim_on {
      aim_on = false
    }

    if clock > nearest_t {
      nearest_t = clock + 0.12
      mut best: f64 = 3.2 * 3.2
      mut bn: i32 = -1
      for n in 0..NPCS {
        const dn = dist2(px, pz, npc_x[n], npc_z[n])
        if dn < best {
          best = dn
          bn = n
        }
      }
      if near_npc != bn {
        near_npc = bn
      }
      if game_state == 1 && known[spell] {
        pick_target()
      } else if aim_target != -1 {
        aim_target = -1
      }
    }

    if toast != "" && clock > toast_until {
      toast = ""
    }
    if banner != "" && clock > banner_until {
      banner = ""
    }
  }
}

async {
  while true {
    await on.pressed(state.mv_actions.CastKey)
    if game_state == 1 && talk_npc >= 0 {
      emit Advance()
    } else if game_state == 1 && talk_npc < 0 && clock > talk_cool {
      pick_target()
      emit CastReq(x: pick_x, z: pick_z)
    }
  }
}

async {
  while true {
    await on.pressed(state.mv_actions.CastClick)
    if game_state == 1 && talk_npc >= 0 {
      emit Advance()
    } else if game_state == 1 && talk_npc < 0 && clock > talk_cool && aim_on {
      emit CastReq(x: aim_x, z: aim_z)
    }
  }
}

async {
  while true {
    await on.pressed(state.mv_actions.TalkKey)
    if game_state == 1 {
      if talk_npc >= 0 {
        emit Advance()
      } else if near_npc >= 0 {
        emit Talk(npc: near_npc)
      }
    }
  }
}

async {
  while true {
    await on.pressed(state.mv_actions.NextSpell)
    if game_state == 1 {
      mut s: i32 = spell
      for i in 0..SPELLS {
        s = s % SPELLS + 1
        if known[s] {
          emit PickSpell(s: s)
          break
        }
      }
    }
  }
}

async {
  while true {
    const e = await PickSpell
    if game_state == 1 && talk_npc < 0 {
      if known[e.s] {
        if spell != e.s {
          spell = e.s
          say("{spell_name(e.s)}: {spell_blurb(e.s)}")
        }
      } else {
        say("You haven't learned that spell yet.")
      }
    }
  }
}

async {
  while true {
    const e = await CastReq
    if !casting && known[spell] {
      const cost = spell_cost(spell)
      if mana < cost {
        say("Not enough mana. Wait a moment for it to return.")
        emit Fizzle(x: px, z: pz)
      } else {
        casting = true
        mana -= cost
        const s = spell
        emit CastStart(spell: s)
        const ddx = e.x - px
        const ddz = e.z - pz
        const dl = max(sqrt(ddx * ddx + ddz * ddz), 0.01)
        const k = dl > CAST_RANGE ? CAST_RANGE / dl : 1
        const tx = px + ddx * k
        const tz = pz + ddz * k
        pyaw = atan2(ddx, ddz)
        cast_anim = 1
        await delay(0.12)
        const sx = px + sin(pyaw) * 0.5
        const sz = pz + cos(pyaw) * 0.5
        orb_spell = s
        orb_x = sx
        orb_y = 2.6
        orb_z = sz
        orb_on = true
        mut t: f64 = 0
        const dur = 0.18 + dl * k * 0.025
        while t < 1 {
          await next_frame()
          t = min(1, t + dt / dur)
          orb_x = sx + (tx - sx) * t
          orb_z = sz + (tz - sz) * t
          orb_y = 2.6 + (0.6 - 2.6) * t + sin(t * PI) * 1.2
        }
        orb_on = false
        emit Impact(spell: s, x: tx, z: tz)
        emit Cast(spell: s, x: tx, z: tz)
        cast_anim = 0
        await delay(0.08)
        casting = false
      }
    }
  }
}
