using flecs.script
using flecs.script.math
using box.app
using box.input
using box.transform
using box.transition
using box.light
using box.geometry
using box.material
using box.camera
using box.particle
using state
using assets

state {
  event CastReq(x: f32, z: f32)
  event Advance()
  event PickSpell(s: i32)

  export mut casting = false
  export mut pick_x: f32 = 0
  export mut pick_z: f32 = 0
  export mut talk_cool: f64 = 0
  export mut aim_target: i32 = -1
}

assets {
  template SpellKey {
    prop s: i32 = 1
    prop key: Key = Num1
    Action: {description: "Choose a spell"}
    Binding: {key: key}
    async {
      while true {
        await on.pressed(this)
        emit PickSpell(s: s)
      }
    }
  }
}

state {
  mv_actions {
    MoveLeft { Action: {description: "Walk west"}; Binding: {key: A}; alt { Binding: {key: Left} } }
    MoveRight { Action: {description: "Walk east"}; Binding: {key: D}; alt { Binding: {key: Right} } }
    MoveUp { Action: {description: "Walk north"}; Binding: {key: W}; alt { Binding: {key: Up} } }
    MoveDown { Action: {description: "Walk south"}; Binding: {key: S}; alt { Binding: {key: Down} } }
    Sprint { Action: {description: "Hurry"}; Binding: {key: ShiftLeft}; alt { Binding: {key: ShiftRight} } }
    CastKey { Action: {description: "Cast at the nearest target"}; Binding: {key: Space} }
    CastClick { Action: {description: "Cast where the cursor points"}; Binding: {key: MouseLeft} }
    TalkKey { Action: {description: "Talk"}; Binding: {key: E}; alt { Binding: {key: Enter} } }
    NextSpell { Action: {description: "Next spell"}; Binding: {key: Q}; alt { Binding: {key: Tab} } }
    SpellKey key_1(s: 1, key: Num1)
    SpellKey key_2(s: 2, key: Num2)
    SpellKey key_3(s: 3, key: Num3)
    SpellKey key_4(s: 4, key: Num4)
    SpellKey key_5(s: 5, key: Num5)
    SpellKey key_6(s: 6, key: Num6)
  }

  fn aim_ground_x(mx: f64, my: f64, w: f64, h: f64, cx: f64, cdist: f64, pitch: f64, fov: f64) -> f64 {
    const t = tan(fov * PI / 360)
    const nx = (2 * mx / w - 1) * t * w / h
    const ny = (1 - 2 * my / h) * t
    const dy = ny * cos(pitch) - sin(pitch)
    const cy = sin(pitch) * cdist
    const s = 0 - cy / min(dy, -0.01)
    cx + s * nx
  }

  fn aim_ground_z(mx: f64, my: f64, w: f64, h: f64, cz: f64, cdist: f64, pitch: f64, fov: f64) -> f64 {
    const t = tan(fov * PI / 360)
    const ny = (1 - 2 * my / h) * t
    const dy = ny * cos(pitch) - sin(pitch)
    const dz = 0 - ny * sin(pitch) - cos(pitch)
    const cy = sin(pitch) * cdist
    const s = 0 - cy / min(dy, -0.01)
    cz + cos(pitch) * cdist + s * dz
  }

  export const CAM_FOV: f32 = 40
  export const CAST_RANGE: f32 = 9

  fn pick_target() {
    mut best: f64 = CAST_RANGE * CAST_RANGE
    mut bi: i32 = -1
    for i in 0..TARGETS {
      if t_on[i] && t_sp[i] == spell && ts[i] < t_lv[i] && qs[t_q[i]] >= QS_OPEN {
        if t_req[i] < 0 || ts[t_req[i]] >= t_lv[t_req[i]] {
          const d = dist2(px, pz, t_x[i], t_z[i])
          if d < best {
            best = d
            bi = i
          }
        }
      }
    }
    aim_target = bi
    if bi >= 0 {
      pick_x = t_x[bi]
      pick_z = t_z[bi]
    } else {
      pick_x = px + sin(pyaw) * 3.5
      pick_z = pz + cos(pyaw) * 3.5
    }
  }
}

assets {
  template Mage {
    const legs = sin(walk_phase) * (moving ? 0.6 : 0)
    const bob = moving ? abs(sin(walk_phase)) * 0.08 : sin(clock * 2.2) * 0.025
    const sway = moving ? sin(walk_phase) * 0.06 : sin(clock * 1.3) * 0.03
    const gem: Rgb = {spell_r(spell), spell_g(spell), spell_b(spell)}

    Position: {px, 0, pz}
    Rotation: {0, pyaw, 0}

    if moving && sprinting {
      dust {
        Position: {0, 0.15, -0.3}
        ParticleEmitter: {max: 40, rate: 18, shape: EmitterSphere, radius: 0.2, direction: {0, 1, -1}, spread: 50, speed: {0.4, 1.0}, lifetime: {0.5, 0.9}, size: {0.25, 0.45}, opacity: {0.3, 0.5}, color: {200, 180, 140}, color_variance: {10, 10, 10}, seed: 17}
