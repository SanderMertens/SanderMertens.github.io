  export const AR_YARD: i32 = 7
  export const AR_SQUARE: i32 = 8
  export const AR_COURT: i32 = 9
  export const AR_PASTURE: i32 = 10

  export const TILE_COBBLE: f32 = 3.2
  export const TILE_LANE: f32 = 3.0
  export const TILE_FLAGS: f32 = 2.4
  export const TILE_DIRT: f32 = 4.5
  export const TILE_VERGE: f32 = 6
  export const TILE_GRASS: f32 = 9
  export const TILE_FOREST: f32 = 10
}

