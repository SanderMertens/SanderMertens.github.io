  fn house_hw(face: i32, w: f32, d: f32) -> f32 {
    match face % 2 { 0: w / 2; _: d / 2 }
  }

  fn house_hd(face: i32, w: f32, d: f32) -> f32 {
    match face % 2 { 0: d / 2; _: w / 2 }
  }
}

mossvale {
  mv_town {
    houses {
      for h in MV_HOUSES {
        House "{h.name}"(x: h.x, z: h.z, w: h.w, d: h.d, h: h.h, face: h.face, wall: h.wall, roof: h.roof, floors: h.floors, sign: h.sign, chimney: h.chimney)
      }
    }
  }
}
