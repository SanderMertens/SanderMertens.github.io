using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using state
using assets

state {
  struct MvStreet(w: f32, kind: i32)
  struct MvArea(x: f32, z: f32, w: f32, d: f32, r: f32, kind: i32)
  struct MvHouseDef(name: string, x: f32, z: f32, w: f32, d: f32, h: f32, face: i32, wall: i32, roof: i32, floors: i32, sign: i32, chimney: bool)

  export const ST_MAIN: i32 = 0
  export const ST_LANE: i32 = 1
  export const ST_ALLEY: i32 = 2
  export const ST_ROAD: i32 = 3
  export const ST_PATH: i32 = 4

  export const AR_MEADOW: i32 = 0
  export const AR_FOREST: i32 = 1
  export const AR_HILLS: i32 = 2
  export const AR_FARM: i32 = 3
  export const AR_CLEARING: i32 = 4
  export const AR_ASH: i32 = 5
