using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.animation
using box.transition
using box.light
using box.text
using box.texture
using state
using terra

state {
  export mut door_open: bool[10] = {}

  fn bottle_ink(n: i32) -> Rgb {
    match n % 6 {
      0: {255, 170, 60}
      1: {110, 230, 130}
      2: {255, 90, 80}
      3: {110, 180, 255}
      4: {240, 240, 220}
      _: {220, 120, 255}
    }
  }

  fn crate_tint(seed: i32) -> Rgb {
    match hash_int(seed, 114, 6) {
      0: {70, 110, 160}
      1: {160, 70, 60}
      2: {80, 140, 100}
      3: {150, 150, 158}
      4: {170, 130, 60}
      _: {110, 90, 140}
    }
  }

  fn depot_level(units: f32) -> i32 {
    units <= 0 ? 0 : units < 40 ? 1 : units < 120 ? 2 : units < 300 ? 3 : units < 600 ? 4 : 5
  }

  fn role_title(role: i32) -> string {
    match role {
      1: "DOCK"
      2: "CONCOURSE"
      3: "BAR"
      4: "TRADE"
      5: "FREIGHT"
      6: "SHIPYARD"
      7: "SITE OFFICE"
      _: ""
    }
  }

  fn plan_gaps(a: Link, b: Link, c: Link, d: Link, e: Link, f: Link, g: Link, h: Link, i: Link, j: Link, x: f32, z: f32) -> bool {
    gap_at(a, x, z) || gap_at(b, x, z) || gap_at(c, x, z) || gap_at(d, x, z) || gap_at(e, x, z) || gap_at(f, x, z) || gap_at(g, x, z) || gap_at(h, x, z) || gap_at(i, x, z) || gap_at(j, x, z)
  }
}

terra {
