    back_ : KitGloss { Position: {0, 0.72, -0.26}; RoundedBox: {len, 0.42, 0.08, 0.03, segments: 2}; Rgb: tint }
    leg_a : KitSteel { Position: {0 - len / 2 + 0.2, 0.22, 0}; Box: {0.08, 0.44, 0.5} }
    leg_b : KitSteel { Position: {len / 2 - 0.2, 0.22, 0}; Box: {0.08, 0.44, 0.5} }
