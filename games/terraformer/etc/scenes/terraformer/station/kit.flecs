  }

  template KitCargo {
    prop len: f32 = 1.8
    prop tint: Rgb = {70, 110, 160}
    body : KitMetal { Position: {0, 0.5, 0}; Box: {len, 1.0, 0.95}; Rgb: tint; PbrMaterial: {metallic: 0.3, roughness: 0.6} }
    const n: i32 = floor(len / 0.3)
    for i in 0..n {
      "rib_{i}" : KitDark { Position: {0 - len / 2 + 0.15 + i * 0.3, 0.48, 0}; Box: {0.05, 0.9, 1.0} }
    }
    rail_a : KitDark { Position: {0, 1.0, 0.45}; Box: {len + 0.04, 0.05, 0.08} }
    rail_b : KitDark { Position: {0, 1.0, -0.45}; Box: {len + 0.04, 0.05, 0.08} }
    cap_a : KitDark { Position: {len / 2, 1.0, 0}; Box: {0.08, 0.05, 0.95} }
    cap_b : KitDark { Position: {0 - len / 2, 1.0, 0}; Box: {0.08, 0.05, 0.95} }
    door : KitSteel { Position: {len / 2 + 0.01, 0.5, 0}; Box: {0.03, 0.86, 0.8} }
