  template KitPlanter {
    prop seed: i32 = 0
    prop tub: Rgb = {232, 232, 236}
    prop trim: Rgb = {214, 168, 84}
    pot : KitGloss { Position: {0, 0.3, 0}; RoundedBox: {1.3, 0.6, 1.3, 0.08, segments: 2}; Rgb: tub }
    lip : KitBrass { Position: {0, 0.6, 0}; Box: {1.36, 0.05, 1.36}; Rgb: trim }
    soil : KitMatte { Position: {0, 0.61, 0}; Box: {1.14, 0.04, 1.14}; Rgb: {58, 42, 32} }
    if hash01(seed, 121) < 0.5 {
      trunk : KitMatte { Position: {0, 1.0, 0}; Cylinder: {length: 0.8, radius: 0.07, segments: 8, smooth: true}; Rgb: {96, 70, 50} }
      crown_a : KitLeaf { Position: {0, 1.55, 0}; IcoSphere: {radius: 0.52, segments: 1} }
      crown_b : KitLeaf { Position: {0.24, 1.36, 0.16}; IcoSphere: {radius: 0.34, segments: 1}; Rgb: {84, 170, 84} }
      crown_c : KitLeaf { Position: {-0.24, 1.42, -0.12}; IcoSphere: {radius: 0.36, segments: 1}; Rgb: {52, 132, 70} }
    } else {
      bush_a : KitLeaf { Position: {-0.22, 0.86, 0.1}; IcoSphere: {radius: 0.38, segments: 1} }
      bush_b : KitLeaf { Position: {0.24, 0.92, -0.14}; IcoSphere: {radius: 0.42, segments: 1}; Rgb: {84, 170, 84} }
      bush_c : KitLeaf { Position: {0.06, 0.8, 0.3}; IcoSphere: {radius: 0.3, segments: 1}; Rgb: {52, 132, 70} }
      bloom_a { Position: {-0.26, 1.2, 0.2}; Sphere: {radius: 0.07, segments: 8, smooth: true}; Rgb: {255, 150, 190}; PbrMaterial: {roughness: 0.6} }
      bloom_b { Position: {0.3, 1.3, -0.1}; Sphere: {radius: 0.07, segments: 8, smooth: true}; Rgb: {255, 220, 120}; PbrMaterial: {roughness: 0.6} }
      bloom_c { Position: {0.1, 1.08, 0.42}; Sphere: {radius: 0.06, segments: 8, smooth: true}; Rgb: {255, 150, 190}; PbrMaterial: {roughness: 0.6} }
    }
  }

