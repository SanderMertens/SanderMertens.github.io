  }
  kit_tile { TextureGen: {source: kit_tile_h, output: GenAlbedo, colors: [{0, {70, 70, 78}}, {0.55, {205, 205, 212}}, {0.85, {240, 240, 244}}, {1, {255, 255, 255}}]} }
  kit_tile_n { TextureGen: {source: kit_tile_h, output: GenNormal, strength: 1.2} }

  kit_plate_h {
