  prefab KitTile { Rgb: {255, 255, 255}; PbrMaterial: {metallic: 0.05, roughness: 0.6}; ClearCoat: {strength: 0.2, roughness: 0.4}; PbrTextures: {albedo: kit_tile, normal: kit_tile_n}; TextureMapping: {mode: MappingWorld, size: 4} }
  prefab KitPlate { Rgb: {255, 255, 255}; PbrMaterial: {metallic: 0.5, roughness: 0.7}; PbrTextures: {albedo: kit_plate, normal: kit_plate_n}; TextureMapping: {mode: MappingWorld, size: 4} }
  prefab KitRock { Rgb: {255, 255, 255}; PbrMaterial: {roughness: 0.95}; PbrTextures: {albedo: kit_rock, normal: kit_rock_n}; TextureMapping: {mode: MappingObject, size: 6, blend: 0.3} }
  prefab KitPaint { PbrMaterial: {metallic: 0.1, roughness: 0.55} }
  prefab KitGloss { PbrMaterial: {metallic: 0.15, roughness: 0.28}; ClearCoat: {strength: 0.7, roughness: 0.12} }
  prefab KitMatte { PbrMaterial: {roughness: 0.92} }
  prefab KitMetal { PbrMaterial: {metallic: 0.9, roughness: 0.38} }
  prefab KitSteel { Rgb: {150, 158, 170}; PbrMaterial: {metallic: 0.85, roughness: 0.4} }
  prefab KitDark { Rgb: {38, 42, 50}; PbrMaterial: {metallic: 0.6, roughness: 0.5} }
  prefab KitBrass { Rgb: {214, 168, 84}; PbrMaterial: {metallic: 1, roughness: 0.3} }
  prefab KitRubber { Rgb: {26, 26, 30}; PbrMaterial: {roughness: 0.85} }
  prefab KitLeaf { Rgb: {64, 150, 72}; PbrMaterial: {roughness: 0.85} }
  prefab KitGlass { Rgb: {190, 225, 240}; PbrMaterial: {metallic: 0.1, roughness: 0.05}; ClearCoat: {strength: 1, roughness: 0.03}; Transmission: {transmission_factor: 0.9, ior: 1.3, thickness_factor: 0.02, attenuation_distance: 8, attenuation_color: {200, 235, 250}} }

  kit_npc_idle {
    AnimationClip: {duration: 1.4}
    lift { AnimationTrack: {component: Position, member: "y", curve: {kind: CurveBezier, keys: [{0, 0, 0, 0}, {1.4, 0.03, 0, 0}]}} }
  }

  kit_arm_swing {
    AnimationClip: {duration: 3.2}
    turn { AnimationTrack: {component: Rotation, member: "y", curve: {kind: CurveBezier, keys: [{0, -0.9, 0, 0}, {3.2, 0.7, 0, 0}]}} }
  }

  kit_arm_reach {
    AnimationClip: {duration: 1.6}
    bend { AnimationTrack: {component: Rotation, member: "z", curve: {kind: CurveBezier, keys: [{0, -0.5, 0, 0}, {1.6, -0.95, 0, 0}]}} }
  }

  kit_glow_pulse {
    AnimationClip: {duration: 1.2}
    strength { AnimationTrack: {component: Emissive, member: "strength", curve: {kind: CurveBezier, keys: [{0, 0.6, 0, 0}, {1.2, 3.2, 0, 0}]}} }
  }

  template KitGlow {
    prop ink: Rgb = {255, 190, 84}
    prop power: f32 = 3
    Rgb: ink
    Emissive: {strength: power, color: ink}
    NoShadow
  }

  template KitSign {
    prop text: string = ""
    prop sub: string = ""
    prop w: f32 = 3
    prop ink: Rgb = {255, 190, 84}
    prop size: f32 = 1

    board : KitDark { Position: {0, 0, 0}; Box: {w, 0.66 * size, 0.08}; Rgb: {20, 22, 28} }
    edge { Position: {0, -0.33 * size - 0.02, 0.02}; Box: {w, 0.04, 0.1}; KitGlow: {ink: ink, power: 3} }
    label { Position: {0, sub == "" ? 0 : 0.09 * size, 0.05}; Scale: {0.0105 * size, 0.0105 * size, 0.0105 * size}; Text: {value: text, size: 32, align: Center}; Rgb: ink; Emissive: {strength: 2.4, color: ink}; NoShadow }
    if sub != "" {
      small { Position: {0, -0.19 * size, 0.05}; Scale: {0.0046 * size, 0.0046 * size, 0.0046 * size}; Text: {value: sub, size: 32, align: Center}; Rgb: {214, 220, 230}; Emissive: {strength: 1.2, color: {200, 208, 220}}; NoShadow }
    }
  }

  template KitNote {
    prop text: string = ""
    prop ink: Rgb = {30, 30, 36}
    prop size: f32 = 1
    prop glow: f32 = 0
    Scale: {0.005 * size, 0.005 * size, 0.005 * size}
    Text: {value: text, size: 32, align: Center}
    Rgb: ink
    Emissive: {strength: glow, color: ink}
    NoShadow
