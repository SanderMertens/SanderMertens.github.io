    const n: i32 = max(1, floor(len / 2.4 + 0.5))
    pane : KitGlass { Position: {0, 0.55, 0}; Box: {len, 0.86, 0.04} }
    top : KitMetal { Position: {0, 1.04, 0}; Box: {len, 0.07, 0.1}; Rgb: trim }
    foot : KitDark { Position: {0, 0.07, 0}; Box: {len, 0.14, 0.1} }
    for i in 0..n + 1 {
      "post_{i}" : KitSteel { Position: {0 - len / 2 + i * len / n, 0.54, 0}; Box: {0.07, 1.06, 0.08} }
