  struct Job(status: i32, client: i32, purpose: i32, planet: i32, fee: f64, deadline: i32, accepted: i32)
  struct Site(used: bool, planet: i32, job: i32, atm: f32, water: f32, temp: f32, bio: f32, dozer: i32)
  struct Freighter(status: i32, cap: i32, poi: i32)
  struct Dozer(status: i32, poi: i32, dest: i32, eta: f64)
  struct Shipment(status: i32, from: i32, to: i32, eta: f64, freighter: i32)

  event Request(op: i32, a: i32, b: i32)
  event DayTick(day: i32)
  event Arrived(poi: i32)
  event Toast(kind: i32)
  event Reset()

  export const JOB_NONE: Job = {0, 0, 0, -1, 0, 0, 0}
