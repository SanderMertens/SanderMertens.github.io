  export mut flight_on: bool = false
  export mut view_sys: i32 = HOME
  export mut view_nav: bool = false
  export mut view_dim: bool = false

  export mut cam_x: f32 = 0
  export mut cam_z: f32 = 0
  export mut cam_dist: f32 = 26
  export mut cam_pitch: f32 = 0.95
  export mut cam_yaw: f32 = 0

  export mut scam_x: f32 = 0
  export mut scam_z: f32 = 0
  export mut scam_dist: f32 = 205
  export mut scam_pitch: f32 = 1.0
  export mut scam_yaw: f32 = 0

  export mut gcam_x: f32 = 0
  export mut gcam_y: f32 = 0
  export mut gcam_h: f32 = 150

  fn stock_at(poi: i32, g: i32) -> f32 {
    poi >= 0 && poi < N_POI && g >= 0 && g < N_GOODS ? stock[poi * 8 + g] : 0
  }

  fn stock_total(poi: i32) -> f32 {
    poi >= 0 && poi < N_POI ? stock[poi * 8] + stock[poi * 8 + 1] + stock[poi * 8 + 2] + stock[poi * 8 + 3] + stock[poi * 8 + 4] + stock[poi * 8 + 5] + stock[poi * 8 + 6] + stock[poi * 8 + 7] : 0
  }

  proc stock_add(poi: i32, g: i32, delta: f32) {
    if poi >= 0 && poi < N_POI && g >= 0 && g < N_GOODS {
      stock[poi * 8 + g] = max(stock[poi * 8 + g] + delta, 0)
    }
  }

  proc toast_as(text: string, kind: i32) {
    toast_text = text
    toast_kind = kind
    toast_seq += 1
    toast_show = true
    emit Toast(kind: kind)
  }

  proc toast(text: string) {
    toast_as(text, 0)
  }

  proc say(name: string, tag: string, text: string, more: bool) {
    say_name = name
    say_tag = tag
    say_text = text
    say_more = more
    say_seq += 1
    say_on = true
  }

  proc say_end() {
    if say_on {
      say_on = false
    }
  }
}
