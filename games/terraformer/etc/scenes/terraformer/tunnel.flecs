using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.camera
using box.view
using box.effects
using box.texture
using box.particle
using box.transition
using box.movement
using box.spatial
using state

state {
  export mut tun_on: bool = false
  export mut tun_cover: bool = false
  export mut tun_flash: bool = false
  export mut tun_rush: bool = false
  export mut tun_fov: f32 = 70
  export mut tun_roll: f32 = 0
  export mut tun_sx: f32 = 0
  export mut tun_sy: f32 = 0
}

terra {
  tun_noise {
    TextureGen: {
      width: 512, height: 512, seed: 77
      layers: [
        {kind: GenNoise, frequency: 5, octaves: 5, gain: 0.62, amount: 1, seed: 4}
        {kind: GenNoise, frequency: 23, octaves: 2, gain: 0.5, amount: 0.3, seed: 9}
      ]
    }
  }

  tun_tex {
    TextureGen: {source: tun_noise, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.42, {2, 4, 16}}
      {0.56, {20, 50, 150}}
      {0.68, {70, 140, 255}}
      {0.8, {190, 225, 255}}
      {1, {255, 255, 255}}
    ]}
  }

  tun_tex_b {
    TextureGen: {source: tun_noise, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.5, {10, 2, 24}}
      {0.64, {110, 40, 190}}
      {0.78, {230, 150, 255}}
      {1, {255, 240, 255}}
    ]}
  }

  prefab TunRing { Torus: {radius: 5.5, tube: 3.6, segments: 32, rings: 12} }

  template TunnelFx {
    if tun_on {
      fx {
        Scene: {blend_modes: true}

        cam {
          Position: {tun_sx, tun_sy, 0}
          Rotation: {0, 0, tun_roll}
          Camera: {fov: tun_fov, near_: 0.1, far_: 4000}
        }

        group {
          Position: {0, 0, 0}
          Opacity: {tun_cover ? 1 : 0}
          Transition: [Opacity: {duration: tun_cover ? 0.1 : 0.32}]
          SpatialIgnore

          back {
            Position: {0, 0, -2400}
            Rect: {12000, 12000}
            Rgb: {1, 2, 9}
          }
          wall_a {
            Position: {0, 0, -900}
            Rotation: {PI / 2, 0, 0}
            Tube: {radius: 11, thickness: 0.5, length: 2000, segments: 48, smooth: true}
            Rgb: {0, 0, 0}
            PbrMaterial: {metallic: 0, roughness: 1}
            Emissive: {strength: 2.6, color: {200, 225, 255}}
            PbrTextures: {emissive: tun_tex}
            TextureTransform: {scale_x: 5, scale_y: 2.4}
            TextureScroll: {velocity: {0.03, 1.5}}
            BlendMode: Additive
            NoShadow
          }
          wall_b {
            Position: {0, 0, -900}
            Rotation: {PI / 2, 0.7, 0}
            Tube: {radius: 7.5, thickness: 0.4, length: 2000, segments: 48, smooth: true}
            Rgb: {0, 0, 0}
            PbrMaterial: {metallic: 0, roughness: 1}
            Emissive: {strength: 1.6, color: {255, 220, 255}}
            PbrTextures: {emissive: tun_tex_b}
            TextureTransform: {scale_x: 3, scale_y: 1.3}
            TextureScroll: {velocity: {-0.05, 2.3}}
            BlendMode: Additive
            NoShadow
          }
          eye {
            Position: {0, 0, -1700}
            Circle: {120}
            Rgb: {0, 0, 0}
            Emissive: {strength: 9, color: {190, 220, 255}}
            BlendMode: Additive
          }
        }

        streaks {
          Position: {0, 0, -150}
          Rotation: {PI / 2, 0, 0}
          ParticleEmitter: {
            max: 1400, rate: tun_rush ? 1100 : 0, shape: EmitterMesh, source: TunRing,
            direction: {0, 1, 0}, spread: 0, speed: {260, 420},
            lifetime: {0.34, 0.52}, size: {0.03, 0.09}, color: {210, 230, 255},
            color_variance: {30, 20, 0}, opacity: {0.3, 0.9}, seed: 12
          }
          ParticleForces: {gravity: {0, 0, 0}}
          ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive, stretch: 0.09}
          SpatialIgnore
        }

        flash {
          Position: {0, 0, -1}
          Rect: {60, 60}
          Rgb: {214, 232, 255}
          BlendMode: Additive
          Opacity: {tun_flash ? 1 : 0}
          Transition: [Opacity: {duration: tun_flash ? 0.07 : 0.55, timing_function: EaseOut}]
          SpatialIgnore
        }
      }

      bloom { Bloom: {intensity: 0.45, threshold: 0.9, threshold_softness: 0.5} }
      film { Tonemap: {operator_: TonyMcMapface} }
      view {
        View: {
          camera: fx.cam,
          order: 5,
          lighting: {enabled: false},
          culling: {enabled: false},
          effects: [{effect: bloom}, {effect: film}]
        }
      }
    }
  }
}

async {
  mut phase: i32 = 0
  mut t: f64 = 0
  mut was_trav: bool = false
  mut fov: f32 = 70
  mut roll: f32 = 0
  while true {
    await next_frame()
    const trav = mode == MODE_TRAVEL
    const jump = trav && trav_jump
    if phase == 0 {
      if jump {
        phase = 1
        t = was_trav ? 0.32 : 0
        fov = 62
        roll = 0
        tun_fov = fov
        tun_roll = 0
        tun_cover = false
        tun_flash = false
        tun_rush = false
        tun_on = true
      }
    } else {
      if phase == 1 {
        t -= dt
        if t <= 0 {
          tun_flash = true
          phase = 2
          t = 0
        }
      } else if phase == 2 {
        t += dt
        if t > 0.06 && !tun_cover {
          tun_cover = true
          tun_rush = true
        }
        if t > 0.24 {
          tun_flash = false
          phase = 3
          t = 0
        }
      } else if phase == 3 {
        t += dt
        if !jump && t > 0.7 {
          tun_flash = true
          tun_rush = false
          phase = 4
          t = 0
        }
      } else if phase == 4 {
        t += dt
        if t > 0.08 && tun_cover {
          tun_cover = false
        }
        if t > 0.3 {
          tun_flash = false
          phase = 5
          t = 0
        }
      } else {
        t += dt
        if t > 0.8 {
          tun_on = false
          phase = 0
        }
      }
      if phase >= 2 && phase <= 4 {
        const want: f32 = phase == 2 ? 118 : phase == 3 ? 92 + sin(real_time * 1.7) * 5 : 64
        fov += (want - fov) * min(1, dt * (phase == 2 ? 14 : 3))
        roll += dt * 0.22
        tun_fov = fov
        tun_roll = roll
        tun_sx = perlin2(real_time * 13, 2.3) * 0.25
        tun_sy = perlin2(real_time * 11, 9.1) * 0.25
      }
    }
    was_trav = trav
  }
}
