  fl_rock {
    TextureGen: {source: fl_rock_h, output: GenAlbedo, colors: [
      {0, {96, 88, 82}}
      {0.4, {138, 128, 118}}
      {0.7, {168, 158, 146}}
      {1, {204, 196, 184}}
    ]}
  }

  fl_rock_n {
    TextureGen: {source: fl_rock_h, output: GenNormal, strength: 3}
  }

  fl_solar_h {
    TextureGen: {
      width: 256, height: 256, seed: 3
      layers: [
        {kind: GenBlocks, courses: 8, per_course: 4, gap: 0.012, softness: 0.004, amount: 0.9, id_amount: 0.1, seed: 2}
      ]
