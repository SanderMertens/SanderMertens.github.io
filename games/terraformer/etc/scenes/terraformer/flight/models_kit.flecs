  fl_cont_h {
    TextureGen: {
      width: 512, height: 512, seed: 44
      layers: [
        {kind: GenBlocks, courses: 10, per_course: 3, gap: 0.005, softness: 0.004, tones: 7, amount: 0.8, id_amount: 0.2, seed: 8}
      ]
    }
  }

  fl_cont {
    TextureGen: {source: fl_cont_h, output: GenAlbedo,
      palette: [{150, 74, 60}, {70, 96, 132}, {176, 144, 70}, {84, 116, 96}, {142, 146, 152}, {168, 108, 66}, {196, 196, 190}],
      colors: [{0, {40, 40, 44}}, {0.5, {200, 200, 200}}, {1, {255, 255, 255}}]}
  }

  fl_cont_n {
    TextureGen: {source: fl_cont_h, output: GenNormal, strength: 0.9}
  }

  fl_rock_h {
    TextureGen: {
      width: 512, height: 512, seed: 91
      layers: [
        {kind: GenNoise, frequency: 3, octaves: 6, gain: 0.62, amount: 0.8, seed: 4}
        {kind: GenCells, count: 14, distance: GenNearest, amount: 0.2, seed: 6}
      ]
