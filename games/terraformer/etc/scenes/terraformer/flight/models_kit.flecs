  }

  fl_win_h {
    TextureGen: {
      width: 1024, height: 512, seed: 12
      layers: [
        {kind: GenBlocks, courses: 16, per_course: 28, amount: 0.3, id_amount: 0.7, seed: 5}
        {kind: GenBlocks, op: GenMultiply, courses: 16, per_course: 28, gap: 0.021, softness: 0.0015, amount: 1, seed: 5}
      ]
    }
  }

  fl_win_e {
    TextureGen: {source: fl_win_h, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.29, {0, 0, 0}}
      {0.3, {4, 6, 10}}
      {0.73, {5, 8, 14}}
      {0.74, {150, 104, 62}}
      {0.8, {160, 112, 66}}
      {0.81, {255, 200, 134}}
      {0.95, {255, 228, 186}}
      {0.96, {200, 226, 255}}
      {1, {226, 240, 255}}
    ]}
