using box.spatial
using box.text
using state

state {
  fn fl_berth_x(kind: i32, tier: i32, small: bool) -> f32 {
    const b: f32 = match kind {
      2: match tier { 0: 300; 1: 420; _: 560 }
      3: 220
      4: 180
      5: 200
      6: 180
      _: 150
    }
    small ? 0 - b * 0.6 : b
  }
}

terra {
  prefab FlPh { Rgb: {150, 156, 168}; PbrMaterial: {metallic: 0.4, roughness: 0.5} }

  fn fl_mix(a: f32, b: f32, t: f32) -> f32 {
    a + (b - a) * t
  }

  fl_plate_h {
    TextureGen: {
      width: 512, height: 512, seed: 71
      layers: [
        {kind: GenBlocks, courses: 8, per_course: 2, gap: 0.0025, stagger: 0.41, jitter: 0.3, softness: 0.003, amount: 0.6, id_amount: 0.08, seed: 3}
        {kind: GenBlocks, courses: 32, per_course: 8, gap: 0.0016, stagger: 0.5, jitter: 0.2, softness: 0.002, amount: 0.08, id_amount: 0.05, seed: 4}
        {kind: GenNoise, frequency: 4, octaves: 5, gain: 0.55, amount: 0.16, seed: 9}
      ]
    }
  }

  fl_plate {
    TextureGen: {source: fl_plate_h, output: GenAlbedo, colors: [
      {0, {132, 134, 140}}
      {0.3, {170, 172, 178}}
      {0.42, {212, 214, 220}}
      {0.74, {230, 232, 236}}
      {0.88, {244, 245, 248}}
      {1, {255, 255, 255}}
