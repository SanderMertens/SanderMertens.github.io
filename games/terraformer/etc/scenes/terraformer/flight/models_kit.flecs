  fl_pane_a {
    TextureGen: {source: fl_pane_h, output: GenAlbedo, colors: [
      {0, {210, 214, 220}}
      {0.36, {220, 224, 230}}
      {0.4, {18, 30, 50}}
      {1, {30, 48, 76}}
    ]}
