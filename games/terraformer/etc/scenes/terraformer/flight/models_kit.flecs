  fl_pane_h {
    TextureGen: {
      width: 256, height: 256, seed: 19
      layers: [
        {kind: GenBlocks, courses: 8, per_course: 8, amount: 0.4, id_amount: 0.6, seed: 6}
        {kind: GenBlocks, op: GenMultiply, courses: 8, per_course: 8, gap: 0.012, softness: 0.004, amount: 1, seed: 6}
      ]
    }
  }

  fl_pane_e {
    TextureGen: {source: fl_pane_h, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.38, {0, 0, 0}}
      {0.4, {40, 30, 20}}
      {0.8, {120, 96, 66}}
      {0.9, {255, 214, 160}}
      {1, {255, 236, 200}}
    ]}
