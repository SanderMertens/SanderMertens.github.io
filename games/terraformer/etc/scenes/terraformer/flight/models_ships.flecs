    pipe_b : FlSteel { Position: {-4.6, -4.2, -2}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 22, radius: 0.4, segments: 8, smooth: true} }
    dish_post : FlSteel { Position: {2, 5.8, -4}; Rotation: {0, 0, 0.2}; Box: {0.3, 3, 0.3} }
    dish : FlWhite { Position: {1.6, 7.6, -4}; Rotation: {-0.9, 0.5, 0.4}; HemiSphere: {radius: 2.4, segments: 12, smooth: true}; Rgb: {200, 196, 180} }
    whip : FlSteel { Position: {-3, 7.5, 10}; Rotation: {0.2, 0, -0.1}; Box: {0.12, 6, 0.12} }
    for i in 0..3 {
      "leg_{i}" : FlIron { Position: {i == 0 ? 0 : (i == 1 ? -4 : 4), -5.6, i == 0 ? 14 : -10}; Rotation: {i == 0 ? 0.3 : -0.2, 0, 0}; Box: {0.5, 3, 0.5} }
      "foot_{i}" : FlIron { Position: {i == 0 ? 0 : (i == 1 ? -4 : 4), -7.2, i == 0 ? 14.5 : -10.3}; Box: {1.6, 0.3, 2} }
    }
