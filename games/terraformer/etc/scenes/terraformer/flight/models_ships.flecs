    pit : FlBlack { Position: {0, 5.1, 8}; Box: {31, 0.4, 79} }
    for i in 0..7 {
      "ore_{i}" { Position: {(i % 3 - 1) * 7, 5.4 + (i % 2) * 1.6, -26 + i * 11.4}; Rotation: {i * 0.7, i * 1.3, 0}; Scale: {1.5, 0.62, 1.3}; IcoSphere: {radius: 7.4 + (i % 3), segments: 1}; Rgb: {112 + i * 5, 98 + i * 3, 86}; PbrMaterial: {metallic: 0.1, roughness: 0.95} }
      "rib_{i}" : FlIron { Position: {0, -4, -30 + i * 12.6}; Box: {37.6, 19, 1.2} }
