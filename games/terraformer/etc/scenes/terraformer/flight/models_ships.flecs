    win_s : FlWin { Position: {5.05, 1.4, -4}; Box: {0.12, 3, 8}; TextureTransform: {1, 1, 0.2, 0.03125}; Rgb: {176, 160, 140}; Emissive: {strength: 1.8 * lights, color: {255, 214, 160}} }
    pod : FlCont { Position: {7.6, -0.6, 1}; Box: {5, 6, 14}; TextureMapping: {MappingObject, size: 12, blend: 0} }
    strap_a : FlIron { Position: {7.7, -0.6, -3}; Box: {5.6, 6.6, 0.5} }
    strap_b : FlIron { Position: {7.7, -0.6, 5}; Box: {5.6, 6.6, 0.5} }
    tank : FlWhite { Position: {-6.8, -2.2, -9}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 8, radius: 2, segments: 12, smooth: true}; Rgb: {190, 180, 160} }
    tank_strap : FlIron { Position: {-6.8, -2.2, -9}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 0.6, radius: 2.1, segments: 12, smooth: true} }
