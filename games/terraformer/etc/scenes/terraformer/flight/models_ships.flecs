  template FlFreighter {
    prop thrust: f32 = 0
    prop rcs: f32 = 0
    prop livery: Rgb = {255, 150, 30}
    prop lights: f32 = 1
    prop cap: i32 = 0

    const len: f32 = match cap { 0: 70; 1: 110; 2: 170; _: 260 }
    const nseg: i32 = match cap { 0: 2; 1: 4; 2: 7; _: 12 }
    const bow: f32 = len / 2
    const hold: f32 = len - 34
    const pitch: f32 = hold / nseg
    const big: bool = cap >= 2

    SpatialIgnore
    spine : FlHullFineDark { Position: {0, 0, bow - 16 - hold / 2}; Box: {6, 6, hold + 2} }
    for i in 0..nseg {
      const cz: f32 = bow - 16 - (i + 0.5) * pitch
      "left_{i}" : FlCont { Position: {-9.6, 0, cz}; Box: {12.4, 26, pitch - 3}; TextureMapping: {MappingObject, size: 26, blend: 0}; TextureTransform: {1, 1, i * 0.37, i * 0.13} }
      "right_{i}" : FlCont { Position: {9.6, 0, cz}; Box: {12.4, 26, pitch - 3}; TextureMapping: {MappingObject, size: 26, blend: 0}; TextureTransform: {1, 1, i * 0.61 + 0.2, i * 0.29} }
      "frame_{i}" : FlIron { Position: {0, 0, cz - pitch / 2 + 0.6}; Box: {33, 28.4, 1.2} }
      "mark_{i}" : FlLampW { Position: {0, 14.5, cz - pitch / 2 + 0.6}; Box: {0.7, 0.5, 0.7}; Emissive: {strength: 6 * lights, color: {235, 244, 255}} }
    }
    cab : FlHullFine { Position: {0, 2, bow - 9}; Box: {24, 20, 14}; Bevel: {top_front: 6, bottom_front: 5, front_left: 4, front_right: 4, segments: 1} }
    cab_base : FlHullFineDark { Position: {0, -10, bow - 10}; Box: {28, 8, 12}; Bevel: {bottom_front: 4, segments: 1} }
    cab_band { Position: {0, -3, bow - 9.5}; Box: {24.3, 3, 13.4}; Bevel: {front_left: 4, front_right: 4, segments: 1}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    bridge : FlGlass { Position: {0, 6.4, bow - 2.4}; Box: {17, 2.2, 1}; Emissive: {strength: 2.4 * lights, color: {255, 214, 160}} }
    cab_win_p : FlWin { Position: {-12.05, 3, bow - 10}; Box: {0.14, 6, 9}; Emissive: {strength: 2.2 * lights, color: {255, 232, 200}} }
    cab_win_s : FlWin { Position: {12.05, 3, bow - 10}; Box: {0.14, 6, 9}; TextureTransform: {1, 1, 0.4, 0}; Emissive: {strength: 2.2 * lights, color: {255, 232, 200}} }
    mast : FlSteel { Position: {0, 16, bow - 12}; Box: {0.5, 8, 0.5} }
    dish : FlWhite { Position: {5, 13.6, bow - 12}; Rotation: {-0.5, 0.4, 0}; HemiSphere: {radius: 2.6, segments: 12, smooth: true} }
    block : FlHullFineDark { Position: {0, 0, 0 - bow + 11}; Box: {28, 24, 14}; Bevel: {radius: 3, segments: 1} }
    block_band { Position: {0, 0, 0 - bow + 16}; Box: {28.4, 20, 2.4}; Bevel: {radius: 2.4, segments: 1}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    tank_p : FlWhite { Position: {-12, 9, 0 - bow + 13}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 8, radius: 3.4, segments: 12, smooth: true} }
    tank_s : FlWhite { Position: {12, 9, 0 - bow + 13}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 8, radius: 3.4, segments: 12, smooth: true} }
    if big {
      FlBell eng_a(power: thrust, r: 4.6, seed: 31, hue: {255, 190, 120}) { Position: {-7, 6, 0 - bow + 4.14} }
      FlBell eng_b(power: thrust, r: 4.6, seed: 32, hue: {255, 190, 120}) { Position: {7, 6, 0 - bow + 4.14} }
      FlBell eng_c(power: thrust, r: 4.6, seed: 33, hue: {255, 190, 120}) { Position: {-7, -6, 0 - bow + 4.14} }
      FlBell eng_d(power: thrust, r: 4.6, seed: 34, hue: {255, 190, 120}) { Position: {7, -6, 0 - bow + 4.14} }
    } else {
      FlBell eng_a(power: thrust, r: 4.6, seed: 31, hue: {255, 190, 120}) { Position: {-7, 0, 0 - bow + 4.14} }
      FlBell eng_b(power: thrust, r: 4.6, seed: 32, hue: {255, 190, 120}) { Position: {7, 0, 0 - bow + 4.14} }
    }
    rcs_p { Position: {-12.1, 8, bow - 5}; Rotation: {0, PI, 0}; FlPuff pod(power: rcs, size: 0.8) }
    rcs_s { Position: {12.1, 8, bow - 5}; FlPuff pod(power: rcs, size: 0.8) }
    if lights > 0.05 {
      nav_p : FlLampR { Position: {-14.2, -10, bow - 10}; Sphere: {radius: 0.5, segments: 6} }
      nav_s : FlLampG { Position: {14.2, -10, bow - 10}; Sphere: {radius: 0.5, segments: 6} }
      nav_pa : FlLampR { Position: {-14.2, 0, 0 - bow + 10}; Sphere: {radius: 0.5, segments: 6} }
      nav_sa : FlLampG { Position: {14.2, 0, 0 - bow + 10}; Sphere: {radius: 0.5, segments: 6} }
      strobe : FlStrobe { Position: {0, 20.4, bow - 12}; Sphere: {radius: 0.5, segments: 6} }
      beacon : FlBlinkA { Position: {0, -12.6, 0 - bow + 11}; Sphere: {radius: 0.5, segments: 6} }
    }
  }

  template FlDozer {
    prop thrust: f32 = 0
    prop rcs: f32 = 0
    prop livery: Rgb = {236, 176, 34}
    prop lights: f32 = 1

    SpatialIgnore
    body : FlHull { Position: {0, 0, -16}; Box: {56, 38, 84}; Bevel: {radius: 4, segments: 1}; Rgb: livery; TextureMapping: {MappingObject, size: 40, blend: 0.2} }
    belly : FlHullDark { Position: {0, -21, -16}; Box: {44, 8, 76}; Bevel: {radius: 2, segments: 1} }
    deck : FlHullDark { Position: {0, 19.6, -20}; Box: {48, 1.4, 70} }
    blade : FlHull { Position: {0, -3, 62}; Box: {90, 42, 5}; Rgb: livery; TextureMapping: {MappingObject, size: 40, blend: 0.2} }
    blade_top : FlHull { Position: {0, 21.6, 65}; Rotation: {0.6, 0, 0}; Box: {90, 12, 5}; Rgb: livery; TextureMapping: {MappingObject, size: 40, blend: 0.2} }
    blade_edge : FlIron { Position: {0, -27, 65.4}; Rotation: {-0.6, 0, 0}; Box: {90, 12, 4} }
    blade_wing_p : FlHull { Position: {-45.5, -3, 57}; Box: {3, 46, 16}; Rgb: livery; TextureMapping: {MappingObject, size: 40, blend: 0.2} }
    blade_wing_s : FlHull { Position: {45.5, -3, 57}; Box: {3, 46, 16}; Rgb: livery; TextureMapping: {MappingObject, size: 40, blend: 0.2} }
    for i in 0..9 {
      "hazard_{i}" : FlBlack { Position: {-40 + i * 10, 16.4, 59.3}; Box: {5, 4, 0.6} }
    }
    for s in 0..2 {
      const sx: f32 = s == 0 ? -1 : 1
      "arm_{s}" : FlHullDark { Position: {sx * 31, -10, 40}; Box: {7, 9, 42} }
      "ram_{s}" : FlSteel { Position: {sx * 31, 2, 44}; Rotation: {0.5, 0, 0}; Cylinder: {length: 34, radius: 1.6, segments: 10, smooth: true} }
      "tank_{s}" : FlHullGrey { Position: {sx * 34, -6, -30}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 40, radius: 8, segments: 16, smooth: true} }
      "tank_strap_a_{s}" : FlIron { Position: {sx * 34, -6, -18}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 2, radius: 8.3, segments: 16, smooth: true} }
      "tank_strap_b_{s}" : FlIron { Position: {sx * 34, -6, -42}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 2, radius: 8.3, segments: 16, smooth: true} }
      "name_{s}" {
        Position: {sx * 28.2, 9, -16}
        Rotation: {0, sx * PI / 2, 0}
        Scale: {0.28, 0.28, 0.28}
        Text: {value: "TERRAFORMING? SURE. LLC", size: 16, align: Center}
        Rgb: {20, 20, 22}
        NoShadow
      }
      "win_{s}" : FlWin { Position: {sx * 28.1, 0, -30}; Box: {0.3, 6, 40}; Rgb: livery; Emissive: {strength: 2.2 * lights, color: {255, 232, 200}} }
      "flood_{s}" : FlLampW { Position: {sx * 30, 27.4, 66}; Box: {3, 1.4, 1}; Emissive: {strength: 7 * lights, color: {235, 244, 255}} }
      "beacon_{s}" : FlBlinkA { Position: {sx * 26, 21.6, -54}; Sphere: {radius: 1.2, segments: 8}; Animator: {clip: fl_blink_clip, time: s * 1.1} }
      "nav_{s}" { Position: {sx * 46.4, 20, 57}; Sphere: {radius: 0.9, segments: 8}; Rgb: {20, 10, 4}; Emissive: {strength: 8 * lights, color: s == 0 ? {255, 50, 36} : {70, 255, 110}}; NoShadow }
    }
    for i in 0..3 {
      "stack_{i}" : FlHullDark { Position: {-14, 29, -44 + i * 22}; Cylinder: {length: 18, radius: 7, segments: 16, smooth: true} }
      "stack_cap_{i}" : FlIron { Position: {-14, 38.6, -44 + i * 22}; Cylinder: {length: 1.4, radius: 7.6, segments: 16, smooth: true} }
      "stack_glow_{i}" { Position: {-14, 39.4, -44 + i * 22}; Cylinder: {length: 0.4, radius: 5.6, segments: 16}; Rgb: {30, 14, 4}; Emissive: {strength: 1.5 + 3 * thrust, color: {255, 150, 60}}; NoShadow }
    }
    cab : FlHull { Position: {14, 26, 10}; Box: {20, 12, 16}; Bevel: {top_front: 4, segments: 1}; Rgb: livery; TextureMapping: {MappingObject, size: 20, blend: 0.2} }
    cab_win : FlGlass { Position: {14, 28, 10.4}; Box: {20.4, 3, 15.6}; Emissive: {strength: 2.4 * lights, color: {255, 214, 160}} }
    cab_roof : FlHullDark { Position: {14, 32.6, 9}; Box: {21, 1.2, 15} }
    ladder : FlSteel { Position: {28.3, 4, 12}; Box: {0.3, 32, 1.2} }
    crane : FlIron { Position: {16, 24, -44}; Rotation: {0.5, 0, 0}; Box: {2, 2, 34} }
    dish : FlWhite { Position: {16, 36, -8}; Rotation: {-0.6, 0.6, 0}; HemiSphere: {radius: 4.4, segments: 14, smooth: true} }
    thrust_plate : FlIron { Position: {0, 0, -59.4}; Box: {50, 34, 3}; Bevel: {radius: 3, segments: 1} }
    FlBell eng_a(power: thrust, r: 6.6, seed: 41, hue: {255, 190, 120}) { Position: {-14, 8, -66} }
    FlBell eng_b(power: thrust, r: 6.6, seed: 42, hue: {255, 190, 120}) { Position: {14, 8, -66} }
    FlBell eng_c(power: thrust, r: 6.6, seed: 43, hue: {255, 190, 120}) { Position: {-14, -8, -66} }
    FlBell eng_d(power: thrust, r: 6.6, seed: 44, hue: {255, 190, 120}) { Position: {14, -8, -66} }
    rcs_p { Position: {-28.2, 14, 20}; Rotation: {0, PI, 0}; FlPuff pod(power: rcs, size: 1.4) }
    rcs_s { Position: {28.2, 14, 20}; FlPuff pod(power: rcs, size: 1.4) }
