  template FlTug {
    prop thrust: f32 = 0
    prop rcs: f32 = 0
    prop livery: Rgb = {255, 150, 30}
    prop lights: f32 = 1
    prop count: i32 = 5

    const n: i32 = clamp(count, 0, 12)

    SpatialIgnore
    hull : FlHullFine { Position: {0, 0, 2}; Box: {14, 10, 20}; Bevel: {radius: 2.4, top_front: 4, segments: 1}; Rgb: livery }
    hull_low : FlHullFineDark { Position: {0, -5, 1}; Box: {12, 3, 20}; Bevel: {radius: 1, segments: 1} }
    cab : FlGlass { Position: {0, 3, 10.4}; Box: {11, 2.6, 4}; Emissive: {strength: 2.2 * lights, color: {255, 214, 160}} }
    bumper : FlBlack { Position: {0, -1.4, 12.6}; Box: {13, 2.4, 1.4}; Bevel: {radius: 0.6, segments: 1} }
    roof : FlHullFineDark { Position: {0, 5.6, -1}; Box: {8, 1.4, 10} }
    mast : FlSteel { Position: {0, 9.6, -3}; Box: {0.4, 7, 0.4} }
    for s in 0..2 {
      const sx: f32 = s == 0 ? -1 : 1
      "out_{s}" : FlHullFineDark { Position: {sx * 9, 0, -3}; Box: {6, 2.4, 8} }
      "nac_{s}" : FlHullFineDark { Position: {sx * 12.4, 0, -4}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 14, radius: 3.4, segments: 16, smooth: true} }
      "nac_band_{s}" : FlYellow { Position: {sx * 12.4, 0, 1}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 1.2, radius: 3.5, segments: 16, smooth: true} }
      "tow_{s}" : FlIron { Position: {sx * 3.4, 0, -12}; Rotation: {0, sx * 0.3, 0}; Box: {1, 1, 9} }
    }
    FlBell eng_p(power: thrust, r: 3, seed: 61) { Position: {-12.4, 0, -13.7} }
    FlBell eng_s(power: thrust, r: 3, seed: 62) { Position: {12.4, 0, -13.7} }
    hitch : FlIron { Position: {0, 0, -16}; Box: {4, 4, 3} }
    if n > 0 {
      cable : FlSteel { Position: {0, 0, -22}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 10, radius: 0.4, segments: 8} }
    }
    for i in 0..n {
      "unit_{i}" : FlCont { Position: {0, 0, -42 - i * 34}; Box: {24, 24, 30}; TextureMapping: {MappingObject, size: 24, blend: 0}; TextureTransform: {1, 1, i * 0.37, i * 0.21} }
      "link_{i}" : FlIron { Position: {0, 0, -25.6 - i * 34}; Box: {5, 5, 3.2} }
      "frame_{i}" : FlIron { Position: {0, 0, -42 - i * 34}; Box: {25.4, 25.4, 1.6} }
      "lamp_{i}" : FlBlinkA { Position: {0, 13.2, -42 - i * 34}; Sphere: {radius: 0.6, segments: 6}; Animator: {clip: fl_blink_clip, time: i * 0.3} }
    }
    rcs_p { Position: {-7.1, 3, 8}; Rotation: {0, PI, 0}; FlPuff pod(power: rcs, size: 0.6) }
    rcs_s { Position: {7.1, 3, 8}; FlPuff pod(power: rcs, size: 0.6) }
    if lights > 0.05 {
      nav_p : FlLampR { Position: {-15.9, 0, -2}; Sphere: {radius: 0.4, segments: 6} }
      nav_s : FlLampG { Position: {15.9, 0, -2}; Sphere: {radius: 0.4, segments: 6} }
      strobe : FlStrobe { Position: {0, 13.4, -3}; Sphere: {radius: 0.4, segments: 6} }
      work : FlLampW { Position: {0, 5, -6.2}; Box: {6, 0.5, 0.3} }
    }
  }

  template FlPatrol {
    prop thrust: f32 = 0
    prop rcs: f32 = 0
    prop livery: Rgb = {90, 110, 70}
    prop lights: f32 = 1

    SpatialIgnore
    hull : FlHullFine { Position: {0, 0, 1}; Box: {7, 5, 30}; Bevel: {radius: 1.2, segments: 1}; Rgb: {112, 120, 100} }
    prow : FlHullFine { Position: {0, -0.4, 17.4}; Scale: {1, 1, 2}; Box: {7, 4.2, 3.4}; Bevel: {front_left: 2.6, front_right: 2.6, top_front: 1.6, bottom_front: 1, segments: 1}; Rgb: {112, 120, 100} }
    band { Position: {0, 0, 4}; Box: {7.2, 5.2, 3}; Bevel: {radius: 1.2, segments: 1}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    canopy : FlGlassCool { Position: {0, 2.4, 10}; Box: {3.4, 1.4, 6}; Bevel: {top_front: 1.2, top_back: 0.6, segments: 1}; Emissive: {strength: 1.4 * lights, color: {130, 200, 255}} }
    spine : FlHullFineDark { Position: {0, 2.9, -5}; Box: {3, 1, 14} }
    for s in 0..2 {
      const sx: f32 = s == 0 ? -1 : 1
      "spon_{s}" : FlHullFineDark { Position: {sx * 5.3, -0.8, -3}; Box: {3.8, 2.6, 16}; Bevel: {front_left: 1, front_right: 1, segments: 1}; Rgb: {70, 78, 62} }
      "gun_{s}" : FlIron { Position: {sx * 5.6, -0.8, 9}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 9, radius: 0.34, segments: 8} }
      "gun_tip_{s}" : FlBlack { Position: {sx * 5.6, -0.8, 13.6}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 1.2, radius: 0.5, segments: 8} }
      "wing_{s}" : FlHullFineDark { Position: {sx * 8, -0.8, -9}; Box: {2, 0.4, 7}; Bevel: {front_left: 0.9, front_right: 0.9, segments: 1}; Rgb: {70, 78, 62} }
      "plate_{s}" : FlHullFineDark { Position: {sx * 3.58, 0.2, -6}; Box: {0.2, 3.4, 9}; Rgb: {84, 92, 74} }
    }
    name_text {
      Position: {-3.62, 0.3, 9.4}
      Rotation: {0, 0 - PI / 2, 0}
      Scale: {0.05, 0.05, 0.05}
      Text: {value: "SECTOR PATROL", size: 16, align: Center}
      Rgb: {236, 236, 226}
      NoShadow
    }
    bar_base : FlBlack { Position: {0, 3.6, 2}; Box: {4.4, 0.4, 1.4} }
    FlBell eng_p(power: thrust, r: 1.7, seed: 71) { Position: {-2, 0, -15.5} }
    FlBell eng_s(power: thrust, r: 1.7, seed: 72) { Position: {2, 0, -15.5} }
    port_collar { Position: {-3.5, 0, 0}; FlCollar hatch(r: 1.3, len: 5.5, lights: lights) }
    rcs_p { Position: {-3.6, 1.6, 13}; Rotation: {0, PI, 0}; FlPuff pod(power: rcs, size: 0.4) }
    rcs_s { Position: {3.6, 1.6, 13}; FlPuff pod(power: rcs, size: 0.4) }
    if lights > 0.05 {
      bar_r : FlBlinkR { Position: {-1.2, 4.1, 2}; Box: {1.8, 0.6, 1}; Animator: {clip: fl_blink_clip, speed: 2.4} }
      bar_b : FlBlinkB { Position: {1.2, 4.1, 2}; Box: {1.8, 0.6, 1}; Animator: {clip: fl_blink_clip, speed: 2.4, time: 1.1} }
      nav_p : FlLampR { Position: {-9.1, -0.8, -9}; Sphere: {radius: 0.3, segments: 6} }
      nav_s : FlLampG { Position: {9.1, -0.8, -9}; Sphere: {radius: 0.3, segments: 6} }
      strobe : FlStrobe { Position: {0, 3.8, -11}; Sphere: {radius: 0.3, segments: 6} }
      spot : FlLampW { Position: {0, -2.2, 19.6}; Box: {1.4, 0.5, 0.3} }
    }
  }
}
