  template SpCasino {
    SpatialIgnore
    hull : SxPurple { Position: {0, 0, 0}; RoundedBox: {2.4, 0.7, 4.4, radius: 0.3, segments: 3} }
    deck : SxGold { Position: {0, 0.4, 0}; RoundedBox: {2.1, 0.16, 4, radius: 0.07, segments: 2} }
