using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.light
using box.movement
using box.texture
using box.particle
using box.animation
using box.transition
using box.spatial
using state

terra {
  export const SX_LIGHT_H: f32 = 38
  export const SX_LIGHT_POWER: f32 = 15000
  export const SX_LANE: Rgb = {90, 170, 255}
  export const SX_WHITE: Rgb = {255, 255, 255}

  fn sx_h(seed: i32, i: i32, salt: i32) -> f32 {
    hash01(seed * 131 + i * 17 + 7, 100 + salt)
  }

  fn sx_mix(a: f32, b: f32, t: f32) -> f32 {
    a + (b - a) * t
  }

  fn sx_accent(i: i32) -> Rgb {
    match i {
      0: {48, 104, 190}
      1: {200, 60, 50}
      2: {60, 170, 130}
      3: {236, 176, 34}
      4: {150, 90, 200}
      _: {255, 150, 30}
    }
  }

  space_env {
    EnvironmentImage: {path: "etc/scenes/space_station/assets/space.hdr"}
    Environment: {resolution: 1024}
  }

  sx_star_noise {
    TextureGen: {
      width: 512, height: 256, seed: 9
      layers: [
        {kind: GenNoise, frequency: 6, octaves: 5, gain: 0.6, amount: 1, seed: 3}
        {kind: GenCells, count: 220, distance: GenEdge, edge: 0.5, amount: 0.35, seed: 5}
      ]
    }
  }

  sx_star_tex {
    TextureGen: {source: sx_star_noise, output: GenAlbedo, colors: [
      {0, {70, 30, 10}}
      {0.35, {170, 96, 50}}
      {0.6, {235, 190, 140}}
      {0.85, {255, 240, 220}}
      {1, {255, 255, 255}}
    ]}
  }

  sx_film_noise {
    TextureGen: {
      width: 256, height: 256, seed: 21
      layers: [
        {kind: GenNoise, frequency: 3, octaves: 4, gain: 0.55, amount: 1, seed: 2}
      ]
    }
  }

  sx_film_tex {
    TextureGen: {source: sx_film_noise, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.38, {4, 14, 40}}
      {0.55, {30, 90, 190}}
      {0.72, {120, 200, 255}}
      {1, {235, 250, 255}}
    ]}
  }

  prefab SxWhite { Rgb: {222, 226, 232}; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
  prefab SxGrey { Rgb: {134, 142, 156}; PbrMaterial: {metallic: 0.7, roughness: 0.45} }
  prefab SxDark { Rgb: {52, 58, 70}; PbrMaterial: {metallic: 0.8, roughness: 0.5} }
  prefab SxBlack { Rgb: {16, 18, 24}; PbrMaterial: {metallic: 0.4, roughness: 0.75} }
  prefab SxYellow { Rgb: {236, 176, 34}; PbrMaterial: {metallic: 0.25, roughness: 0.5} }
  prefab SxAmber { Rgb: {255, 150, 30}; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
  prefab SxOrange { Rgb: {206, 96, 40}; PbrMaterial: {metallic: 0.35, roughness: 0.6} }
  prefab SxRust { Rgb: {128, 70, 46}; PbrMaterial: {metallic: 0.5, roughness: 0.8} }
  prefab SxRed { Rgb: {188, 52, 44}; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
  prefab SxBlue { Rgb: {48, 104, 190}; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
  prefab SxTeal { Rgb: {40, 138, 136}; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
  prefab SxPurple { Rgb: {110, 60, 150}; PbrMaterial: {metallic: 0.4, roughness: 0.4} }
  prefab SxGold { Rgb: {236, 184, 84}; PbrMaterial: {metallic: 1, roughness: 0.3} }
  prefab SxStone { Rgb: {150, 140, 124}; PbrMaterial: {metallic: 0, roughness: 0.95} }
  prefab SxSolar { Rgb: {22, 40, 110}; PbrMaterial: {metallic: 0.7, roughness: 0.22} }
  prefab SxGlass { Rgb: {20, 40, 62}; PbrMaterial: {metallic: 0.6, roughness: 0.1}; Emissive: {strength: 0.8, color: {70, 150, 220}} }
  prefab SxRock { Rgb: {116, 106, 98}; PbrMaterial: {metallic: 0, roughness: 0.96} }
  prefab SxRockDark { Rgb: {78, 72, 70}; PbrMaterial: {metallic: 0, roughness: 0.96} }
  prefab SxRockWarm { Rgb: {138, 112, 88}; PbrMaterial: {metallic: 0.1, roughness: 0.9} }
  prefab SxWindow { Rgb: {40, 30, 16}; Emissive: {strength: 5, color: {255, 214, 150}} }
  prefab SxCyan { Rgb: {10, 30, 40}; Emissive: {strength: 5, color: {90, 210, 255}} }
  prefab SxGreen { Rgb: {8, 30, 12}; Emissive: {strength: 6, color: {90, 255, 120}} }
  prefab SxRedLight { Rgb: {40, 6, 4}; Emissive: {strength: 6, color: {255, 60, 40}} }
  prefab SxAmberLight { Rgb: {40, 24, 4}; Emissive: {strength: 6, color: {255, 170, 40}} }
  prefab SxPink { Rgb: {40, 6, 30}; Emissive: {strength: 6, color: {255, 70, 190}} }
  prefab SxCandle { Rgb: {40, 26, 8}; Emissive: {strength: 3.5, color: {255, 190, 110}} }

  prefab sx_blink_clip {
    AnimationClip: {duration: 1.8}
    strength { AnimationTrack: {component: Emissive, member: "strength", curve: {keys: [{0, 0.3}, {0.05, 9}, {0.28, 9}, {0.4, 0.3}, {1.8, 0.3}]}} }
  }

  prefab sx_pulse_clip {
    AnimationClip: {duration: 2.6}
    strength { AnimationTrack: {component: Emissive, member: "strength", curve: {keys: [{0, 2}, {1.3, 6}, {2.6, 2}]}} }
  }

  prefab SxBeacon { Rgb: {40, 6, 4}; Emissive: {strength: 6, color: {255, 60, 40}}; Animator: {clip: sx_blink_clip} }
  prefab SxBeaconAmber { Rgb: {40, 24, 4}; Emissive: {strength: 6, color: {255, 170, 40}}; Animator: {clip: sx_blink_clip} }
  prefab SxBeaconGreen { Rgb: {8, 30, 12}; Emissive: {strength: 6, color: {90, 255, 120}}; Animator: {clip: sx_pulse_clip} }

  template Star {
    prop kind: i32 = 2
    prop radius: f32 = 3

    const r: f32 = radius * star_size(kind)
    const cr: f32 = star_color_r(kind)
    const cg: f32 = star_color_g(kind)
    const cb: f32 = star_color_b(kind)

    key {
      Position: {0, SX_LIGHT_H, 0}
      PointLight: {intensity: SX_LIGHT_POWER, range: 500}
      Rgb: {sx_mix(cr, 255, 0.6), sx_mix(cg, 250, 0.6), sx_mix(cb, 244, 0.6)}
    }
    under {
      Position: {0, 0 - SX_LIGHT_H, 0}
      PointLight: {intensity: SX_LIGHT_POWER * 0.3, range: 500}
      Rgb: {sx_mix(cr, 255, 0.4), sx_mix(cg, 250, 0.4), sx_mix(cb, 244, 0.4)}
    }
    core {
      Position: {0, 0, 0}
      AngularVelocity: {0, 0.03, 0}
      Sphere: {radius: r, segments: 40, smooth: true}
      Rgb: {0, 0, 0}
      PbrMaterial: {metallic: 0, roughness: 1}
      Emissive: {strength: 7, color: {cr, cg, cb}}
      PbrTextures: {emissive: sx_star_tex}
      TextureTransform: {scale_x: 2, scale_y: 1}
      NoShadow
      SpatialIgnore
    }
    boil {
      Position: {0, 0, 0}
      Rotation: {0.4, 0, 0.3}
      AngularVelocity: {0, -0.045, 0.01}
      Sphere: {radius: r * 1.03, segments: 40, smooth: true}
      Rgb: {0, 0, 0}
      PbrMaterial: {metallic: 0, roughness: 1}
      Emissive: {strength: 3, color: {cr, cg, cb}}
      PbrTextures: {emissive: sx_star_tex}
      TextureTransform: {scale_x: 3, scale_y: 2, offset_x: 0.37}
      Fresnel: {color: {cr, cg, cb}, strength: 6, power: 2.2}
      BlendMode: Additive
      NoShadow
      SpatialIgnore
    }
    corona {
      Position: {0, 0, 0}
      ParticleEmitter: {
        max: 48, rate: 7, shape: EmitterSphere, radius: r * 0.15,
        direction: {0, 0, 0}, speed: {0, 0}, lifetime: {3, 5},
        size: {r * 3.4, r * 5}, opacity: {0.06, 0.11},
        color: {cr, cg, cb}, seed: 5 + kind
      }
      ParticleForces: {gravity: {0, 0, 0}}
      ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive}
      ParticleCurves: {opacity: {keys: [{0, 0}, {0.3, 1}, {0.7, 1}, {1, 0}]}}
      SpatialIgnore
    }
    flares {
      Position: {0, 0, 0}
      ParticleEmitter: {
        max: 260, rate: 46, shape: EmitterSphere, radius: r * 0.98,
        direction: {0, 0, 0}, speed: {0, 0}, radial: {0.25, 1.1}, lifetime: {1.5, 4},
        size: {r * 0.1, r * 0.34}, opacity: {0.3, 0.8},
        color: {sx_mix(cr, 255, 0.3), sx_mix(cg, 255, 0.3), sx_mix(cb, 255, 0.3)}, seed: 11 + kind
      }
      ParticleForces: {gravity: {0, 0, 0}, turbulence: 0.6, turbulence_scale: 0.5}
      ParticleAppearance: {shape: ParticleCircle, blend: ParticleAdditive}
      ParticleCurves: {
        opacity: {keys: [{0, 0}, {0.15, 1}, {1, 0}]}
        size: {keys: [{0, 1}, {1, 0.3}]}
      }
      SpatialIgnore
    }
  }

  template SpStarfield {
    prop seed: i32 = 0
    prop count: i32 = 320

    SpatialIgnore
    for i in 0..count {
      const u: f32 = sx_h(seed, i, 1) * 2 - 1
      const a: f32 = sx_h(seed, i, 2) * 2 * PI
      const d: f32 = 260 + sx_h(seed, i, 3) * 520
      const s: f32 = 0.35 + sx_h(seed, i, 4) * sx_h(seed, i, 5) * 1.2
      const w: f32 = sqrt(max(1 - u * u, 0))
      const tint: f32 = sx_h(seed, i, 6)
      "s_{i}" {
        Position: {cos(a) * w * d, u * d, sin(a) * w * d}
        Rotation: {a, u * 3, 0}
        Box: {s, s, s}
        Rgb: {0, 0, 0}
        Emissive: {strength: 2 + sx_h(seed, i, 7) * 9, color: {tint < 0.3 ? 255 : 200 + tint * 55, 226 + tint * 20, tint < 0.3 ? 200 : 255}}
        NoShadow
      }
    }
  }

  sx_plate_h {
    TextureGen: {
      width: 256, height: 256, seed: 31
      layers: [
        {kind: GenBlocks, courses: 6, per_course: 4, gap: 0.005, stagger: 0.5, softness: 0.008, amount: 0.9, id_amount: 0.1, seed: 2}
      ]
    }
  }

  sx_plate {
    TextureGen: {source: sx_plate_h, output: GenAlbedo, colors: [
      {0, {196, 199, 206}}
      {0.6, {236, 238, 242}}
      {0.9, {244, 245, 248}}
      {1, {255, 255, 255}}
    ]}
  }

  sx_plate_n {
    TextureGen: {source: sx_plate_h, output: GenNormal, strength: 0.45}
  }

  sx_win_h {
    TextureGen: {
      width: 512, height: 512, seed: 12
      layers: [
        {kind: GenBlocks, courses: 16, per_course: 16, gap: 0.044, softness: 0.004, amount: 0.3, id_amount: 0.7, seed: 5}
      ]
    }
  }

  sx_win {
    TextureGen: {source: sx_win_h, output: GenAlbedo, colors: [
      {0, {0, 0, 0}}
      {0.28, {0, 0, 0}}
      {0.3, {6, 9, 16}}
      {0.68, {8, 12, 22}}
      {0.7, {255, 206, 140}}
      {1, {255, 236, 200}}
    ]}
  }

  sx_win_alb {
    TextureGen: {source: sx_win_h, output: GenAlbedo, colors: [
      {0, {62, 68, 84}}
      {0.28, {62, 68, 84}}
      {0.3, {30, 34, 46}}
      {1, {36, 40, 54}}
    ]}
  }

  prefab SxHull { Rgb: {228, 232, 238}; PbrMaterial: {metallic: 0.35, roughness: 0.42}; PbrTextures: {albedo: sx_plate, normal: sx_plate_n}; TextureMapping: {MappingObject, size: 0.9, blend: 0.3} }
  prefab SxHullGrey { Rgb: {150, 158, 172}; PbrMaterial: {metallic: 0.65, roughness: 0.42}; PbrTextures: {albedo: sx_plate, normal: sx_plate_n}; TextureMapping: {MappingObject, size: 0.9, blend: 0.3} }
  prefab SxHullDark { Rgb: {70, 78, 94}; PbrMaterial: {metallic: 0.8, roughness: 0.45}; PbrTextures: {albedo: sx_plate, normal: sx_plate_n}; TextureMapping: {MappingObject, size: 0.9, blend: 0.3} }
  prefab SxHullRust { Rgb: {150, 92, 60}; PbrMaterial: {metallic: 0.5, roughness: 0.75}; PbrTextures: {albedo: sx_plate, normal: sx_plate_n}; TextureMapping: {MappingObject, size: 0.9, blend: 0.3} }
  prefab SxWinBelt { Rgb: {214, 218, 226}; PbrMaterial: {metallic: 0.3, roughness: 0.4}; Emissive: {strength: 3.6, color: {255, 222, 176}}; PbrTextures: {albedo: sx_win_alb, emissive: sx_win}; TextureMapping: {MappingObject, size: 1.9, blend: 0.12} }
  prefab SxStrobe { Rgb: {30, 30, 30}; Emissive: {strength: 6, color: {235, 245, 255}}; Animator: {clip: sx_blink_clip} }
  prefab SxWhiteLight { Rgb: {30, 30, 30}; Emissive: {strength: 5, color: {235, 245, 255}} }
  prefab SxHot { Rgb: {30, 8, 4}; Emissive: {strength: 2.2, color: {255, 90, 40}} }

  template SxEngine {
    prop power: f32 = 0
    prop size: f32 = 0.2
    prop hue: Rgb = {110, 190, 255}

    bell : SxDark {
      Position: {0, 0, 0}
      Rotation: {PI / 2, 0, 0}
      Frustum: {length: size * 1.6, radius_bottom: size, radius_top: size * 0.6, segments: 16, smooth: true}
    }
    lip : SxGrey {
      Position: {0, 0, 0 - size * 0.8}
      Rotation: {PI / 2, 0, 0}
      Torus: {radius: size, tube: size * 0.07, segments: 16, rings: 4}
    }
    glow {
      Position: {0, 0, 0 - size * 0.5}
      Rotation: {PI / 2, 0, 0}
      Cylinder: {length: size * 0.1, radius: size * 0.82, segments: 16}
      Rgb: {0, 0, 0}
      Emissive: {strength: 0.4 + power * 13, color: hue}
      NoShadow
    }
    if power > 0.02 {
      plume {
        Position: {0, 0, 0 - size * (0.6 + 2.6 * power)}
        Scale: {1, 1, 0.4 + 3.6 * power}
        Sphere: {radius: size * 0.76, segments: 14, smooth: true}
        Rgb: {0, 0, 0}
        Emissive: {strength: 1.3, color: hue}
        BlendMode: Additive
        NoShadow
      }
      jet {
        Position: {0, 0, 0 - size * (0.6 + 1.5 * power)}
        Scale: {1, 1, 0.4 + 3.2 * power}
        Sphere: {radius: size * 0.44, segments: 12, smooth: true}
        Rgb: {0, 0, 0}
        Emissive: {strength: 4.5, color: hue}
        BlendMode: Additive
        NoShadow
      }
    }
  }

  template SxCollar {
    prop size: f32 = 0.26

    tube : SxDark { Position: {0, 0, 0}; Rotation: {0, 0, PI / 2}; Cylinder: {length: size * 1.2, radius: size, segments: 14, smooth: true} }
    face : SxBlack { Position: {size * 0.61, 0, 0}; Rotation: {0, 0, PI / 2}; Cylinder: {length: size * 0.05, radius: size * 0.74, segments: 14} }
    ring : SxGreen { Position: {size * 0.62, 0, 0}; Rotation: {0, 0, PI / 2}; Torus: {radius: size * 0.86, tube: size * 0.07, segments: 16, rings: 4} }
  }

  template SpLiner {
    prop thrust: f32 = 0
    prop livery: Rgb = {255, 150, 30}
    prop detail: i32 = 1

    SpatialIgnore
    hull : SxHull { Position: {0, 0, 0.2}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Capsule: {length: 5, radius: 0.62, segments: 20, smooth: true} }
    belt : SxWinBelt { Position: {0, 0.02, 0.35}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Cylinder: {length: 3.9, radius: 0.632, segments: 20, smooth: true} }
    belt_cap_a : SxHull { Position: {0, 0, 2.38}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Cylinder: {length: 0.12, radius: 0.65, segments: 20, smooth: true} }
    belt_cap_b : SxHull { Position: {0, 0, -1.68}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Cylinder: {length: 0.12, radius: 0.65, segments: 20, smooth: true} }
    nose : SxHull { Position: {0, -0.02, 3.3}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Frustum: {length: 1.4, radius_bottom: 0.6, radius_top: 0.2, segments: 20, smooth: true} }
    tip : SxGrey { Position: {0, -0.02, 4}; Scale: {1.12, 0.92, 1.3}; Sphere: {radius: 0.2, segments: 12, smooth: true} }
    bridge : SxGlass { Position: {0, 0.3, 3}; Scale: {1.5, 0.5, 1.5}; Sphere: {radius: 0.34, segments: 14, smooth: true} }
    stripe { Position: {0, -0.3, 0.3}; Box: {1.36, 0.07, 5}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    nose_band { Position: {0, -0.02, 2.75}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Cylinder: {length: 0.16, radius: 0.615, segments: 20, smooth: true}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    deck : SxHull { Position: {0, 0.62, -0.1}; RoundedBox: {0.84, 0.34, 3.5, radius: 0.12, segments: 3} }
    deck_win : SxWinBelt { Position: {0, 0.63, -0.1}; Box: {0.86, 0.13, 3.2} }
    dome : SxGlass { Position: {0, 0.8, 1.2}; Scale: {1, 0.55, 1.5}; Sphere: {radius: 0.3, segments: 14, smooth: true} }
    keel : SxHullGrey { Position: {0, -0.52, -0.2}; RoundedBox: {0.7, 0.3, 3.8, radius: 0.1, segments: 3} }
    stern : SxHullDark { Position: {0, 0, -3.05}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.95}; Frustum: {length: 1, radius_bottom: 0.82, radius_top: 0.62, segments: 20, smooth: true} }
    stern_band { Position: {0, 0, -2.52}; Rotation: {PI / 2, 0, 0}; Scale: {1.12, 1, 0.92}; Cylinder: {length: 0.1, radius: 0.64, segments: 20, smooth: true}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    fin { Position: {0, 0.74, -2.5}; Rotation: {-0.6, 0, 0}; Box: {0.07, 0.56, 1}; Rgb: livery; PbrMaterial: {metallic: 0.3, roughness: 0.4} }
    fin_low : SxHullGrey { Position: {0, -0.84, -2.5}; Rotation: {0.5, 0, 0}; Box: {0.06, 0.6, 0.9} }
    wing_l : SxHullDark { Position: {-1.3, -0.08, -2.3}; Rotation: {0, 0.5, 0.06}; Box: {1.7, 0.06, 1.2} }
    wing_r : SxHullDark { Position: {1.3, -0.08, -2.3}; Rotation: {0, -0.5, -0.06}; Box: {1.7, 0.06, 1.2} }
    hot_l : SxHot { Position: {-1.42, -0.08, -2.82}; Rotation: {0, 0.5, 0.06}; Box: {1.5, 0.07, 0.1} }
    hot_r : SxHot { Position: {1.42, -0.08, -2.82}; Rotation: {0, -0.5, -0.06}; Box: {1.5, 0.07, 0.1} }
    port_light : SxRedLight { Position: {-2.08, -0.13, -2.75}; Sphere: {radius: 0.07, segments: 8} }
    star_light : SxGreen { Position: {2.08, -0.13, -2.75}; Sphere: {radius: 0.07, segments: 8} }
    strobe_top : SxStrobe { Position: {0, 1.26, -2.98}; Sphere: {radius: 0.06, segments: 8} }
    strobe_low : SxBeacon { Position: {0, -1.14, -2.66}; Sphere: {radius: 0.06, segments: 8} }
    SxCollar collar_r(size: 0.25) { Position: {0.74, -0.05, 1.3} }
    collar_l { Position: {-0.74, -0.05, 1.3}; Rotation: {0, PI, 0}; SxCollar hatch(size: 0.25) }
    SxEngine eng_c(power: thrust, size: 0.42) { Position: {0, 0, -3.9} }
    SxEngine eng_a(power: thrust, size: 0.24) { Position: {-0.56, 0.36, -3.72} }
    SxEngine eng_b(power: thrust, size: 0.24) { Position: {0.56, 0.36, -3.72} }
    SxEngine eng_d(power: thrust, size: 0.24) { Position: {-0.56, -0.36, -3.72} }
    SxEngine eng_e(power: thrust, size: 0.24) { Position: {0.56, -0.36, -3.72} }
    if detail > 0 {
      for i in 0..8 {
        "keel_light_{i}" : SxWhiteLight { Position: {0, -0.68, 1.5 - i * 0.48}; Box: {0.08, 0.02, 0.08} }
      }
      for i in 0..5 {
        "boat_l_{i}" : SxOrange { Position: {-0.66, -0.36, 1.7 - i * 0.62}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 0.26, radius: 0.09, segments: 8, smooth: true} }
        "boat_r_{i}" : SxOrange { Position: {0.66, -0.36, 1.7 - i * 0.62}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 0.26, radius: 0.09, segments: 8, smooth: true} }
      }
      mast : SxGrey { Position: {0, 1.05, 0.2}; Box: {0.03, 0.6, 0.03} }
      mast_bar : SxGrey { Position: {0, 1.2, 0.2}; Box: {0.4, 0.02, 0.02} }
      dish : SxWhite { Position: {0, 0.98, -0.6}; Rotation: {-0.6, 0, 0}; HemiSphere: {radius: 0.2, segments: 12, smooth: true} }
      vent_l : SxBlack { Position: {-0.44, 0.62, -1.4}; Box: {0.02, 0.2, 0.5} }
      vent_r : SxBlack { Position: {0.44, 0.62, -1.4}; Box: {0.02, 0.2, 0.5} }
      rcs_a : SxDark { Position: {0, 0.6, 2.2}; Box: {0.22, 0.08, 0.16} }
      rcs_b : SxDark { Position: {0, -0.62, 2.2}; Box: {0.22, 0.08, 0.16} }
      gear : SxHullDark { Position: {0, -0.72, -1.2}; Box: {0.5, 0.12, 1.2} }
    }
  }

  template SpShuttle {
    prop thrust: f32 = 0
    prop livery: Rgb = {255, 150, 30}
    prop detail: i32 = 1

    SpatialIgnore
