    wall_r : SxHullRust { Position: {0.9, -0.05, 0}; Rotation: {0, 0, -0.18}; Box: {0.12, 1, 3.6} }
    wall_f : SxHullGrey { Position: {0, -0.05, 1.8}; Box: {1.8, 0.9, 0.12} }
    wall_b : SxHullGrey { Position: {0, -0.05, -1.8}; Box: {1.8, 0.9, 0.12} }
    for i in 0..3 {
      "rib_l_{i}" : SxDark { Position: {-1.02, -0.05, -1.1 + i * 1.1}; Rotation: {0, 0, 0.18}; Box: {0.1, 1.1, 0.14} }
      "rib_r_{i}" : SxDark { Position: {1.02, -0.05, -1.1 + i * 1.1}; Rotation: {0, 0, -0.18}; Box: {0.1, 1.1, 0.14} }
    }
    if load > 0.05 {
      for i in 0..9 {
        const tone = i % 3
        if tone == 0 {
          "ore_{i}" : SxRock { Position: {(sx_h(7, i, 31) - 0.5) * 1.1, -0.3 + load * 0.5 + sx_h(7, i, 32) * 0.2, -1.4 + i * 0.35}; Rotation: {i * 1.3, i * 0.7, i}; Scale: {1.2, 0.8, 1}; IcoSphere: {radius: 0.3 + sx_h(7, i, 33) * 0.22, segments: 1} }
        } else if tone == 1 {
          "ore_{i}" : SxRockWarm { Position: {(sx_h(7, i, 31) - 0.5) * 1.1, -0.3 + load * 0.5 + sx_h(7, i, 32) * 0.2, -1.4 + i * 0.35}; Rotation: {i * 1.3, i * 0.7, i}; Scale: {1.2, 0.8, 1}; IcoSphere: {radius: 0.3 + sx_h(7, i, 33) * 0.22, segments: 1} }
        } else {
          "ore_{i}" : SxRockDark { Position: {(sx_h(7, i, 31) - 0.5) * 1.1, -0.3 + load * 0.5 + sx_h(7, i, 32) * 0.2, -1.4 + i * 0.35}; Rotation: {i * 1.3, i * 0.7, i}; Scale: {1.2, 0.8, 1}; IcoSphere: {radius: 0.3 + sx_h(7, i, 33) * 0.22, segments: 1} }
        }
      }
    }
    cab : SxYellow { Position: {0, 0.7, -2.3}; RoundedBox: {1, 0.6, 0.8, radius: 0.1, segments: 2} }
    glass : SxGlass { Position: {0, 0.78, -1.88}; Box: {0.8, 0.26, 0.05} }
    block : SxHullDark { Position: {0, -0.1, -2.4}; Box: {1.9, 1, 1} }
    tip_l : SxRedLight { Position: {-0.96, 0.5, 1.84}; Sphere: {radius: 0.05, segments: 6} }
    tip_r : SxGreen { Position: {0.96, 0.5, 1.84}; Sphere: {radius: 0.05, segments: 6} }
    SxEngine eng_l(power: thrust, size: 0.32, hue: {255, 170, 90}) { Position: {-0.5, -0.1, -3.1} }
    SxEngine eng_r(power: thrust, size: 0.32, hue: {255, 170, 90}) { Position: {0.5, -0.1, -3.1} }
    if detail > 0 {
      crane : SxYellow { Position: {0.5, 1.2, -1.6}; Rotation: {0.5, 0, 0}; Box: {0.1, 0.1, 1.8} }
      claw : SxDark { Position: {0.5, 0.56, -0.86}; Box: {0.3, 0.3, 0.3} }
      strobe : SxBeaconAmber { Position: {0, 1.08, -2.3}; Sphere: {radius: 0.06, segments: 6} }
      flood : SxWhiteLight { Position: {0, 0.44, -1.86}; Box: {0.4, 0.08, 0.04} }
      for i in 0..4 {
        "haz_{i}" : SxYellow { Position: {-0.66 + i * 0.44, -0.05, 1.87}; Rotation: {0, 0, 0.6}; Box: {0.1, 0.7, 0.02} }
      }
    }
  }

