  template SxCargoRow {
    prop tone: i32 = 0

    if tone == 0 {
      a : SxBlue { Position: {-0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      b : SxRust { Position: {0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      c : SxGrey { Position: {-0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
      d : SxTeal { Position: {0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
    } else if tone == 1 {
      a : SxTeal { Position: {-0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      b : SxYellow { Position: {0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      c : SxRed { Position: {-0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
      d : SxWhite { Position: {0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
    } else if tone == 2 {
      a : SxRed { Position: {-0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      b : SxGrey { Position: {0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      c : SxBlue { Position: {-0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
      d : SxOrange { Position: {0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
    } else {
      a : SxWhite { Position: {-0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      b : SxBlue { Position: {0.36, 0.36, 0}; Box: {0.66, 0.66, 0.76} }
      c : SxYellow { Position: {-0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
      d : SxRust { Position: {0.36, -0.36, 0}; Box: {0.66, 0.66, 0.76} }
    }
    rib : SxDark { Position: {0, 0, 0.41}; Box: {1.5, 1.5, 0.05} }
  }

  template SpFreighter {
    prop thrust: f32 = 0
    prop livery: Rgb = {206, 96, 40}
    prop cap: i32 = 1
    prop seed: i32 = 0
    prop detail: i32 = 1

    const rows: i32 = match cap { 0: 1; 1: 2; 2: 4; _: 8 }
    const len: f32 = rows * 0.84
    const bow: f32 = len / 2

    SpatialIgnore
    spine : SxHullDark { Position: {0, 0, 0}; Box: {0.24, 0.24, len + 0.6} }
    for i in 0..rows {
      SxCargoRow "row_{i}"(tone: (i + seed) % 4) { Position: {0, 0, bow - 0.42 - i * 0.84} }
    }
    cab { Position: {0, 0.1, bow + 0.62}; RoundedBox: {1.1, 0.8, 0.9, radius: 0.16, segments: 3}; Rgb: livery; PbrMaterial: {metallic: 0.35, roughness: 0.55} }
    glass : SxGlass { Position: {0, 0.26, bow + 1.04}; Box: {0.86, 0.26, 0.12} }
    chin : SxHullGrey { Position: {0, -0.36, bow + 0.56}; Box: {0.9, 0.3, 1} }
    neck : SxHullDark { Position: {0, 0, bow + 0.1}; Box: {0.6, 0.6, 0.3} }
    block : SxHullDark { Position: {0, 0, 0 - bow - 0.5}; Box: {1.5, 1.1, 0.8} }
    tank_l : SxGrey { Position: {-0.56, 0.66, 0 - bow - 0.45}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 0.5, radius: 0.2, segments: 10, smooth: true} }
    tank_r : SxGrey { Position: {0.56, 0.66, 0 - bow - 0.45}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 0.5, radius: 0.2, segments: 10, smooth: true} }
    tip_l : SxRedLight { Position: {-0.58, 0.1, bow + 1.0}; Sphere: {radius: 0.05, segments: 6} }
    tip_r : SxGreen { Position: {0.58, 0.1, bow + 1.0}; Sphere: {radius: 0.05, segments: 6} }
    SxEngine eng_l(power: thrust, size: 0.34, hue: {255, 170, 90}) { Position: {-0.4, 0, 0 - bow - 1.15} }
    SxEngine eng_r(power: thrust, size: 0.34, hue: {255, 170, 90}) { Position: {0.4, 0, 0 - bow - 1.15} }
    if detail > 0 {
      mast : SxGrey { Position: {0, 0.8, bow + 0.5}; Box: {0.04, 0.7, 0.04} }
      strobe : SxBeaconAmber { Position: {0, 1.18, bow + 0.5}; Sphere: {radius: 0.06, segments: 6} }
      dish : SxWhite { Position: {0.3, 0.6, bow + 0.4}; Rotation: {-0.5, 0.4, 0}; HemiSphere: {radius: 0.16, segments: 10, smooth: true} }
      SxCollar hatch(size: 0.18) { Position: {0.58, -0.1, bow + 0.5} }
      rad_l : SxHot { Position: {-0.77, 0, 0 - bow - 0.5}; Box: {0.03, 0.8, 0.6} }
      rad_r : SxHot { Position: {0.77, 0, 0 - bow - 0.5}; Box: {0.03, 0.8, 0.6} }
      lamp_l : SxWindow { Position: {-0.36, -0.14, bow + 1.08}; Box: {0.18, 0.1, 0.03} }
      lamp_r : SxWindow { Position: {0.36, -0.14, bow + 1.08}; Box: {0.18, 0.1, 0.03} }
      for i in 0..rows {
        "mark_{i}" : SxAmberLight { Position: {0, 0.76, bow - 0.42 - i * 0.84}; Box: {0.08, 0.03, 0.08} }
      }
    }
  }

  template SpBarge {
    prop thrust: f32 = 0
    prop load: f32 = 1
    prop detail: i32 = 1

    SpatialIgnore
    floor_plate : SxHullRust { Position: {0, -0.5, 0}; Box: {1.7, 0.2, 3.6} }
