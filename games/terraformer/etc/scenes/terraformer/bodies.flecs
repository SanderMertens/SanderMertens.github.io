          lamp_a : SxAmberLight { Position: {0, 0.76, 0}; Box: {0.1, 0.04, 0.1} }
          lamp_b : SxRedLight { Position: {0.76, 0, -0.8}; Box: {0.04, 0.1, 0.06} }
        }
      }
