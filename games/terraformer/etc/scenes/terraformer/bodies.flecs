      winch : SxDark { Position: {0, 0.3, -0.5}; Rotation: {0, 0, PI / 2}; Cylinder: {length: 0.5, radius: 0.16, segments: 10, smooth: true} }
      lamp_l : SxWindow { Position: {-0.3, 0.1, 0.83}; Box: {0.16, 0.1, 0.03} }
      lamp_r : SxWindow { Position: {0.3, 0.1, 0.83}; Box: {0.16, 0.1, 0.03} }
    }
  }

