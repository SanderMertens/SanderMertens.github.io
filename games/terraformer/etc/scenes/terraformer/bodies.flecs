  template SpShipLot {
    SpatialIgnore
    slab : SxDark { Position: {0, -0.3, 0}; Box: {5.2, 0.2, 3.4} }
    edge_a : SxYellow { Position: {0, -0.19, 1.66}; Box: {5.2, 0.03, 0.08} }
    edge_b : SxYellow { Position: {0, -0.19, -1.66}; Box: {5.2, 0.03, 0.08} }
    for i in 0..3 {
      "row_a_{i}" { Position: {-1.7 + i * 1.7, 0.06, 0.75}; Rotation: {0, 0.3, 0}; Scale: {0.62, 0.62, 0.62}; SpShuttle ship(detail: 0) }
      "tag_a_{i}" : SxWindow { Position: {-1.7 + i * 1.7, -0.14, 1.5}; Box: {0.6, 0.03, 0.14} }
    }
    row_b_0 { Position: {-1.5, 0.2, -0.8}; Rotation: {0, 1.3, 0}; Scale: {0.4, 0.4, 0.4}; SpFreighter ship(seed: 1, cap: 1, detail: 0) }
    row_b_1 { Position: {1.2, 0.16, -0.8}; Rotation: {0, 1.8, 0}; Scale: {0.42, 0.42, 0.42}; SpLiner ship(detail: 0) }
    office : SxOrange { Position: {2.2, 0.1, -1.25}; Box: {0.7, 0.6, 0.6} }
    office_win : SxWindow { Position: {2.2, 0.16, -0.94}; Box: {0.4, 0.2, 0.03} }
    pole : SxGrey { Position: {-2.4, 0.9, -1.5}; Box: {0.07, 2.2, 0.07} }
    arrow {
      Position: {-2.4, 2.2, -1.5}
      AngularVelocity: {0, 0.8, 0}
      board : SxRed { Position: {0, 0, 0}; Box: {1.2, 0.5, 0.08} }
      face_a : SxAmberLight { Position: {0, 0, 0.05}; Box: {1, 0.3, 0.02} }
      face_b : SxAmberLight { Position: {0, 0, -0.05}; Box: {1, 0.3, 0.02} }
    }
    for i in 0..9 {
      const tone = i % 3
      if tone == 0 {
        "flag_{i}" : SxRedLight { Position: {-2.2 + i * 0.55, 1.5 - abs(i - 4) * 0.06, 1.6}; Box: {0.12, 0.12, 0.02} }
      } else if tone == 1 {
        "flag_{i}" : SxAmberLight { Position: {-2.2 + i * 0.55, 1.5 - abs(i - 4) * 0.06, 1.6}; Box: {0.12, 0.12, 0.02} }
      } else {
        "flag_{i}" : SxCyan { Position: {-2.2 + i * 0.55, 1.5 - abs(i - 4) * 0.06, 1.6}; Box: {0.12, 0.12, 0.02} }
      }
    }
    wire : SxGrey { Position: {0, 1.52, 1.6}; Box: {5, 0.015, 0.015} }
    post_a : SxGrey { Position: {-2.5, 0.65, 1.6}; Box: {0.04, 1.8, 0.04} }
    post_b : SxGrey { Position: {2.5, 0.65, 1.6}; Box: {0.04, 1.8, 0.04} }
  }

  template SpMonastery {
    SpatialIgnore
    rock : SxRockDark { Position: {0, -1.1, 0}; Rotation: {0.2, 0.5, 0}; Scale: {1.3, 0.6, 1.3}; IcoSphere: {radius: 1.9, segments: 2} }
    court : SxStone { Position: {0, -0.3, 0}; Cylinder: {length: 0.24, radius: 2, segments: 24} }
    for i in 0..12 {
      const a = i * PI / 6
      "col_{i}" : SxStone { Position: {cos(a) * 1.7, 0.4, sin(a) * 1.7}; Cylinder: {length: 1.2, radius: 0.09, segments: 8, smooth: true} }
      "candle_{i}" : SxCandle { Position: {cos(a) * 1.5, 0.02, sin(a) * 1.5}; Box: {0.06, 0.2, 0.06} }
    }
    cloister : SxStone { Position: {0, 1.06, 0}; Tube: {radius: 1.87, thickness: 0.34, length: 0.16, segments: 24, smooth: true} }
    keep : SxStone { Position: {0, 0.7, 0}; Cylinder: {length: 1.8, radius: 0.6, segments: 12, smooth: true} }
    keep_win : SxCandle { Position: {0, 0.9, 0.6}; Box: {0.12, 0.5, 0.03} }
    keep_win_b : SxCandle { Position: {0, 0.9, -0.6}; Box: {0.12, 0.5, 0.03} }
    belfry : SxStone { Position: {0, 1.9, 0}; Box: {0.8, 0.6, 0.8} }
    bell : SxGold { Position: {0, 1.86, 0}; Cone: {length: 0.34, radius: 0.22, segments: 10, smooth: true} }
    roof : SxRust { Position: {0, 2.7, 0}; Cone: {length: 1.1, radius: 0.64, segments: 4} }
    ledger : SxGold { Position: {0, 3.4, 0}; Rotation: {0, 0.6, 0}; AngularVelocity: {0, 0.5, 0}; Box: {0.3, 0.38, 0.06} }
  }

  template SpOddity {
    prop kind: i32 = 0

    if kind == 0 {
      SpResearch hull()
    } else if kind == 1 {
      SpCasino hull()
    } else if kind == 2 {
      SpListening hull()
    } else if kind == 3 {
      SpShipLot hull()
    } else {
      SpMonastery hull()
    }
  }
}
