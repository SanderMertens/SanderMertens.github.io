    lamp_r : SxWindow { Position: {0.36, 0.2, 1.18}; Box: {0.16, 0.1, 0.03} }
    if busy {
      beacon : SxBeaconAmber { Position: {0, 0.96, -0.15}; Sphere: {radius: 0.1, segments: 8} }
    } else {
      beacon : SxAmberLight { Position: {0, 0.96, -0.15}; Sphere: {radius: 0.08, segments: 8} }
    }
    SxEngine eng_l(power: thrust, size: 0.24, hue: {255, 180, 90}) { Position: {-0.32, 0.02, -1.05} }
    SxEngine eng_r(power: thrust, size: 0.24, hue: {255, 180, 90}) { Position: {0.32, 0.02, -1.05} }
  }

  template SpCamp {
    prop busy: bool = false

    SpatialIgnore
    SpDozer dozer(busy: busy) { Position: {-0.2, 0, 0}; Rotation: {0, 0.5, 0} }
    hut : SxBlue { Position: {1.9, 0.1, -0.6}; Box: {1.5, 0.7, 0.7} }
    hut_ribs : SxDark { Position: {1.9, 0.1, -0.6}; Box: {1.56, 0.08, 0.74} }
    door : SxGrey { Position: {1.9, 0.02, -0.24}; Box: {0.3, 0.5, 0.03} }
    pane : SxWindow { Position: {2.35, 0.2, -0.24}; Box: {0.26, 0.2, 0.03} }
    aerial : SxGrey { Position: {2.5, 0.75, -0.8}; Box: {0.03, 0.7, 0.03} }
    dish : SxWhite { Position: {1.4, 0.56, -0.7}; Rotation: {0.6, 0.4, 0}; HemiSphere: {radius: 0.2, segments: 10, smooth: true} }
    tether : SxGrey { Position: {0.95, 0, -0.3}; Box: {0.9, 0.03, 0.03} }
    tip : SxBeaconAmber { Position: {2.5, 1.12, -0.8}; Sphere: {radius: 0.05, segments: 6} }
  }

  template SpGate {
    prop charge: f32 = 0
    prop detail: i32 = 1

    const glow: f32 = 2.5 + charge * 11
    const lamp: Rgb = {110 + charge * 145, 210 + charge * 40, 255}

    SpatialIgnore
    ring : SxHullDark {
      Position: {0, 0, 0}
      Rotation: {PI / 2, 0, 0}
      Torus: {radius: 3.1, tube: 0.3, segments: 64, rings: 12, smooth: true}
    }
    lip {
      Position: {0, 0, 0}
      Rotation: {PI / 2, 0, 0}
      Torus: {radius: 2.78, tube: 0.05, segments: 64, rings: 4}
      Rgb: {4, 14, 24}
      Emissive: {strength: glow, color: {90, 200, 255}}
      NoShadow
    }
    for i in 0..8 {
      "seg_{i}" {
        Rotation: {0, 0, i * PI / 4 + PI / 8}
        block : SxHullGrey { Position: {3.14, 0, 0}; Box: {0.74, 1.2, 0.84} }
        plate : SxHull { Position: {3.46, 0, 0}; Box: {0.2, 0.9, 0.96} }
        lamp_a { Position: {3.14, 0, 0.44}; Box: {0.14, 0.7, 0.04}; Rgb: {6, 16, 24}; Emissive: {strength: glow, color: lamp}; NoShadow }
        lamp_b { Position: {3.14, 0, -0.44}; Box: {0.14, 0.7, 0.04}; Rgb: {6, 16, 24}; Emissive: {strength: glow, color: lamp}; NoShadow }
        if detail > 0 {
          vane : SxDark { Position: {2.6, 0, 0}; Rotation: {0, 0, 0}; Box: {0.4, 0.1, 0.5} }
          vane_tip { Position: {2.38, 0, 0}; Box: {0.06, 0.16, 0.4}; Rgb: {6, 16, 24}; Emissive: {strength: glow * 1.2, color: lamp}; NoShadow }
          coil : SxGold { Position: {3.14, 0.72, 0}; Rotation: {PI / 2, 0, 0}; Cylinder: {length: 0.7, radius: 0.12, segments: 10, smooth: true} }
          rib_a : SxDark { Position: {3.3, 0, 0.5}; Box: {0.5, 1.3, 0.05} }
          rib_b : SxDark { Position: {3.3, 0, -0.5}; Box: {0.5, 1.3, 0.05} }
        }
      }
    }
    for i in 0..4 {
      "pylon_{i}" {
        Rotation: {0, 0, i * PI / 2 + PI / 4}
        arm : SxHullDark { Position: {3.9, 0, 0}; Box: {1.1, 0.26, 0.4} }
        pod : SxHull { Position: {4.5, 0, 0}; Rotation: {PI / 2, 0, 0}; Capsule: {length: 0.9, radius: 0.24, segments: 12, smooth: true} }
        tip : SxBeacon { Position: {4.5, 0, 0.74}; Sphere: {radius: 0.07, segments: 6} }
        if detail > 0 {
          tail : SxStrobe { Position: {4.5, 0, -0.74}; Sphere: {radius: 0.05, segments: 6} }
          fin : SxHullGrey { Position: {4.86, 0, 0}; Box: {0.3, 0.05, 0.7} }
        }
      }
    }
    film_a {
      Position: {0, 0, 0.02}
      AngularVelocity: {0, 0, 0.2 + charge * 0.9}
      Circle: {2.78}
      Image: {texture: sx_film_tex}
      Rgb: {110, 170, 255}
      Emissive: {strength: 0.8 + charge * 2.4, color: {90, 170, 255}}
      Opacity: {0.5 + charge * 0.5}
      BlendMode: Additive
      NoShadow
    }
    film_b {
      Position: {0, 0, -0.02}
      Rotation: {0, PI, 0}
      AngularVelocity: {0, 0, 0.15 + charge * 0.7}
      Circle: {2.78}
      Image: {texture: sx_film_tex}
      Rgb: {110, 170, 255}
      Emissive: {strength: 0.8 + charge * 2.4, color: {120, 150, 255}}
      Opacity: {0.5 + charge * 0.5}
      BlendMode: Additive
      NoShadow
    }
    if charge > 0.6 {
      iris_a {
        Position: {0, 0, 0.04}
        Circle: {2.7 * (charge - 0.6) / 0.4}
        Rgb: {0, 0, 0}
        Emissive: {strength: (charge - 0.6) * 12, color: {200, 230, 255}}
        BlendMode: Additive
        NoShadow
      }
      iris_b {
        Position: {0, 0, -0.04}
        Rotation: {0, PI, 0}
        Circle: {2.7 * (charge - 0.6) / 0.4}
        Rgb: {0, 0, 0}
        Emissive: {strength: (charge - 0.6) * 12, color: {200, 230, 255}}
        BlendMode: Additive
        NoShadow
      }
    }
  }

  template SpGateQueue {
    prop queue: i32 = 0
    prop slots: i32 = 4

    SpatialIgnore
    for i in 0..slots {
      "slot_{i}" {
        Position: {5.5, 0, -7 - i * 5}
        buoy : SxHullDark { Position: {0, 0, 0}; Cylinder: {length: 0.5, radius: 0.12, segments: 8, smooth: true} }
        fin_a : SxGrey { Position: {0, -0.36, 0}; Box: {0.4, 0.03, 0.03} }
        fin_b : SxGrey { Position: {0, -0.36, 0}; Box: {0.03, 0.03, 0.4} }
        if i < queue {
          lamp : SxRedLight { Position: {0, 0.34, 0}; Sphere: {radius: 0.12, segments: 8} }
        } else {
          lamp : SxBeaconGreen { Position: {0, 0.34, 0}; Sphere: {radius: 0.12, segments: 8} }
        }
      }
      "lead_{i}" : SxStrobe { Position: {0, -3.6, -7 - i * 5}; Sphere: {radius: 0.07, segments: 6} }
    }
  }

  template SpGateStation {
    prop charge: f32 = 0
    prop queue: i32 = 0
    prop accent: Rgb = {255, 150, 30}
    prop detail: i32 = 1

    SpatialIgnore
    SpGate gate(charge: charge, detail: detail)
    strut : SxHullDark { Position: {0, -3.75, 0}; Box: {0.3, 0.8, 0.3} }
    hab : SxHull { Position: {0, -4.5, 0}; Rotation: {0, 0, PI / 2}; Capsule: {length: 2.6, radius: 0.5, segments: 16, smooth: true} }
    hab_win : SxWinBelt { Position: {0, -4.5, 0}; Rotation: {0, 0, PI / 2}; Cylinder: {length: 1.9, radius: 0.508, segments: 16, smooth: true} }
    hab_band { Position: {-1.1, -4.5, 0}; Rotation: {0, 0, PI / 2}; Cylinder: {length: 0.24, radius: 0.52, segments: 16, smooth: true}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
    hab_band_b { Position: {1.1, -4.5, 0}; Rotation: {0, 0, PI / 2}; Cylinder: {length: 0.24, radius: 0.52, segments: 16, smooth: true}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
    pier : SxHullGrey { Position: {0, -4.5, -1.3}; Box: {0.2, 0.14, 1.8} }
    pad : SxDark { Position: {0, -4.5, -2.3}; Cylinder: {length: 0.1, radius: 0.5, segments: 14} }
    pad_light : SxGreen { Position: {0, -4.43, -2.3}; Torus: {radius: 0.36, tube: 0.025, segments: 16, rings: 4} }
    panel_l : SxSolar { Position: {-2.6, -4.5, 0}; Rotation: {0.5, 0, 0}; Box: {1.5, 0.04, 0.9} }
    panel_r : SxSolar { Position: {2.6, -4.5, 0}; Rotation: {0.5, 0, 0}; Box: {1.5, 0.04, 0.9} }
    mast : SxGrey { Position: {0, -5.4, 0}; Box: {0.05, 0.9, 0.05} }
    mast_tip : SxBeaconGreen { Position: {0, -5.9, 0}; Sphere: {radius: 0.08, segments: 6} }
    if detail > 0 {
      SpGateQueue holding(queue: queue)
      tower : SxHullGrey { Position: {0.9, -3.8, 0}; Box: {0.4, 0.7, 0.4} }
      tower_glass : SxGlass { Position: {0.9, -3.56, 0}; Box: {0.46, 0.16, 0.46} }
      dish : SxWhite { Position: {-0.9, -3.9, 0.1}; Rotation: {0.5, 0.4, 0}; HemiSphere: {radius: 0.3, segments: 12, smooth: true} }
      rod_l : SxGrey { Position: {-1.75, -4.5, 0}; Box: {0.6, 0.06, 0.06} }
      rod_r : SxGrey { Position: {1.75, -4.5, 0}; Box: {0.6, 0.06, 0.06} }
      SxCollar dock(size: 0.2) { Position: {0, -4.5, -3} }
      tank_a : SxGrey { Position: {0.5, -5.1, 0.1}; Rotation: {0, 0, PI / 2}; Capsule: {length: 0.5, radius: 0.16, segments: 10, smooth: true} }
      tank_b : SxGrey { Position: {-0.5, -5.1, 0.1}; Rotation: {0, 0, PI / 2}; Capsule: {length: 0.5, radius: 0.16, segments: 10, smooth: true} }
    }
  }

  template SxPortArm {
    prop reach: f32 = 4.4
    prop accent: Rgb = {48, 104, 190}
    prop detail: i32 = 1

    boom : SxHullGrey { Position: {reach / 2 + 0.3, 0, 0}; Box: {reach - 0.6, 0.22, 0.26} }
    pad : SxHullDark { Position: {reach, 0, 0}; Cylinder: {length: 0.14, radius: 0.7, segments: 16} }
    pad_ring : SxCyan { Position: {reach, 0.08, 0}; Torus: {radius: 0.5, tube: 0.03, segments: 20, rings: 4} }
    pad_red : SxBeacon { Position: {reach + 0.7, 0.06, 0}; Sphere: {radius: 0.07, segments: 6} }
    SxCollar clamp(size: 0.24) { Position: {reach, 0.3, 0}; Rotation: {0, 0, PI / 2} }
    if detail > 0 {
      band { Position: {reach - 0.9, 0, 0}; Box: {0.3, 0.26, 0.3}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
      truss_a : SxGrey { Position: {reach / 2 + 0.3, 0.2, 0}; Box: {reach - 0.8, 0.03, 0.03} }
      truss_b : SxGrey { Position: {reach / 2 + 0.3, -0.2, 0}; Box: {reach - 0.8, 0.03, 0.03} }
      for i in 0..4 {
        "light_{i}" : SxWhiteLight { Position: {1.2 + i * (reach - 2) / 3, 0.12, 0}; Box: {0.08, 0.03, 0.08} }
      }
      cabin : SxHull { Position: {reach - 0.9, 0.3, 0}; Box: {0.5, 0.3, 0.4} }
      cabin_win : SxWindow { Position: {reach - 0.9, 0.32, 0.21}; Box: {0.36, 0.12, 0.02} }
    }
  }

  template SpPort {
    prop tier: i32 = 1
    prop accent: Rgb = {48, 104, 190}
    prop detail: i32 = 1

    const arms: i32 = 2 + tier

    SpatialIgnore
    spindle : SxHull { Position: {0, 0, 0}; Cylinder: {length: 4.6, radius: 0.46, segments: 18, smooth: true} }
    hub : SxHullGrey { Position: {0, 0, 0}; Cylinder: {length: 0.9, radius: 0.9, segments: 24, smooth: true} }
    hub_win : SxWinBelt { Position: {0, 0, 0}; Cylinder: {length: 0.5, radius: 0.91, segments: 24, smooth: true} }
    dome : SxGold { Position: {0, 2.3, 0}; HemiSphere: {radius: 0.62, segments: 18, smooth: true} }
    spire : SxGold { Position: {0, 3.3, 0}; Cone: {length: 1.4, radius: 0.12, segments: 8, smooth: true} }
    spire_tip : SxBeaconGreen { Position: {0, 4.05, 0}; Sphere: {radius: 0.09, segments: 8} }
    foot : SxHullGrey { Position: {0, -2.5, 0}; Frustum: {length: 0.5, radius_bottom: 0.9, radius_top: 0.46, segments: 18, smooth: true} }
    dish : SxWhite { Position: {0, -3, 0}; Rotation: {PI, 0, 0}; HemiSphere: {radius: 0.7, segments: 16, smooth: true} }
    wheel {
      Position: {0, 0, 0}
      AngularVelocity: {0, 0.1, 0}
      rim : SxHull { Position: {0, 0, 0}; Torus: {radius: 2.6, tube: 0.36, segments: 56, rings: 12, smooth: true} }
      rim_win : SxWinBelt { Position: {0, 0, 0}; Tube: {radius: 2.975, thickness: 0.04, length: 0.3, segments: 56, smooth: true} }
      rim_top : SxWinBelt { Position: {0, 0.345, 0}; Tube: {radius: 2.74, thickness: 0.28, length: 0.04, segments: 56, smooth: true} }
      rim_band { Position: {0, -0.2, 0}; Torus: {radius: 2.9, tube: 0.05, segments: 56, rings: 4}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
      for i in 0..4 {
        "spoke_{i}" : SxHullGrey { Position: {0, 0, 0}; Rotation: {0, i * PI / 4, 0}; Box: {5.1, 0.16, 0.22} }
      }
    }
    if tier > 0 {
      upper {
        Position: {0, 1.25, 0}
        AngularVelocity: {0, -0.16, 0}
        rim : SxHull { Position: {0, 0, 0}; Torus: {radius: 1.35, tube: 0.22, segments: 40, rings: 10, smooth: true} }
        rim_win : SxWinBelt { Position: {0, 0, 0}; Tube: {radius: 1.585, thickness: 0.03, length: 0.2, segments: 40, smooth: true} }
        for i in 0..3 {
          "spoke_{i}" : SxHullGrey { Position: {0, 0, 0}; Rotation: {0, i * PI / 3, 0}; Box: {2.7, 0.1, 0.14} }
        }
      }
    }
    if tier > 1 {
      crown {
        Position: {0, -1.05, 0}
        AngularVelocity: {0, 0.07, 0}
        rim : SxHull { Position: {0, 0, 0}; Torus: {radius: 3.6, tube: 0.26, segments: 64, rings: 10, smooth: true} }
        rim_win : SxWinBelt { Position: {0, 0, 0}; Tube: {radius: 3.875, thickness: 0.03, length: 0.22, segments: 64, smooth: true} }
        rim_band { Position: {0, 0.15, 0}; Torus: {radius: 3.8, tube: 0.04, segments: 64, rings: 4}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
        for i in 0..3 {
          "spoke_{i}" : SxHullGrey { Position: {0, 0, 0}; Rotation: {0, i * PI / 3 + 0.3, 0}; Box: {7.1, 0.14, 0.2} }
        }
      }
      gild : SxGold { Position: {0, 1.9, 0}; Torus: {radius: 0.5, tube: 0.06, segments: 20, rings: 6} }
    }
    for i in 0..arms {
      "arm_{i}" {
        Position: {0, -1.7, 0}
        Rotation: {0, i * 2 * PI / arms + PI / 2, 0}
        SxPortArm arm(reach: 4.4 + tier * 0.4, accent: accent, detail: detail)
      }
    }
    wing_l : SxSolar { Position: {-2.4, 2, 0}; Rotation: {0, 0, -0.25}; Box: {2.6, 0.04, 1.1} }
    wing_r : SxSolar { Position: {2.4, 2, 0}; Rotation: {0, 0, 0.25}; Box: {2.6, 0.04, 1.1} }
    band { Position: {0, 1.7, 0}; Cylinder: {length: 0.3, radius: 0.48, segments: 18, smooth: true}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
    if detail > 0 {
      wing_rod_l : SxGrey { Position: {-0.9, 1.9, 0}; Box: {1, 0.06, 0.06} }
      wing_rod_r : SxGrey { Position: {0.9, 1.9, 0}; Box: {1, 0.06, 0.06} }
      neck_win : SxWinBelt { Position: {0, -1, 0}; Cylinder: {length: 0.6, radius: 0.468, segments: 18, smooth: true} }
      for i in 0..6 {
        "tank_{i}" {
          Rotation: {0, i * PI / 3, 0}
          vat : SxGrey { Position: {0.74, -2.05, 0}; Capsule: {length: 0.4, radius: 0.18, segments: 10, smooth: true} }
        }
      }
      aerial_a : SxGrey { Position: {0.3, 2.9, 0}; Box: {0.02, 0.9, 0.02} }
      aerial_b : SxGrey { Position: {-0.24, 2.8, 0.2}; Box: {0.02, 0.7, 0.02} }
      dish_b : SxWhite { Position: {0.5, 2.36, 0.3}; Rotation: {0.7, 0.6, 0}; HemiSphere: {radius: 0.22, segments: 12, smooth: true} }
      low_light : SxBeacon { Position: {0, -3.72, 0}; Sphere: {radius: 0.08, segments: 6} }
    }
  }

  template SpSite {
    prop done: bool = false
    prop progress: f32 = 0.5
    prop bar: bool = false
    prop trade: bool = false
    prop terminal: bool = false
    prop depot: bool = false
    prop accent: Rgb = {255, 150, 30}

    const arc: f32 = clamp(progress, 0.08, 1) * 2 * PI

    SpatialIgnore
    core : SxWhite { Position: {0, 0, 0}; Cylinder: {length: 1.9, radius: 0.5, segments: 14, smooth: true} }
    band { Position: {0, 0.5, 0}; Cylinder: {length: 0.3, radius: 0.52, segments: 14, smooth: true}; Rgb: accent; PbrMaterial: {metallic: 0.3, roughness: 0.45} }
    cap : SxGrey { Position: {0, 1, 0}; HemiSphere: {radius: 0.5, segments: 12, smooth: true} }
    foot : SxGrey { Position: {0, -1.1, 0}; Frustum: {length: 0.3, radius_bottom: 0.3, radius_top: 0.5, segments: 12, smooth: true} }
    if done {
      rim : SxWhite { Position: {0, -0.1, 0}; Torus: {radius: 1.5, tube: 0.24, segments: 36, rings: 8, smooth: true} }
      for i in 0..2 {
        "spoke_{i}" : SxGrey { Position: {0, -0.1, 0}; Rotation: {0, i * PI / 2, 0}; Box: {3, 0.1, 0.14} }
      }
      for i in 0..12 {
        "win_{i}" {
          Rotation: {0, i * PI / 6, 0}
          up : SxWindow { Position: {1.5, 0.15, 0}; Box: {0.22, 0.03, 0.1} }
        }
      }
      panel_l : SxSolar { Position: {-1.5, 1.2, 0}; Rotation: {0, 0, -0.2}; Box: {1.6, 0.04, 0.8} }
      panel_r : SxSolar { Position: {1.5, 1.2, 0}; Rotation: {0, 0, 0.2}; Box: {1.6, 0.04, 0.8} }
      tip : SxBeaconGreen { Position: {0, 1.62, 0}; Sphere: {radius: 0.09, segments: 8} }
      sign : SxAmberLight { Position: {0, 0.5, 0.53}; Box: {0.5, 0.16, 0.03} }
    } else {
      rim : SxGrey {
        Position: {0, -0.1, 0}
        TorusShell: {radius: 1.5, tube: 0.24, ring_start: 0, ring_end: arc, tube_start: 0, tube_end: 2 * PI, thickness: 0.05, rims: true, segments: 36, rings: 8}
      }
      for i in 0..4 {
        const a = i * PI / 2 + PI / 4
        "post_{i}" : SxYellow { Position: {cos(a) * 1.9, 0, sin(a) * 1.9}; Box: {0.06, 2.6, 0.06} }
        "beam_a_{i}" : SxYellow { Position: {cos(a + PI / 4) * 1.343, 1.3, sin(a + PI / 4) * 1.343}; Rotation: {0, PI / 4 - a, 0}; Box: {2.69, 0.05, 0.05} }
        "beam_b_{i}" : SxYellow { Position: {cos(a + PI / 4) * 1.343, -1.3, sin(a + PI / 4) * 1.343}; Rotation: {0, PI / 4 - a, 0}; Box: {2.69, 0.05, 0.05} }
        "lamp_{i}" : SxBeaconAmber { Position: {cos(a) * 1.9, 1.36, sin(a) * 1.9}; Sphere: {radius: 0.07, segments: 6} }
      }
      crane : SxYellow { Position: {0.6, 1.5, 0}; Rotation: {0, 0, 0.5}; Box: {1.8, 0.07, 0.07} }
      hook : SxDark { Position: {1.35, 1.55, 0}; Box: {0.03, 0.7, 0.03} }
      crate : SxOrange { Position: {1.35, 1.15, 0}; Box: {0.3, 0.3, 0.3} }
      sparks {
        Position: {cos(arc) * 1.5, -0.1, sin(arc) * 1.5}
        ParticleEmitter: {
          max: 60, rate: 26, shape: EmitterPoint, direction: {0, 1, 0}, spread: 80, speed: {0.4, 1.6},
          lifetime: {0.25, 0.7}, size: {0.04, 0.1}, opacity: {0.8, 1}, color: {255, 210, 130}, seed: 3
        }
        ParticleForces: {gravity: {0, 0, 0}, drag: 1}
        ParticleAppearance: {blend: ParticleAdditive, stretch: 0.05}
        ParticleCurves: {opacity: {keys: [{0, 1}, {1, 0}]}}
      }
      weld : SxBeaconAmber { Position: {cos(arc) * 1.5, -0.1, sin(arc) * 1.5}; Sphere: {radius: 0.09, segments: 6} }
    }
    if bar {
      bar_pod : SxPurple { Position: {0, -0.55, 0.85}; Sphere: {radius: 0.34, segments: 10, smooth: true} }
      bar_neon : SxPink { Position: {0, -0.55, 0.85}; Torus: {radius: 0.36, tube: 0.03, segments: 16, rings: 4} }
    }
    if trade {
      trade_a : SxBlue { Position: {0.8, -0.6, -0.3}; Box: {0.5, 0.36, 0.36} }
      trade_b : SxRust { Position: {0.8, -0.6, 0.12}; Box: {0.5, 0.36, 0.36} }
      trade_c : SxTeal { Position: {0.8, -0.22, -0.1}; Box: {0.5, 0.36, 0.36} }
    }
    if terminal {
      term_arm : SxGrey { Position: {-1.5, -0.6, 0}; Box: {2.2, 0.12, 0.16} }
      term_pad : SxDark { Position: {-2.7, -0.6, 0}; Cylinder: {length: 0.1, radius: 0.46, segments: 12} }
      term_light : SxGreen { Position: {-2.7, -0.53, 0}; Torus: {radius: 0.32, tube: 0.025, segments: 14, rings: 4} }
    }
    if depot {
      tank_a : SxGrey { Position: {0.3, -0.75, -0.8}; Rotation: {0, 0, PI / 2}; Capsule: {length: 0.7, radius: 0.24, segments: 10, smooth: true} }
      tank_b : SxGrey { Position: {-0.4, -0.75, -0.8}; Rotation: {0, 0, PI / 2}; Capsule: {length: 0.5, radius: 0.24, segments: 10, smooth: true} }
    }
  }

  template SpAsteroids {
    prop seed: i32 = 0
    prop count: i32 = 22
    prop inner: f32 = 2.6
    prop outer: f32 = 7
    prop size: f32 = 0.5
    prop flat: f32 = 0.3

    SpatialIgnore
    AngularVelocity: {0, 0.012, 0}
    for i in 0..count {
      const a: f32 = sx_h(seed, i, 11) * 2 * PI
      const d: f32 = inner + (outer - inner) * sqrt(sx_h(seed, i, 12))
      const s: f32 = size * (0.35 + sx_h(seed, i, 13) * sx_h(seed, i, 14) * 1.5)
      const tone: i32 = floor(sx_h(seed, i, 15) * 3)
      if tone == 0 {
        "rock_{i}" : SxRock {
          Position: {cos(a) * d, (sx_h(seed, i, 16) - 0.5) * 2 * flat * d, sin(a) * d}
          Rotation: {a * 3, a * 7, a * 5}
          AngularVelocity: {0.05 + sx_h(seed, i, 17) * 0.12, 0.04, 0.02}
          Scale: {1 + sx_h(seed, i, 18) * 0.7, 0.66 + sx_h(seed, i, 19) * 0.3, 1}
          IcoSphere: {radius: s, segments: 1}
        }
      } else if tone == 1 {
        "rock_{i}" : SxRockDark {
          Position: {cos(a) * d, (sx_h(seed, i, 16) - 0.5) * 2 * flat * d, sin(a) * d}
          Rotation: {a * 3, a * 7, a * 5}
          AngularVelocity: {0.02, 0.05 + sx_h(seed, i, 17) * 0.1, 0.04}
          Scale: {1 + sx_h(seed, i, 18) * 0.7, 0.66 + sx_h(seed, i, 19) * 0.3, 1}
          IcoSphere: {radius: s, segments: 1}
        }
      } else {
        "rock_{i}" : SxRockWarm {
          Position: {cos(a) * d, (sx_h(seed, i, 16) - 0.5) * 2 * flat * d, sin(a) * d}
          Rotation: {a * 3, a * 7, a * 5}
          AngularVelocity: {0.03, 0.02, 0.05 + sx_h(seed, i, 17) * 0.1}
          Scale: {1 + sx_h(seed, i, 18) * 0.7, 0.66 + sx_h(seed, i, 19) * 0.3, 1}
          IcoSphere: {radius: s, segments: 1}
        }
      }
    }
  }

  template SpBelt {
    prop seed: i32 = 0
    prop count: i32 = 70
    prop radius: f32 = 53
    prop angle: f32 = 0
    prop sweep: f32 = 1.1

    SpatialIgnore
    for i in 0..count {
      const u: f32 = sx_h(seed, i, 21) * 2 - 1
      const a: f32 = angle + u * abs(u) * sweep
      const d: f32 = radius + (sx_h(seed, i, 22) - 0.5) * 7
      const s: f32 = 0.12 + sx_h(seed, i, 23) * sx_h(seed, i, 24) * 0.5
      "b_{i}" : SxRock {
        Position: {cos(a) * d, (sx_h(seed, i, 25) - 0.5) * 1.6, 0 - sin(a) * d}
        Rotation: {a * 5, a * 9, a * 3}
        Scale: {1 + sx_h(seed, i, 26) * 0.6, 0.7, 1}
        IcoSphere: {radius: s, segments: 1}
      }
    }
  }

  template SpMine {
    prop seed: i32 = 0

    SpatialIgnore
    rock : SxRockDark { Position: {0, -0.9, 0}; Rotation: {0.4, 0.8, 0.2}; Scale: {1.35, 0.8, 1.1}; IcoSphere: {radius: 1.7, segments: 2} }
    lump : SxRock { Position: {1.4, -1.2, 0.6}; Rotation: {1, 0.3, 0.5}; Scale: {1, 0.8, 1.1}; IcoSphere: {radius: 0.9, segments: 1} }
    deck : SxDark { Position: {0, 0.36, 0}; Box: {2.6, 0.16, 1.8} }
    deck_edge : SxYellow { Position: {0, 0.46, 0.88}; Box: {2.6, 0.06, 0.06} }
    deck_edge_b : SxYellow { Position: {0, 0.46, -0.88}; Box: {2.6, 0.06, 0.06} }
    for i in 0..4 {
      const sx = i % 2 == 0 ? -1 : 1
      const sz = i < 2 ? -1 : 1
      "leg_{i}" : SxRust { Position: {sx * 0.36, 1.5, sz * 0.36}; Rotation: {0 - sz * 0.1, 0, sx * 0.1}; Box: {0.07, 2.2, 0.07} }
    }
    for i in 0..3 {
      "brace_{i}" : SxRust { Position: {0, 0.9 + i * 0.6, 0}; Box: {0.74 - i * 0.12, 0.05, 0.74 - i * 0.12} }
    }
    head : SxOrange { Position: {0, 2.66, 0}; Box: {0.4, 0.24, 0.4} }
    head_light : SxBeacon { Position: {0, 2.88, 0}; Sphere: {radius: 0.09, segments: 6} }
    drill {
      Position: {0, 0.3, 0}
      AngularVelocity: {0, 2.4, 0}
      shaft : SxGrey { Position: {0, 0.7, 0}; Cylinder: {length: 3.4, radius: 0.09, segments: 8} }
      collar : SxYellow { Position: {0, 0.5, 0}; Box: {0.3, 0.2, 0.3} }
    }
    for i in 0..3 {
      "silo_{i}" : SxGrey { Position: {-0.95 + i * 0.44, 0.86, -0.5}; Cylinder: {length: 0.86, radius: 0.2, segments: 10, smooth: true} }
      "silo_cap_{i}" : SxRust { Position: {-0.95 + i * 0.44, 1.3, -0.5}; HemiSphere: {radius: 0.2, segments: 10, smooth: true} }
    }
    hut : SxOrange { Position: {0.88, 0.7, 0.4}; Box: {0.7, 0.5, 0.6} }
    hut_win : SxWindow { Position: {0.88, 0.76, 0.71}; Box: {0.44, 0.14, 0.03} }
    boom : SxRust { Position: {1.9, 0.9, -0.3}; Rotation: {0, 0.2, 0.32}; Box: {2.4, 0.1, 0.16} }
    boom_tip : SxBeaconAmber { Position: {3, 1.3, -0.52}; Sphere: {radius: 0.07, segments: 6} }
    crate_a : SxRust { Position: {-0.9, 0.62, 0.5}; Box: {0.4, 0.36, 0.4} }
    crate_b : SxBlue { Position: {-0.44, 0.62, 0.56}; Box: {0.4, 0.36, 0.4} }
    crate_c : SxRust { Position: {-0.7, 0.98, 0.52}; Box: {0.4, 0.36, 0.4} }
    flood {
      Position: {0.4, 1.2, 0.86}
      Box: {0.3, 0.12, 0.05}
      Rgb: {40, 36, 30}
      Emissive: {strength: 7, color: {255, 236, 200}}
      NoShadow
    }
    SpAsteroids rocks(seed: seed, count: 26, inner: 3.2, outer: 8.5, size: 0.62)
  }

  template SpResearch {
