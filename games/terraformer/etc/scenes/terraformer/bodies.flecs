    dice_a : SxWhite { Position: {0.6, 0.7, 0.4}; Rotation: {0.3, 0.5, 0.2}; AngularVelocity: {0.4, 0.3, 0.2}; Box: {0.34, 0.34, 0.34} }
    dice_b : SxRed { Position: {-0.5, 0.7, 0.2}; Rotation: {0.1, 0.9, 0.4}; AngularVelocity: {0.2, 0.5, 0.3}; Box: {0.34, 0.34, 0.34} }
    SxEngine eng_l(power: 0, size: 0.3, hue: {255, 90, 200}) { Position: {-0.6, -0.05, -2.3} }
    SxEngine eng_r(power: 0, size: 0.3, hue: {255, 90, 200}) { Position: {0.6, -0.05, -2.3} }
