  template SpListening {
    SpatialIgnore
    body : SxBlack { Position: {0, -0.6, 0}; Cylinder: {length: 1.5, radius: 0.5, segments: 8} }
    skirt : SxDark { Position: {0, -1.5, 0}; Frustum: {length: 0.4, radius_bottom: 0.2, radius_top: 0.5, segments: 8} }
    turn {
      Position: {0, 0.4, 0}
      AngularVelocity: {0, 0.16, 0}
      yoke : SxDark { Position: {0, 0.2, 0}; Box: {0.3, 0.5, 0.3} }
      dish : SxDark { Position: {0, 1.3, 0.3}; Rotation: {0.9, 0, 0}; HemiSphere: {radius: 2.1, segments: 20, smooth: true} }
      dish_in : SxGrey { Position: {0, 1.32, 0.32}; Rotation: {0.9, 0, 0}; Cylinder: {length: 0.03, radius: 2.04, segments: 20} }
      feed : SxGrey { Position: {0, 2.14, 1.34}; Rotation: {0.9, 0, 0}; Box: {0.05, 0.05, 2.5} }
      horn : SxRedLight { Position: {0, 2.86, 2.26}; Sphere: {radius: 0.09, segments: 6} }
    }
    for i in 0..5 {
      const a = i * 2 * PI / 5
      "whip_{i}" : SxGrey { Position: {cos(a) * 0.7, -0.9, sin(a) * 0.7}; Rotation: {sin(a) * 0.5, 0, 0 - cos(a) * 0.5}; Box: {0.025, 2.4, 0.025} }
    }
    eye : SxRedLight { Position: {0, -0.4, 0.51}; Box: {0.3, 0.05, 0.03} }
