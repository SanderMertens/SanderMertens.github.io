include state
include galaxy

using flecs.script
using flecs.script.math
using state

state {
  export const COMPANY: string = "Terraforming? Sure. LLC"
  export const SELL_FACTOR: f64 = 0.75
  export const EMERGENCY_FACTOR: f64 = 4
  export const CLAWBACK_FACTOR: f64 = 1.25
  export const OVERHEAD_DAILY: f64 = 200
  export const HOP_DAYS: f64 = 0.2
  export const JUMP_DAYS: f64 = 1
  export const PORT_ENTER_COST: f64 = 60
  export const CHARTER_COST: f64 = 250
  export const DOZER_PRICE: f64 = 45000
  export const DOZER_DEPOT: f32 = 150
  export const PORT_DEPOT: f32 = 400
  export const RATE_ATM: f32 = 1.5
  export const RATE_WATER: f32 = 1.5
  export const RATE_TEMP: f32 = 1.5
  export const RATE_BIO: f32 = 1.2
  export const STAFF_FOOD: f32 = 1
  export const STAFF_AIR: f32 = 1
  export const SELF_AIR_ATM: f32 = 60
  export const SELF_FOOD_BIO: f32 = 50
  export const SEED_MIN_ATM: f32 = 40
  export const SEED_MIN_WATER: f32 = 30
  export const SEED_TEMP_LO: f32 = 30
  export const SEED_TEMP_HI: f32 = 70
  export const POWER_SLOTS: i32 = 4

  export const S_PORT: i32 = 0
  export const S_BAR: i32 = 1
  export const S_TRADE: i32 = 2
  export const S_PASSENGER: i32 = 3
  export const S_DEPOT: i32 = 4
  export const S_FUSION: i32 = 5
  export const S_ATMO: i32 = 6
  export const S_LASSO: i32 = 7
  export const S_THERMAL: i32 = 8
  export const S_SEEDER: i32 = 9
  export const S_GREENHOUSE: i32 = 10
  export const S_AIRPLANT: i32 = 11
  export const S_PURPOSE: i32 = 12

  fn good_name(g: i32) -> string {
    match g {
      0: "Alloys"
      1: "Machinery"
      2: "Food"
      3: "Air"
      4: "Ice"
      5: "Biostock"
      6: "Reagents"
      _: "Luxuries"
    }
  }

  fn good_blurb(g: i32) -> string {
    match g {
      0: "Structural. Mostly."
      1: "Has moving parts. Keep them moving."
      2: "Technically edible."
      3: "Bottled at the source."
      4: "Water, patiently."
      5: "Seeds, spores, and one confused goat."
      6: "Do not mix. Do not ask."
      _: "Things nobody needs, priced accordingly."
    }
  }

  fn good_base(g: i32) -> f64 {
    match g {
      0: 40
      1: 120
      2: 20
      3: 15
      4: 12
      5: 90
      6: 55
      _: 200
    }
  }

  fn good_r(g: i32) -> i32 {
    match g { 0: 170; 1: 236; 2: 150; 3: 140; 4: 190; 5: 110; 6: 214; _: 255 }
  }

  fn good_g(g: i32) -> i32 {
    match g { 0: 184; 1: 172; 2: 214; 3: 210; 4: 232; 5: 200; 6: 120; _: 206 }
  }

  fn good_b(g: i32) -> i32 {
    match g { 0: 204; 1: 80; 2: 96; 3: 255; 4: 255; 5: 120; 6: 226; _: 92 }
  }

  fn region_factor(s: i32, g: i32) -> f64 {
    0.8 + 0.4 * hash01(s * 8 + g, 71)
  }

  fn price_drift(s: i32, g: i32, day: i32) -> f64 {
    1 + 0.06 * sin(day * 0.11 + hash01(s * 8 + g, 72) * 2 * PI)
  }

  fn kind_factor(kind: i32, g: i32) -> f64 {
    match kind {
      4: g == 2 || g == 3 ? 1.15 : 0.9
      5: g == 0 || g == 4 || g == 6 ? 0.7 : 0.9
      6: g == 7 ? 0.9 : g == 2 ? 1.2 : 0.9
      _: 1
    }
  }

  fn kind_sells(kind: i32, g: i32) -> bool {
    match kind {
      2: true
      3: true
      4: g == 2 || g == 3
      5: g == 0 || g == 4 || g == 6
      6: g == 7 || g == 2
      _: false
    }
  }

  fn poi_sells(poi: i32, g: i32) -> bool {
    g >= 0 && g < N_GOODS && poi_has(poi, 2) && kind_sells(poi_kind(poi), g)
  }

  fn poi_buys(poi: i32, g: i32) -> bool {
    g >= 0 && g < N_GOODS && poi_has(poi, 2)
  }

  fn price_ref(poi: i32, g: i32, day: i32) -> f64 {
    const s = poi_sys(poi)
    const kind = poi_kind(poi)
    kind == 3 ? good_base(g) : good_base(g) * kind_factor(kind, g) * region_factor(s, g) * price_drift(s, g, day)
  }

  fn price_buy(poi: i32, g: i32, day: i32) -> f64 {
    max(1, round(price_ref(poi, g, day)))
  }

  fn price_sell(poi: i32, g: i32, day: i32) -> f64 {
    max(1, floor(price_buy(poi, g, day) * SELL_FACTOR))
  }

  fn struct_ok(k: i32) -> bool {
    k >= 0 && k <= 12
  }

  fn struct_tier(k: i32) -> i32 {
    k < 0 ? -1 : k <= 4 ? 0 : k <= 11 ? 1 : k == 12 ? 2 : -1
  }

  fn purpose_name(i: i32) -> string {
    match i {
      0: "Expansion"
      1: "Leisure"
      2: "Gambling"
      3: "Agriculture"
      4: "Corrections"
      5: "Research"
      6: "Preservation"
      _: "Security"
    }
  }

  fn purpose_brief(i: i32) -> string {
    match i {
      0: "They need somewhere to put people."
      1: "Guests expect a beach. And an ocean to go with it."
      2: "Breathable is enough. Nobody looks outside."
      3: "It has to grow things. On purpose."
      4: "Habitable. Not comfortable."
      5: "They want to study it. It should survive that."
      6: "Make it pristine. From scratch."
      _: "Defensible, stocked, and yesterday."
    }
  }

  fn purpose_struct_name(i: i32) -> string {
    match i {
      0: "Colony Hub"
      1: "Resort Complex"
      2: "Casino"
      3: "Agri-Combine"
      4: "Penitentiary"
      5: "Research Campus"
      6: "Sanctuary"
      _: "Garrison"
    }
  }

  fn purpose_struct_blurb(i: i32) -> string {
    match i {
      0: "Homes for people who have not read the brochure."
      1: "Sun loungers, pre-reserved."
      2: "The house always terraforms."
      3: "Fields. So many fields."
      4: "Guests stay longer."
      5: "For studying things. Any things."
      6: "Nature, under guard."
      _: "Deters visitors."
    }
  }

  fn purpose_client(i: i32) -> i32 {
    match i {
      0: 0
      1: 1
      2: 1
      3: 2
      4: 3
      5: 4
      6: 5
      _: 6
    }
  }

  fn client_name(i: i32) -> string {
    match i {
      0: "Ministry of Elsewhere"
      1: "Helios Leisure Group"
      2: "AgriCorp Unlimited (Limited)"
      3: "Department of Corrections & Amendments"
      4: "The Institute of Things"
      5: "Friends of Nature (Armed)"
      _: "Sector Defense Collective"
    }
  }

  fn client_short(i: i32) -> string {
    match i {
      0: "Ministry"
      1: "Helios"
      2: "AgriCorp"
      3: "Corrections"
      4: "Institute"
      5: "Friends"
      _: "Defense"
    }
  }

  fn purpose_fee(i: i32) -> f64 {
    match i {
      0: 270000
      1: 240000
      2: 130000
      3: 260000
      4: 110000
      5: 150000
      6: 265000
      _: 170000
    }
  }

  fn purpose_days(i: i32) -> i32 {
    match i {
      0: 200
      1: 180
      2: 95
      3: 200
      4: 90
      5: 110
      6: 210
      _: 75
    }
  }

  fn req_atm(i: i32) -> f32 {
    match i {
      0: 80
      1: 70
      2: 30
      3: 60
      4: 25
      5: 40
      6: 70
      _: 40
    }
  }

  fn req_max_atm(i: i32) -> f32 {
    i == 4 ? 45 : 100
  }

  fn req_water(i: i32) -> f32 {
    match i {
      0: 50
      1: 70
      3: 60
      5: 30
      6: 60
      _: 0
    }
  }

  fn req_temp_lo(i: i32) -> f32 {
    match i {
      0: 40
      1: 55
      3: 45
      6: 30
      _: 0
    }
  }

  fn req_temp_hi(i: i32) -> f32 {
    match i {
      0: 60
      1: 70
      3: 60
      6: 70
      _: 100
    }
  }

  fn req_bio(i: i32) -> f32 {
    match i {
      0: 60
      1: 40
      3: 80
      6: 90
      _: 0
    }
  }

  fn req_struct(i: i32) -> i32 {
    i == 7 ? 4 : -1
  }

  fn req_met(i: i32, atm: f32, water: f32, temp: f32, bio: f32) -> bool {
    atm >= req_atm(i) && atm <= req_max_atm(i) && water >= req_water(i) && temp >= req_temp_lo(i) && temp <= req_temp_hi(i) && bio >= req_bio(i)
  }

  fn temp_target(i: i32) -> f32 {
    req_temp_lo(i) <= 0 && req_temp_hi(i) >= 100 ? 50 : (req_temp_lo(i) + req_temp_hi(i)) * 0.5
  }

  fn struct_name(k: i32, purpose: i32) -> string {
    match k {
      0: "Space Port"
      1: "Bar"
      2: "Trade Hub"
      3: "Passenger Terminal"
      4: "Depot Expansion"
      5: "Fusion Plant"
      6: "Atmosphere Processor"
      7: "Comet Lasso"
      8: "Thermal Regulator"
      9: "Biosphere Seeder"
      10: "Greenhouse Dome"
      11: "Air Plant"
      12: purpose_struct_name(purpose)
      _: "Reserved"
    }
  }

  fn struct_blurb(k: i32, purpose: i32) -> string {
    match k {
      0: "A place to land. Everything else is paperwork."
      1: "Morale, served warm."
      2: "Buy low. Sell here."
      3: "People arrive. Some leave."
      4: "More room for things you will need later."
      5: "A small sun in a box. Runs four machines."
      6: "Makes air from Reagents. Do not ask which ones."
      7: "Catches comets. Mostly on purpose."
      8: "A thermostat, but for a planet."
      9: "Plants plants."
      10: "Grows the site's Food."
      11: "Makes the site's Air."
      12: purpose_struct_blurb(purpose)
      _: ""
    }
  }

  fn purpose_cost(purpose: i32, g: i32) -> i32 {
    match purpose {
      0: match g { 0: 200; 1: 60; 7: 20; _: 0 }
      1: match g { 0: 150; 1: 40; 7: 60; _: 0 }
      2: match g { 0: 100; 1: 30; 7: 80; _: 0 }
      3: match g { 0: 120; 1: 80; 5: 40; _: 0 }
      4: match g { 0: 140; 1: 20; _: 0 }
      5: match g { 0: 100; 1: 70; 6: 30; _: 0 }
      6: match g { 0: 60; 1: 20; 5: 60; _: 0 }
      _: match g { 0: 180; 1: 60; _: 0 }
    }
  }

  fn struct_cost(k: i32, purpose: i32, g: i32) -> i32 {
    match k {
      0: match g { 0: 80; 1: 20; _: 0 }
      1: match g { 0: 20; 1: 5; 7: 10; _: 0 }
      2: match g { 0: 30; 1: 10; _: 0 }
      3: match g { 0: 30; 1: 10; _: 0 }
      4: match g { 0: 40; _: 0 }
      5: match g { 0: 60; 1: 30; 6: 10; _: 0 }
      6: match g { 0: 50; 1: 25; 6: 20; _: 0 }
      7: match g { 0: 40; 1: 30; 4: 20; _: 0 }
      8: match g { 0: 50; 1: 30; _: 0 }
      9: match g { 0: 30; 1: 20; 5: 30; _: 0 }
      10: match g { 0: 40; 1: 10; 5: 10; _: 0 }
      11: match g { 0: 30; 1: 15; 6: 10; _: 0 }
      12: purpose_cost(purpose, g)
      _: 0
    }
  }

  fn struct_cost_units(k: i32, purpose: i32) -> i32 {
    struct_cost(k, purpose, 0) + struct_cost(k, purpose, 1) + struct_cost(k, purpose, 2) + struct_cost(k, purpose, 3) + struct_cost(k, purpose, 4) + struct_cost(k, purpose, 5) + struct_cost(k, purpose, 6) + struct_cost(k, purpose, 7)
  }

  fn struct_cost_value(k: i32, purpose: i32) -> f64 {
    struct_cost(k, purpose, 0) * good_base(0) + struct_cost(k, purpose, 1) * good_base(1) + struct_cost(k, purpose, 2) * good_base(2) + struct_cost(k, purpose, 3) * good_base(3) + struct_cost(k, purpose, 4) * good_base(4) + struct_cost(k, purpose, 5) * good_base(5) + struct_cost(k, purpose, 6) * good_base(6) + struct_cost(k, purpose, 7) * good_base(7)
  }

  fn struct_days(k: i32) -> i32 {
    match k {
      0: 8
      1: 3
      2: 4
      3: 4
      4: 3
      5: 6
      6: 5
      7: 5
      8: 5
      9: 5
      10: 4
      11: 4
      12: 9
      _: 0
    }
  }

  fn struct_needs_power(k: i32) -> bool {
    k >= 6 && k <= 9
  }

  fn struct_staffed(k: i32) -> bool {
    k == 1 || k == 2 || k == 3 || k == 12
  }

  fn struct_income(k: i32) -> f64 {
    match k {
      1: 60
      2: 90
      3: 75
      _: 0
    }
  }

  fn struct_eats(k: i32) -> i32 {
    match k {
      6: 6
      7: 4
      9: 5
      _: -1
    }
  }

  fn struct_eats_qty(k: i32) -> f32 {
    match k {
      6: 2
      7: 3
      9: 2
      _: 0
    }
  }

  fn sys_enter_cost(s: i32, run: i32) -> f64 {
    sys_has_port(s) ? PORT_ENTER_COST : CHARTER_COST * pow(2, clamp(run, 1, 12) - 1)
  }

  fn hop_cost() -> f64 {
    25
  }

  fn freighter_cap(tier: i32) -> i32 {
    match tier {
      0: 50
      1: 100
      2: 200
      3: 400
      _: 0
    }
  }

  fn freighter_price(tier: i32) -> f64 {
    freighter_cap(tier) * 300
  }

  fn freighter_name(tier: i32) -> string {
    match tier {
      0: "Errand Runner"
      1: "Workhorse"
      2: "Heavy Hauler"
      _: "Fiscal Event"
    }
  }

  fn freighter_tier(cap: i32) -> i32 {
    cap >= 400 ? 3 : cap >= 200 ? 2 : cap >= 100 ? 1 : 0
  }

  fn freight_fee(units: f64, jumps: i32) -> f64 {
    200 + 6 * units * max(jumps, 1)
  }

  fn freight_fuel(units: f64, jumps: i32) -> f64 {
    units * max(jumps, 1)
  }

  fn freight_days(jumps: i32) -> f64 {
    1.5 * max(jumps, 1) + 0.5
  }

  fn fac_name(fac: i32) -> string {
    match fac {
      1: "Bar"
      2: "Trade Hub"
      4: "Freight Terminal"
      8: "Passenger Terminal"
      16: "Depot"
      32: "Shipyard"
      64: "Site Office"
      _: ""
    }
  }

  fn fac_screen(fac: i32) -> i32 {
    match fac {
      1: 2
      2: 3
      4: 4
      8: 5
      32: 6
      64: 7
      _: 0
    }
  }

  fn screen_fac(scr: i32) -> i32 {
    match scr {
      2: 1
      3: 2
      4: 4
      5: 8
      6: 32
      7: 64
      _: 0
    }
  }

  fn deck_half_x(kind: i32) -> f32 {
    match kind {
      0: 3.5
      1: 5
      2: 18
      3: 14
      4: 9
      5: 11
      _: 9
    }
  }

  fn deck_half_z(kind: i32) -> f32 {
    match kind {
      0: 2.5
      1: 3.5
      2: 11
      3: 9
      4: 6
      5: 7
      _: 6
    }
  }

  fn layer_of(m: i32, scr: i32, t: i32, level: i32) -> i32 {
    scr == 1 && t == 0 ? (level == 0 ? 2 : 1) : m == 1 ? 1 : 0
  }

  fn money_text(v: f64) -> string {
    const a = abs(v)
    const sign = v < 0 ? "-" : ""
    a >= 1000000 ? "{sign}\${a / 1000000:.2}M" : a >= 10000 ? "{sign}\${a / 1000:.1}k" : "{sign}\${a:.0}"
  }
}
