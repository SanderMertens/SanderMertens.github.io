// Button: a push button that taps an action or reports a change when activated.

module box.widgets

using flecs.script
using box.ui
using box.input
using box.picking
using box.layout
using box.geometry
using box.material
using box.text
using box.transition

template HeadlessPressable {
  prop disabled: bool = false

  mut hover = false
  mut down = false
  mut focused = false

  async {
    while true {
      await on.enter(this)
      hover = !disabled
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.press(this)
      down = !disabled
      await on.release(this)
      down = false
    }
  }

  async {
    while true {
      const e = await on.focus(this)
      if e.target == this {
        focused = true
      }
    }
  }

  async {
    while true {
      const e = await on.blur(this)
      if e.target == this {
        focused = false
        down = false
      }
    }
  }

  async {
    while true {
      const e = await on.key_down(this)
      if e.key == " " && !e.repeat {
        down = true
      }
    }
  }

  async {
    while true {
      const e = await on.key_up(this)
      if e.key == " " {
        down = false
      }
    }
  }
}

// Behavior of a push button. A click, Enter or Space activates it: with an action the
// ActionTrigger taps it, without one the button reports a change (ui.changed). Space shows the
// pressed look while it is down. The pointer shows a hand over it, a crossed circle while it is
// disabled.
template HeadlessButton : HeadlessPressable {
  prop label: string = "Button"
  prop action: entity = 0
  prop width: f32 = 0

  if !disabled {
    Focusable
    ActionTrigger: {action: action}
    Cursor: {CursorPointer}
  } else {
    Cursor: {CursorNotAllowed}
  }

  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        down = false
        if !disabled && action == 0 {
          await ui.changed(this)
        }
      }
    }
  }
}

// A push button with a text label. variant is "primary" (the accent), "secondary" (a surface
// with a border), "ghost" (on the surface of a panel, with no surface of its own until hovered)
// or "danger".
template Button : HeadlessButton {
  prop variant: string = "primary"

  const t = box.ui.theme[UiTheme]
  const ring = focused && FocusStatus[FocusStatus].visible
  const pad = t.padding * 1.5
  const filled = variant == "primary" || variant == "danger"
  const edge = ring ? t.focus : t.border

  Layout: {direction: Row, padding: {0, 0, pad, pad}, h: Center, v: Middle}
  LayoutItem: {
    width: {min: width, max: width},
    height: {mode: Fixed, value: t.control_height}
  }
  Rect: {1, 1}
  Rgb: variant == "danger" ? t.danger : filled ? t.accent : down ? t.pressed : hover ? t.hover : t.surface

  // A filled button lightens while hovered and darkens while pressed
  Tint: filled && down ? {0, 0, 0, 60} : {255, 255, 255, filled && hover ? 40 : 0}
  Transition: [Rgb: WidgetFade, Tint: WidgetFade]

  Border: {
    width: ring ? t.focus_width : variant == "secondary" ? 1 : 0,
    radius: t.radius,
    color: {edge.r, edge.g, edge.b, 255}
  }

  if disabled {
    Opacity: {t.disabled_opacity}
  }

  caption {
    Text: {value: label, size: t.font_size}
    Rgb: filled ? t.accent_text : t.text
  }
}
