        if !ruined {
          for v in 0..5 {
            if fract(seed * 3 + v * 0.3) > 0.35 {
              "veg_{v}" : CastleCabbage { Position: {-0.44 + v * 0.22, 0.07, 0}; IcoSphere: {radius: 0.06, segments: 1} }
