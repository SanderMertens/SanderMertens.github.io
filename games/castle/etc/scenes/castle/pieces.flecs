        for p in 0..6 {
          "picket_{p}" : CastleOldWood { Position: {-0.6 + p * 0.24, 0.1, -0.2}; Rotation: {match ruined && p % 2 == 1 { true: 0.6; _: 0 }, 0, 0}; Box: {0.03, 0.2, 0.03} }
        }
        rail : CastleOldWood { Position: {0, 0.14, -0.2}; Box: {1.24, 0.03, 0.02} }
      }
    } else if lvl == 2 {
      const thatch = false
