        door : CastleWood { Position: {0, 0.46, -0.06}; Rotation: {0, match ruined { true: -0.8; _: 0 }, 0}; Box: {0.3, 0.6, 0.03}; TextureTransform: {scale_x: 0.3, scale_y: 0.6} }
        post_a : CastleTimber { Position: {-0.2, 0.42, 0.16}; Box: {0.05, 0.7, 0.05} }
        post_b : CastleTimber { Position: {0.2, 0.42, 0.16}; Box: {0.05, 0.7, 0.05} }
