// State and rules of Castlewright: the plot is a grid of GRID x GRID cells, each holding one piece
// (kind) at a level. Every rule is a function of the kind and level so that the board, the logic
// and the HUD agree on names, costs, food, folk and prestige.

using flecs.script
using flecs.script.math

export const GRID: i32 = 14
export const CELLS: i32 = 196
export const PITCH: f32 = 2
export const HALF: f32 = 14

export const K_EMPTY: i32 = 0
export const K_WALL: i32 = 1
export const K_TOWER: i32 = 2
export const K_GATE: i32 = 3
export const K_KEEP: i32 = 4
export const K_HOUSE: i32 = 5
export const K_FARM: i32 = 6
export const K_SMITH: i32 = 7
export const K_QUARRY: i32 = 8
export const K_MOAT: i32 = 9
export const K_TREE: i32 = 10
export const K_PATH: i32 = 11
export const T_DEMOLISH: i32 = 12

export const RANKS: i32 = 6
export const RESEARCH_MAX: i32 = 4
export const MINING_MAX: i32 = 3
export const R_FARMING: i32 = 0
export const R_MINING: i32 = 1
export const FOOD_CAP: f64 = 250
export const STARVE_SECONDS: i32 = 6
export const FARM_SIZE: i32 = 4
export const RAID_SECONDS: i32 = 35
export const RAID_GRACE: i32 = 60

event Build(i: i32)
event Upgrade(i: i32)
event Demolish(i: i32)
event Research(track: i32)
event PickTool(t: i32)
event Toast(text: string)
event RankUp(rank: i32)
event NewRealm()
event ToastShown(until: f64)
event RaidShown(until: f64)
event PanelDisarm(until: f64)

fn kind_name(k: i32) -> string {
  match k {
    1: "Wall"
    2: "Tower"
    3: "Gatehouse"
    4: "Keep"
    5: "Cottage"
    6: "Farm"
    7: "Blacksmith"
    8: "Quarry"
    9: "Moat"
    10: "Tree"
    11: "Path"
    12: "Demolish"
    _: "Meadow"
  }
}

fn piece_name(k: i32, lvl: i32) -> string {
  match k {
    1: match lvl { 1: "Palisade"; 2: "Curtain Wall"; _: "Great Wall" }
    2: match lvl { 1: "Watchtower"; 2: "Tower"; _: "Great Tower" }
    3: match lvl { 1: "Timber Gate"; _: "Gatehouse" }
    4: match lvl { 1: "Tower Keep"; 2: "Stone Keep"; 3: "Great Keep"; _: "Royal Palace" }
    5: match lvl { 1: "Cottage"; 2: "House"; _: "Manor" }
    _: kind_name(k)
  }
}

fn kind_blurb(k: i32) -> string {
  match k {
    1: "A wooden palisade, rebuilt in stone once your keep allows. Walls, towers and gatehouses that close a ring turn the ground inside into a courtyard."
    2: "Round tower. Joins the walls next to it. Select it to raise it, as high as your keep allows."
    3: "A timber gate, rebuilt in stone once your keep allows. Turns to follow the wall it sits in, and closes the ring like a wall does."
    4: "The lord's keep, one per realm. Collects taxes and caps the level of every other piece; the walls and gates rise with it. It eats twice as much food with every level."
    5: "A cottage for 4 folk. Outside the walls bandits raid it for gold; safe inside them it grows into a house, then a manor, eating twice as much food at every step."
    6: "A fenced farm of 4 by 4 cells with a farmhouse. Grows 10 food a second; the blacksmith can research better farming."
    7: "The blacksmith, one per realm. Select it to research farming and quarrying tools, so your fields feed more folk and your quarries cut more stone."
    8: "A stone quarry, dug into a stone deposit where grey rock breaks through the grass. Cuts 1 stone a second; the blacksmith can research better quarrying."
    9: "A moat of still water."
    10: "An oak or a pine. Cheap, and pleasant to look at."
    11: "A cobbled path."
    12: "Tear a piece down and get half of its cost back. Abandoned buildings only give back some stone."
    _: ""
  }
}

fn max_level(k: i32) -> i32 {
  match k {
    1: 3
    2: 3
    3: 2
    4: 4
    5: 3
    _: 1
  }
}

fn cost_gold(k: i32, lvl: i32) -> i32 {
  match k {
    1: match lvl { 1: 3; 2: 10; _: 25 }
    2: 10 + (lvl - 1) * 20
    3: match lvl { 1: 20; _: 25 }
    4: match lvl { 1: 80; 2: 160; 3: 300; _: 500 }
    5: match lvl { 1: 25; 2: 50; _: 110 }
    6: 40
    7: 60
    8: 40
    9: 8
    10: 3
    11: 2
    _: 0
  }
}

fn cost_stone(k: i32, lvl: i32) -> i32 {
  match k {
    1: match lvl { 1: 0; 2: 25; _: 45 }
    2: 30 + (lvl - 1) * 20
    3: match lvl { 1: 0; _: 40 }
    4: match lvl { 1: 120; 2: 200; 3: 320; _: 480 }
    5: match lvl { 1: 5; 2: 25; _: 60 }
    7: 40
    11: 1
    _: 0
  }
}

fn cost_text(k: i32, lvl: i32) -> string {
  const g = cost_gold(k, lvl)
  const s = cost_stone(k, lvl)
  match g > 0 && s > 0 {
    true: "{g}g {s}s"
    _: match g > 0 {
      true: "{g} gold"
      _: match s > 0 {
        true: "{s} stone"
        _: "refund"
      }
    }
  }
}

fn spent_gold(k: i32, lvl: i32) -> i32 {
  match lvl {
    1: cost_gold(k, 1)
    2: cost_gold(k, 1) + cost_gold(k, 2)
    3: cost_gold(k, 1) + cost_gold(k, 2) + cost_gold(k, 3)
    4: cost_gold(k, 1) + cost_gold(k, 2) + cost_gold(k, 3) + cost_gold(k, 4)
    _: 0
  }
}

fn spent_stone(k: i32, lvl: i32) -> i32 {
  match lvl {
    1: cost_stone(k, 1)
    2: cost_stone(k, 1) + cost_stone(k, 2)
    3: cost_stone(k, 1) + cost_stone(k, 2) + cost_stone(k, 3)
    4: cost_stone(k, 1) + cost_stone(k, 2) + cost_stone(k, 3) + cost_stone(k, 4)
    _: 0
  }
}

fn drag_tool(t: i32) -> bool {
  t == 1 || t == 11
}

fn barrier(k: i32) -> bool {
  k == 1 || k == 2 || k == 3
}

fn wooden(k: i32, lvl: i32) -> bool {
  (k == 1 || k == 3) && lvl == 1
}

fn turns(k: i32) -> bool {
  k == 2 || k == 4 || k == 5 || k == 6 || k == 7 || k == 8
}

fn faces_path(r: i32, kn: i32, ke: i32, ks: i32, kw: i32) -> bool {
  match r {
    0: ks == 11
    1: ke == 11
    2: kn == 11
    _: kw == 11
  }
}

fn house_face(r: i32, kn: i32, ke: i32, ks: i32, kw: i32) -> i32 {
  match faces_path(r, kn, ke, ks, kw) {
    true: r
    _: match ks == 11 {
      true: 0
      _: match ke == 11 {
        true: 1
        _: match kn == 11 {
          true: 2
          _: kw == 11 ? 3 : r
        }
      }
    }
  }
}

fn build_face(t: i32, r: i32, kn: i32, ke: i32, ks: i32, kw: i32) -> i32 {
  t == 5 ? house_face(r, kn, ke, ks, kw) : r
}

fn on_line(x: i32, z: i32, a: i32, b: i32) -> bool {
  const ax = a % GRID
  const az = (a - ax) / GRID
  const bx = b % GRID
  const bz = (b - bx) / GRID
  (z == az && z == bz && x >= min(ax, bx) && x <= max(ax, bx)) || (x == ax && x == bx && z >= min(az, bz) && z <= max(az, bz))
}

fn wall_height(k: i32, lvl: i32) -> f32 {
  match k {
    1: 1.2 + lvl * 0.7
    2: 2.6
    3: 2.6
    _: 0
  }
}

fn food_need(k: i32, lvl: i32) -> f64 {
  match k {
    4: match lvl { 1: 4; 2: 8; 3: 16; _: 32 }
    5: match lvl { 1: 1; 2: 2; _: 4 }
    7: 1
    _: 0
  }
}

fn folk_of(k: i32, lvl: i32) -> i32 {
  match k {
    5: match lvl { 1: 4; 2: 9; _: 16 }
    7: 2
    _: 0
  }
}

fn gold_of(k: i32, lvl: i32, safe: bool) -> f64 {
  match k {
    4: lvl * 3
    5: match lvl { 1: safe ? 2 : 1; 2: 4; _: 8 }
    _: 0
  }
}

fn upkeep_of(k: i32) -> f64 {
  match k {
    6: 5
    8: 10
    _: 0
  }
}

fn farm_yield(r: i32) -> f64 {
  10 + r * 5
}

fn hunger_rank(k: i32, lvl: i32) -> i32 {
  match k {
    5: lvl
    7: 4
    4: 5
    _: 0
  }
}

fn keep_folk(lvl: i32) -> i32 {
  match lvl {
    2: 16
    3: 40
    4: 80
    _: 0
  }
}

fn protect_need(lvl: i32) -> f64 {
  match lvl {
    1: 40
    2: 90
    _: 0
  }
}

fn upgrade_lock(k: i32, lvl: i32, keep_lvl: i32, folk: i32, pts: f64, ruined: bool) -> string {
  match ruined {
    true: "Abandoned. Demolish it and build anew."
    _: match max_level(k) <= 1 {
      true: "A {kind_name(k)} has no upgrades."
      _: match lvl >= max_level(k) {
        true: "Fully upgraded."
        _: match k == K_KEEP {
          true: match folk >= keep_folk(lvl + 1) {
            true: ""
            _: "Needs {keep_folk(lvl + 1)} folk in the realm, you have {folk}."
          }
          _: match keep_lvl < lvl + 1 {
            true: match keep_lvl == 0 {
              true: "Needs a keep of level {lvl + 1}. Build a keep first."
              _: "Needs a keep of level {lvl + 1}. Raise your keep first."
            }
            _: match k == K_HOUSE && pts < protect_need(lvl) {
              true: "Gathering protection inside the walls: {pts:.0} of {protect_need(lvl):.0}."
              _: ""
            }
          }
        }
      }
    }
  }
}

fn raid_loot(lvl: i32) -> f64 {
  15 + lvl * 10
}

fn research_name(r: i32) -> string {
  match r {
    0: "Iron Ploughshares"
    1: "Crop Rotation"
    2: "Horse Collars"
    3: "Three Fields"
    _: ""
  }
}

fn research_blurb(r: i32) -> string {
  match r {
    0: "Iron-shod ploughs cut deeper furrows."
    1: "Beans and clover rest the soil between harvests."
    2: "Padded collars let horses pull the heavy plough."
    3: "One field in three lies fallow, the others feed twice as well."
    _: ""
  }
}

fn research_gold(r: i32) -> i32 {
  match r { 0: 40; 1: 90; 2: 160; _: 260 }
}

fn research_stone(r: i32) -> i32 {
  match r { 0: 20; 1: 50; 2: 90; _: 150 }
}

fn research_time(r: i32) -> f64 {
  match r { 0: 15; 1: 25; 2: 35; _: 45 }
}

fn mining_name(m: i32) -> string {
  match m {
    0: "Iron Wedges"
    1: "Treadwheel Cranes"
    2: "Frame Saws"
    _: ""
  }
}

fn mining_gold(m: i32) -> i32 {
  match m { 0: 50; 1: 100; _: 160 }
}

fn mining_stone(m: i32) -> i32 {
  match m { 0: 100; 1: 200; _: 300 }
}

fn mining_time(m: i32) -> f64 {
  match m { 0: 20; 1: 30; _: 40 }
}

fn quarry_yield(m: i32) -> f64 {
  1 + m * 0.5
}

fn study_max(track: i32) -> i32 {
  match track { 1: MINING_MAX; _: RESEARCH_MAX }
}

fn study_name(track: i32, r: i32) -> string {
  match track { 1: mining_name(r); _: research_name(r) }
}

fn study_gold(track: i32, r: i32) -> i32 {
  match track { 1: mining_gold(r); _: research_gold(r) }
}

fn study_stone(track: i32, r: i32) -> i32 {
  match track { 1: mining_stone(r); _: research_stone(r) }
}

fn study_time(track: i32, r: i32) -> f64 {
  match track { 1: mining_time(r); _: research_time(r) }
}

fn prestige_of(k: i32, lvl: i32, safe: bool) -> f64 {
  match k {
    1: lvl
    2: lvl * 4
    3: 3 + lvl * 3
    4: safe ? lvl * 40 : lvl * 20
    5: match lvl { 1: safe ? 3 : 2; 2: 6; _: 12 }
    6: 3
    7: 4
    8: 1
    9: 1
    10: 1
    _: 0
  }
}

fn rank_need(r: i32) -> f64 {
  match r {
    0: 0
    1: 40
    2: 120
    3: 250
    4: 420
    5: 650
    _: 99999
  }
}

fn rank_name(r: i32) -> string {
  match r {
    0: "Hamlet"
    1: "Motte"
    2: "Fort"
    3: "Castle"
    4: "Stronghold"
    5: "Royal Citadel"
    _: ""
  }
}

fn rank_of(p: f64) -> i32 {
  match p >= rank_need(5) {
    true: 5
    _: match p >= rank_need(4) {
      true: 4
      _: match p >= rank_need(3) {
        true: 3
        _: match p >= rank_need(2) {
          true: 2
          _: p >= rank_need(1) ? 1 : 0
        }
      }
    }
  }
}

fn cell_x(i: i32) -> f32 {
  ((i % GRID) - (GRID - 1) / 2.0) * PITCH
}

fn cell_z(i: i32) -> f32 {
  (floor(i / GRID) - (GRID - 1) / 2.0) * PITCH
}

fn fract(v: f64) -> f64 {
  v - floor(v)
}

fn hash(i: i32) -> f64 {
  fract(sin(i * 12.9898 + 4.1414) * 43758.5453)
}

fn bool_f(b: bool) -> f32 {
  b ? 1 : 0
}

fn signed(v: f64) -> string {
  v >= 0 ? "+{v:.1}" : "{v:.1}"
}

export mut kind: i32[196] = {}
export mut level: i32[196] = {}
export mut inside: bool[196] = {}
export mut abandoned: bool[196] = {}
export mut points: f64[196] = {}
export mut ready: bool[196] = {}
export mut farm_origin: i32[196] = {}
export mut fits4: bool[196] = {}
export mut deposit: bool[196] = {}
export mut facing: i32[196] = {}

export mut tool: i32 = 0
export mut hover_tool: i32 = 0
export mut hover_cell: i32 = -1
export mut build_rot: i32 = 0
export mut selected: i32 = -1
export mut rising: i32 = -1
export mut rising_age: i32 = 0
export mut dragging = false
export mut drag_start: i32 = -1
export mut drag_end: i32 = -1

export mut gold: f64 = 200
export mut stone: f64 = 160
export mut food: f64 = 60
export mut gold_rate: f64 = 0
export mut stone_rate: f64 = 0
export mut food_make: f64 = 0
export mut food_eat: f64 = 0
export mut food_rate: f64 = 0
export mut folk: i32 = 0
export mut farms: i32 = 0
export mut prestige: f64 = 0
export mut rank: i32 = 0
export mut courtyard: i32 = 0
export mut pieces: i32 = 0
export mut keep_cell: i32 = -1
export mut keep_level: i32 = 0
export mut smith_cell: i32 = -1
export mut crowned = false
export mut starving = false
export mut starve_time: i32 = 0

export mut research: i32 = 0
export mut mining: i32 = 0
export mut research_track: i32 = 0
export mut researching = false
export mut research_left: f64 = 0

export mut clock: f64 = 0
export mut toast: string = ""
export mut toast_until: f64 = 0

export mut raid_timer: i32 = 0
export mut raids: i32 = 0
export mut raid_cell: i32 = -1
export mut raid_until: f64 = 0
