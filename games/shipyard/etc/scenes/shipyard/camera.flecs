// The camera orbits the slipway: the right mouse button drags the view around, the wheel zooms,
// the arrow keys turn and tilt, W, A, S and D move the point the view turns around, Q and E lower
// and raise it and Home resets the view.

using flecs.script
using flecs.script.math
using box.app
using box.input
using state

state {
  view_actions {
    Orbit { Action: {description: "Drag to turn the view"}; Binding: {key: MouseRight} }
    TurnLeft { Action: {description: "Turn the view left"}; Binding: {key: Left} }
    TurnRight { Action: {description: "Turn the view right"}; Binding: {key: Right} }
    TiltUp { Action: {description: "Look from higher up"}; Binding: {key: Up} }
    TiltDown { Action: {description: "Look from lower down"}; Binding: {key: Down} }
    PanLeft { Action: {description: "Move the view left"}; Binding: {key: A} }
    PanRight { Action: {description: "Move the view right"}; Binding: {key: D} }
    PanUp { Action: {description: "Move the view forward"}; Binding: {key: W} }
    PanDown { Action: {description: "Move the view back"}; Binding: {key: S} }
    Lower { Action: {description: "Move the view down"}; Binding: {key: Q} }
    Raise { Action: {description: "Move the view up"}; Binding: {key: E} }
    ZoomIn { Action: {description: "Zoom in"}; Binding: {key: Equal}; alt { Binding: {key: KpAdd} } }
    ZoomOut { Action: {description: "Zoom out"}; Binding: {key: Minus}; alt { Binding: {key: KpSubtract} } }
    Home { Action: {description: "Reset the view"}; Binding: {key: Home} }
  }

  export const VIEW_YAW: f32 = 1.02
  export const VIEW_PITCH: f32 = 0.42
  export const VIEW_DIST: f32 = 78
  export const LINER_DIST: f32 = 140

  export mut view_yaw: f32 = VIEW_YAW
  export mut view_pitch: f32 = VIEW_PITCH
  export mut view_dist: f32 = VIEW_DIST
  export mut cam_yaw: f32 = VIEW_YAW
  export mut cam_pitch: f32 = VIEW_PITCH
  export mut cam_dist: f32 = VIEW_DIST
  export mut view_x: f32 = 0
  export mut view_z: f32 = 0
  export mut view_y: f32 = 0
  export mut cam_x: f32 = 0
  export mut cam_y: f32 = 4
  export mut cam_z: f32 = 0

  fn held(b: bool) -> f32 {
    b ? 1 : 0
  }
}

async {
  while true {
    await on.pressed(view_actions.Home)
    view_yaw = VIEW_YAW
    view_pitch = VIEW_PITCH
    view_dist = liner ? LINER_DIST : VIEW_DIST
    view_x = 0
    view_z = 0
    view_y = 0
  }
}

async {
  mut last: f64 = AppStatus[AppStatus].elapsed
  mut was_liner = false
  while true {
    await next_frame()
    const now = AppStatus[AppStatus].elapsed
    const fixed = App[App].delta_time
    const dt = fixed > 0 ? fixed : clamp(now - last, 0.001, 0.1)
    last = now

    if liner != was_liner {
      was_liner = liner
      view_dist = liner ? LINER_DIST : VIEW_DIST
    }

    const turn = held(view_actions.TurnLeft[ActionState].down) - held(view_actions.TurnRight[ActionState].down)
    const tilt = held(view_actions.TiltUp[ActionState].down) - held(view_actions.TiltDown[ActionState].down)
    const px = held(view_actions.PanRight[ActionState].down) - held(view_actions.PanLeft[ActionState].down)
    const pz = held(view_actions.PanDown[ActionState].down) - held(view_actions.PanUp[ActionState].down)
    const py = held(view_actions.Raise[ActionState].down) - held(view_actions.Lower[ActionState].down)
    const zoom = held(view_actions.ZoomOut[ActionState].down) - held(view_actions.ZoomIn[ActionState].down)
    const mouse = Input[Input].mouse

    if px != 0 || pz != 0 {
      const speed = view_dist * 0.6 * dt
      view_x += (cos(view_yaw) * px + sin(view_yaw) * pz) * speed
      view_z += (cos(view_yaw) * pz - sin(view_yaw) * px) * speed
    }
    if py != 0 {
      view_y += py * view_dist * 0.3 * dt
    }
    if turn != 0 {
      view_yaw += turn * 1.4 * dt
    }
    if tilt != 0 {
      view_pitch = clamp(view_pitch + tilt * 0.9 * dt, -0.6, 1.45)
    }
    if view_actions.Orbit[ActionState].down && (mouse.delta.x != 0 || mouse.delta.y != 0) {
      view_yaw -= mouse.delta.x * 0.006
      view_pitch = clamp(view_pitch + mouse.delta.y * 0.004, -0.6, 1.45)
    }
    if zoom != 0 {
      view_dist = max(view_dist * (1 + zoom * 1.2 * dt), 1)
    }
    if mouse.scroll.y != 0 {
      view_dist = max(view_dist * (1 - mouse.scroll.y * 0.08), 1)
    }

    const ease = min(1, dt * 10)
    const target_y = (liner ? AXIS_Y : deck * CH * 0.5 + 2.5) + view_y
    if abs(cam_yaw - view_yaw) > 0.0001 || abs(cam_pitch - view_pitch) > 0.0001 {
      cam_yaw += (view_yaw - cam_yaw) * ease
      cam_pitch += (view_pitch - cam_pitch) * ease
    }
    if abs(cam_dist - view_dist) > 0.001 {
      cam_dist += (view_dist - cam_dist) * ease
    }
    if abs(cam_x - view_x) > 0.001 || abs(cam_z - view_z) > 0.001 {
      cam_x += (view_x - cam_x) * ease
      cam_z += (view_z - cam_z) * ease
    }
    if abs(cam_y - target_y) > 0.001 {
      cam_y += (target_y - cam_y) * ease
    }
  }
}
