using flecs.script
using flecs.script.math
using box.app
using box.camera
using box.view
using box.effects
using box.surface
using box.geometry
using box.input
using box.layout
using box.material
using box.picking
using box.text
using box.texture
using box.transform
using box.transition
using box.ui
using box.widgets
using state

window {}

box {
  ui {
    theme {
      UiTheme: {
        background: {3, 10, 17},
        surface: {5, 16, 26},
        surface_alt: {9, 27, 41},
        border: {34, 86, 110},
        text: {214, 236, 246},
        text_muted: {112, 152, 176},
        accent: {95, 216, 255},
        accent_text: {5, 16, 26},
        hover: {14, 40, 58},
        pressed: {3, 10, 17},
        focus: {170, 238, 255},
        danger: {255, 92, 76},
        selection: {24, 70, 96},
        caret: {214, 236, 246},
        disabled_opacity: 0.38,
        font_size: 13,
        small_font_size: 11,
        heading_font_size: 13,
        radius: 1,
        padding: 8,
        spacing: 6,
        control_height: 26,
        focus_width: 2,
        caret_blink: 0.5
      }
    }
  }
}

assets {
  yard_font_body { Font: {path: "etc/scenes/shipyard/assets/fonts/ChakraPetch-Medium.ttf"} }
  yard_font_title { Font: {path: "etc/scenes/shipyard/assets/fonts/ChakraPetch-SemiBold.ttf"} }
  yard_font_mono { Font: {path: "etc/scenes/shipyard/assets/fonts/ShareTechMono-Regular.ttf"} }
  yard_icon_cockpit { TexturePath: {path: "etc/scenes/shipyard/assets/icons/cockpit.svg", width: 96} }
  yard_icon_hab { TexturePath: {path: "etc/scenes/shipyard/assets/icons/hab.svg", width: 96} }
  yard_icon_life { TexturePath: {path: "etc/scenes/shipyard/assets/icons/life.svg", width: 96} }
  yard_icon_reactor { TexturePath: {path: "etc/scenes/shipyard/assets/icons/reactor.svg", width: 96} }
  yard_icon_radiator { TexturePath: {path: "etc/scenes/shipyard/assets/icons/radiator.svg", width: 96} }
  yard_icon_cargo { TexturePath: {path: "etc/scenes/shipyard/assets/icons/cargo.svg", width: 96} }
  yard_icon_fuel { TexturePath: {path: "etc/scenes/shipyard/assets/icons/fuel.svg", width: 96} }
  yard_icon_weapon { TexturePath: {path: "etc/scenes/shipyard/assets/icons/weapon.svg", width: 96} }
  yard_icon_engine { TexturePath: {path: "etc/scenes/shipyard/assets/icons/engine.svg", width: 96} }
  yard_icon_biome { TexturePath: {path: "etc/scenes/shipyard/assets/icons/biome.svg", width: 96} }
  yard_icon_dock { TexturePath: {path: "etc/scenes/shipyard/assets/icons/dock.svg", width: 96} }
  yard_icon_obs { TexturePath: {path: "etc/scenes/shipyard/assets/icons/obs.svg", width: 96} }
  yard_icon_hull { TexturePath: {path: "etc/scenes/shipyard/assets/icons/hull.svg", width: 96} }
  yard_icon_drill { TexturePath: {path: "etc/scenes/shipyard/assets/icons/drill.svg", width: 96} }
  yard_icon_builder { TexturePath: {path: "etc/scenes/shipyard/assets/icons/builder.svg", width: 96} }
  yard_icon_datacenter { TexturePath: {path: "etc/scenes/shipyard/assets/icons/datacenter.svg", width: 96} }
  yard_icon_autopilot { TexturePath: {path: "etc/scenes/shipyard/assets/icons/autopilot.svg", width: 96} }
  yard_icon_remove { TexturePath: {path: "etc/scenes/shipyard/assets/icons/remove.svg", width: 96} }
  yard_icon_deck { TexturePath: {path: "etc/scenes/shipyard/assets/icons/deck.svg", width: 96} }
  yard_icon_power { TexturePath: {path: "etc/scenes/shipyard/assets/icons/power.svg", width: 96} }
  yard_icon_crew { TexturePath: {path: "etc/scenes/shipyard/assets/icons/crew.svg", width: 96} }
  yard_icon_thrust { TexturePath: {path: "etc/scenes/shipyard/assets/icons/thrust.svg", width: 96} }
  yard_icon_range { TexturePath: {path: "etc/scenes/shipyard/assets/icons/range.svg", width: 96} }
  yard_icon_ok { TexturePath: {path: "etc/scenes/shipyard/assets/icons/ok.svg", width: 96} }
  yard_icon_warn { TexturePath: {path: "etc/scenes/shipyard/assets/icons/warn.svg", width: 96} }
  yard_icon_ship { TexturePath: {path: "etc/scenes/shipyard/assets/icons/ship.svg", width: 96} }
  yard_icon_liner { TexturePath: {path: "etc/scenes/shipyard/assets/icons/liner.svg", width: 96} }
  yard_icon_spine { TexturePath: {path: "etc/scenes/shipyard/assets/icons/spine.svg", width: 96} }
  yard_icon_quarters { TexturePath: {path: "etc/scenes/shipyard/assets/icons/quarters.svg", width: 96} }
  yard_icon_truss { TexturePath: {path: "etc/scenes/shipyard/assets/icons/truss.svg", width: 96} }
  yard_icon_yoke { TexturePath: {path: "etc/scenes/shipyard/assets/icons/yoke.svg", width: 96} }
  yard_icon_bridge { TexturePath: {path: "etc/scenes/shipyard/assets/icons/bridge.svg", width: 96} }
  yard_icon_sensor { TexturePath: {path: "etc/scenes/shipyard/assets/icons/sensor.svg", width: 96} }
  yard_icon_ring { TexturePath: {path: "etc/scenes/shipyard/assets/icons/ring.svg", width: 96} }
  yard_icon_arbor { TexturePath: {path: "etc/scenes/shipyard/assets/icons/arbor.svg", width: 96} }
  yard_icon_core { TexturePath: {path: "etc/scenes/shipyard/assets/icons/core.svg", width: 96} }
  yard_icon_wing { TexturePath: {path: "etc/scenes/shipyard/assets/icons/wing.svg", width: 96} }
  yard_icon_drive { TexturePath: {path: "etc/scenes/shipyard/assets/icons/drive.svg", width: 96} }
  yard_icon_jump { TexturePath: {path: "etc/scenes/shipyard/assets/icons/jump.svg", width: 96} }
  yard_icon_tanks { TexturePath: {path: "etc/scenes/shipyard/assets/icons/tanks.svg", width: 96} }
  yard_icon_freight { TexturePath: {path: "etc/scenes/shipyard/assets/icons/freight.svg", width: 96} }
  yard_icon_hangar { TexturePath: {path: "etc/scenes/shipyard/assets/icons/hangar.svg", width: 96} }
  yard_icon_slip { TexturePath: {path: "etc/scenes/shipyard/assets/icons/slip.svg", width: 96} }
  yard_icon_refinery { TexturePath: {path: "etc/scenes/shipyard/assets/icons/refinery.svg", width: 96} }
  yard_icon_armor { TexturePath: {path: "etc/scenes/shipyard/assets/icons/armor.svg", width: 96} }
  yard_icon_battery { TexturePath: {path: "etc/scenes/shipyard/assets/icons/battery.svg", width: 96} }
  yard_icon_farm { TexturePath: {path: "etc/scenes/shipyard/assets/icons/farm.svg", width: 96} }
}


state {
  export const UI_OK: i32 = 0
  export const UI_WARN: i32 = 1
  export const UI_BAD: i32 = 2
  export const UI_GOOD: i32 = 3
  export const UI_DIM: i32 = 4
  export const UI_MUTED: i32 = 5
  export const UI_NAVY: i32 = 6
  export const UI_TEXT: i32 = 7
  export const UI_HAZARD: i32 = 8
  export const UI_SOFT: i32 = 9

  fn ui_r(s: i32) -> i32 { match s { 0: 95; 1: 255; 2: 255; 3: 110; 4: 14; 5: 64; 6: 5; 8: 226; 9: 112; _: 214 } }
  fn ui_g(s: i32) -> i32 { match s { 0: 216; 1: 179; 2: 92; 3: 232; 4: 36; 5: 96; 6: 16; 8: 169; 9: 152; _: 236 } }
  fn ui_b(s: i32) -> i32 { match s { 0: 255; 1: 71; 2: 76; 3: 150; 4: 52; 5: 116; 6: 26; 8: 28; 9: 176; _: 246 } }

  fn kind_icon(k: i32) -> entity {
    match k {
      1: assets.yard_icon_cockpit
      2: assets.yard_icon_hab
      3: assets.yard_icon_life
      4: assets.yard_icon_reactor
      5: assets.yard_icon_cargo
      6: assets.yard_icon_fuel
      7: assets.yard_icon_weapon
      8: assets.yard_icon_engine
      9: assets.yard_icon_biome
      10: assets.yard_icon_obs
      11: assets.yard_icon_dock
      12: assets.yard_icon_hull
      13: assets.yard_icon_radiator
      14: assets.yard_icon_drill
      15: assets.yard_icon_builder
      16: assets.yard_icon_datacenter
      17: assets.yard_icon_autopilot
      40: assets.yard_icon_bridge
      41: assets.yard_icon_sensor
      42: assets.yard_icon_quarters
      43: assets.yard_icon_ring
      44: assets.yard_icon_arbor
      45: assets.yard_icon_core
      46: assets.yard_icon_wing
      47: assets.yard_icon_jump
      48: assets.yard_icon_drive
      49: assets.yard_icon_tanks
      50: assets.yard_icon_freight
      51: assets.yard_icon_hangar
      52: assets.yard_icon_refinery
      53: assets.yard_icon_slip
      54: assets.yard_icon_truss
      55: assets.yard_icon_yoke
      56: assets.yard_icon_armor
      57: assets.yard_icon_battery
      58: assets.yard_icon_farm
      _: assets.yard_icon_remove
    }
  }

  fn rig_ready() -> bool {
    const hands = counts[K_COCKPIT] * 2 + counts[K_HAB] * 3
    const breath = counts[K_LIFE] * 10 + counts[K_BIOME] * 5
    const gen: f32 = counts[K_POWER] * 30
    const use: f32 = counts[K_COCKPIT] * 2 + counts[K_HAB] + counts[K_LIFE] * 2 + counts[K_CARGO] * 0.5 + counts[K_WEAPON] * 3 + counts[K_ENGINE] * 3 + counts[K_BIOME] + counts[K_OBS] + counts[K_DRILL] * 4 + counts[K_BUILDER] * 2 + counts[K_DATA] * 12 + counts[K_AUTO] * 2
    const crewless = hands == 0 && counts[K_AUTO] > 0
    (counts[K_COCKPIT] > 0 || counts[K_AUTO] > 0) && counts[K_ENGINE] > 0 && gen >= use && use > 0 &&
    counts[K_RADIATOR] >= counts[K_POWER] + counts[K_DATA] && counts[K_DATA] * 60 >= counts[K_AUTO] * 30 + counts[K_BUILDER] * 10 &&
    (crewless || (hands > 0 && breath >= hands)) && (counts[K_DRILL] == 0 || counts[K_CARGO] > 0) && counts[K_FUEL] > 0 &&
    problems == 0 && modules > 0
  }

  fn liner_ready() -> bool {
    const souls = lc(L_QUARTERS) * 60 + lc(L_HABRING) * 900 + lc(L_BRIDGE) * 40 + lc(L_HANGAR) * 30 + lc(L_REFINERY) * 30 + lc(L_FAB) * 30 + lc(L_TURRET) * 15
    const food = lc(L_QUARTERS) * 200 + lc(L_ESTATE) * 400 + lc(L_FARM) * 2400
    const use = liner_power()
    lc(L_BRIDGE) > 0 && lc(L_DRIVE) > 0 && lc(L_JUMP) > 0 && lc(L_TANKS) > 0 &&
    lc(L_REACTOR) * 120 >= use && use > 0 && lc(L_RADIATOR) >= lc(L_REACTOR) + lc(L_JUMP) &&
    souls > 0 && food >= souls && (lc(L_REFINERY) == 0 || lc(L_HANGAR) > 0) &&
    (lc(L_FAB) == 0 || lc(L_REFINERY) + lc(L_CARGO) > 0) && lproblems == 0 && lmodules > 0
  }

  fn lane_name(d: i32) -> string {
    match d { 0: "Core"; 1: "Port"; 2: "Stbd"; 3: "Dorsal"; _: "Ventral" }
  }

  fn op_selected(op: i32, d: i32) -> bool {
    op == OP_DECK + d || (op == OP_LINERS && liner) || (op == OP_RIGS && !liner) ||
    (op == OP_SHOW_UI && show_ui) || (op == OP_SHOW_GANTRY && show_gantry)
  }
}

assets {
  template YardIcon {
    prop icon: entity = 0
    prop size: f32 = 20
    prop state: i32 = 0

    LayoutItem: {width: {mode: Fixed, value: size}, height: {mode: Fixed, value: size}}
    Rect: {1, 1}
    Image: {texture: icon}
    Rgb: {ui_r(state), ui_g(state), ui_b(state)}
  }

  template YardHazard {
    prop w: f32 = 5

    LayoutItem: {width: {mode: Fixed, value: w}, height: {mode: Grow}}
    Rect: {1, 1}
    Image: {texture: yard_tex_hazard}
    ImageSlice: {scale: 0.05, edges: SliceTile, center: SliceTile}
    Border: {radius: 1}
  }

  template YardPanel {
    prop title: string = ""
    prop note: string = ""
    prop width: f32 = 0
    prop spacing: f32 = 8

    Layout: {direction: Column, padding: {10, 12, 12, 12}, spacing: spacing}
    LayoutItem: {width: {min: width, max: width}}
    Rect: {1, 1}
    Rgb: {5, 16, 26}
    Border: {width: 1, radius: 2, color: {34, 86, 110, 255}}
    BoxShadow: {offset_y: -4, blur: 18, spread: 1, color: {0, 0, 0, 160}}
    InputBlocker

    if title != "" {
      heading {
        Layout: {direction: Row, spacing: 8, v: Middle}
        LayoutItem: {width: {mode: Grow}}
        tab {
          Layout: {padding: {2, 2, 7, 7}}
          Rect: {1, 1}
          Rgb: {95, 216, 255}
          Border: {radius: 1}
          name {
            Text: {value: title, size: 12, font: yard_font_title}
            Rgb: {5, 16, 26}
          }
        }
        rail {
          LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 3}}
          Rect: {1, 1}
          Rgb: {28, 74, 96}
        }
        if note != "" {
          aside {
            Text: {value: note, size: 12, font: yard_font_mono}
            Rgb: {112, 152, 176}
          }
        }
      }
    }
  }

  template YardStrip {
    Layout: {direction: Row, padding: {3, 3, 3, 3}, spacing: 2, v: Middle}
    Rect: {1, 1}
    Rgb: {5, 16, 26}
    Border: {width: 1, radius: 2, color: {34, 86, 110, 255}}
    BoxShadow: {offset_y: -3, blur: 14, spread: 1, color: {0, 0, 0, 150}}
    InputBlocker
  }

  template YardStripLabel {
    prop text: string = ""

    Layout: {padding: {0, 0, 8, 6}}
    caption {
      Text: {value: text, size: 10, font: yard_font_title}
      Rgb: {72, 118, 142}
    }
  }

  template YardDivider {
    LayoutItem: {width: {mode: Fixed, value: 1}, height: {mode: Fixed, value: 16}}
    Rect: {1, 1}
    Rgb: {28, 74, 96}
  }

  template YardRule {
    LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 1}}
    Rect: {1, 1}
    Rgb: {18, 48, 64}
  }

  template YardFiller {
    LayoutItem: {width: {mode: Grow}}
  }

  template YardAction : HeadlessButton {
    prop op: i32 = 0

    async {
      while true {
        const e = await on.activate(this)
        if ui.activation(e) == this {
          emit Request(op: op)
        }
      }
    }
  }

  template YardSegmentFace {
    prop op: i32 = 0
    prop label: string = ""
    prop icon: entity = 0
    prop hover: bool = false
    prop down: bool = false

    const selected = op_selected(op, liner ? lane : deck)

    Layout: {direction: Row, padding: {0, 0, 10, 10}, spacing: 6, h: Center, v: Middle}
    LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if selected {
      Rgb: {95, 216, 255}
    } else if down {
      Rgb: {3, 10, 17}
    } else if hover {
      Rgb: {14, 40, 58}
    } else {
      Rgb: {5, 16, 26}
    }
    Border: {radius: 1}
    Transition: [Rgb: {duration: 0.08}]

    if icon != 0 {
      YardIcon glyph(icon: icon, size: 14, state: selected ? UI_NAVY : UI_SOFT)
    }
    name {
      Text: {value: label, size: 12, font: selected ? yard_font_title : yard_font_body}
      if selected {
        Rgb: {5, 16, 26}
      } else if hover {
        Rgb: {214, 236, 246}
      } else {
        Rgb: {150, 184, 204}
      }
    }
  }

  template YardSegment : YardAction {
    prop icon: entity = 0
    prop grow: bool = false

    if grow {
      LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 26}}
    } else {
      LayoutItem: {width: {min: 30}, height: {mode: Fixed, value: 26}}
    }
    Layout: {}

    YardSegmentFace face(op: op, label: label, icon: icon, hover: hover, down: down)
  }

  template YardGhostFace {
    prop label: string = ""
    prop icon: entity = 0
    prop danger: bool = false
    prop hover: bool = false
    prop down: bool = false

    Layout: {direction: Row, padding: {4, 4, danger ? 4 : 10, 10}, spacing: 7, h: Center, v: Middle}
    LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if down {
      Rgb: {3, 10, 17}
    } else if hover {
      Rgb: {14, 40, 58}
    } else {
      Rgb: {5, 16, 26}
    }
    Border: {radius: 1}
    Transition: [Rgb: {duration: 0.08}]

    if danger {
      YardHazard stripe(w: 4)
    }
    if icon != 0 {
      YardIcon glyph(icon: icon, size: 14, state: danger ? UI_HAZARD : UI_SOFT)
    }
    name {
      Text: {value: label, size: 12, font: yard_font_body}
      if hover {
        Rgb: {214, 236, 246}
      } else {
        Rgb: {150, 184, 204}
      }
    }
  }

  template YardGhost : YardAction {
    prop icon: entity = 0
    prop danger: bool = false

    LayoutItem: {height: {mode: Fixed, value: 26}}
    Layout: {}

    YardGhostFace face(label: label, icon: icon, danger: danger, hover: hover, down: down)
  }

  template YardTileFace {
    prop op: i32 = 0
    prop label: string = ""
    prop key_hint: string = ""
    prop hover: bool = false
    prop down: bool = false

    const selected = op == tool
    const danger = op == T_REMOVE

    Layout: {direction: Row, padding: {danger ? 4 : 0, danger ? 4 : 0, danger ? 4 : 8, 6}, spacing: 8, v: Middle}
    LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
    Rect: {1, 1}
    if selected && danger {
      Rgb: {226, 169, 28}
      Border: {width: 1, radius: 1, color: {255, 214, 110, 255}}
    } else if selected {
      Rgb: {95, 216, 255}
      Border: {width: 1, radius: 1, color: {170, 238, 255, 255}}
    } else if down {
      Rgb: {5, 16, 26}
      Border: {width: 1, radius: 1, color: {95, 216, 255, 255}}
    } else if hover {
      Rgb: {14, 40, 58}
      Border: {width: 1, radius: 1, color: {95, 216, 255, 255}}
    } else {
      Rgb: {9, 27, 41}
      Border: {width: 1, radius: 1, color: {22, 58, 78, 255}}
    }
    Transition: [Rgb: {duration: 0.08}]

    if danger {
      YardHazard stripe(w: 5)
    }
    YardIcon glyph(icon: kind_icon(op), size: 16, state: selected ? UI_NAVY : danger ? UI_HAZARD : UI_OK)
    words {
      Layout: {direction: Column}
      LayoutItem: {width: {mode: Grow}}
      name {
        Text: {value: label, size: 12, font: selected ? yard_font_title : yard_font_body}
        if selected {
          Rgb: {5, 16, 26}
        } else {
          Rgb: {214, 236, 246}
        }
      }
    }
    if key_hint != "" {
      hint {
        Layout: {padding: {1, 1, 5, 5}}
        Rect: {1, 1}
        Rgb: {5, 16, 26}
        Border: {width: 1, radius: 1, color: {34, 86, 110, 255}}
        key {
          Text: {value: key_hint, size: 11, font: yard_font_mono}
          Rgb: {150, 184, 204}
        }
      }
    }
  }

  template YardTile : YardAction {
    prop key_hint: string = ""

    LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 30}}
    Layout: {direction: Column}

    YardTileFace face(op: op, label: label, key_hint: key_hint, hover: hover, down: down)
  }

  template YardGroup {
    prop title: string = ""

    Layout: {direction: Column, spacing: 4}
    LayoutItem: {width: {mode: Grow}}
    heading {
      Layout: {direction: Row, spacing: 6, padding: {0, 1, 0, 0}, v: Middle}
      LayoutItem: {width: {mode: Grow}}
      name {
        Text: {value: title, size: 10, font: yard_font_title}
        Rgb: {84, 132, 158}
      }
      YardRule rule()
    }
  }

  template YardTileRow {
    Layout: {direction: Row, spacing: 4}
    LayoutItem: {width: {mode: Grow}}
  }

  template YardMeter {
    prop ratio: f32 = 0
    prop state: i32 = 0

    const fill = clamp(ratio, 0.0, 1.0)

    Layout: {direction: Row}
    LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: 3}}
    Rect: {1, 1}
    Rgb: {ui_r(UI_DIM), ui_g(UI_DIM), ui_b(UI_DIM)}
    lit {
      LayoutItem: {width: {mode: Grow, value: fill, content_min: false}, height: {mode: Grow}}
      Rect: {1, 1}
      Rgb: {ui_r(state), ui_g(state), ui_b(state)}
    }
    unlit {
      LayoutItem: {width: {mode: Grow, value: 1 - fill, content_min: false}}
    }
  }

  template YardStat {
    prop icon: entity = 0
    prop label: string = ""
    prop value: string = ""
    prop ratio: f32 = 0
    prop state: i32 = 0

    const shown = state == UI_OK ? UI_TEXT : state

    Layout: {direction: Column, spacing: 4}
    LayoutItem: {width: {mode: Grow}}
    head {
      Layout: {direction: Row, spacing: 8, v: Middle}
      LayoutItem: {width: {mode: Grow}}
      YardIcon glyph(icon: icon, size: 14, state: state)
      name {
        Text: {value: label, size: 11, font: yard_font_body}
        Rgb: {112, 152, 176}
      }
      gap {
        LayoutItem: {width: {mode: Grow}}
      }
      amount {
        Text: {value: value, size: 13, font: yard_font_mono}
        Rgb: {ui_r(shown), ui_g(shown), ui_b(shown)}
      }
    }
    YardMeter meter(ratio: ratio, state: state)
  }

  template YardCheck {
    prop label: string = ""
    prop ok: bool = false

    Layout: {direction: Row, spacing: 8, v: Middle}
    LayoutItem: {width: {mode: Grow}}
    YardIcon glyph(icon: ok ? yard_icon_ok : yard_icon_warn, size: 13, state: ok ? UI_GOOD : UI_WARN)
    name {
      Text: {value: label, size: 11, font: yard_font_body}
      if ok {
        Rgb: {112, 152, 176}
      } else {
        Rgb: {255, 210, 150}
      }
    }
  }

  template YardVerdict {
    prop label: string = ""
    prop ok: bool = false

    const s = ok ? UI_GOOD : UI_WARN

    Layout: {direction: Row, padding: {4, 4, 8, 8}, spacing: 7, v: Middle}
    LayoutItem: {width: {mode: Grow}}
    Rect: {1, 1}
    Rgb: {ui_r(s), ui_g(s), ui_b(s)}
    Border: {radius: 1}
    YardIcon glyph(icon: ok ? yard_icon_ok : yard_icon_warn, size: 14, state: UI_NAVY)
    name {
      Text: {value: label, size: 12, font: yard_font_title}
      Rgb: {5, 16, 26}
    }
  }

  template ModulesCard : YardPanel {
    YardGroup command(title: "COMMAND") {
      YardTileRow row_a {
        YardTile cockpit(label: liner ? "Bridge" : "Cockpit", op: liner ? L_BRIDGE : K_COCKPIT)
        YardTile autopilot(label: liner ? "Sensor Mast" : "Autopilot", op: liner ? L_SENSOR : K_AUTO)
      }
    }
    YardGroup crew_group(title: liner ? "HABITATION" : "CREW") {
      YardTileRow row_a {
        YardTile hab(label: liner ? "Quarters" : "Habitat", op: liner ? L_QUARTERS : K_HAB)
        YardTile life(label: liner ? "Hab Ring" : "Life Support", op: liner ? L_HABRING : K_LIFE)
      }
      YardTileRow row_b {
        YardTile biome(label: liner ? "Estate Ring" : "Biome", op: liner ? L_ESTATE : K_BIOME)
        if liner {
          YardTile farm(label: "Agri Ring", op: L_FARM)
        } else {
          YardTile obs(label: "Observation", op: K_OBS)
        }
      }
    }
    YardGroup systems(title: liner ? "POWER & JUMP" : "POWER & COMPUTE") {
      YardTileRow row_a {
        YardTile power(label: liner ? "Reactor" : "Power Plant", op: liner ? L_REACTOR : K_POWER)
        YardTile radiator(label: "Radiator", op: liner ? L_RADIATOR : K_RADIATOR)
      }
      YardTileRow row_b {
        YardTile datacenter(label: liner ? "Jump Drive" : "Datacenter", op: liner ? L_JUMP : K_DATA)
        YardFiller filler()
      }
    }
    YardGroup drive(title: "PROPULSION") {
      YardTileRow row_a {
        YardTile engine(label: liner ? "Main Drive" : "Engine", op: liner ? L_DRIVE : K_ENGINE)
        YardTile fuel(label: liner ? "Tank Cluster" : "Fuel Tank", op: liner ? L_TANKS : K_FUEL)
      }
    }
    YardGroup industry(title: "INDUSTRY & LOGISTICS") {
      YardTileRow row_a {
        YardTile cargo(label: liner ? "Container Block" : "Cargo Bay", op: liner ? L_CARGO : K_CARGO)
        YardTile dock(label: liner ? "Hangar" : "Docking Port", op: liner ? L_HANGAR : K_DOCK)
      }
      YardTileRow row_b {
        YardTile drill(label: liner ? "Refinery" : "Mining Drill", op: liner ? L_REFINERY : K_DRILL)
        YardTile builder(label: liner ? "Fab Bay" : "Constructor", op: liner ? L_FAB : K_BUILDER)
      }
    }
    YardGroup hull(title: liner ? "STRUCTURE & DEFENSE" : "HULL & DEFENSE") {
      YardTileRow row_a {
        YardTile fairing(label: liner ? "Armor" : "Hull Fairing", op: liner ? L_ARMOR : K_HULL)
        YardTile weapon(label: liner ? "Gun Turret" : "Weapons", op: liner ? L_TURRET : K_WEAPON)
      }
      if liner {
        YardTileRow row_b {
          YardTile truss(label: "Truss", op: L_TRUSS)
          YardTile yoke(label: "Yoke", op: L_YOKE)
        }
      }
    }
    YardRule remove_rule()
    YardTile remove(label: "Remove", op: T_REMOVE, key_hint: "X")
  }

  template SystemsCard : YardPanel {
    const c1 = counts[1]
    const c2 = counts[2]
    const c3 = counts[3]
    const c4 = counts[4]
    const c5 = counts[5]
    const c6 = counts[6]
    const c7 = counts[7]
    const c8 = counts[8]
    const c9 = counts[9]
    const c10 = counts[10]
    const c13 = counts[13]
    const c14 = counts[14]
    const c15 = counts[15]
    const c16 = counts[16]
    const c17 = counts[17]
    const crew = c1 * 2 + c2 * 3
    const air = c3 * 10 + c9 * 5
    const gen: f32 = c4 * 30
    const use: f32 = c1 * 2 + c2 + c3 * 2 + c5 * 0.5 + c7 * 3 + c8 * 3 + c9 + c10 + c14 * 4 + c15 * 2 + c16 * 12 + c17 * 2
    const mass: f32 = c1 * kind_mass(1) + c2 * kind_mass(2) + c3 * kind_mass(3) + c4 * kind_mass(4) + c5 * kind_mass(5) + c6 * kind_mass(6) + c7 * kind_mass(7) + c8 * kind_mass(8) + c9 * kind_mass(9) + c10 * kind_mass(10) + c13 * kind_mass(13) + c14 * kind_mass(14) + c15 * kind_mass(15) + c16 * kind_mass(16) + c17 * kind_mass(17)
    const accel: f32 = c8 * 260.0 / max(mass, 1)
    const reach: f32 = c6 * 900.0 / max(mass, 1)
    const cgen: f32 = c16 * 60
    const cuse: f32 = c17 * 30 + c15 * 10
    const has_helm = c1 > 0 || c17 > 0
    const crewless = crew == 0 && c17 > 0
    const compute_ok = cgen >= cuse
    const has_drive = c8 > 0
    const power_ok = gen >= use && use > 0
    const air_ok = crewless || (crew > 0 && air >= crew)
    const hold_ok = c14 == 0 || c5 > 0
    const fuel_ok = c6 > 0
    const cool_ok = c13 >= c4 + c16
    const sound = problems == 0 && modules > 0
    const ready = rig_ready()

    const l_bridge = lc(L_BRIDGE)
    const l_quarters = lc(L_QUARTERS)
    const l_habring = lc(L_HABRING)
    const l_estate = lc(L_ESTATE)
    const l_farm = lc(L_FARM)
    const l_reactor = lc(L_REACTOR)
    const l_radiator = lc(L_RADIATOR)
    const l_jump = lc(L_JUMP)
    const l_drive = lc(L_DRIVE)
    const l_tanks = lc(L_TANKS)
    const l_cargo = lc(L_CARGO)
    const l_hangar = lc(L_HANGAR)
    const l_refinery = lc(L_REFINERY)
    const l_fab = lc(L_FAB)
    const l_turret = lc(L_TURRET)
    const souls = l_quarters * 60 + l_habring * 900 + l_bridge * 40 + l_hangar * 30 + l_refinery * 30 + l_fab * 30 + l_turret * 15
    const food = l_quarters * 200 + l_estate * 400 + l_farm * 2400
    const l_gen: f32 = l_reactor * 120
    const l_use: f32 = liner_power()
    const l_heat = l_reactor + l_jump
    const l_mass = liner_mass()
    const l_accel: f32 = l_drive * 60.0 / max(l_mass, 1)
    const l_range: f32 = l_jump * (8000.0 + l_tanks * 2500) / max(l_mass, 1)
    const l_reach: f32 = l_tanks * 2000.0 / max(l_mass, 1)
    const l_power_ok = l_gen >= l_use && l_use > 0
    const l_cool_ok = l_radiator >= l_heat
    const l_food_ok = souls > 0 && food >= souls
    const l_mine_ok = l_refinery == 0 || l_hangar > 0
    const l_stock_ok = l_fab == 0 || l_refinery + l_cargo > 0
    const l_sound = lproblems == 0 && lmodules > 0
    const l_ready = liner_ready()
    const why = lhover >= 0 ? lstatus[max(lhover, 0)] : 0

    YardStat power(icon: yard_icon_power, label: "POWER",
      value: liner ? "{l_use:.0} / {l_gen:.0} GW" : "{use:.1} / {gen:.0} MW",
      ratio: liner ? l_use / max(l_gen, 1) : use / max(gen, 1),
      state: liner ? (l_gen == 0 && l_use == 0 ? UI_MUTED : l_gen >= l_use ? UI_OK : UI_BAD) : (gen == 0 && use == 0 ? UI_MUTED : gen >= use ? UI_OK : UI_BAD))
    YardStat compute(icon: liner ? yard_icon_wing : yard_icon_datacenter, label: liner ? "HEAT / RADIATORS" : "COMPUTE",
      value: liner ? "{l_heat} / {l_radiator}" : "{cuse:.0} / {cgen:.0} PF",
      ratio: liner ? l_heat / max(l_radiator, 1.0) : cuse / max(cgen, 1),
      state: liner ? (l_heat == 0 ? UI_MUTED : l_cool_ok ? UI_OK : UI_BAD) : (cgen == 0 && cuse == 0 ? UI_MUTED : compute_ok ? UI_OK : UI_BAD))
    YardStat crew_stat(icon: yard_icon_crew, label: liner ? "SOULS / FOOD" : "CREW / AIR",
      value: liner ? "{souls} / {food}" : "{crew} / {air}",
      ratio: liner ? souls / max(food, 1.0) : crew / max(air, 1.0),
      state: liner ? (souls == 0 ? UI_MUTED : food >= souls ? UI_OK : UI_BAD) : (crew == 0 ? UI_MUTED : air >= crew ? UI_OK : UI_BAD))
    YardStat thrust(icon: yard_icon_thrust, label: "ACCELERATION",
      value: liner ? "{l_accel:.2} g" : "{accel:.1} g",
      ratio: liner ? l_accel / 0.5 : accel / 4,
      state: liner ? (l_drive == 0 ? UI_MUTED : l_accel >= 0.15 ? UI_GOOD : UI_WARN) : (c8 == 0 ? UI_MUTED : accel >= 1 ? UI_GOOD : UI_WARN))
    ranges {
      Layout: {direction: Column, spacing: spacing}
      LayoutItem: {width: {mode: Grow}}
      YardStat range(icon: liner ? yard_icon_jump : yard_icon_range, label: liner ? "JUMP RANGE" : "RANGE",
        value: liner ? "{l_range:.1} ly" : "{reach:.1} ly",
        ratio: liner ? l_range / 40 : reach / 25,
        state: (liner ? l_jump : c6) == 0 ? UI_MUTED : UI_OK)
      if liner {
        YardStat reach_stat(icon: yard_icon_range, label: "RANGE",
          value: "{l_reach:.1} AU",
          ratio: l_reach / 40,
          state: l_tanks == 0 ? UI_MUTED : UI_OK)
      }
    }
    YardStat hold(icon: liner ? yard_icon_freight : yard_icon_cargo, label: "CARGO",
      value: liner ? "{l_cargo * 60} kt" : "{c5 * 120} t",
      ratio: liner ? l_cargo / 45.0 : c5 / 12.0,
      state: (liner ? l_cargo : c5) == 0 ? UI_MUTED : UI_OK)
    YardStat mining(icon: liner ? yard_icon_hangar : yard_icon_drill, label: liner ? "HANGAR" : "MINING",
      value: liner ? "{l_hangar * 6} craft" : "{c14 * 40} t/h",
      ratio: liner ? l_hangar / 8.0 : c14 / 6.0,
      state: liner ? (l_hangar == 0 ? UI_MUTED : UI_OK) : (c14 == 0 ? UI_MUTED : hold_ok ? UI_OK : UI_WARN))
    YardStat assembly(icon: liner ? yard_icon_slip : yard_icon_builder, label: liner ? "FABRICATION" : "ASSEMBLY",
      value: liner ? "{l_fab * 2} hulls/yr  ·  {l_refinery * 3} kt/d" : "{c15 * 15} m/h",
      ratio: liner ? (l_fab + l_refinery) / 8.0 : c15 / 6.0,
      state: liner ? (l_fab + l_refinery == 0 ? UI_MUTED : l_mine_ok && l_stock_ok ? UI_OK : UI_WARN) : (c15 == 0 ? UI_MUTED : UI_OK))
    YardStat guns(icon: liner ? yard_icon_battery : yard_icon_weapon, label: "FIREPOWER",
      value: liner ? "{l_turret * 400}" : "{c7 * 25}",
      ratio: liner ? l_turret / 12.0 : c7 / 8.0,
      state: (liner ? l_turret : c7) == 0 ? UI_MUTED : UI_WARN)

    YardVerdict verdict(label: liner ? (l_ready ? "STARWORTHY" : "NOT READY") : (ready ? "SPACEWORTHY" : "NOT READY"), ok: liner ? l_ready : ready)
    checks {
      Layout: {direction: Column, padding: {2, 0, 2, 0}, spacing: 7}
      LayoutItem: {width: {mode: Grow}}
      YardCheck chk_helm(label: liner ? "A bridge to command her" : c1 == 0 && c17 > 0 ? "An autopilot flies her" : "A cockpit or autopilot to fly her", ok: liner ? l_bridge > 0 : has_helm)
      YardCheck chk_drive(label: liner ? "Main drives to push her" : "Engines to push her", ok: liner ? l_drive > 0 : has_drive)
      YardCheck chk_fuel(label: liner ? "Propellant for the drives" : "Fuel for the engines", ok: liner ? l_tanks > 0 : fuel_ok)
      YardCheck chk_power(label: "Enough power", ok: liner ? l_power_ok : power_ok)
      YardCheck chk_cool(label: liner ? "A radiator per reactor and jump drive" : c16 > 0 ? "A radiator per power plant and datacenter" : "A radiator for every power plant", ok: liner ? l_cool_ok : cool_ok)
      YardCheck chk_air(label: liner ? "Food for every soul aboard" : crewless ? "No crew, no air needed" : "Air for every crew member", ok: liner ? l_food_ok : air_ok)
      YardCheck chk_rules(label: liner ? (lproblems == 0 ? "Every segment fits" : lproblems == 1 ? "One segment breaks a rule" : "{lproblems} segments break a rule") : (problems == 0 ? "Every module fits" : problems == 1 ? "One module breaks a rule" : "{problems} modules break a rule"), ok: liner ? l_sound : sound)
      if liner {
        YardCheck chk_jump(label: "A jump drive to cross between stars", ok: l_jump > 0)
        if l_refinery > 0 {
          YardCheck chk_mine(label: "A hangar of mining craft for the refinery", ok: l_mine_ok)
        }
        if l_fab > 0 {
          YardCheck chk_stock(label: "Stock for the fab bays", ok: l_stock_ok)
        }
      } else {
        if cuse > 0 {
          YardCheck chk_compute(label: "Compute for the autopilot and robots", ok: compute_ok)
        }
        if c14 > 0 {
          YardCheck chk_hold(label: "A cargo bay for the ore", ok: hold_ok)
        }
      }
    }
    if liner && why != 0 {
      why_box {
        Layout: {direction: Column, spacing: 6}
        LayoutItem: {width: {mode: Grow}}
        YardRule why_rule()
        YardCheck chk_why(label: rule_text(why), ok: false)
      }
    }
  }

  template ShipyardHud {
    const rig_mass: f32 = counts[1] * kind_mass(1) + counts[2] * kind_mass(2) + counts[3] * kind_mass(3) + counts[4] * kind_mass(4) + counts[5] * kind_mass(5) + counts[6] * kind_mass(6) + counts[7] * kind_mass(7) + counts[8] * kind_mass(8) + counts[9] * kind_mass(9) + counts[10] * kind_mass(10) + counts[13] * kind_mass(13) + counts[14] * kind_mass(14) + counts[15] * kind_mass(15) + counts[16] * kind_mass(16) + counts[17] * kind_mass(17)
    const lmass = liner_mass()

    Scene: {}

    camera {
      Position: {0, 0, 100}
      Camera: {ortho: true, ortho_scale: 1}
    }

    screen {
      LayoutFill: {surface: window}
      Layout: {direction: Column, padding: {12, 12, 12, 12}}
      FocusScope

      content {
        Layout: {direction: Column, spacing: 10}
        if show_ui {
          LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}
        } else {
          LayoutItem: {width: {mode: Fixed, value: 0}, height: {mode: Fixed, value: 0}}
          ClipChildren
        }

        top {
          Layout: {direction: Row, spacing: 10, v: Middle}
          LayoutItem: {width: {mode: Grow}}

          YardStrip class_switch {
            LayoutItem: {width: {min: 320, max: 320}}
            YardSegment b_rigs(label: "Rigs", icon: yard_icon_ship, op: OP_RIGS, grow: true)
            YardSegment b_liners(label: "Liners", icon: yard_icon_liner, op: OP_LINERS, grow: true)
          }

          spacer_a {
            LayoutItem: {width: {mode: Grow}}
          }

          YardStrip layer_picker {
            YardStripLabel caption(text: liner ? "SPINE" : "DECK")
            for d in 0..(liner ? LANES : GY) {
              YardSegment "b_d{d}"(label: liner ? lane_name(d) : "{d + 1}", op: OP_DECK + d)
            }
          }

          spacer_b {
            LayoutItem: {width: {mode: Grow}}
          }

          gap_right {
            LayoutItem: {width: {mode: Fixed, value: 320}}
          }
        }

        middle {
          Layout: {direction: Row}
          LayoutItem: {width: {mode: Grow}, height: {mode: Grow}}

          ModulesCard modules_card(title: liner ? "SEGMENTS" : "MODULES", width: 320, spacing: 10)

          spacer {
            LayoutItem: {width: {mode: Grow}}
          }

          SystemsCard systems_card(title: "SYSTEMS",
            note: liner ? "{lspan * 40} m  ·  {lmass:.0} kt" : "{span * 4} m  ·  {rig_mass:.0} t",
            width: 280, spacing: 10)
        }

        bottom {
          Layout: {direction: Row, h: Center}
          LayoutItem: {width: {mode: Grow}}

          YardStrip presets {
            YardStripLabel caption(text: "PRESETS")
            designs {
              Layout: {direction: Row, spacing: 2, v: Middle}
              if liner {
                YardGhost b_passenger(label: "Passenger", op: OP_PASSENGER)
                YardGhost b_freighter(label: "Freighter", op: OP_FREIGHTER)
                YardGhost b_tender(label: "Tender", op: OP_TENDER)
                YardGhost b_battleship(label: "Battleship", op: OP_BATTLESHIP)
              } else {
                YardGhost b_frigate(label: "Frigate", op: OP_FRIGATE)
                YardGhost b_scout(label: "Scout", op: OP_SCOUT)
                YardGhost b_miner(label: "Miner", op: OP_MINER)
              }
            }
            YardDivider divider()
            YardGhost b_clear(label: "Clear", icon: yard_icon_remove, op: OP_CLEAR, danger: true)
          }
        }
      }
    }

    toggles {
      LayoutFill: {surface: window}
      Layout: {direction: Row, padding: {12, 12, 12, 12}, v: Top}

      spacer {
        LayoutItem: {width: {mode: Grow}}
      }

      YardStrip view_switch {
        LayoutItem: {width: {min: 320, max: 320}}
        YardStripLabel caption(text: "SHOW")
        YardSegment b_ui(label: "Interface", op: OP_SHOW_UI, grow: true)
        if liner {
          YardSegment b_gantry(label: "Gantry", op: OP_SHOW_GANTRY, grow: true)
        }
      }
    }

    view {
      View: {camera: camera, order: 1, lighting: {enabled: false}, culling: {enabled: false}}
    }
  }
}
