    OP_BATTLESHIP, 3, 9, 9, L_ARMOR,
    OP_BATTLESHIP, 3, 10, 10, L_TURRET,
    OP_BATTLESHIP, 3, 11, 11, L_QUARTERS,
    OP_BATTLESHIP, 3, 12, 12, L_TURRET,
    OP_BATTLESHIP, 3, 13, 13, L_SENSOR,
    OP_BATTLESHIP, 3, 14, 14, L_BRIDGE,
    OP_BATTLESHIP, 4, 9, 11, L_HANGAR
  ]

  fn lane_of(i: i32) -> i32 { (i - i % SLOTS) / SLOTS }
  fn slot_of(i: i32) -> i32 { i % SLOTS }
  fn lcell(l: i32, z: i32) -> i32 { l * SLOTS + z }

  fn lkind(l: i32, z: i32) -> i32 {
    const k = lgrid[lcell(clamp(l, 0, LANES - 1), clamp(z, 0, SLOTS - 1))]
    z >= 0 && z < SLOTS && l >= 0 && l < LANES ? k : 0
  }

  fn lc(k: i32) -> i32 { lcounts[clamp(k - L_BASE, 0, LKINDS - 1)] }

  fn lane_angle(l: i32) -> f32 {
    match l { 1: PI; 3: HALF_PI; 4: 0 - HALF_PI; _: 0 }
  }

  fn lane_x(l: i32) -> f32 { l == 0 ? 0 : cos(lane_angle(l)) * OUT_D }
  fn lane_y(l: i32) -> f32 { l == 0 ? 0 : sin(lane_angle(l)) * OUT_D }
  fn lane_r(l: i32) -> f32 { l == 0 ? R_CORE : R_OUT }
  fn slot_z(z: i32) -> f32 { (z - SLOTS / 2.0 + 0.5) * SEG }

  fn ringed(k: i32) -> bool { k == L_HABRING || k == L_ESTATE || k == L_FARM }
  fn housed(k: i32) -> bool { k == L_QUARTERS || ringed(k) }
  fn core_only(k: i32) -> bool { ringed(k) || k == L_JUMP || k == L_YOKE }

  fn outriggers_at(z: i32) -> i32 {
    (lkind(1, z) != 0 ? 1 : 0) + (lkind(2, z) != 0 ? 1 : 0) + (lkind(3, z) != 0 ? 1 : 0) + (lkind(4, z) != 0 ? 1 : 0)
  }

  fn open_ahead(l: i32, z: i32) -> bool {
    match z >= SLOTS - 1 {
      true: true
      _: lkind(l, z + 1) == 0 && open_ahead(l, z + 1)
    }
  }

  fn open_behind(l: i32, z: i32) -> bool {
    match z <= 0 {
      true: true
      _: lkind(l, z - 1) == 0 && open_behind(l, z - 1)
    }
  }

  fn lrule(l: i32, z: i32, k: i32) -> i32 {
    l != 0 && core_only(k) ? 1 :
    k == L_BRIDGE && !open_ahead(l, z) ? 2 :
    k == L_DRIVE && !open_behind(l, z) ? 3 :
    ringed(k) && outriggers_at(z) > 0 ? 4 :
    k == L_YOKE && outriggers_at(z) == 0 ? 5 :
    housed(k) && (lkind(l, z - 1) == L_REACTOR || lkind(l, z + 1) == L_REACTOR) ? 6 :
    k == L_HANGAR && l == 0 && lkind(LANE_VENTRAL, z) != 0 ? 7 :
    0
  }

  fn rule_text(code: i32) -> string {
    match code {
      1: "Rings, yokes and jump drives sit on the core"
      2: "A bridge needs open space ahead"
      3: "A drive needs open space behind"
      4: "A ring needs the outriggers clear beside it"
      5: "A yoke needs an outrigger to hold"
      6: "Living space too close to a reactor"
      7: "The hangar opens onto the ventral spine"
      8: "Cut off from the rest of the core"
      9: "This outrigger has no yoke to the core"
      _: ""
    }
  }

  fn lvalidate() {
    mut st: i32[90] = {}
    mut tally: i32[19] = {}
    mut front: i32 = SLOTS
    mut back: i32 = -1
    mut total: i32 = 0

    for i in 0..LCELLS {
      const k = lgrid[i]
      if k != 0 {
        total += 1
        tally[clamp(k - L_BASE, 0, LKINDS - 1)] += 1
        front = min(front, slot_of(i))
        back = max(back, slot_of(i))
        st[i] = lrule(lane_of(i), slot_of(i), k)
      }
    }

    mut run: i32 = 0
    mut best: i32 = 0
    mut best_end: i32 = 0
    for z in 0..SLOTS + 1 {
      if lkind(0, z) != 0 {
        run += 1
      } else {
        if run > best {
          best = run
          best_end = z
        }
        run = 0
      }
    }
    const best_start = best_end - best

    for z in 0..SLOTS {
      if lgrid[z] != 0 && st[z] == 0 && (z < best_start || z >= best_end) {
        st[z] = 8
      }
    }

    for l in 1..LANES {
      mut start: i32 = -1
      for z in 0..SLOTS + 1 {
        const on = lkind(l, z) != 0
        if on && start < 0 {
          start = z
        }
        if !on && start >= 0 {
          mut tied = false
          for q in start..z {
            if lkind(0, q) == L_YOKE && q >= best_start && q < best_end {
              tied = true
            }
          }
          if !tied {
            for q in start..z {
              if st[lcell(l, q)] == 0 {
                st[lcell(l, q)] = 9
              }
            }
          }
          start = -1
        }
      }
    }

    mut bad: i32 = 0
    for i in 0..LCELLS {
      if st[i] != 0 {
        bad += 1
      }
    }

    lstatus = st
    lcounts = tally
    lmodules = total
    lproblems = bad
    lspan = max(back - front + 1, 0)
  }

  fn load_liner(design: i32) {
    mut g: i32[90] = {}
    for b in 0..LPLAN_ROWS {
      const o = b * 5
      if liner_plan[o] == design {
        for z in liner_plan[o + 2]..liner_plan[o + 3] + 1 {
          g[lcell(liner_plan[o + 1], z)] = liner_plan[o + 4]
        }
      }
    }
    lgrid = g
    lvalidate()
  }

  fn lkind_mass(k: i32) -> f32 {
    match k {
      40: 18; 41: 8; 42: 10; 43: 30; 44: 34; 45: 26; 46: 6; 47: 34; 48: 24
      49: 18; 50: 14; 51: 12; 52: 22; 53: 16; 54: 3; 55: 8; 56: 20; 57: 18; 58: 32
      _: 0
    }
  }

  fn lkind_power(k: i32) -> f32 {
    match k {
      40: 2; 41: 4; 42: 1; 43: 6; 44: 4; 47: 30; 48: 10; 49: 0.2; 50: 0.2; 51: 2; 52: 8; 53: 6; 57: 6; 58: 2
      _: 0
    }
  }

  fn liner_mass() -> f32 {
    mut m: f32 = 0
    for k in L_BASE..L_END {
      m += lc(k) * lkind_mass(k)
    }
    m
  }

  fn liner_power() -> f32 {
    mut w: f32 = 0
    for k in L_BASE..L_END {
      w += lc(k) * lkind_power(k)
    }
    w
  }
}
