  export const L_YOKE: i32 = 55
  export const L_ARMOR: i32 = 56
  export const L_TURRET: i32 = 57
  export const L_FARM: i32 = 58
  export const L_END: i32 = 59
  export const LKINDS: i32 = 19

  event SlotClick(slot: i32)

  export mut lane: i32 = 0
  export mut lhover: i32 = -1
  export mut lgrid: i32[90] = {}
  export mut lstatus: i32[90] = {}
