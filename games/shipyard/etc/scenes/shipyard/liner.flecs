  export const R_OUT: f32 = 1.7
  export const OUT_D: f32 = 8.5
  export const AXIS_Y: f32 = 6
  export const RING_R: f32 = 14

  export const LANE_CORE: i32 = 0
  export const LANE_PORT: i32 = 1
  export const LANE_STBD: i32 = 2
  export const LANE_DORSAL: i32 = 3
  export const LANE_VENTRAL: i32 = 4

  export const L_BASE: i32 = 40
  export const L_BRIDGE: i32 = 40
  export const L_SENSOR: i32 = 41
  export const L_QUARTERS: i32 = 42
