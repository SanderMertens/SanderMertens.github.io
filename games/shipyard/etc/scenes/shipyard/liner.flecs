    OP_FREIGHTER, 2, 0, 0, L_DRIVE,
    OP_FREIGHTER, 2, 1, 1, L_TANKS,
    OP_FREIGHTER, 2, 7, 15, L_CARGO,
    OP_FREIGHTER, 3, 7, 15, L_CARGO,
    OP_FREIGHTER, 4, 7, 15, L_CARGO,

