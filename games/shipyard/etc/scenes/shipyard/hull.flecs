using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using state

assets {
  yard_wedge_core_shape { Path2D: {start: {0, 0}, segments: [{kind: Line, end: {3.406, 0}}, {kind: Line, end: {0, 3.406}}], closed: true} }
  yard_wedge_core { Profile2D: {outer: yard_wedge_core_shape} }
  yard_wedge_wall_shape { Path2D: {start: {0, 0}, segments: [{kind: Line, end: {4, 0}}, {kind: Line, end: {0, 4}}], closed: true} }
  yard_wedge_wall { Profile2D: {outer: yard_wedge_wall_shape} }

  template HullPlate {
    prop x0: f32 = -2
    prop x1: f32 = 2
    prop y0: f32 = 0
    prop y1: f32 = 3
    prop z0: f32 = -2
    prop z1: f32 = 2
    prop dark: bool = false

    if dark {
      plate : ShipHullDark { Position: {(x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2}; Box: {x1 - x0, y1 - y0, z1 - z0} }
    } else {
      plate : ShipHull { Position: {(x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2}; Box: {x1 - x0, y1 - y0, z1 - z0} }
    }
  }

  template HullEdgeZ {
    prop sx: f32 = 1
    prop sy: f32 = 1
    prop z0: f32 = -2
    prop z1: f32 = 2
    prop f0: bool = false
    prop f1: bool = false
    prop r: f32 = RAD

    const ex = sx * (2 - r)
    const ey = sy > 0 ? CH - r : r
    const fx = sx * (2 - r / 2)
    const fy = sy > 0 ? CH - r / 2 : r / 2

    rod : ShipHull { Position: {ex, ey, (z0 + z1) / 2}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: r, length: z1 - z0, segments: 8, smooth: true} }
    if f0 {
      fill_a : ShipHull { Position: {fx, fy, -2 + 0.015}; Box: {r, r, 0.03} }
    }
    if f1 {
      fill_b : ShipHull { Position: {fx, fy, 2 - 0.015}; Box: {r, r, 0.03} }
    }
  }

  template HullEdgeX {
    prop sy: f32 = 1
    prop sz: f32 = 1
    prop x0: f32 = -2
    prop x1: f32 = 2
    prop f0: bool = false
    prop f1: bool = false
    prop r: f32 = RAD

    const ey = sy > 0 ? CH - r : r
    const ez = sz * (2 - r)
    const fy = sy > 0 ? CH - r / 2 : r / 2
    const fz = sz * (2 - r / 2)

    rod : ShipHull { Position: {(x0 + x1) / 2, ey, ez}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: r, length: x1 - x0, segments: 8, smooth: true} }
    if f0 {
      fill_a : ShipHull { Position: {-2 + 0.015, fy, fz}; Box: {0.03, r, r} }
    }
    if f1 {
      fill_b : ShipHull { Position: {2 - 0.015, fy, fz}; Box: {0.03, r, r} }
    }
  }

  template HullEdgeY {
    prop sx: f32 = 1
    prop sz: f32 = 1
    prop y0: f32 = 0
    prop y1: f32 = 3
    prop f0: bool = false
    prop f1: bool = false
    prop r: f32 = RAD

    const ex = sx * (2 - r)
    const ez = sz * (2 - r)
    const fx = sx * (2 - r / 2)
    const fz = sz * (2 - r / 2)

    rod : ShipHull { Position: {ex, (y0 + y1) / 2, ez}; Cylinder: {radius: r, length: y1 - y0, segments: 8, smooth: true} }
    if f0 {
      fill_a : ShipHull { Position: {fx, 0.015, fz}; Box: {r, 0.03, r} }
    }
    if f1 {
      fill_b : ShipHull { Position: {fx, CH - 0.015, fz}; Box: {r, 0.03, r} }
    }
  }

  template HullCorner {
    prop sx: f32 = 1
    prop sy: f32 = 1
    prop sz: f32 = 1
    prop r: f32 = RAD

    ball : ShipHull { Position: {sx * (2 - r), sy > 0 ? CH - r : r, sz * (2 - r)}; Sphere: {radius: r, segments: 4, smooth: true} }
  }

  // The skin of one cell: a plate on every face that no visible module covers, rounded where two
  // exposed faces meet. The xy, xz and yz flags tell whether the diagonal neighbor in that plane
  // is there (p for the positive side, n for the negative one), which decides whether a rounded
  // edge runs on into the next cell or ends against a wall and needs its gap filled.
  template HullShell {
    prop px: bool = true
    prop nx: bool = true
    prop py: bool = true
    prop ny: bool = true
    prop pz: bool = true
    prop nz: bool = true
    prop xy_pp: bool = false
    prop xy_pn: bool = false
    prop xy_np: bool = false
    prop xy_nn: bool = false
    prop xz_pp: bool = false
    prop xz_pn: bool = false
    prop xz_np: bool = false
    prop xz_nn: bool = false
    prop yz_pp: bool = false
    prop yz_pn: bool = false
    prop yz_np: bool = false
    prop yz_nn: bool = false
    prop stripe: bool = true
    prop front: bool = true

    const r = RAD
    const sk = SKIN
    const by = 1.98
    const bh = 0.22
    const ly = 1.74
    const lh = 0.05
    const ax0 = nx ? -2 + r : -2
    const ax1 = px ? 2 - r : 2
    const ay0 = ny ? r : 0
    const ay1 = py ? CH - r : CH
    const az0 = nz ? -2 + r : -2
    const az1 = pz ? 2 - r : 2

    if px {
      HullPlate side_px(x0: 2 - sk, x1: 2, y0: ay0, y1: ay1, z0: az0, z1: az1)
      if stripe {
        band_px : ShipStripe { Position: {2 + 0.006, by, (az0 + az1) / 2}; Box: {0.012, bh, az1 - az0} }
        line_px : ShipTrim { Position: {2 + 0.006, ly, (az0 + az1) / 2}; Box: {0.012, lh, az1 - az0} }
      }
    }
    if nx {
      HullPlate side_nx(x0: -2, x1: -2 + sk, y0: ay0, y1: ay1, z0: az0, z1: az1)
      if stripe {
        band_nx : ShipStripe { Position: {-2 - 0.006, by, (az0 + az1) / 2}; Box: {0.012, bh, az1 - az0} }
        line_nx : ShipTrim { Position: {-2 - 0.006, ly, (az0 + az1) / 2}; Box: {0.012, lh, az1 - az0} }
      }
    }
    if py {
      HullPlate side_py(x0: ax0, x1: ax1, y0: CH - sk, y1: CH, z0: az0, z1: az1)
    }
    if ny {
      HullPlate side_ny(x0: ax0, x1: ax1, y0: 0, y1: sk, z0: az0, z1: az1, dark: true)
    }
    if pz && front {
      HullPlate side_pz(x0: ax0, x1: ax1, y0: ay0, y1: ay1, z0: 2 - sk, z1: 2)
    }
    if nz {
      HullPlate side_nz(x0: ax0, x1: ax1, y0: ay0, y1: ay1, z0: -2, z1: -2 + sk)
    }

    if px && py {
      HullEdgeZ ez_pp(sx: 1, sy: 1, z0: az0, z1: az1, f0: !nz && (xz_pn || yz_pn), f1: !pz && (xz_pp || yz_pp), r: r)
    }
    if px && ny {
      HullEdgeZ ez_pn(sx: 1, sy: -1, z0: az0, z1: az1, f0: !nz && (xz_pn || yz_nn), f1: !pz && (xz_pp || yz_np), r: r)
    }
    if nx && py {
      HullEdgeZ ez_np(sx: -1, sy: 1, z0: az0, z1: az1, f0: !nz && (xz_nn || yz_pn), f1: !pz && (xz_np || yz_pp), r: r)
    }
    if nx && ny {
      HullEdgeZ ez_nn(sx: -1, sy: -1, z0: az0, z1: az1, f0: !nz && (xz_nn || yz_nn), f1: !pz && (xz_np || yz_np), r: r)
    }

    if py && pz {
      HullEdgeX ex_pp(sy: 1, sz: 1, x0: ax0, x1: ax1, f0: !nx && (xy_np || xz_np), f1: !px && (xy_pp || xz_pp), r: r)
    }
    if py && nz {
      HullEdgeX ex_pn(sy: 1, sz: -1, x0: ax0, x1: ax1, f0: !nx && (xy_np || xz_nn), f1: !px && (xy_pp || xz_pn), r: r)
    }
    if ny && pz {
      HullEdgeX ex_np(sy: -1, sz: 1, x0: ax0, x1: ax1, f0: !nx && (xy_nn || xz_np), f1: !px && (xy_pn || xz_pp), r: r)
    }
    if ny && nz {
      HullEdgeX ex_nn(sy: -1, sz: -1, x0: ax0, x1: ax1, f0: !nx && (xy_nn || xz_nn), f1: !px && (xy_pn || xz_pn), r: r)
    }

    if px && pz {
      HullEdgeY ey_pp(sx: 1, sz: 1, y0: ay0, y1: ay1, f0: !ny && (xy_pn || yz_np), f1: !py && (xy_pp || yz_pp), r: r)
    }
    if px && nz {
      HullEdgeY ey_pn(sx: 1, sz: -1, y0: ay0, y1: ay1, f0: !ny && (xy_pn || yz_nn), f1: !py && (xy_pp || yz_pn), r: r)
    }
    if nx && pz {
      HullEdgeY ey_np(sx: -1, sz: 1, y0: ay0, y1: ay1, f0: !ny && (xy_nn || yz_np), f1: !py && (xy_np || yz_pp), r: r)
    }
    if nx && nz {
      HullEdgeY ey_nn(sx: -1, sz: -1, y0: ay0, y1: ay1, f0: !ny && (xy_nn || yz_nn), f1: !py && (xy_np || yz_pn), r: r)
    }

    if px && py && pz {
      HullCorner c_ppp(sx: 1, sy: 1, sz: 1, r: r)
    }
    if px && py && nz {
      HullCorner c_ppn(sx: 1, sy: 1, sz: -1, r: r)
    }
    if px && ny && pz {
      HullCorner c_pnp(sx: 1, sy: -1, sz: 1, r: r)
    }
    if px && ny && nz {
      HullCorner c_pnn(sx: 1, sy: -1, sz: -1, r: r)
    }
    if nx && py && pz {
      HullCorner c_npp(sx: -1, sy: 1, sz: 1, r: r)
    }
    if nx && py && nz {
      HullCorner c_npn(sx: -1, sy: 1, sz: -1, r: r)
    }
    if nx && ny && pz {
      HullCorner c_nnp(sx: -1, sy: -1, sz: 1, r: r)
    }
    if nx && ny && nz {
      HullCorner c_nnn(sx: -1, sy: -1, sz: -1, r: r)
    }
  }

  // The wedge in the corner between two hulls, with the corner at the origin and the hulls on
  // its -x and -z sides. Its angled wall runs from (4, 0) to (0, 4), and the rounded edges along
  // it meet the edges of the hulls beside it in a ball at each end.
  template HullWedge {

    const len = 4 * 1.41421 - RAD * 0.82843

    core : ShipHull { Position: {0, (CH + SKIN) / 2, 0}; ProfileExtrusion: {profile: yard_wedge_core, depth: CH - SKIN, cap_start: true, cap_end: true} }
    belly : ShipHullDark { Position: {0, SKIN / 2, 0}; ProfileExtrusion: {profile: yard_wedge_core, depth: SKIN, cap_start: true, cap_end: true} }
    wall : ShipHull { Position: {0, CH / 2, 0}; ProfileExtrusion: {profile: yard_wedge_wall, depth: CH - RAD * 2, cap_start: true, cap_end: true} }
    face {
      Position: {2, 0, 2}
      Rotation: {0, 0 - PI / 4, 0}
      for s in 0..2 {
        const ey = s == 0 ? RAD : CH - RAD
        "rod_{s}" : ShipHull { Position: {0 - RAD, ey, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: RAD, length: len, segments: 8, smooth: true} }
        "ball_a_{s}" : ShipHull { Position: {0 - RAD, ey, len / 2}; Sphere: {radius: RAD, segments: 4, smooth: true} }
        "ball_b_{s}" : ShipHull { Position: {0 - RAD, ey, 0 - len / 2}; Sphere: {radius: RAD, segments: 4, smooth: true} }
      }
      band : ShipStripe { Position: {0.006, 1.98, 0}; Box: {0.012, 0.22, 4 * 1.41421} }
      line : ShipTrim { Position: {0.006, 1.74, 0}; Box: {0.012, 0.05, 4 * 1.41421} }
    }
  }

  // The ramp from the top of a hull on its -x side down to the hull below it, which it covers,
  // centered on the cell. A hanging ramp runs from the bottom of the hull up to the hull above it.
  template HullSlope {
    prop hang: bool = false

    if hang {
      ramp : ShipHull { Position: {0, 0, 0}; Rotation: {PI, 0, 0}; RightTrianglePrism: {4, CH, 4} }
    } else {
      ramp : ShipHull { Position: {0, 0, 0}; RightTrianglePrism: {4, CH, 4} }
    }
  }

  template HullValley {
    prop hang: bool = false

    const s = hang ? -1 : 1
    const ty = hang ? 0 : CH
    const by = hang ? CH : 0

    body : ShipHull {
      Position: {0, 0, 0}
      Mesh3: {
        vertices: [
          {-2, ty, -2}, {2 * s, ty, -2 * s}, {-2 * s, ty, 2 * s},
          {-2, by, -2}, {2 * s, by, -2 * s}, {2, by, 2}, {-2 * s, by, 2 * s}
        ],
        indices: [0, 5, 1, 0, 2, 5, 3, 4, 5, 3, 5, 6, 3, 0, 1, 3, 1, 4, 3, 6, 2, 3, 2, 0, 4, 1, 5, 6, 5, 2]
      }
    }
  }

  template HullHip {
    prop hang: bool = false

    const s = hang ? -1 : 1
    const ty = hang ? 0 : CH
    const by = hang ? CH : 0

    body : ShipHull {
      Position: {0, 0, 0}
      Mesh3: {
        vertices: [{-2, ty, -2}, {-2, by, -2}, {2 * s, by, -2 * s}, {2, by, 2}, {-2 * s, by, 2 * s}],
        indices: [1, 2, 3, 1, 3, 4, 0, 2, 1, 0, 1, 4, 0, 3, 2, 0, 4, 3]
      }
    }
  }

  // A hull fairing takes its shape from the hulls around it; sx, sy and sz are their sides. Between
  // a hull along x and one along z it is a wedge with its corner against both. Beside one hull and
  // on top of another it ramps down from the first to the second, and under one it ramps up.
  template HullFairing {
    prop shape: i32 = H_WEDGE
    prop sx: i32 = 0
    prop sy: i32 = 0
    prop sz: i32 = 0

    if shape == H_WEDGE {
      const yaw: f32 = sx < 0 ? (sz < 0 ? 0 : HALF_PI) : (sz < 0 ? 0 - HALF_PI : PI)
      wedge { Position: {sx * 2, 0, sz * 2}; Rotation: {0, yaw, 0}; HullWedge body() }
    } else if shape == H_SLOPE {
      const yaw: f32 = sx < 0 ? 0 : sx > 0 ? PI : sz > 0 ? HALF_PI : 0 - HALF_PI
      slope { Position: {0, CH / 2, 0}; Rotation: {0, yaw, 0}; HullSlope body(hang: sy > 0) }
    } else {
      const yaw: f32 = sx < 0 ? (sz < 0 ? 0 : HALF_PI) : (sz < 0 ? 0 - HALF_PI : PI)
      corner {
        Position: {0, 0, 0}
        Rotation: {0, yaw, 0}
        if shape == H_VALLEY {
          HullValley body(hang: sy > 0)
        } else {
          HullHip body(hang: sy > 0)
        }
      }
    }
  }
}
