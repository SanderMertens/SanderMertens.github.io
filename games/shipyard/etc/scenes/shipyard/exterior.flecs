        fluid : ShipAlgae { Position: {0, 1.05, 0}; Cylinder: {radius: 0.1, length: 1.7, segments: 6, smooth: true} }
        tube : ShipGlass { Position: {0, 1.05, 0}; Cylinder: {radius: 0.13, length: 1.8, segments: 6, smooth: true} }
        cap_a : ShipTrim { Position: {0, 0.13, 0}; Cylinder: {radius: 0.15, length: 0.08, segments: 6, smooth: true} }
        cap_b : ShipTrim { Position: {0, 1.97, 0}; Cylinder: {radius: 0.15, length: 0.08, segments: 6, smooth: true} }
      }
    }
    PlantPipe algae_low(len: 1.4, r: 0.06) { Position: {1.16, 0.32, 1.42}; Rotation: {0, 0, HALF_PI} }
    PlantPipe algae_high(len: 1.5, r: 0.06) { Position: {1.11, 2.22, 1.42}; Rotation: {0, 0, HALF_PI} }
    PlantElbow algae_knee(r: 0.06) { Position: {0.3, 2.22, 1.42} }
    PlantPipe algae_rise(len: 0.18, r: 0.06) { Position: {0.3, 2.31, 1.42} }
    glow { Position: {1.1, 1.3, 1.0}; PointLight: {intensity: 2.5, range: 2.6}; Rgb: {110, 255, 150} }

    PlantPipe header_a(len: 4, r: 0.09, copper: true) { Position: {0, 2.55, 0}; Rotation: {HALF_PI, 0, 0} }
    PlantPipe header_b(len: 4, r: 0.07) { Position: {0.3, 2.4, 0}; Rotation: {HALF_PI, 0, 0} }
    header_c : ShipTeal { Position: {-0.28, 2.4, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.06, length: 4, segments: 4, smooth: true} }
    PlantPipe low_line(len: 4, r: 0.07, copper: true) { Position: {1.68, 0.4, 0}; Rotation: {HALF_PI, 0, 0} }
    for i in 0..3 {
      "hanger_{i}" : ShipTrim { Position: {0.01, 2.66, -1.3 + i * 1.3}; Box: {0.7, 0.04, 0.06} }
      "hanger_post_{i}" : ShipTrim { Position: {0.01, 2.7, -1.3 + i * 1.3}; Box: {0.04, 0.12, 0.04} }
    }

    for s in 0..2 {
