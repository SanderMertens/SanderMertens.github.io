  template EngineMount {
    prop seed: i32 = 0
    prop mounted: bool = true

    const cy = CH / 2

    plate : ShipHullDark { Position: {0, cy, 1.93}; RoundedBox: {3.0, 2.5, 0.14, 0.12, segments: 2} }
    for i in 0..4 {
      const bx = i % 2 == 0 ? -1.32 : 1.32
      const by = i < 2 ? -1.07 : 1.07
      "bolt_{i}" : ShipChrome { Position: {bx, cy + by, 1.85}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.06, length: 0.04, segments: 4, smooth: true} }
    }
    flange : ShipTrim { Position: {0, cy, 1.78}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 1.12, length: 0.16, segments: 8, smooth: true} }
    for i in 0..10 {
      const a = i * PI / 5
      "stud_{i}" : ShipChrome { Position: {cos(a) * 1.0, cy + sin(a) * 1.0, 1.68}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.045, length: 0.05, segments: 4, smooth: true} }
    }
    thrust : ShipSteel { Position: {0, cy, 1.3}; Rotation: {0 - HALF_PI, 0, 0}; Frustum: {radius_bottom: 0.95, radius_top: 0.5, length: 0.8, segments: 8, smooth: true} }
    for i in 0..6 {
      const a = i * PI / 3 + PI / 6
      "rib_{i}" : ShipTrim { Position: {cos(a) * 0.72, cy + sin(a) * 0.72, 1.3}; Rotation: {0, 0, a}; Box: {0.06, 0.06, 0.78} }
    }
    chamber : ShipSteel { Position: {0, cy, 0.62}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.5, length: 0.6, segments: 8, smooth: true} }
    for i in 0..3 {
      "coil_{i}" : ShipCopper { Position: {0, cy, 0.42 + i * 0.2}; Torus: {radius: 0.52, tube: 0.035, segments: 8, rings: 3, smooth: true}; Rotation: {HALF_PI, 0, 0} }
    }
    for s in 0..2 {
      const sx = s == 0 ? -0.86 : 0.86
      "pump_{s}" : ShipChrome { Position: {sx, cy + 0.42, 0.95}; Rotation: {HALF_PI, 0, 0}; Capsule: {radius: 0.18, length: 0.4, segments: 4, smooth: true} }
      "pump_band_{s}" : ShipOrange { Position: {sx, cy + 0.42, 0.95}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.19, length: 0.1, segments: 6, smooth: true} }
      "feed_{s}" : ShipCopper { Position: {sx, cy + 0.42, 1.42}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.06, length: 0.5, segments: 4, smooth: true} }
      "line_{s}" : ShipCopper { Position: {sx * 0.66, cy + 0.3, 0.7}; Rotation: {0, 0, 0 - sx * 0.6}; Cylinder: {radius: 0.045, length: 0.5, segments: 4, smooth: true} }
      "ram_{s}" : ShipSteel { Position: {sx * 0.95, cy - 0.5, 0.9}; Rotation: {HALF_PI - 0.25, 0, 0}; Cylinder: {radius: 0.05, length: 1.6, segments: 4, smooth: true} }
      "ram_sleeve_{s}" : ShipTrim { Position: {sx * 0.95, cy - 0.6, 1.3}; Rotation: {HALF_PI - 0.25, 0, 0}; Cylinder: {radius: 0.08, length: 0.7, segments: 4, smooth: true} }
    }
    bell {
      Position: {0, cy, 0.34}
      Rotation: {0 - HALF_PI, 0, 0}
      Lathe: {profile: bell_outer, inner: bell_inner, cap_start: true, cap_end: true, segments: 8, rings: 3}
      Rgb: {128, 120, 116}
      PbrMaterial: {metallic: 0.9, roughness: 0.32}
      SurfaceMaterials: {inner: {color: {70, 80, 104, 255}, metallic: 0.9, roughness: 0.4}}
    }
    band_a : ShipTrim { Position: {0, cy, 0.34 - 0.87}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.67, tube: 0.04, segments: 8, rings: 3, smooth: true} }
    band_b : ShipTrim { Position: {0, cy, 0.34 - 1.69}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 1.04, tube: 0.04, segments: 8, rings: 3, smooth: true} }
    lip : ShipHeat { Position: {0, cy, 0.34 - 2.25}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 1.36, tube: 0.04, segments: 8, rings: 3, smooth: true} }
    core : ShipPlasma { Position: {0, cy, 0.3}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.4, length: 0.04, segments: 8, smooth: true} }
    throat : ShipPlasma { Position: {0, cy, 0.2}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.42, tube: 0.05, segments: 8, rings: 3, smooth: true} }
