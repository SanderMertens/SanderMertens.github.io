        color: {keys: [{0, {200, 230, 255}}, {0.4, {255, 255, 255}}, {1, {170, 110, 255}}]}
      }
      SpatialIgnore
    }
    exhaust {
      Position: {0, cy, -1.9}
      ParticleEmitter: {
        max: 160, rate: 260, shape: EmitterDisc, radius: 0.6,
        direction: {0, 0, -1}, spread: 3, speed: {18, 26},
        lifetime: {0.22, 0.42}, size: {0.22, 0.4}, opacity: {0.3, 0.55},
        color: {170, 215, 255}, seed: 70 + seed
      }
      ParticleForces: {gravity: {0, 0, 0}, turbulence: 14, turbulence_scale: 0.8}
      ParticleAppearance: {blend: ParticleAdditive, stretch: 0.06}
      ParticleCurves: {
        size: {keys: [{0, 0.8}, {1, 1.3}]},
        opacity: {keys: [{0, 0}, {0.08, 1}, {0.4, 0.45}, {1, 0}]},
        color: {keys: [{0, {255, 255, 255}}, {0.3, {130, 190, 255}}, {1, {90, 60, 255}}]}
      }
      SpatialIgnore
    }
    light {
      Position: {0, cy, -2.6}
      PointLight: {intensity: 22, range: 9}
      Rgb: {120, 180, 255}
