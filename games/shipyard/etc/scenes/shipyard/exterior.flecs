  template PlantPipe {
    prop len: f32 = 1
    prop r: f32 = 0.07
    prop copper: bool = false

    if copper {
      run : ShipCopper { Position: {0, 0, 0}; Cylinder: {radius: r, length: len, segments: 4, smooth: true} }
    } else {
      run : ShipSteel { Position: {0, 0, 0}; Cylinder: {radius: r, length: len, segments: 4, smooth: true} }
    }
    if len > 1.2 {
      flange_a : ShipTrim { Position: {0, len / 2 - 0.2, 0}; Cylinder: {radius: r * 1.6, length: 0.06, segments: 6, smooth: true} }
      flange_b : ShipTrim { Position: {0, 0.2 - len / 2, 0}; Cylinder: {radius: r * 1.6, length: 0.06, segments: 6, smooth: true} }
    }
  }

  template PlantElbow {
    prop r: f32 = 0.07
    prop copper: bool = false

    if copper {
      ball : ShipCopper { Position: {0, 0, 0}; Sphere: {radius: r * 1.25, segments: 3, smooth: true} }
    } else {
      ball : ShipSteel { Position: {0, 0, 0}; Sphere: {radius: r * 1.25, segments: 3, smooth: true} }
    }
  }

  template ReactorVessel {
    prop h: f32 = 1.9
    prop r: f32 = 0.6
    prop jacket: bool = false

    skirt : ShipTrim { Position: {0, 0.15, 0}; Cylinder: {radius: r * 0.85, length: 0.3, segments: 8, smooth: true} }
    shell : ShipWhite { Position: {0, 0.3 + h / 2, 0}; Cylinder: {radius: r, length: h, segments: 8, smooth: true} }
    head : ShipWhite { Position: {0, 0.3 + h, 0}; EllipsoidShell: {radius: {r, r * 0.5, r}, longitude_start: 0, longitude_end: 6.2832, latitude_start: 0, latitude_end: HALF_PI, segments: 8, rings: 3} }
    foot : ShipWhite { Position: {0, 0.3, 0}; EllipsoidShell: {radius: {r, r * 0.3, r}, longitude_start: 0, longitude_end: 6.2832, latitude_start: 0 - HALF_PI, latitude_end: 0, segments: 8, rings: 3} }
    if jacket {
      for i in 0..6 {
        "coil_{i}" : ShipCopper { Position: {0, 0.55 + i * (h - 0.5) / 5, 0}; Torus: {radius: r + 0.03, tube: 0.035, segments: 8, rings: 3, smooth: true} }
      }
      motor : ShipTeal { Position: {0, 0.3 + h + r * 0.5 + 0.18, 0}; RoundedBox: {0.36, 0.36, 0.36, 0.05, segments: 2} }
      shaft : ShipChrome { Position: {0, 0.3 + h + r * 0.5, 0}; Cylinder: {radius: 0.06, length: 0.12, segments: 4, smooth: true} }
    } else {
      band_a : ShipTeal { Position: {0, 0.3 + h * 0.18, 0}; Cylinder: {radius: r + 0.015, length: 0.14, segments: 8, smooth: true} }
      band_b : ShipTeal { Position: {0, 0.3 + h * 0.86, 0}; Cylinder: {radius: r + 0.015, length: 0.14, segments: 8, smooth: true} }
      nozzle : ShipSteel { Position: {0, 0.3 + h + r * 0.5 + 0.08, 0}; Cylinder: {radius: 0.09, length: 0.2, segments: 4, smooth: true} }
      nozzle_cap : ShipTrim { Position: {0, 0.3 + h + r * 0.5 + 0.19, 0}; Cylinder: {radius: 0.14, length: 0.04, segments: 6, smooth: true} }
    }
    for s in 0..2 {
      const a = s == 0 ? 0.0 : PI
      "sight_{s}" : ShipAlgae { Position: {cos(a) * (r + 0.005), 0.3 + h / 2, sin(a) * (r + 0.005)}; Rotation: {0, 0 - a, 0}; Box: {0.02, h * 0.6, 0.07} }
      "sight_rim_{s}" : ShipTrim { Position: {cos(a) * r, 0.3 + h / 2, sin(a) * r}; Rotation: {0, 0 - a, 0}; Box: {0.02, h * 0.6 + 0.08, 0.13} }
    }
    manway : ShipTrim { Position: {0, 0.3 + h * 0.4, r}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.18, length: 0.06, segments: 6, smooth: true} }
  }

  template LifePlant {
    prop pz: bool = true
    prop nz: bool = true
    prop roof: bool = false
    prop seed: i32 = 0

    RackFrame frame(pz: pz, nz: nz)
    deck : ShipHullDark { Position: {0, 0.19, 0}; Box: {3.56, 0.06, 3.56} }
    for i in 0..9 {
      "grate_{i}" : ShipRecess { Position: {0, 0.225, -1.6 + i * 0.4}; Box: {3.4, 0.012, 0.04} }
    }
    walk : ShipHazard { Position: {0.32, 0.228, 0}; Box: {0.08, 0.01, 3.56} }
    if roof {
      lid : ShipHullDark { Position: {0, CH - 0.05, 0}; Box: {3.56, 0.08, 3.56} }
    }

    for s in 0..2 {
      ReactorVessel "bed_{s}"(h: 1.6, r: 0.34) { Position: {s == 0 ? -1.38 : -0.62, 0.22, -1.3} }
      PlantPipe "bed_up_{s}"(len: 0.18, r: 0.06) { Position: {s == 0 ? -1.38 : -0.62, 2.46, -1.3} }
      PlantElbow "bed_knee_{s}"(r: 0.06) { Position: {s == 0 ? -1.38 : -0.62, 2.55, -1.3} }
    }
    PlantPipe bed_link(len: 1.38, r: 0.06) { Position: {-0.69, 2.55, -1.3}; Rotation: {0, 0, HALF_PI} }
    bed_valve : ShipRed { Position: {-1.0, 2.55, -1.18}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.11, tube: 0.02, segments: 6, rings: 3, smooth: true} }
    bed_valve_body : ShipSteel { Position: {-1.0, 2.55, -1.3}; Box: {0.16, 0.16, 0.2} }

    sabatier {
      Position: {-1.3, 2.18, 0.6}
      shell : ShipWhite { Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.3, length: 1.6, segments: 8, smooth: true} }
      for e in 0..2 {
        "head_{e}" : ShipWhite { Position: {0, 0, e == 0 ? -0.8 : 0.8}; Rotation: {0, e == 0 ? PI : 0, 0}; EllipsoidShell: {radius: {0.3, 0.3, 0.14}, longitude_start: 0, longitude_end: PI, latitude_start: 0 - HALF_PI, latitude_end: HALF_PI, segments: 3, rings: 4} }
      }
      for i in 0..7 {
        "fin_{i}" : ShipCopper { Position: {0, 0, -0.6 + i * 0.2}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.34, length: 0.03, segments: 8, smooth: true} }
      }
      band : ShipOrange { Position: {0, 0, 0.72}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.31, length: 0.08, segments: 8, smooth: true} }
      for e in 0..2 {
        "saddle_{e}" : ShipTrim { Position: {0, -0.62, e == 0 ? -0.55 : 0.55}; Box: {0.4, 0.66, 0.12} }
      }
    }
    PlantPipe sab_out(len: 0.72, r: 0.06) { Position: {-0.64, 2.18, 0.6}; Rotation: {0, 0, HALF_PI} }
    PlantElbow sab_knee(r: 0.06) { Position: {-0.28, 2.18, 0.6} }
    PlantPipe sab_up(len: 0.22, r: 0.06) { Position: {-0.28, 2.29, 0.6} }

    stack {
      Position: {-1.1, 0.22, 0.6}
      skid : ShipHullDark { Position: {0, 0.05, 0}; Box: {0.95, 0.1, 1.5} }
      for e in 0..2 {
        "end_{e}" : ShipTrim { Position: {0, 0.62, e == 0 ? -0.66 : 0.66}; Box: {0.92, 1.0, 0.1} }
      }
      for i in 0..9 {
        if i % 2 == 0 {
          "cell_{i}" : ShipSteel { Position: {0, 0.6, -0.52 + i * 0.13}; Box: {0.82, 0.86, 0.08} }
        } else {
          "cell_{i}" : ShipTeal { Position: {0, 0.6, -0.52 + i * 0.13}; Box: {0.78, 0.82, 0.06} }
        }
      }
      for i in 0..4 {
        const rx = i % 2 == 0 ? -0.38 : 0.38
        const ry = i < 2 ? 0.22 : 1.0
        "rod_{i}" : ShipChrome { Position: {rx, ry, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.025, length: 1.46, segments: 4, smooth: true} }
      }
      bus_a : ShipCopper { Position: {-0.2, 1.14, 0}; Box: {0.08, 0.04, 1.4} }
      bus_b : ShipCopper { Position: {0.2, 1.14, 0}; Box: {0.08, 0.04, 1.4} }
      led : ShipGreenLight { Position: {0.47, 0.9, -0.66}; Box: {0.02, 0.05, 0.08} }
    }
    PlantPipe o2_out(len: 0.36, r: 0.05) { Position: {-0.47, 0.82, -0.2}; Rotation: {0, 0, HALF_PI} }
    PlantElbow o2_knee(r: 0.05) { Position: {-0.28, 0.82, -0.2} }
    PlantPipe o2_up(len: 1.56, r: 0.05) { Position: {-0.28, 1.6, -0.2} }
    PlantElbow o2_top(r: 0.05) { Position: {-0.28, 2.4, -0.2} }

    column {
      Position: {1.32, 0.22, -1.3}
      skirt : ShipTrim { Position: {0, 0.12, 0}; Cylinder: {radius: 0.26, length: 0.24, segments: 6, smooth: true} }
      body : ShipSteel { Position: {0, 1.18, 0}; Cylinder: {radius: 0.28, length: 1.92, segments: 6, smooth: true} }
      cap : ShipSteel { Position: {0, 2.14, 0}; HemiSphere: {radius: 0.28, segments: 4, smooth: true} }
      for i in 0..7 {
        "tray_{i}" : ShipTrim { Position: {0, 0.45 + i * 0.27, 0}; Torus: {radius: 0.29, tube: 0.022, segments: 8, rings: 3, smooth: true} }
      }
      for s in 0..2 {
        "rail_{s}" : ShipYellow { Position: {s == 0 ? -0.12 : 0.12, 1.2, 0.36}; Box: {0.025, 2.0, 0.025} }
      }
      for i in 0..10 {
        "rung_{i}" : ShipYellow { Position: {0, 0.3 + i * 0.2, 0.36}; Box: {0.24, 0.02, 0.02} }
      }
      sight : ShipAlgae { Position: {-0.285, 1.2, 0}; Box: {0.02, 1.2, 0.06} }
    }
    PlantPipe col_out(len: 0.74, r: 0.06) { Position: {0.67, 2.2, -1.3}; Rotation: {0, 0, HALF_PI} }
    PlantElbow col_knee(r: 0.06) { Position: {0.3, 2.2, -1.3} }
    PlantPipe col_up(len: 0.2, r: 0.06) { Position: {0.3, 2.3, -1.3} }

    tank {
      Position: {1.08, 0, -0.1}
      ball : ShipWhite { Position: {0, 1.0, 0}; Sphere: {radius: 0.52, segments: 6, smooth: true} }
      belt : ShipTeal { Position: {0, 1.0, 0}; Torus: {radius: 0.52, tube: 0.03, segments: 8, rings: 3, smooth: true} }
      for i in 0..4 {
        const a = i * HALF_PI + 0.785
        "leg_{i}" : ShipSteel { Position: {cos(a) * 0.38, 0.58, sin(a) * 0.38}; Cylinder: {radius: 0.04, length: 0.72, segments: 4, smooth: true} }
      }
      gauge : ShipAmberLight { Position: {0, 1.0, 0.53}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.09, length: 0.02, segments: 4, smooth: true} }
    }
    PlantPipe tank_up(len: 0.48, r: 0.055) { Position: {1.08, 1.76, -0.1} }
    PlantElbow tank_knee(r: 0.055) { Position: {1.08, 2.0, -0.1} }
    PlantPipe tank_over(len: 0.78, r: 0.055) { Position: {0.69, 2.0, -0.1}; Rotation: {0, 0, HALF_PI} }
    PlantElbow tank_joint(r: 0.055) { Position: {0.3, 2.0, -0.1} }
    PlantPipe tank_rise(len: 0.4, r: 0.055) { Position: {0.3, 2.2, -0.1} }
    tank_valve : ShipRed { Position: {0.69, 2.0, 0.02}; Rotation: {HALF_PI, 0, 0}; Torus: {radius: 0.1, tube: 0.02, segments: 6, rings: 3, smooth: true} }

    for i in 0..4 {
      const tx = 0.62 + i * 0.36
      "algae_{i}" {
