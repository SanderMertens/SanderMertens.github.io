      "tray_{s}" : ShipHullDark { Position: {sx, 2.7, 0}; Box: {0.3, 0.03, 4} }
      "cable_a_{s}" : ShipRed { Position: {sx - 0.08, 2.74, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true} }
      "cable_b_{s}" : ShipYellow { Position: {sx, 2.74, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true} }
      "cable_c_{s}" : ShipTeal { Position: {sx + 0.08, 2.74, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.03, length: 4, segments: 4, smooth: true} }
    }

    pump {
      Position: {0.1, 0.22, -0.5}
      body : ShipTeal { Position: {0, 0.22, 0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.18, length: 0.42, segments: 6, smooth: true} }
      motor : ShipTrim { Position: {0, 0.22, 0.36}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.15, length: 0.34, segments: 6, smooth: true} }
      skid : ShipHullDark { Position: {0, 0.03, 0.12}; Box: {0.36, 0.06, 0.9} }
      led : ShipGreenLight { Position: {0, 0.4, 0.36}; Box: {0.12, 0.03, 0.12} }
    }
    PlantPipe pump_up(len: 2.0, r: 0.07, copper: true) { Position: {0.1, 1.48, -0.72} }
    PlantElbow pump_top(r: 0.07, copper: true) { Position: {0.1, 2.5, -0.72} }

    cabinet {
      Position: {-0.3, 0.22, 1.55}
      body : ShipWhite { Position: {0, 0.6, 0}; RoundedBox: {0.6, 1.2, 0.36, 0.04, segments: 2} }
      screen : ShipScreen { Position: {0, 0.86, 0.185}; Box: {0.44, 0.3, 0.01} }
      for i in 0..3 {
        "led_{i}" : ShipGreenLight { Position: {-0.15 + i * 0.15, 0.55, 0.185}; Box: {0.06, 0.03, 0.01} }
      }
      conduit : ShipTrim { Position: {0, 1.82, 0}; Cylinder: {radius: 0.04, length: 1.24, segments: 4, smooth: true} }
    }
    tag : ShipGreenLight { Position: {-1.89, 2.3, 0}; Box: {0.04, 0.05, 0.6} }
    tag_b : ShipGreenLight { Position: {1.89, 2.3, 0}; Box: {0.04, 0.05, 0.6} }
