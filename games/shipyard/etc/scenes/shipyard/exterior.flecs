// Exterior detail of the modules. A side feature is drawn in the frame of a face: x runs along
// the face, y up from the deck and z out of the hull, with the hull surface at z = 0.

assets {
  bell_outer { Path2D: {start: {0.45, 0}, segments: [{kind: CubicBezier, end: {1.38, 2.25}, control1: {0.52, 0.8}, control2: {0.98, 1.75}}]} }
  bell_inner { Path2D: {start: {0.38, 0}, segments: [{kind: CubicBezier, end: {1.31, 2.25}, control1: {0.45, 0.8}, control2: {0.91, 1.75}}]} }
  plume_core_shape { Path2D: {start: {0.62, 0}, segments: [{kind: CubicBezier, end: {0.08, 8}, control1: {0.5, 2.5}, control2: {0.35, 6}}]} }

  yard_nose_shape {
    Path2D: {
      start: {2, 0},
      segments: [
        {kind: Line, end: {2, 1.08}},
        {kind: CubicBezier, end: {1.58, 1.5}, control1: {2, 1.312}, control2: {1.812, 1.5}},
        {kind: Line, end: {-1.58, 1.5}},
        {kind: CubicBezier, end: {-2, 1.08}, control1: {-1.812, 1.5}, control2: {-2, 1.312}},
        {kind: Line, end: {-2, -1.08}},
        {kind: CubicBezier, end: {-1.58, -1.5}, control1: {-2, -1.312}, control2: {-1.812, -1.5}},
        {kind: Line, end: {1.58, -1.5}},
        {kind: CubicBezier, end: {2, -1.08}, control1: {1.812, -1.5}, control2: {2, -1.312}}
      ],
      closed: true
    }
  }
  yard_nose_profile { Profile2D: {outer: yard_nose_shape} }

  yard_canopy_shape {
    Path2D: {
      start: {2, 0.62},
      segments: [
        {kind: Line, end: {2, 1.08}},
        {kind: CubicBezier, end: {1.58, 1.5}, control1: {2, 1.312}, control2: {1.812, 1.5}},
        {kind: Line, end: {-1.58, 1.5}},
        {kind: CubicBezier, end: {-2, 1.08}, control1: {-1.812, 1.5}, control2: {-2, 1.312}},
        {kind: Line, end: {-2, 0.62}},
        {kind: Line, end: {-1.95, 0.62}},
        {kind: Line, end: {-1.95, 1.08}},
        {kind: CubicBezier, end: {-1.58, 1.45}, control1: {-1.95, 1.285}, control2: {-1.785, 1.45}},
        {kind: Line, end: {1.58, 1.45}},
        {kind: CubicBezier, end: {1.95, 1.08}, control1: {1.785, 1.45}, control2: {1.95, 1.285}},
        {kind: Line, end: {1.95, 0.62}}
      ],
      closed: true
    }
  }
  yard_canopy_profile { Profile2D: {outer: yard_canopy_shape} }

  yard_stripe_shape { Path2D: {start: {2.02, 0.37}, segments: [{kind: Line, end: {2.02, 0.59}}, {kind: Line, end: {1.98, 0.59}}, {kind: Line, end: {1.98, 0.37}}], closed: true} }
  yard_stripe_profile { Profile2D: {outer: yard_stripe_shape} }
  yard_line_shape { Path2D: {start: {2.02, 0.215}, segments: [{kind: Line, end: {2.02, 0.265}}, {kind: Line, end: {1.98, 0.265}}, {kind: Line, end: {1.98, 0.215}}], closed: true} }
  yard_line_profile { Profile2D: {outer: yard_line_shape} }
  yard_stripe_n_shape { Path2D: {start: {-2.02, 0.37}, segments: [{kind: Line, end: {-1.98, 0.37}}, {kind: Line, end: {-1.98, 0.59}}, {kind: Line, end: {-2.02, 0.59}}], closed: true} }
  yard_stripe_n_profile { Profile2D: {outer: yard_stripe_n_shape} }
  yard_line_n_shape { Path2D: {start: {-2.02, 0.215}, segments: [{kind: Line, end: {-1.98, 0.215}}, {kind: Line, end: {-1.98, 0.265}}, {kind: Line, end: {-2.02, 0.265}}], closed: true} }
  yard_line_n_profile { Profile2D: {outer: yard_line_n_shape} }
  yard_spine_shape { Path2D: {start: {0.07, 1.46}, segments: [{kind: Line, end: {0.07, 1.54}}, {kind: Line, end: {-0.07, 1.54}}, {kind: Line, end: {-0.07, 1.46}}], closed: true} }
  yard_spine_profile { Profile2D: {outer: yard_spine_shape} }

  yard_arch_shape {
    Path2D: {
      start: {1.95, 0},
      segments: [
        {kind: CubicBezier, end: {0, 1.95}, control1: {1.95, 1.077}, control2: {1.077, 1.95}},
        {kind: CubicBezier, end: {-1.95, 0}, control1: {-1.077, 1.95}, control2: {-1.95, 1.077}},
        {kind: Line, end: {-1.92, 0}},
        {kind: CubicBezier, end: {0, 1.92}, control1: {-1.92, 1.06}, control2: {-1.06, 1.92}},
        {kind: CubicBezier, end: {1.92, 0}, control1: {1.06, 1.92}, control2: {1.92, 1.06}}
      ],
      closed: true
    }
  }
  yard_arch_profile { Profile2D: {outer: yard_arch_shape} }

  yard_rib_shape {
    Path2D: {
      start: {2.01, 0},
      segments: [
        {kind: CubicBezier, end: {0, 2.01}, control1: {2.01, 1.11}, control2: {1.11, 2.01}},
        {kind: CubicBezier, end: {-2.01, 0}, control1: {-1.11, 2.01}, control2: {-2.01, 1.11}},
        {kind: Line, end: {-1.9, 0}},
        {kind: CubicBezier, end: {0, 1.9}, control1: {-1.9, 1.05}, control2: {-1.05, 1.9}},
        {kind: CubicBezier, end: {1.9, 0}, control1: {1.05, 1.9}, control2: {1.9, 1.05}}
      ],
      closed: true
    }
  }
  yard_rib_profile { Profile2D: {outer: yard_rib_shape} }
}

state {
  export const NOSE_LEN: f32 = 3.6

  fn nose_w(t: f32) -> f32 { 0.12 + 0.88 * sqrt(max(1 - pow(t, 1.9), 0)) }
  fn nose_h(t: f32) -> f32 { 0.1 + 0.9 * sqrt(max(1 - pow(t, 1.35), 0)) }
  fn nose_y(t: f32) -> f32 { 0.7 * t * t + 1.5 * nose_h(t) }
  fn nose_z(t: f32) -> f32 { 2 + NOSE_LEN * t }

  fn nose_sec(t: f32, grow: f32) -> box.geometry.LoftSection {
    {profile: assets.yard_nose_profile, offset: {0, nose_y(t), nose_z(t)}, rotation: {0 - HALF_PI, 0, 0}, scale: {0 - nose_w(t) * grow, nose_h(t) * grow}}
  }

  fn glass_sec(t: f32, grow: f32) -> box.geometry.LoftSection {
    {profile: assets.yard_canopy_profile, offset: {0, nose_y(t), nose_z(t)}, rotation: {0 - HALF_PI, 0, 0}, scale: {0 - nose_w(t) * grow, nose_h(t) * grow}}
  }

  fn band_sec(p: entity, t: f32) -> box.geometry.LoftSection {
    {profile: p, offset: {0, nose_y(t), nose_z(t)}, rotation: {0 - HALF_PI, 0, 0}, scale: {0 - nose_w(t), nose_h(t)}}
  }

  fn arch_sec(p: entity, z: f32) -> box.geometry.LoftSection {
    {profile: p, offset: {0, 0.6, z}, rotation: {0 - HALF_PI, 0, 0}, scale: {-1, 1}}
  }
}

assets {
  template HabSide {
    for c in 0..3 {
      "frame_{c}" : ShipTrim { Position: {-1.1 + c * 1.1, 1.15, 0.02}; RoundedBox: {0.78, 0.56, 0.06, 0.08, segments: 2} }
      "pane_{c}" : ShipWindow { Position: {-1.1 + c * 1.1, 1.15, 0.045}; RoundedBox: {0.62, 0.4, 0.04, 0.06, segments: 2} }
      "sill_{c}" : ShipSteel { Position: {-1.1 + c * 1.1, 0.83, 0.05}; Box: {0.7, 0.04, 0.06} }
    }
    vent : ShipTrim { Position: {0.9, 2.5, 0.02}; Box: {0.8, 0.22, 0.04} }
    for i in 0..4 {
      "slat_{i}" : ShipRecess { Position: {0.62 + i * 0.19, 2.5, 0.041}; Box: {0.08, 0.16, 0.01} }
    }
  }

  template ObsSide {
    backdrop : ShipLounge { Position: {0, 1.66, 0.012}; Box: {3.3, 1.66, 0.02} }
    sill : ShipHull { Position: {0, 0.78, 0.32}; Box: {3.56, 0.12, 0.64} }
    head : ShipHull { Position: {0, 2.55, 0.43}; Box: {3.56, 0.12, 0.86} }
    head_trim : ShipStripe { Position: {0, 2.55, 0.866}; Box: {3.56, 0.08, 0.012} }
    for s in 0..2 {
      "cheek_{s}" : ShipHull { Position: {s == 0 ? -1.74 : 1.74, 1.66, 0.4}; Box: {0.08, 1.66, 0.8} }
    }
    glass : ShipGlass { Position: {0, 1.66, 0.6}; Rotation: {0.18, 0, 0}; Box: {3.4, 1.68, 0.03} }
    for i in 0..4 {
      "mullion_{i}" : ShipTrim { Position: {-1.2 + i * 0.8, 1.66, 0.62}; Rotation: {0.18, 0, 0}; Box: {0.05, 1.7, 0.06} }
    }
    couch : ShipFabric { Position: {-0.6, 0.98, 0.22}; RoundedBox: {1.5, 0.28, 0.36, 0.08, segments: 2} }
    couch_back : ShipFabric { Position: {-0.6, 1.2, 0.07}; RoundedBox: {1.5, 0.4, 0.12, 0.05, segments: 2} }
    plant : ShipLeaf { Position: {1.15, 1.08, 0.24}; IcoSphere: {radius: 0.22, segments: 0} }
    pot : ShipWhite { Position: {1.15, 0.9, 0.24}; Cylinder: {radius: 0.12, length: 0.2, segments: 6, smooth: true} }
    underglow : ShipWhiteLight { Position: {0, 0.71, 0.55}; Box: {3.3, 0.02, 0.04} }
  }

  template SideFeature {
    prop k: i32 = 0

    if k == K_HAB {
      HabSide f()
    } else if k == K_OBS {
      ObsSide f()
    }
  }

  template Sides {
    prop k: i32 = 0
    prop px: bool = false
    prop nx: bool = false
    prop pz: bool = false
    prop nz: bool = false

    if px {
      face_px { Position: {2, 0, 0}; Rotation: {0, HALF_PI, 0}; SideFeature f(k: k) }
    }
    if nx {
      face_nx { Position: {-2, 0, 0}; Rotation: {0, -HALF_PI, 0}; SideFeature f(k: k) }
    }
    if pz {
      face_pz { Position: {0, 0, 2}; SideFeature f(k: k) }
    }
    if nz {
      face_nz { Position: {0, 0, -2}; Rotation: {0, PI, 0}; SideFeature f(k: k) }
    }
  }

  template WeaponTurret {
    pad : ShipHullDark { Position: {0, 0.03, 0}; RoundedBox: {2.7, 0.06, 2.7, 0.03, segments: 2} }
    for i in 0..4 {
      const bx = i % 2 == 0 ? -1.15 : 1.15
      const bz = i < 2 ? -1.15 : 1.15
      "bolt_{i}" : ShipChrome { Position: {bx, 0.08, bz}; Cylinder: {radius: 0.07, length: 0.05, segments: 4, smooth: true} }
    }
    base : ShipTrim { Position: {0, 0.13, 0}; Cylinder: {radius: 1.15, length: 0.22, segments: 8, smooth: true} }
    ring : ShipSteel { Position: {0, 0.25, 0}; Torus: {radius: 1.08, tube: 0.05, segments: 8, rings: 3, smooth: true} }
    head {
      Position: {0, 0.26, 0}
      housing : ShipHullDark { Position: {0, 0.38, -0.15}; RoundedBox: {1.5, 0.72, 1.7, 0.2, segments: 3} }
      cap : ShipHull { Position: {0, 0.76, -0.25}; RoundedBox: {1.2, 0.1, 1.2, 0.05, segments: 2} }
      mantlet : ShipTrim { Position: {0, 0.4, 0.74}; RoundedBox: {1.0, 0.5, 0.24, 0.08, segments: 2} }
      for s in 0..2 {
        const bx = s == 0 ? -0.26 : 0.26
        "shroud_{s}" : ShipTrim { Position: {bx, 0.4, 1.0}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.13, length: 0.5, segments: 6, smooth: true} }
        "barrel_{s}" : ShipSteel { Position: {bx, 0.4, 1.3}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.075, length: 1.1, segments: 4, smooth: true} }
        "muzzle_{s}" : ShipTrim { Position: {bx, 0.4, 1.8}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.11, length: 0.16, segments: 6, smooth: true} }
      }
      eye : ShipRedLight { Position: {0.6, 0.55, 0.62}; Sphere: {radius: 0.08, segments: 3, smooth: true} }
      vent_a : ShipRecess { Position: {-0.76, 0.38, -0.3}; Box: {0.02, 0.36, 0.9} }
      vent_b : ShipRecess { Position: {0.76, 0.38, -0.3}; Box: {0.02, 0.36, 0.9} }
    }
  }

  template HabTop {
    hatch : ShipTrim { Position: {0.7, 0.03, 0.6}; Cylinder: {radius: 0.45, length: 0.06, segments: 8, smooth: true} }
    lid : ShipHull { Position: {0.7, 0.07, 0.6}; Cylinder: {radius: 0.36, length: 0.04, segments: 8, smooth: true} }
    stalk : ShipSteel { Position: {-0.8, 0.3, -0.8}; Cylinder: {radius: 0.05, length: 0.6, segments: 4, smooth: true} }
    dish : ShipWhite { Position: {-0.8, 0.62, -0.8}; Rotation: {PI - 0.5, 0, 0}; HemiSphere: {radius: 0.42, segments: 4, smooth: true} }
    feed : ShipSteel { Position: {-0.8, 0.55, -0.65}; Cylinder: {radius: 0.02, length: 0.4, segments: 4, smooth: true} }
  }

  template LandingLeg {
    strut : ShipSteel { Position: {0, -0.46, 0}; Cylinder: {radius: 0.09, length: 0.88, segments: 4, smooth: true} }
    sleeve : ShipTrim { Position: {0, -0.25, 0}; Cylinder: {radius: 0.14, length: 0.4, segments: 6, smooth: true} }
    foot : ShipTrim { Position: {0, -0.92, 0}; Cylinder: {radius: 0.32, length: 0.08, segments: 8, smooth: true} }
  }

  template CargoBelly {
    frame : ShipHazard { Position: {0, -0.02, 0}; Box: {2.7, 0.04, 2.9} }
    ramp : ShipHullDark { Position: {0, -0.045, 0}; Box: {2.4, 0.04, 2.6} }
    for i in 0..6 {
      "rib_{i}" : ShipTrim { Position: {0, -0.07, -1.05 + i * 0.42}; Box: {2.3, 0.02, 0.06} }
    }
    LandingLeg leg_a() { Position: {-1.2, 0, -1.2} }
    LandingLeg leg_b() { Position: {1.2, 0, -1.2} }
    LandingLeg leg_c() { Position: {-1.2, 0, 1.2} }
    LandingLeg leg_d() { Position: {1.2, 0, 1.2} }
    flood : ShipWhiteLight { Position: {0, -0.08, 1.5}; Box: {0.6, 0.04, 0.12} }
  }

  template WeaponMount {
    prop side: i32 = 1

    if side == 2 {
      mount { Position: {-2, CH / 2, 0}; Rotation: {0, 0, 0 - HALF_PI}; WeaponTurret turret() }
    } else if side == 3 {
      mount { Position: {2, CH / 2, 0}; Rotation: {0, 0, HALF_PI}; WeaponTurret turret() }
    } else {
      WeaponTurret turret()
    }
  }

  template RackFrame {
    prop pz: bool = true
    prop nz: bool = true

    const bw = 0.22
    const ex = 2 - bw / 2
    for c in 0..4 {
      const cx = c % 2 == 0 ? 0 - ex : ex
      const cy = c < 2 ? bw / 2 : CH - bw / 2
      "long_{c}" : ShipHullDark { Position: {cx, cy, 0}; Box: {bw, bw, 4} }
    }
    for e in 0..2 {
      const ez = e == 0 ? 0 - ex : ex
      if (e == 0 && nz) || (e == 1 && pz) {
        const post_z = ez - (e == 0 ? -0.0015 : 0.0015)
        "post_a_{e}" : ShipHullDark { Position: {0 - ex, CH / 2, post_z}; Box: {bw, CH - bw * 2, bw - 0.003} }
        "post_b_{e}" : ShipHullDark { Position: {ex, CH / 2, post_z}; Box: {bw, CH - bw * 2, bw - 0.003} }
        "sill_{e}" : ShipHullDark { Position: {0, bw / 2, ez}; Box: {4 - bw * 2, bw, bw} }
        "lintel_{e}" : ShipHullDark { Position: {0, CH - bw / 2, ez}; Box: {4 - bw * 2, bw, bw} }
        "cap_a_{e}" : ShipHazard { Position: {0 - ex, CH - 0.02, ez}; Box: {bw + 0.02, 0.06, bw + 0.02} }
        "cap_b_{e}" : ShipHazard { Position: {ex, CH - 0.02, ez}; Box: {bw + 0.02, 0.06, bw + 0.02} }
      }
    }
  }

  template CargoContainer {
    prop tint: Rgb = {164, 70, 44}
    prop rib_p: bool = false
    prop rib_n: bool = false
    prop roof: bool = false
    prop front: bool = false
    prop back: bool = false

    const w = 1.7
    const h = 1.22
    const l = 3.5

    body : ShipCrate { Position: {0, 0, 0}; Box: {w - 0.08, h - 0.08, l - 0.1}; Rgb: tint }
    for e in 0..2 {
      "end_{e}" : ShipCrate { Position: {0, 0, e == 0 ? 0.05 - l / 2 : l / 2 - 0.05}; Box: {w - 0.02, h - 0.02, 0.1}; Rgb: tint }
    }
    for c in 0..4 {
      const cx = c % 2 == 0 ? 0.05 - w / 2 : w / 2 - 0.05
      const cy = c < 2 ? 0.05 - h / 2 : h / 2 - 0.05
      "rail_{c}" : ShipTrim { Position: {cx, cy, 0}; Box: {0.1, 0.1, l + 0.02} }
    }
    for i in 0..8 {
      const rz = -1.33 + i * 0.38
      if rib_p {
        "rib_p_{i}" : ShipCrate { Position: {w / 2 - 0.03, 0, rz}; Box: {0.04, h - 0.2, 0.1}; Rgb: tint }
      }
      if rib_n {
        "rib_n_{i}" : ShipCrate { Position: {0.03 - w / 2, 0, rz}; Box: {0.04, h - 0.2, 0.1}; Rgb: tint }
      }
      if roof {
        "rib_t_{i}" : ShipCrate { Position: {0, h / 2 - 0.03, rz}; Box: {w - 0.2, 0.04, 0.1}; Rgb: tint }
      }
    }
    for e in 0..2 {
      const ez = e == 0 ? 0 - l / 2 - 0.01 : l / 2 + 0.01
      if (e == 0 && back) || (e == 1 && front) {
        "seam_{e}" : ShipRecess { Position: {0, 0, ez}; Box: {0.02, h - 0.14, 0.02} }
        for b in 0..2 {
          const bx = b == 0 ? -0.22 : 0.22
          "bar_{e}_{b}" : ShipSteel { Position: {bx, 0, ez}; Box: {0.035, h - 0.18, 0.04} }
          "grip_{e}_{b}" : ShipSteel { Position: {bx + (b == 0 ? -0.05 : 0.05), -0.1, ez}; Box: {0.1, 0.03, 0.05} }
        }
      }
    }
  }

  template CargoRack {
    prop px: bool = false
    prop nx: bool = false
    prop py: bool = false
    prop pz: bool = true
    prop nz: bool = true
    prop belly: bool = true
    prop seed: i32 = 0

    RackFrame frame(pz: pz, nz: nz)
    floor : ShipHullDark { Position: {0, 0.19, 0}; Box: {3.56, 0.06, 3.56} }
    for s in 0..4 {
      const right = s % 2 == 1
      const upper = s >= 2
      const pick = (seed * 37 + s * 13) % 6
      const tint: Rgb = match pick {
        0: {164, 70, 44}
        1: {38, 76, 132}
        2: {52, 106, 72}
        3: {206, 154, 38}
        4: {124, 130, 138}
        _: {30, 112, 120}
      }
      if !(upper && py && (seed * 29 + s * 7) % 5 == 0) {
        CargoContainer "crate_{s}"(tint: tint, rib_p: right && px, rib_n: !right && nx, roof: upper && py, front: pz, back: nz) {
          Position: {right ? 0.92 : -0.92, upper ? 2.09 : 0.83, 0}
        }
      }
    }
    if belly {
      CargoBelly belly()
    }
  }

  template FuelRack {
    prop px: bool = true
    prop nx: bool = true
    prop pz: bool = true
    prop nz: bool = true
    prop tp: bool = false
    prop tn: bool = false

    const r = 1.22
    const z0 = tn ? -2 : -1.2
    const z1 = tp ? 2 : 1.2
    const brace = 0.6233

    RackFrame frame(pz: pz, nz: nz)
    tank : ShipWhite { Position: {0, 1.5, (z0 + z1) / 2}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: r, length: z1 - z0, segments: 8, smooth: true} }
    if !tp {
      dome_p : ShipWhite { Position: {0, 1.5, 1.2}; EllipsoidShell: {radius: {r, r, 0.58}, longitude_start: 0, longitude_end: PI, latitude_start: 0 - HALF_PI, latitude_end: HALF_PI, segments: 4, rings: 4} }
      boss_p : ShipSteel { Position: {0, 1.5, 1.8}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.16, length: 0.1, segments: 6, smooth: true} }
    }
    if !tn {
      dome_n : ShipWhite { Position: {0, 1.5, -1.2}; Rotation: {0, PI, 0}; EllipsoidShell: {radius: {r, r, 0.58}, longitude_start: 0, longitude_end: PI, latitude_start: 0 - HALF_PI, latitude_end: HALF_PI, segments: 4, rings: 4} }
      boss_n : ShipSteel { Position: {0, 1.5, -1.8}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.16, length: 0.1, segments: 6, smooth: true} }
    }
    for s in 0..2 {
      const sz = s == 0 ? -1.0 : 1.0
      "band_{s}" : ShipOrange { Position: {0, 1.5, s == 0 ? -0.5 : 0.5}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: r + 0.02, length: 0.2, segments: 8, smooth: true} }
      "strap_{s}" : ShipTrim { Position: {0, 1.5, sz}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: r + 0.025, length: 0.08, segments: 8, smooth: true} }
      "cross_{s}" : ShipHullDark { Position: {0, 0.11, sz}; Box: {3.56, 0.18, 0.2} }
      "saddle_{s}" : ShipTrim { Position: {0, 0.38, sz}; Box: {1.6, 0.36, 0.26} }
      "clip_{s}" : ShipTrim { Position: {0, 2.8, sz}; Box: {0.14, 0.12, 0.1} }
    }
    const pz0 = nz ? -1.998 : -2
    const pz1 = pz ? 1.998 : 2
    pipe : ShipCopper { Position: {0, 2.9, (pz0 + pz1) / 2}; Rotation: {HALF_PI, 0, 0}; Cylinder: {radius: 0.07, length: pz1 - pz0, segments: 4, smooth: true} }
    riser : ShipSteel { Position: {0, 2.98, 0}; Cylinder: {radius: 0.04, length: 0.14, segments: 4, smooth: true} }
    wheel : ShipRed { Position: {0, 3.04, 0}; Torus: {radius: 0.13, tube: 0.025, segments: 6, rings: 3, smooth: true} }
    if px {
      gauge_p : ShipAmberLight { Position: {r + 0.01, 1.5, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.12, length: 0.03, segments: 6, smooth: true} }
      brace_pa : ShipSteel { Position: {1.89, 1.5, 0}; Rotation: {brace, 0, 0}; Box: {0.08, 0.08, 4.38} }
      brace_pb : ShipSteel { Position: {1.89, 1.5, 0}; Rotation: {0 - brace, 0, 0}; Box: {0.08, 0.08, 4.38} }
    }
    if nx {
      gauge_n : ShipAmberLight { Position: {0 - r - 0.01, 1.5, 0}; Rotation: {0, 0, HALF_PI}; Cylinder: {radius: 0.12, length: 0.03, segments: 6, smooth: true} }
      brace_na : ShipSteel { Position: {-1.89, 1.5, 0}; Rotation: {brace, 0, 0}; Box: {0.08, 0.08, 4.38} }
      brace_nb : ShipSteel { Position: {-1.89, 1.5, 0}; Rotation: {0 - brace, 0, 0}; Box: {0.08, 0.08, 4.38} }
    }
  }

  template CockpitNose {
    prop px: bool = true
    prop nx: bool = true

    shell : ShipHull {
      Position: {0, 0, 0}; Loft: {
        sections: [
          nose_sec(0, 1), nose_sec(0.12, 1), nose_sec(0.25, 1), nose_sec(0.38, 1), nose_sec(0.5, 1), nose_sec(0.62, 1),
          nose_sec(0.72, 1), nose_sec(0.8, 1), nose_sec(0.87, 1), nose_sec(0.93, 1), nose_sec(0.97, 1), nose_sec(1, 1)
        ],
        cap_start: false, cap_end: true, segments: 2, rings: 4
      }
    }
    canopy : ShipCanopy {
      Position: {0, 0, 0}; Loft: {
        sections: [glass_sec(0, 1.012), glass_sec(0.12, 1.012), glass_sec(0.25, 1.012), glass_sec(0.38, 1.012), glass_sec(0.5, 1.012), glass_sec(0.6, 1.012)],
        cap_start: true, cap_end: true, segments: 2, rings: 3
      }
    }
    for i in 0..4 {
      const t = match i { 0: 0.003; 1: 0.2; 2: 0.4; _: 0.585 }
      "frame_{i}" : ShipTrim {
        Position: {0, 0, 0}; Loft: {sections: [glass_sec(t, 1.03), glass_sec(t + 0.018, 1.03)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
    }
    ridge : ShipTrim {
      Position: {0, 0, 0}; Loft: {sections: [band_sec(yard_spine_profile, 0.003), band_sec(yard_spine_profile, 0.2), band_sec(yard_spine_profile, 0.4), band_sec(yard_spine_profile, 0.597)], cap_start: true, cap_end: true, segments: 2, rings: 3}
    }
    if px {
      stripe_p : ShipStripe {
        Position: {0, 0, 0}; Loft: {sections: [band_sec(yard_stripe_n_profile, 0), band_sec(yard_stripe_n_profile, 0.25), band_sec(yard_stripe_n_profile, 0.5), band_sec(yard_stripe_n_profile, 0.7), band_sec(yard_stripe_n_profile, 0.84)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
      line_p : ShipTrim {
        Position: {0, 0, 0}; Loft: {sections: [band_sec(yard_line_n_profile, 0), band_sec(yard_line_n_profile, 0.25), band_sec(yard_line_n_profile, 0.5), band_sec(yard_line_n_profile, 0.7), band_sec(yard_line_n_profile, 0.8)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
    }
    if nx {
      stripe_n : ShipStripe {
        Position: {0, 0, 0}; Loft: {sections: [band_sec(yard_stripe_profile, 0), band_sec(yard_stripe_profile, 0.25), band_sec(yard_stripe_profile, 0.5), band_sec(yard_stripe_profile, 0.7), band_sec(yard_stripe_profile, 0.84)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
      line_n : ShipTrim {
        Position: {0, 0, 0}; Loft: {sections: [band_sec(yard_line_profile, 0), band_sec(yard_line_profile, 0.25), band_sec(yard_line_profile, 0.5), band_sec(yard_line_profile, 0.7), band_sec(yard_line_profile, 0.8)], cap_start: true, cap_end: true, segments: 2, rings: 3}
      }
    }
    tip : ShipChrome { Position: {0, nose_y(1), nose_z(1) - 0.05}; Sphere: {radius: 0.16, segments: 4, smooth: true} }
    for s in 0..2 {
      const sx = s == 0 ? -1 : 1
      "lamp_{s}" : ShipWhiteLight { Position: {sx * (2 * nose_w(0.55) + 0.01), nose_y(0.55) - nose_h(0.55) * 0.5, nose_z(0.55)}; Box: {0.02, 0.05, 0.36} }
    }
  }

