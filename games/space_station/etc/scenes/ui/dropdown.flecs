// Dropdown: one of a list of strings chosen from a list that floats below the button.

module box.widgets

using flecs.script
using flecs.script.math
using box.ui
using box.input
using box.picking
using box.layout
using box.geometry
using box.material
using box.text
using box.transform

// A chevron of two strokes in a box of size points that points down, up, right or left
template Chevron {
  prop direction: string = "down"
  prop size: f32 = 12
  prop color: Rgb = {214, 218, 224}

  const a = size / 3
  const b = size / 6
  const sx = match direction {
    "right": -b
    "left": b
    _: -a
  }
  const sy = match direction {
    "down": b
    "up": -b
    "right": a
    _: a
  }
  const tx = match direction {
    "right": b
    "left": -b
    _: 0
  }
  const ty = match direction {
    "down": -b
    "up": b
    _: 0
  }
  const ex = match direction {
    "right": -b
    "left": b
    _: a
  }
  const ey = match direction {
    "down": b
    "up": -b
    "right": -a
    _: -a
  }

  Layout: {}
  LayoutItem: {width: {mode: Fixed, value: size}, height: {mode: Fixed, value: size}}

  first {
    Position: {0, 0, 0}
    Line: {sx, sy, tx, ty, 1.5}
    Rgb: color
  }

  second {
    Position: {0, 0, 0}
    Line: {tx, ty, ex, ey, 1.5}
    Rgb: color
  }
}

// Behavior of a dropdown, a select-only combobox: current is the index of the chosen string of
// options, open whether its list shows and highlight the option the list marks.
//
// A click, Enter, Space, Down or Up opens the list with the current option highlighted; while it
// is open the dropdown has KeyCapture, so the keys stay out of the bindings: Up and Down move the
// highlight, Home and End go to the first and last option, Enter or Space choose the highlighted
// one and close, Escape closes without a change. The pointer over an option highlights it and a
// click chooses it. A click on the button, Tab or a press anywhere else (the dropdown loses the
// focus) closes the list. Choosing another option reports a change.
//
// The list is the child list, a LayoutFloat below the button that flips above it when it does not
// fit below and hides (not drawn, not clicked) while a scroll view clips the button out of view,
// staying open; its options are row points tall with inset points above and below them. over is
// whether the pointer is over the list. The template reads no component, so its async blocks only
// restart when a prop changes. The pointer shows a hand over the button and the list, a crossed
// circle while the dropdown is disabled.
template HeadlessDropdown {
  prop options = ["Option"]
  prop value: i32 = 0
  prop disabled: bool = false
  prop width: f32 = 0
  prop row: f32 = 0
  prop inset: f32 = 0

  mut current: i32 = clamp(value, 0, options.count() - 1)
  mut last_value: i32 = value
  mut open = false
  mut highlight: i32 = 0
  mut over = false
  mut hover = false
  mut down = false
  mut focused = false

  const count = options.count()
  const list_h = count * row + inset * 2

  if !disabled {
    Focusable
    Cursor: {CursorPointer}
  } else {
    Cursor: {CursorNotAllowed}
  }

  if open {
    KeyCapture
  }

  async {
    if value != last_value {
      last_value = value
      current = clamp(value, 0, count - 1)
    }
  }

  list {
    LayoutFloat: {
      h: Left, v: Top, anchor_h: Left, anchor_v: Bottom, y: -2, flip: true, hide_clipped: true
    }
  }

  // A disabled dropdown ignores the pointer, so it never shows as hovered or pressed
  async {
    while true {
      await on.enter(this)
      hover = !disabled
    }
  }

  async {
    while true {
      await on.leave(this)
      hover = false
    }
  }

  async {
    while true {
      await on.press(this)
      down = !disabled
    }
  }

  async {
    while true {
      await on.release(this)
      down = false
    }
  }

  async {
    while true {
      const e = await on.focus(this)
      if e.target == this {
        focused = true
      }
    }
  }

  async {
    while true {
      const e = await on.blur(this)
      if e.target == this {
        focused = false
        down = false
        open = false
      }
    }
  }

  async {
    while true {
      await on.leave(list)
      over = false
    }
  }

  // The option under the pointer, counted from the top of the list
  async {
    while true {
      const e = await on.move(list)
      const i = floor((list_h / 2 - e.local_y - inset) / max(row, 1))
      over = true
      if open && i >= 0 && i < count && i != highlight {
        highlight = i
      }
    }
  }

  async {
    while true {
      const e = await on.press(list)
      const i = floor((list_h / 2 - e.local_y - inset) / max(row, 1))
      over = true
      if open && i >= 0 && i < count {
        highlight = i
      }
    }
  }

  // A click on the list chooses the highlighted option, one on the button opens or closes it
  async {
    while true {
      const e = await on.activate(this)
      if ui.activation(e) == this {
        if !e.keyboard && !disabled && open && over {
          open = false
          if highlight != current {
            current = highlight
            await ui.changed(this)
          }
        } else if !e.keyboard && !disabled && open {
          open = false
        } else if !e.keyboard && !disabled {
          highlight = current
          over = false
          open = true
        }
      }
    }
  }

  async {
    while true {
      const e = await on.key_down(this)
      if !disabled {
        if open {
          if e.key == "Escape" {
            open = false
          } else if e.key == "Enter" || e.key == " " {
            open = false
            if highlight != current {
              current = highlight
              await ui.changed(this)
            }
          } else {
            const target = match e.key {
              "ArrowDown": highlight + 1
              "ArrowUp": highlight - 1
              "PageDown": highlight + 10
              "PageUp": highlight - 10
              "Home": 0
              "End": count - 1
              _: highlight
            }
            highlight = clamp(target, 0, count - 1)
          }
        } else if !e.repeat && (e.key == "Enter" || e.key == " " ||
          e.key == "ArrowDown" || e.key == "ArrowUp")
        {
          highlight = current
          over = false
          open = true
        }
      }
    }
  }
}

// A dropdown: a button with the chosen option and a chevron, and while open a list of the options
// as wide as the button. A width fixes it, 0 makes it 160 points.
template Dropdown : HeadlessDropdown {
  prop row: f32 = 28
  prop inset: f32 = 4

  const t = box.ui.theme[UiTheme]
  const ring = focused && FocusStatus[FocusStatus].visible
  const count = options.count()
  const w = match width {
    0.0: 160
    _: width
  }

  Layout: {direction: Row, padding: {0, 0, t.padding * 1.5, t.padding}, v: Middle}
  LayoutItem: {
    width: {mode: Fixed, value: w},
    height: {mode: Fixed, value: t.control_height}
  }
  Rect: {1, 1}

  if down && !open {
    Rgb: t.pressed
  } else if hover && !open {
    Rgb: t.hover
  } else {
    Rgb: t.surface
  }

  if ring {
    Border: {
      width: t.focus_width, radius: t.radius,
      color: {t.focus.r, t.focus.g, t.focus.b, 255}
    }
  } else {
    Border: {width: 1, radius: t.radius, color: {t.border.r, t.border.g, t.border.b, 255}}
  }

  caption {
    Text: {value: options[current], size: t.font_size}
    Rgb: t.text
  }

  gap {
    LayoutItem: {width: {mode: Grow}}
  }

  Chevron chevron(direction: match open { true: "up"; _: "down" }, color: t.text_muted)

  list {
    if open {
      Layout: {direction: Column, padding: {inset, inset, inset, inset}}
      LayoutItem: {width: {mode: Grow}}
      Rect: {1, 1}
      Rgb: t.surface
      Border: {width: 1, radius: t.radius, color: {t.border.r, t.border.g, t.border.b, 255}}

      for i in 0..count {
        "option_{i}" {
          Layout: {direction: Row, padding: {0, 0, t.padding, t.padding}, v: Middle}
          LayoutItem: {width: {mode: Grow}, height: {mode: Fixed, value: row}}
          Rect: {1, 1}
          Border: {radius: t.radius - 1}

          if i == highlight {
            Rgb: t.hover
          } else {
            Rgb: t.surface
          }

          caption {
            Text: {value: options[i], size: t.font_size}
            if i == current {
              Rgb: t.accent
            } else {
              Rgb: t.text
            }
          }
        }
      }
    }
  }

  if disabled {
    Opacity: {t.disabled_opacity}
  }
}
