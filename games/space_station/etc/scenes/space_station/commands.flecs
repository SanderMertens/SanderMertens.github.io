include state

using flecs.script
using flecs.script.math
using state

state {
  proc st_reset() {
    st_tool = 0
    st_speed = 1
    st_lost = false
    st_rank = 0
    st_credits = 2500
    st_income = 0
    st_residents = 8
    st_visitors = 0
    st_food = 40
    st_goods = 0
    st_air = 80
    st_reputation = 50
    st_growth = 0
    st_decline = 0
    st_visitor_spend = 0
    st_grid = st_start_grid
    st_pad_busy = {}
    st_ships = {}
    st_next_pax = st_beat + 6
    st_next_cargo = st_beat + 10
    st_pax_docked = 0
    st_pax_holding = 0
    st_cargo_docked = 0
    st_cargo_holding = 0
    st_ships_served = 0
    st_ships_lost = 0
    st_stock_food = 0
    st_stock_goods = 0
    st_demand_goods = 0
    st_notify("A new station. Good luck, Director.", 6)
    st_retally()
  }
}

async {
  while true {
    const e = await Click
    const i = e.slot
    const kind = st_grid[i]
    if !st_lost && st_tool > 0 && st_tool != K_DEMOLISH && kind == K_EMPTY {
      if !st_near(i) {
        st_notify("A module must connect to the station.", 4)
      } else if st_credits < st_cost(st_tool) {
        st_notify("Not enough credits for a {st_kind_name(st_tool)}.", 4)
      } else {
        st_credits -= st_cost(st_tool)
        st_grid[i] = st_tool
        emit Built(slot: i)
        st_retally()
      }
    } else if !st_lost && st_tool == K_DEMOLISH && kind > K_HUB {
      if st_pad_busy[i] {
        st_notify("That dock has a ship on it. Wait until the ship has left.", 5)
      } else {
        st_credits += st_cost(kind) / 2
        st_grid[i] = K_EMPTY
        st_retally()
      }
    }
    st_tool = 0
  }
}

async {
  while true {
    const e = await Request
    const op = e.op
    const room = max(st_storage - st_food - st_goods, 0)

    if (op > 0 && op <= K_BAY) || op == K_DEMOLISH {
      st_tool = st_tool == op ? 0 : op
    } else if op == OP_CANCEL {
      st_tool = 0
    } else if op == OP_PAUSE {
      st_speed = st_speed == 0 ? 1 : 0
    } else if op >= OP_SPEED && op < OP_RESTART {
      st_speed = op - OP_SPEED
      st_tool = 0
    } else if op == OP_BUY_FOOD && st_cargo_docked > 0 {
      const amount = min(min(10, st_stock_food), min(room, st_credits / st_price_food))
      if amount > 0 {
        st_food += amount
        st_stock_food -= amount
        st_credits -= amount * st_price_food
      }
    } else if op == OP_BUY_GOODS && st_cargo_docked > 0 {
      const amount = min(min(10, st_stock_goods), min(room, st_credits / st_price_goods_buy))
      if amount > 0 {
        st_goods += amount
        st_stock_goods -= amount
        st_credits -= amount * st_price_goods_buy
      }
    } else if op == OP_SELL_GOODS && st_cargo_docked > 0 {
      const amount = min(min(10, st_goods), st_demand_goods)
      if amount > 0 {
        st_goods -= amount
        st_demand_goods -= amount
        st_credits += amount * st_price_goods_sell
      }
    } else if op == OP_RESTART {
      st_reset()
    }
  }
}
