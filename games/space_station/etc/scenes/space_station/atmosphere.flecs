using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template StationGasTank {
    prop tall: f32 = 2.4

    shell : StationWhite { Position: {0, 0.3 + tall / 2, 0}; Capsule: {radius: 0.7, length: tall - 1, segments: 20, smooth: true} }
    band : StationBlue { Position: {0, 0.3 + tall / 2, 0}; Cylinder: {radius: 0.72, length: 0.3, segments: 20, smooth: true} }
    band_a : StationDark { Position: {0, 0.3 + tall / 2 + 0.22, 0}; Cylinder: {radius: 0.725, length: 0.05, segments: 20, smooth: true} }
    band_b : StationDark { Position: {0, 0.3 + tall / 2 - 0.22, 0}; Cylinder: {radius: 0.725, length: 0.05, segments: 20, smooth: true} }
    gauge : StationCyanLight { Position: {0, 0.3 + tall / 2, 0.725}; Box: {0.2, 0.1, 0.012} }
    foot : StationDark { Position: {0, 0.15, 0}; Cylinder: {radius: 0.6, length: 0.3, segments: 14} }
    valve : StationGold { Position: {0, 0.45 + tall, 0}; Cylinder: {radius: 0.09, length: 0.28, segments: 10} }
    wheel : StationRed { Position: {0, 0.62 + tall, 0}; Torus: {radius: 0.13, tube: 0.022, segments: 14, rings: 5} }
  }

  template StationAtmosphereBody {
    pad : StationDark { Position: {0, 0.12, 0}; RoundedBox: {4.8, 0.24, 4.8, 0.06, segments: 1} }
    StationGasTank tank_a(tall: 2.9) { Position: {-1.45, 0.2, -1.45} }
    StationGasTank tank_b(tall: 2.3) { Position: {1.45, 0.2, -1.45} }
    StationGasTank tank_c(tall: 2.3) { Position: {-1.45, 0.2, 1.45} }
    plant : StationHull { Position: {1.25, 0.84, 1.25}; RoundedBox: {1.9, 1.2, 1.9, 0.1, segments: 2} }
    plant_band : StationBlue { Position: {1.25, 0.54, 1.25}; Box: {1.93, 0.14, 1.93} }
    stack : StationPanel { Position: {1.25, 2, 1.25}; Frustum: {radius_bottom: 0.5, radius_top: 0.3, length: 1.2, segments: 16, smooth: true} }
    stack_ring : StationDark { Position: {1.25, 1.9, 1.25}; Cylinder: {radius: 0.46, length: 0.06, segments: 16, smooth: true} }
    stack_lip : StationDark { Position: {1.25, 2.6, 1.25}; Cylinder: {radius: 0.34, length: 0.08, segments: 16} }
    gauge : StationCyanLight { Position: {1.25, 0.95, 2.21}; Box: {1.1, 0.34, 0.02} }
    gauge_frame : StationDark { Position: {1.25, 0.95, 2.205}; Box: {1.22, 0.46, 0.02} }
    StationVent vent(w: 1.1, d: 0.4) { Position: {1.25, 1.44, 0.66} }
    StationPipeX pipe_a(length: 2.9, radius: 0.08) { Position: {0, 0.48, -1.45} }
    StationPipeX pipe_b(length: 2, radius: 0.08, clamps: 2) { Position: {-0.4, 0.48, 1.45} }
    StationPipeZ pipe_c(length: 2.6, radius: 0.08) { Position: {1.45, 0.48, -0.15} }
    StationSteam steam(rate: 26, seed: 15) { Position: {1.25, 2.66, 1.25} }
  }
}
