using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template StationSolarWing {
    frame : StationDark { Position: {0, 0, 0}; Box: {4.5, 0.06, 1.82} }
    edge_a : StationChrome { Position: {0, 0.03, 0.9}; Box: {4.5, 0.04, 0.03} }
    edge_b : StationChrome { Position: {0, 0.03, -0.9}; Box: {4.5, 0.04, 0.03} }
    cells : StationSolarCell { Position: {0, 0.04, 0}; Box: {4.36, 0.02, 1.7} }
    for i in 0..3 {
      { (IsA, StationTruss); Position: {-1.45 + i * 1.45, -0.06, 0}; Box: {0.05, 0.06, 1.7} }
    }
  }

  template StationSolarBody {
    plinth : StationPanel { Position: {0, 0.2, 0}; RoundedBox: {1.7, 0.4, 3.4, 0.05, segments: 1} }
    StationGreebleBlock box_a(w: 0.9, h: 0.3, d: 0.8, led: StationGreenLight) { Position: {0, 0.4, 1.05} }
    StationGreebleBlock box_b(w: 0.9, h: 0.3, d: 0.8, led: StationGreenLight) { Position: {0, 0.4, -1.05} }
    StationPipeZ cable_a(length: 3, radius: 0.04) { Position: {0.7, 0.45, 0} }
    StationPipeZ cable_b(length: 3, radius: 0.04) { Position: {-0.7, 0.45, 0} }
    post_a : StationChrome { Position: {0, 1.05, 1.1}; Cylinder: {radius: 0.09, length: 1.4, segments: 12, smooth: true} }
    post_b : StationChrome { Position: {0, 1.05, -1.1}; Cylinder: {radius: 0.09, length: 1.4, segments: 12, smooth: true} }
    axle : StationTruss { Position: {0, 1.75, 0}; Rotation: {1.5708, 0, 0}; Cylinder: {radius: 0.07, length: 4.8, segments: 12, smooth: true} }
    gear : StationGold { Position: {0, 1.75, 0}; Rotation: {1.5708, 0, 0}; Cylinder: {radius: 0.16, length: 0.14, segments: 16, smooth: true} }
    StationSolarWing wing_a() { Position: {0, 1.85, 1.15}; Rotation: {0.36, 0, 0} }
    StationSolarWing wing_b() { Position: {0, 1.85, -1.15}; Rotation: {0.36, 0, 0} }
  }
}
