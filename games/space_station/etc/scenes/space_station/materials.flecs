using flecs.script
using box.material
using box.texture

station_tex_hull { TexturePath: {path: "etc/scenes/space_station/assets/hull.jpg"} }
station_tex_hull_normal { TexturePath: {path: "etc/scenes/space_station/assets/hull_normal.jpg"} }
station_tex_hull_orm { TexturePath: {path: "etc/scenes/space_station/assets/hull_orm.jpg"} }
station_tex_deck { TexturePath: {path: "etc/scenes/space_station/assets/deck.jpg"} }
station_tex_deck_normal { TexturePath: {path: "etc/scenes/space_station/assets/deck_normal.jpg"} }
station_tex_deck_orm { TexturePath: {path: "etc/scenes/space_station/assets/deck_orm.jpg"} }
station_tex_solar { TexturePath: {path: "etc/scenes/space_station/assets/solar.jpg"} }

prefab StationHull { Rgb: {226, 230, 236}; PbrMaterial: {metallic: 0.55, roughness: 0.62}; PbrTextures: {albedo: station_tex_hull, normal: station_tex_hull_normal, orm: station_tex_hull_orm} }
prefab StationPanel { Rgb: {168, 176, 186}; PbrMaterial: {metallic: 0.7, roughness: 0.56}; PbrTextures: {albedo: station_tex_hull, normal: station_tex_hull_normal, orm: station_tex_hull_orm} }
prefab StationDark { Rgb: {74, 82, 94}; PbrMaterial: {metallic: 0.8, roughness: 0.52}; PbrTextures: {albedo: station_tex_hull, normal: station_tex_hull_normal, orm: station_tex_hull_orm} }
prefab StationRecess { Rgb: {18, 22, 28}; PbrMaterial: {metallic: 0.5, roughness: 0.8} }
prefab StationDeck { Rgb: {112, 120, 132}; PbrMaterial: {metallic: 0.7, roughness: 0.66}; PbrTextures: {albedo: station_tex_hull, normal: station_tex_hull_normal, orm: station_tex_hull_orm} }
prefab StationBayFloor { PbrMaterial: {metallic: 0.65, roughness: 0.74}; PbrTextures: {albedo: station_tex_deck, normal: station_tex_deck_normal, orm: station_tex_deck_orm} }
prefab StationTruss { Rgb: {146, 152, 162}; PbrMaterial: {metallic: 0.9, roughness: 0.38} }
prefab StationGold { Rgb: {232, 178, 78}; PbrMaterial: {metallic: 1, roughness: 0.28} }
prefab StationCopper { Rgb: {204, 122, 72}; PbrMaterial: {metallic: 1, roughness: 0.32} }
prefab StationChrome { Rgb: {214, 220, 228}; PbrMaterial: {metallic: 1, roughness: 0.16} }
prefab StationSolarCell { Rgb: {255, 255, 255}; PbrMaterial: {metallic: 0.5, roughness: 0.16}; ClearCoat: {strength: 0.8, roughness: 0.08}; PbrTextures: {albedo: station_tex_solar} }
prefab StationHazard { Rgb: {226, 172, 44}; PbrMaterial: {metallic: 0.25, roughness: 0.48}; ClearCoat: {strength: 0.35, roughness: 0.3}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationRed { Rgb: {186, 58, 44}; PbrMaterial: {metallic: 0.25, roughness: 0.42}; ClearCoat: {strength: 0.5, roughness: 0.2}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationBlue { Rgb: {52, 108, 178}; PbrMaterial: {metallic: 0.3, roughness: 0.4}; ClearCoat: {strength: 0.5, roughness: 0.2}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationTeal { Rgb: {44, 132, 132}; PbrMaterial: {metallic: 0.3, roughness: 0.4}; ClearCoat: {strength: 0.5, roughness: 0.2}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationOrange { Rgb: {214, 112, 44}; PbrMaterial: {metallic: 0.25, roughness: 0.42}; ClearCoat: {strength: 0.5, roughness: 0.2}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationWhite { Rgb: {236, 240, 244}; PbrMaterial: {metallic: 0.15, roughness: 0.36}; ClearCoat: {strength: 0.5, roughness: 0.18}; PbrTextures: {normal: station_tex_hull_normal} }
prefab StationLeaf { Rgb: {64, 158, 72}; PbrMaterial: {roughness: 0.82} }
prefab StationLeafDark { Rgb: {38, 112, 58}; PbrMaterial: {roughness: 0.86} }
prefab StationSoil { Rgb: {62, 44, 32}; PbrMaterial: {roughness: 0.95} }
prefab StationGlass { Rgb: {176, 220, 238}; PbrMaterial: {metallic: 0.1, roughness: 0.05}; ClearCoat: {strength: 1, roughness: 0.03}; Opacity: {0.28} }
prefab StationViewport { Rgb: {18, 34, 52}; PbrMaterial: {metallic: 0.2, roughness: 0.06}; ClearCoat: {strength: 1, roughness: 0.03} }
prefab StationWindow { Rgb: {255, 226, 170}; Emissive: {strength: 3.4, color: {255, 206, 136}} }
prefab StationCyanLight { Rgb: {96, 220, 240}; Emissive: {strength: 4.5, color: {80, 214, 255}} }
prefab StationGreenLight { Rgb: {110, 240, 130}; Emissive: {strength: 4.5, color: {90, 255, 110}} }
prefab StationRedLight { Rgb: {255, 80, 60}; Emissive: {strength: 5, color: {255, 60, 40}} }
prefab StationAmberLight { Rgb: {255, 180, 70}; Emissive: {strength: 4.5, color: {255, 160, 50}} }
prefab StationGrowLight { Rgb: {255, 150, 220}; Emissive: {strength: 5, color: {255, 110, 210}} }
prefab StationPlasma { Rgb: {170, 220, 255}; Emissive: {strength: 11, color: {110, 190, 255}} }
prefab StationStar { Rgb: {255, 255, 255}; Emissive: {strength: 3, color: {220, 232, 255}} }
