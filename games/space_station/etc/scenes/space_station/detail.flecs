
using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material
using box.movement
using box.particle

template StationPipeX {
  prop length: f32 = 2
  prop radius: f32 = 0.05
  prop clamps: i32 = 3

  tube : StationCopper { Position: {0, 0, 0}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: radius, length: length, segments: 10, smooth: true} }
  for i in 0..clamps {
    { (IsA, StationDark); Position: {-length / 2 + (i + 0.5) * length / clamps, 0, 0}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: radius * 1.5, length: 0.06, segments: 8} }
  }
}

template StationPipeZ {
  prop length: f32 = 2
  prop radius: f32 = 0.05
  prop clamps: i32 = 3

  tube : StationCopper { Position: {0, 0, 0}; Rotation: {1.5708, 0, 0}; Cylinder: {radius: radius, length: length, segments: 10, smooth: true} }
  for i in 0..clamps {
    { (IsA, StationDark); Position: {0, 0, -length / 2 + (i + 0.5) * length / clamps}; Rotation: {1.5708, 0, 0}; Cylinder: {radius: radius * 1.5, length: 0.06, segments: 8} }
  }
}

template StationVent {
  prop w: f32 = 0.8
  prop d: f32 = 0.5
  prop slats: i32 = 5

  frame : StationDark { Position: {0, 0.03, 0}; Box: {w, 0.06, d} }
  hole : StationRecess { Position: {0, 0.062, 0}; Box: {w - 0.08, 0.004, d - 0.08} }
  for i in 0..slats {
    { (IsA, StationPanel); Position: {0, 0.07, -d / 2 + 0.04 + (i + 0.5) * (d - 0.08) / slats}; Rotation: {0.4, 0, 0}; Box: {w - 0.1, 0.012, (d - 0.08) / slats * 0.7} }
  }
}

template StationHatch {
  prop size: f32 = 0.9

  ring : StationDark { Position: {0, 0.02, 0}; Cylinder: {radius: size / 2, length: 0.04, segments: 20, smooth: true} }
  lid : StationPanel { Position: {0, 0.05, 0}; Cylinder: {radius: size * 0.4, length: 0.03, segments: 20, smooth: true} }
  bar_a : StationHazard { Position: {0, 0.07, 0}; Box: {size * 0.6, 0.015, 0.05} }
  bar_b : StationHazard { Position: {0, 0.07, 0}; Box: {0.05, 0.015, size * 0.6} }
  for i in 0..8 {
    const a = i * PI / 4
    { (IsA, StationChrome); Position: {cos(a) * size * 0.45, 0.05, sin(a) * size * 0.45}; Cylinder: {radius: 0.022, length: 0.03, segments: 6} }
  }
}

template StationGreebleBlock {
  prop w: f32 = 0.5
  prop h: f32 = 0.25
  prop d: f32 = 0.4
  prop led: entity = 0

  body : StationDark { Position: {0, h / 2, 0}; RoundedBox: {w, h, d, 0.02, segments: 1} }
  plate : StationPanel { Position: {0, h + 0.008, 0}; Box: {w * 0.78, 0.016, d * 0.78} }
  nub : StationTruss { Position: {w * 0.2, h + 0.05, 0}; Cylinder: {radius: 0.035, length: 0.07, segments: 8} }
  if led != 0 {
    { (IsA, led); Position: {0, h * 0.55, d / 2 + 0.006}; Box: {w * 0.5, 0.03, 0.012} }
  }
}

template StationAntenna {
  prop tall: f32 = 1.2

  foot : StationDark { Position: {0, 0.04, 0}; Cylinder: {radius: 0.09, length: 0.08, segments: 8} }
  rod : StationChrome { Position: {0, tall / 2, 0}; Cylinder: {radius: 0.016, length: tall, segments: 6} }
  bar_a : StationTruss { Position: {0, tall * 0.7, 0}; Box: {tall * 0.3, 0.012, 0.012} }
  bar_b : StationTruss { Position: {0, tall * 0.85, 0}; Box: {tall * 0.2, 0.012, 0.012} }
  tip : StationRedLight { Position: {0, tall + 0.02, 0}; Sphere: {radius: 0.035, segments: 6} }
}

template StationSteam {
  prop rate: f32 = 18
  prop seed: i32 = 1

  ParticleEmitter: {
    max: 120,
    rate: rate,
    shape: EmitterDisc, radius: 0.08,
    direction: {0, 1, 0}, spread: 14, speed: {0.5, 1.1},
    lifetime: {0.8, 1.8}, size: {0.05, 0.2}, opacity: {0.04, 0.16},
    color: {214, 228, 240}, seed: seed
  }
}

template StationJunction {
  plate : StationDark { Position: {0, 0.045, 0}; Cylinder: {radius: 0.34, length: 0.05, segments: 6} }
  cap : StationTruss { Position: {0, 0.08, 0}; Cylinder: {radius: 0.17, length: 0.03, segments: 12} }
  lamp : StationCyanLight { Position: {0, 0.1, 0}; Cylinder: {radius: 0.07, length: 0.015, segments: 10} }
}
