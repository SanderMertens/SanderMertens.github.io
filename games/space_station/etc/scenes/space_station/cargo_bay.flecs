using flecs.script
using box.transform
using box.geometry
using box.material

template StationContainer {
  prop mat: entity = 0

  body { (IsA, mat); Position: {0, 0.45, 0}; RoundedBox: {1.9, 0.9, 0.86, 0.03, segments: 1} }
  for i in 0..5 {
    { (IsA, StationDark); Position: {-0.76 + i * 0.38, 0.45, 0.44}; Box: {0.06, 0.76, 0.02} }
    { (IsA, StationDark); Position: {-0.76 + i * 0.38, 0.45, -0.44}; Box: {0.06, 0.76, 0.02} }
  }
  cap_a : StationDark { Position: {0.96, 0.45, 0}; Box: {0.03, 0.86, 0.82} }
  cap_b : StationDark { Position: {-0.96, 0.45, 0}; Box: {0.03, 0.86, 0.82} }
  lock_a : StationChrome { Position: {0.98, 0.45, 0.2}; Box: {0.012, 0.74, 0.03} }
  lock_b : StationChrome { Position: {0.98, 0.45, -0.2}; Box: {0.012, 0.74, 0.03} }
  tag : StationWhite { Position: {0, 0.75, 0.441}; Box: {0.3, 0.1, 0.012} }
}

template StationCargoBayBody {
  floor : StationPanel { Position: {0, 0.1, 0}; RoundedBox: {5, 0.2, 5, 0.05, segments: 1} }
  frame_a : StationTruss { Position: {-2.35, 1.5, -2.35}; Box: {0.14, 2.8, 0.14} }
  frame_b : StationTruss { Position: {2.35, 1.5, -2.35}; Box: {0.14, 2.8, 0.14} }
  frame_c : StationTruss { Position: {-2.35, 1.5, 2.35}; Box: {0.14, 2.8, 0.14} }
  frame_d : StationTruss { Position: {2.35, 1.5, 2.35}; Box: {0.14, 2.8, 0.14} }
  roof_a : StationTruss { Position: {0, 2.9, -2.35}; Box: {4.8, 0.14, 0.14} }
  roof_b : StationTruss { Position: {0, 2.9, 2.35}; Box: {4.8, 0.14, 0.14} }
  light_a : StationCyanLight { Position: {0, 2.82, -2.35}; Box: {3.8, 0.02, 0.06} }
  light_b : StationCyanLight { Position: {0, 2.82, 2.35}; Box: {3.8, 0.02, 0.06} }
  gantry : StationHazard { Position: {0.5, 2.9, 0}; Box: {0.3, 0.2, 4.8} }
  trolley : StationDark { Position: {0.5, 2.7, 0.8}; Box: {0.5, 0.2, 0.5} }
  hoist : StationDark { Position: {0.5, 2.1, 0.8}; Cylinder: {radius: 0.015, length: 1, segments: 5} }
  for i in 0..3 {
    { (IsA, StationTruss); Position: {-2.35, 0.9 + i * 0.9, -1.8 + i * 1.8}; Rotation: {0.6, 0, 0}; Box: {0.05, 2.2, 0.05} }
    { (IsA, StationTruss); Position: {2.35, 0.9 + i * 0.9, -1.8 + i * 1.8}; Rotation: {0.6, 0, 0}; Box: {0.05, 2.2, 0.05} }
  }
  StationContainer c_a(mat: StationOrange) { Position: {-1.1, 0.2, -1.5} }
  StationContainer c_b(mat: StationBlue) { Position: {-1.1, 0.2, -0.5} }
  StationContainer c_c(mat: StationRed) { Position: {-1.1, 0.2, 0.5} }
  StationContainer c_d(mat: StationTeal) { Position: {-1.1, 0.2, 1.5} }
  StationContainer c_e(mat: StationWhite) { Position: {1.1, 0.2, -1.5} }
  StationContainer c_f(mat: StationOrange) { Position: {1.1, 0.2, 1.5} }
  StationContainer c_g(mat: StationTeal) { Position: {-1.1, 1.1, -1.5} }
  StationContainer c_h(mat: StationBlue) { Position: {-1.1, 1.1, 0.5} }
}
