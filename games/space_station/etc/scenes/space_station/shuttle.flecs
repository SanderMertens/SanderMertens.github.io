using flecs.script
using flecs.script.math
using box.transform
using box.geometry
using box.material

template StationShuttleBody {
  hull : StationWhite { Position: {0, 1.1, 0}; Rotation: {0, 0, 1.5708}; Capsule: {radius: 0.72, length: 2.8, segments: 24, smooth: true} }
  stripe : StationBlue { Position: {-0.1, 1.1, 0}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.735, length: 1.8, segments: 24, smooth: true} }
  stripe_a : StationGold { Position: {0.81, 1.1, 0}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.742, length: 0.05, segments: 24, smooth: true} }
  stripe_b : StationGold { Position: {-1.01, 1.1, 0}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.742, length: 0.05, segments: 24, smooth: true} }
  nose : StationDark { Position: {2.05, 1.14, 0}; Rotation: {0, 0, -1.5708}; Frustum: {radius_bottom: 0.46, radius_top: 0.2, length: 0.5, segments: 18, smooth: true} }
  canopy : StationViewport { Position: {1.25, 1.54, 0}; Rotation: {0, 0, -0.3}; Scale: {1.5, 0.5, 1}; Sphere: {radius: 0.4, segments: 18, smooth: true} }
  cockpit_light : StationCyanLight { Position: {1.25, 1.3, 0}; Box: {0.4, 0.02, 0.4} }
  for i in 0..6 {
    { (IsA, StationWindow); Position: {-0.9 + i * 0.36, 1.32, 0.68}; Box: {0.2, 0.17, 0.02} }
    { (IsA, StationWindow); Position: {-0.9 + i * 0.36, 1.32, -0.68}; Box: {0.2, 0.17, 0.02} }
  }
  wing_l : StationHull { Position: {-0.5, 0.9, 1.3}; Rotation: {0.1, 0.34, 0}; Box: {1.5, 0.08, 1.6} }
  wing_r : StationHull { Position: {-0.5, 0.9, -1.3}; Rotation: {-0.1, -0.34, 0}; Box: {1.5, 0.08, 1.6} }
  nav_l : StationGreenLight { Position: {-0.75, 0.98, 2.05}; Sphere: {radius: 0.05, segments: 8} }
  nav_r : StationRedLight { Position: {-0.75, 0.98, -2.05}; Sphere: {radius: 0.05, segments: 8} }
  fin : StationBlue { Position: {-1.75, 1.95, 0}; Rotation: {0, 0, 0.5}; Box: {0.8, 0.9, 0.08} }
  fin_tip : StationRedLight { Position: {-2.05, 2.36, 0}; Sphere: {radius: 0.04, segments: 6} }
  dorsal : StationDark { Position: {-0.3, 1.84, 0}; RoundedBox: {1, 0.1, 0.4, 0.02, segments: 1} }
  engine_l : StationDark { Position: {-2.15, 1.1, 0.34}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.26, length: 0.5, segments: 14} }
  engine_r : StationDark { Position: {-2.15, 1.1, -0.34}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.26, length: 0.5, segments: 14} }
  glow_l : StationPlasma { Position: {-2.42, 1.1, 0.34}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.2, length: 0.03, segments: 14} }
  glow_r : StationPlasma { Position: {-2.42, 1.1, -0.34}; Rotation: {0, 0, 1.5708}; Cylinder: {radius: 0.2, length: 0.03, segments: 14} }
  leg_a : StationDark { Position: {0.8, 0.22, 0.4}; Box: {0.1, 0.44, 0.1} }
  leg_b : StationDark { Position: {0.8, 0.22, -0.4}; Box: {0.1, 0.44, 0.1} }
  leg_c : StationDark { Position: {-1, 0.22, 0.5}; Box: {0.1, 0.44, 0.1} }
  leg_d : StationDark { Position: {-1, 0.22, -0.5}; Box: {0.1, 0.44, 0.1} }
}
