using flecs.script.math

export const st_grid_w: i32 = 7
export const st_grid_h: i32 = 5
export const st_slots: i32 = 35
export const st_pitch: f32 = 6
export const st_hub_slot: i32 = 17

export const K_EMPTY: i32 = 0
export const K_HUB: i32 = 1
export const K_SOLAR: i32 = 2
export const K_REACTOR: i32 = 3
export const K_LIFE: i32 = 4
export const K_AIR: i32 = 5
export const K_FARM: i32 = 6
export const K_HAB: i32 = 7
export const K_PAX: i32 = 8
export const K_CARGO: i32 = 9
export const K_BAY: i32 = 10
export const K_DEMOLISH: i32 = 99

fn st_cost(k: i32) -> i32 {
  match k {
    2: 350
    3: 1600
    4: 550
    5: 450
    6: 400
    7: 500
    8: 650
    9: 650
    10: 250
    _: 0
  }
}

fn st_power_made(k: i32) -> f32 {
  match k {
    1: 2
    2: 7
    3: 32
    _: 0
  }
}

fn st_power_used(k: i32) -> f32 {
  match k {
    1: 1
    3: 0
    4: 3
    5: 3
    6: 2
    7: 1
    8: 2
    9: 2
    10: 1
    _: 0
  }
}

fn st_upkeep(k: i32) -> f32 {
  match k {
    0: 0
    1: 0
    2: 0.2
    3: 2.2
    8: 0.8
    9: 0.8
    _: 0.4
  }
}

fn st_kind_name(k: i32) -> string {
  match k {
    1: "Command Hub"
    2: "Solar Array"
    3: "Fusion Reactor"
    4: "Life Support"
    5: "Atmosphere Plant"
    6: "Hydroponics"
    7: "Habitat Ring"
    8: "Passenger Dock"
    9: "Cargo Dock"
    10: "Cargo Bay"
    _: "Empty bay"
  }
}

fn st_kind_blurb(k: i32) -> string {
  match k {
    1: "The heart of the station. Cannot be sold."
    2: "Makes 7 power."
    3: "Makes 32 power, with a high upkeep."
    4: "Scrubs and recycles for 16 people. Uses 3 power."
    5: "Makes air: 3 per second at full power. Uses 3 power."
    6: "Grows 0.8 food per second at full power. Uses 2 power."
    7: "Houses 12 residents, who pay rent. Uses 1 power."
    8: "Lands one visitor ship at a time. Visitors pay to land and spend money while here."
    9: "Lands one freighter at a time. A docked freighter opens the market."
    10: "Stores 80 more tonnes of food and goods."
    _: ""
  }
}

fn st_x(i: i32) -> f32 {
  ((i % st_grid_w) - (st_grid_w - 1) / 2.0) * st_pitch
}

fn st_z(i: i32) -> f32 {
  (floor(i / st_grid_w) - (st_grid_h - 1) / 2.0) * st_pitch
}

fn st_bits_raw(mask: u64, i: i32, width: i32) -> u64 {
  const one: u64 = 1
  (mask >> (i * width)) & ((one << width) - one)
}

fn st_bits_get(mask: u64, i: i32, width: i32) -> i32 {
  st_bits_raw(mask, i, width)
}

fn st_bits_set(mask: u64, i: i32, width: i32, value: u64) -> u64 {
  mask - (st_bits_raw(mask, i, width) << (i * width)) + (value << (i * width))
}

fn st_bit(i: i32) -> u64 {
  const one: u64 = 1
  one << i
}

fn st_has(mask: u64, i: i32) -> bool {
  st_bits_raw(mask, i, 1) == 1
}

fn st_near(mask: u64, i: i32) -> bool {
  const x = i % st_grid_w
  const y = floor(i / st_grid_w)
  (x > 0 && st_has(mask, i - 1)) || (x < st_grid_w - 1 && st_has(mask, i + 1)) || (y > 0 && st_has(mask, i - st_grid_w)) || (y < st_grid_h - 1 && st_has(mask, i + st_grid_w))
}

fn st_kind_of(i: i32, w0: u64, w1: u64, w2: u64) -> i32 {
  const word = match floor(i / 12) {
    0: w0
    1: w1
    _: w2
  }
  st_bits_get(word, i % 12, 4)
}

export const st_start_built: u64 = (1 << 17) | (1 << 16) | (1 << 18) | (1 << 10) | (1 << 24) | (1 << 15) | (1 << 19)

