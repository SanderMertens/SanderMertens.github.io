using flecs.script
using box.transform
using box.geometry
using box.material

template CanopyRail {
  prop length: f32 = 4
  const posts: i32 = math.floor(length / 1.3) + 1
  top : CanopyIron { Position: {0, 1.02, 0}; Box: {length, 0.05, 0.08} }
  wire_a : CanopyMetal { Position: {0, 0.72, 0}; Box: {length, 0.018, 0.018} }
  wire_b : CanopyMetal { Position: {0, 0.42, 0}; Box: {length, 0.018, 0.018} }
  kick : CanopyTimberDark { Position: {0, 0.05, 0}; Box: {length, 0.1, 0.05} }
  for i in 0..posts + 1 {
    { (IsA, CanopyMetal); Position: {-length / 2 + i * length / posts, 0.5, 0}; Box: {0.05, 1, 0.05} }
  }
}

template CanopyPlanter {
  prop length: f32 = 1.6
  prop seed: i32 = 0
  prop bloom: bool = false
  box : CanopyWood { Position: {0, 0.15, 0}; Box: {length, 0.3, 0.42} }
  soil : CanopySoil { Position: {0, 0.3, 0}; Box: {length - 0.08, 0.04, 0.34} }
  for i in 0..3 {
    const x = (i - 1) * length * 0.3
    if bloom && i == 1 {
      { (IsA, CanopyBlossomCard); Position: {x, 0.56, 0}; Rotation: {-0.25, seed + i * 1.1, 0}; Quad: {length * 0.62, length * 0.5} }
    } else {
      { (IsA, CanopyLeafCard); Rgb: {74, 132, 56}; Position: {x, 0.52, 0}; Rotation: {-0.25, seed + i * 1.1, 0}; Quad: {length * 0.55, length * 0.42} }
    }
  }
}

template CanopyBench {
  prop length: f32 = 1.5
  for i in 0..3 {
    { (IsA, CanopyWood); Position: {0, 0.44, -0.14 + i * 0.14}; Box: {length, 0.04, 0.11} }
  }
  for side in 0..2 {
    { (IsA, CanopyMetal); Position: {(side - 0.5) * (length - 0.2), 0.21, 0}; Box: {0.05, 0.42, 0.4} }
  }
  back : CanopyWood { Position: {0, 0.72, -0.2}; Rotation: {-0.15, 0, 0}; Box: {length, 0.28, 0.035} }
}

template CanopyPotted {
  prop size: f32 = 0.6
  prop seed: f32 = 0
  pot : CanopyTerracotta { Position: {0, size * 0.25, 0}; Frustum: {radius_bottom: size * 0.2, radius_top: size * 0.28, length: size * 0.5, segments: 14, smooth: true} }
  lip : CanopyTerracotta { Position: {0, size * 0.5, 0}; Torus: {radius: size * 0.28, tube: size * 0.024, segments: 14, rings: 4} }
  soil : CanopySoil { Position: {0, size * 0.49, 0}; Cylinder: {radius: size * 0.27, length: 0.01, segments: 12} }
  { (IsA, CanopyLeafCard); Rgb: {82, 136, 58}; Position: {0, size * 0.92, 0}; Rotation: {0, seed, 0}; Quad: {size * 1.1, size * 1.1} }
  { (IsA, CanopyLeafCard); Rgb: {66, 122, 56}; Position: {0, size * 0.92, 0}; Rotation: {0, seed + 1.57, 0}; Quad: {size * 1.1, size * 1.1} }
}

template CanopyPerson {
  prop seed: i32 = 0
  const hue = seed % 6
  const red: Rgb = {196, 74, 52}
  const cream: Rgb = {232, 222, 190}
  const teal: Rgb = {38, 110, 104}
  const ochre: Rgb = {226, 172, 56}
  const plum: Rgb = {120, 74, 140}
  const blue: Rgb = {70, 110, 170}
  const shirts = [red, cream, teal, ochre, plum, blue]
  const shirt: Rgb = shirts[hue]
  const skin_a: Rgb = {226, 182, 148}
  const skin_b: Rgb = {176, 122, 86}
  const skin_c: Rgb = {108, 72, 50}
  const skins = [skin_a, skin_b, skin_c]
  const skin: Rgb = skins[seed % 3]
  const lean_a = (seed % 5 - 2) * 0.05
  Rotation: {0, seed * 2.399963, 0}
  for side in 0..2 {
    const x = (side - 0.5) * 0.17
    { Position: {x, 0.42, (side - 0.5) * lean_a * 2}; Capsule: {radius: 0.068, length: 0.72, segments: 6}; Rgb: {50, 54, 66}; PbrMaterial: {roughness: 0.9} }
    { Position: {(side - 0.5) * 0.44, 1.02, 0}; Rotation: {(side - 0.5) * lean_a * 3, 0, (side - 0.5) * 0.12}; Capsule: {radius: 0.046, length: 0.46, segments: 5}; Rgb: shirt; PbrMaterial: {roughness: 0.9} }
  }
  body { Position: {0, 1.08, 0}; Scale: {1, 1, 0.68}; Capsule: {radius: 0.17, length: 0.3, segments: 8, smooth: true}; Rgb: shirt; PbrMaterial: {roughness: 0.9} }
  head { Position: {0, 1.53, 0}; Sphere: {radius: 0.11, segments: 10, smooth: true}; Rgb: skin; PbrMaterial: {roughness: 0.7} }
  hair { Position: {0, 1.57, -0.02}; Scale: {1.02, 0.8, 1}; Sphere: {radius: 0.11, segments: 8, smooth: true}; Rgb: {38 + seed % 4 * 26, 28 + seed % 4 * 18, 24}; PbrMaterial: {roughness: 0.8} }
}

template CanopyAwning {
  prop width: f32 = 2.4
  prop depth: f32 = 1
  prop stripes: i32 = 6
  prop style: i32 = 0
  const w = width / stripes
  for i in 0..stripes {
    const x = -width / 2 + (i + 0.5) * w
    if i % 2 == 0 {
      if style % 3 == 0 {
        { (IsA, CanopyCanvasA); Position: {x, 0, depth / 2}; Rotation: {0.32, 0, 0}; Box: {w, 0.025, depth} }
      } else if style % 3 == 1 {
        { (IsA, CanopyCanvasC); Position: {x, 0, depth / 2}; Rotation: {0.32, 0, 0}; Box: {w, 0.025, depth} }
      } else {
        { (IsA, CanopyTerracotta); Position: {x, 0, depth / 2}; Rotation: {0.32, 0, 0}; Box: {w, 0.025, depth} }
      }
    } else {
      { (IsA, CanopyCanvasB); Position: {x, 0, depth / 2}; Rotation: {0.32, 0, 0}; Box: {w, 0.025, depth} }
    }
  }
  for side in 0..2 {
    { (IsA, CanopyMetal); Position: {(side - 0.5) * width, -0.16, depth * 0.48}; Rotation: {0.32, 0, 0}; Box: {0.025, 0.025, depth} }
  }
}

template CanopyCondenser {
  prop size: f32 = 0.7
  body : CanopyTrim { Position: {0, size * 0.42, 0}; RoundedBox: {size * 1.3, size * 0.84, size * 0.5, 0.03, segments: 1}; Rgb: {186, 188, 178} }
  fan : CanopyMetal { Position: {size * 0.24, size * 0.42, size * 0.26}; Rotation: {math.PI / 2, 0, 0}; Cylinder: {radius: size * 0.31, length: 0.02, segments: 12} }
  hub : CanopyTrim { Position: {size * 0.24, size * 0.42, size * 0.28}; Rotation: {math.PI / 2, 0, 0}; Cylinder: {radius: size * 0.07, length: 0.02, segments: 8} }
  pipe : CanopyCopper { Position: {-size * 0.55, size * 0.08, 0.12}; Box: {0.03, size * 0.5, 0.03} }
}

template CanopyLaundry {
  prop length: f32 = 2.2
  prop seed: i32 = 0
  line : CanopyTrim { Position: {0, 1.8, 0}; Box: {length, 0.012, 0.012} }
  for i in 0..4 {
    const shade = (seed + i * 3) % 4
    const x = -length * 0.36 + i * length * 0.24
    if shade == 0 {
      { (IsA, CanopyCanvasA); Position: {x, 1.48, 0}; Box: {0.34, 0.6, 0.012} }
    } else if shade == 1 {
      { (IsA, CanopyCanvasB); Position: {x, 1.42, 0}; Box: {0.4, 0.72, 0.012} }
    } else if shade == 2 {
      { (IsA, CanopyCanvasC); Position: {x, 1.5, 0}; Box: {0.28, 0.56, 0.012} }
    } else {
      { (IsA, CanopyTrim); Position: {x, 1.44, 0}; Box: {0.38, 0.68, 0.012} }
    }
  }
}

template CanopyBalconySet {
  table : CanopyMetal { Position: {0, 0.62, 0}; Cylinder: {radius: 0.26, length: 0.03, segments: 10} }
  stem : CanopyMetal { Position: {0, 0.3, 0}; Cylinder: {radius: 0.02, length: 0.6, segments: 6} }
  for side in 0..2 {
    { (IsA, CanopyWood); Position: {(side - 0.5) * 0.9, 0.42, 0}; Box: {0.36, 0.04, 0.36} }
    { (IsA, CanopyWood); Position: {(side - 0.5) * 1.06, 0.66, 0}; Box: {0.04, 0.46, 0.34} }
    { (IsA, CanopyMetal); Position: {(side - 0.5) * 0.9, 0.2, 0}; Box: {0.3, 0.4, 0.3} }
  }
}

template CanopyBalconyProp {
  prop kind: i32 = 0
  prop seed: i32 = 0
  if kind == 0 {
    CanopyPlanter(length: 1.4, seed: seed, bloom: true) {}
  } else if kind == 1 {
    CanopyCondenser(size: 0.62) {}
  } else if kind == 2 {
    CanopyBalconySet() {}
  } else if kind == 3 {
    CanopyLaundry(seed: seed) {}
  } else {
    CanopyPotted(size: 0.8, seed: seed) { Position: {-0.5, 0, 0} }
    CanopyPotted(size: 0.6, seed: seed + 2) { Position: {0.15, 0, 0.05} }
  }
}

template CanopyDownpipe {
  prop length: f32 = 8
  pipe : CanopyCopper { Position: {0, -length / 2, 0}; Cylinder: {radius: 0.04, length: length, segments: 6} }
  hopper : CanopyCopper { Position: {0, -0.1, 0}; Frustum: {radius_bottom: 0.05, radius_top: 0.12, length: 0.2, segments: 6} }
}

template CanopyTank {
  prop size: f32 = 1
  barrel : CanopyWood { Position: {0, size * 1.1, 0}; Cylinder: {radius: size * 0.55, length: size * 1.05, segments: 14} }
  lid : CanopyVerdigris { Position: {0, size * 1.78, 0}; Cone: {radius: size * 0.62, length: size * 0.3, segments: 14} }
  for i in 0..2 {
    { (IsA, CanopyMetal); Position: {0, size * (0.86 + i * 0.5), 0}; Torus: {radius: size * 0.56, tube: 0.018, segments: 14, rings: 4} }
  }
  for i in 0..4 {
    const a = i * math.PI / 2 + 0.78
    { (IsA, CanopyTimberDark); Position: {math.sin(a) * size * 0.42, size * 0.3, math.cos(a) * size * 0.42}; Box: {0.08, size * 0.6, 0.08} }
  }
  pipe : CanopyCopper { Position: {size * 0.6, size * 0.4, 0}; Cylinder: {radius: 0.035, length: size * 0.8, segments: 6} }
}

template CanopyVentStack {
  prop tall: f32 = 0.9
  pipe : CanopyMetal { Position: {0, tall / 2, 0}; Cylinder: {radius: 0.1, length: tall, segments: 8} }
  cap : CanopyMetal { Position: {0, tall + 0.09, 0}; Cone: {radius: 0.2, length: 0.14, segments: 8} }
  collar : CanopyTrim { Position: {0, 0.04, 0}; Cylinder: {radius: 0.16, length: 0.08, segments: 8} }
}

template CanopyMast {
  prop tall: f32 = 2.4
  foot : CanopyMetal { Position: {0, 0.05, 0}; Box: {0.3, 0.1, 0.3} }
  rod : CanopyMetal { Position: {0, tall / 2, 0}; Cylinder: {radius: 0.025, length: tall, segments: 6} }
  bar_a : CanopyMetal { Position: {0, tall * 0.74, 0}; Box: {tall * 0.28, 0.018, 0.018} }
  bar_b : CanopyMetal { Position: {0, tall * 0.88, 0}; Box: {tall * 0.18, 0.018, 0.018} }
  tip { Position: {0, tall + 0.03, 0}; Sphere: {radius: 0.045, segments: 6}; Rgb: {255, 80, 60}; Emissive: {strength: 3, color: {255, 60, 40}} }
}

template CanopySkylight {
  prop w: f32 = 1.2
  prop d: f32 = 0.9
  frame : CanopyTrim { Position: {0, 0.08, 0}; Box: {w, 0.16, d} }
  pane : CanopyGlass { Position: {0, 0.18, 0}; Rotation: {0, 0, 0.14}; Box: {w - 0.1, 0.04, d - 0.1} }
}

template CanopyRoofKit {
  prop variant: i32 = 0
  const kit: math.Rng = {seed: variant + 55711}
  for i in 0..5 {
    const kind = kit.u(5)
    const x = kit.f(4.4) - 2.2
    const z = kit.f(4) - 2
    if kind == 0 {
      CanopyVentStack(tall: 0.5 + kit.f(0.8)) { Position: {x, 0, z} }
    } else if kind == 1 {
      CanopyCondenser(size: 0.8) { Position: {x, 0, z}; Rotation: {0, kit.u(4) * math.PI / 2, 0} }
    } else if kind == 2 {
      CanopySkylight() { Position: {x, 0, z} }
    } else if kind == 3 {
      CanopyPotted(size: 0.9, seed: variant + i) { Position: {x, 0, z} }
    } else {
      CanopyBench(length: 1.2) { Position: {x, 0, z}; Rotation: {0, kit.u(4) * math.PI / 2, 0} }
    }
  }
  if variant % 3 == 0 {
    CanopyTank(size: 0.9) { Position: {-2.3, 0, -2} }
  }
  if variant % 4 == 1 {
    CanopyMast(tall: 2.2 + variant % 3) { Position: {2.4, 0, -2.2} }
  }
  if variant % 5 == 2 {
    CanopyLaundry(length: 2.6, seed: variant) { Position: {0.3, 0, 2.3} }
  }
}

template CanopyPlinth {
  prop width: f32 = 8
  prop depth: f32 = 8
  prop height: f32 = 1.3
  prop round: bool = false
  prop radius: f32 = 4
  prop variant: i32 = 0
  const front = round ? radius : depth / 2
  const span = round ? radius * 2 : width
  if round {
    { (IsA, CanopyAshlar); Position: {0, (height - 0.2) / 2, 0}; Cylinder: {radius: radius, length: height + 0.2, segments: 28} }
    { (IsA, CanopyTrim); Position: {0, height, 0}; Cylinder: {radius: radius + 0.09, length: 0.1, segments: 28} }
    { (IsA, CanopyConcrete); Position: {0, 0.08, 0}; Cylinder: {radius: radius + 0.12, length: 0.3, segments: 28} }
  } else {
    { (IsA, CanopyAshlar); Position: {0, (height - 0.2) / 2, 0}; Box: {width, height + 0.2, depth} }
    for side in 0..2 {
      { (IsA, CanopyMetal); Position: {(side - 0.5) * span * 0.7, 0.62, front + 0.012}; Box: {0.6, 0.34, 0.03} }
      for slat in 0..3 {
        { (IsA, CanopyTrim); Position: {(side - 0.5) * span * 0.7, 0.53 + slat * 0.09, front + 0.03}; Box: {0.56, 0.02, 0.02} }
      }
    }
    { (IsA, CanopyTrim); Position: {0, height, 0}; Box: {width + 0.18, 0.1, depth + 0.18} }
    { (IsA, CanopyConcrete); Position: {0, 0.08, 0}; Box: {width + 0.24, 0.3, depth + 0.24} }
  }
  for i in 0..4 {
    { (IsA, CanopyPaver); Position: {0, (i + 0.5) * height / 4 - 0.02, front + 0.2 + (3 - i) * 0.34}; Box: {2.2, height / 4 + 0.02, 0.36 + 0.02} }
  }
  for side in 0..2 {
    const x = (side - 0.5) * 2.5
    { (IsA, CanopyAshlar); Position: {x, height * 0.42, front + 0.68}; Box: {0.28, height * 0.84, 1.4} }
    CanopyPotted(size: 0.62, seed: variant + side) { Position: {x, height * 0.84, front + 1.18} }
  }
  door : CanopyTimberDark { Position: {0, height + 1.05, front + 0.03}; Box: {1.3, 2, 0.05} }
  lintel : CanopyTrim { Position: {0, height + 2.14, front + 0.05}; Box: {1.6, 0.14, 0.1} }
  knob : CanopyBrass { Position: {0.42, height + 1, front + 0.07}; Sphere: {radius: 0.035, segments: 6} }
  CanopyAwning(width: 2.2, depth: 0.8, stripes: 6, style: variant) { Position: {0, height + 2.5, front + 0.05} }
}

template CanopyStreetlight {
  foot : CanopyMetal { Position: {0, 0.06, 0}; Cylinder: {radius: 0.14, length: 0.12, segments: 8} }
  mast : CanopyMetal { Position: {0, 1.65, 0}; Frustum: {radius_bottom: 0.055, radius_top: 0.03, length: 3.3, segments: 8} }
  arm : CanopyMetal { Position: {0.32, 3.28, 0}; Box: {0.68, 0.04, 0.05} }
  lamp : CanopyLampGlow { Position: {0.56, 3.2, 0}; Box: {0.34, 0.05, 0.16} }
  hood : CanopyTrim { Position: {0.56, 3.26, 0}; Box: {0.42, 0.03, 0.22} }
  cap : CanopySolar { Position: {0, 3.44, 0}; Rotation: {0, 0, -0.18}; Box: {0.5, 0.03, 0.44} }
}

template CanopyBollard {
  post : CanopyMetal { Position: {0, 0.32, 0}; Cylinder: {radius: 0.05, length: 0.64, segments: 8} }
  glow : CanopyLampGlow { Position: {0, 0.6, 0}; Cylinder: {radius: 0.052, length: 0.05, segments: 8} }
}

template CanopyHangingLantern {
  cord : CanopyMetal { Position: {0, -0.2, 0}; Box: {0.012, 0.4, 0.012} }
  shade : CanopyLanternGlow { Position: {0, -0.52, 0}; Scale: {1, 1.25, 1}; Sphere: {radius: 0.17, segments: 8, smooth: true} }
}

template CanopyRocks {
  prop seed: f32 = 0
  prop count: i32 = 3
  for i in 0..count {
    const a = i * 2.399963 + seed
    const s = 0.2 + (i % 3) * 0.14
    { (IsA, CanopyRock); Position: {math.sin(a) * 0.5, s * 0.34, math.cos(a) * 0.5}; Rotation: {a, a * 2, 0}; Scale: {1.25, 0.72, 1}; IcoSphere: {radius: s, segments: 1} }
  }
}

template CanopyKiosk {
  prop style: i32 = 0
  for i in 0..4 {
    const a = i * math.PI / 2 + 0.78
    { (IsA, CanopyTimberDark); Position: {math.sin(a) * 1.1, 1.05, math.cos(a) * 1.1}; Box: {0.07, 2.1, 0.07} }
  }
  counter : CanopyWood { Position: {0, 0.5, 0.56}; Box: {1.56, 1, 0.36} }
  CanopyAwning(width: 1.9, depth: 1.8, stripes: 6, style: style) { Position: {0, 2.34, -0.86} }
  for i in 0..5 {
    { (IsA, CanopyTerracotta); Position: {-0.56 + i * 0.28, 1.08, 0.56}; IcoSphere: {radius: 0.09, segments: 1}; Rgb: {222 - i * 12, 120 + i * 22, 50 + i * 8} }
  }
  CanopyHangingLantern() { Position: {0, 2.1, 0} }
  crate : CanopyWood { Position: {1.2, 0.2, -0.2}; Rotation: {0, 0.3, 0}; Box: {0.4, 0.4, 0.4} }
}
