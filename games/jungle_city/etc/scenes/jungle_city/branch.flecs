using flecs.script
using box.transform
using box.geometry
using box.material

template CanopyBranch {
  prop ax: f32 = 0
  prop ay: f32 = 0
  prop az: f32 = 0
  prop bx: f32 = 0
  prop by: f32 = 1
  prop bz: f32 = 0
  prop radius: f32 = 0.06
  const dx = bx - ax
  const dy = by - ay
  const dz = bz - az
  const length = math.sqrt(dx * dx + dy * dy + dz * dz)
  (IsA, CanopyBark)
  Position: {(ax + bx) / 2, (ay + by) / 2, (az + bz) / 2}
  Rotation: {math.acos(dy / length), math.atan2(dx, dz), 0}
  Frustum: {length: length, radius_bottom: radius, radius_top: radius * 0.55, segments: 4, smooth: true}
}
