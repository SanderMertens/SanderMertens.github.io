using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template CanopySpire {
    prop floors: i32 = 5
    prop variant: i32 = 0
    prop wall: Rgb = {226, 235, 211}
    prop timber: Rgb = {143, 91, 48}
    prop roof_style: i32 = 0
    prop facade_style: i32 = 0
    prop sx: f32 = 1
    prop sz: f32 = 1
    const windows: math.Rng = {seed: variant + 314159}
    const height = floors * 3.2 + 4
    const bays = math.max(1, math.round(math.PI * 2.35 * (sx + sz) / 3.2))
    const taper = math.atan(1.1 / height)
    const fin = math.sqrt(height * height + 1.21)
    Scale: {sx, 1, sz}
    CanopyPlinth(round: true, radius: 3.7, variant: variant) {}
    core : CanopyFacade { Position: {0, height / 2 + 1.2, 0}; Frustum: {radius_bottom: 2.9, radius_top: 1.8, length: height, segments: 8, smooth: true}; TextureTransform: {scale_x: bays / 8.0, scale_y: height / 25.6, offset_x: variant % 8 / 8.0, offset_y: variant % 13 / 8.0} }
    for i in 0..8 + facade_style * 4 {
      const a = i * math.PI * 2 / (8 + facade_style * 4)
      {
        Rotation: {0, a, 0}
        { (IsA, CanopyWood); Rgb: timber; Position: {0, height / 2 + 1.2, 2.35}; Rotation: {-taper, 0, 0}; Box: {0.22, fin, 0.3} }
      }
    }
    for f in 0..3 {
      const y = 4.4 + f * (height - 3.2) / 2
      { (IsA, CanopyIvory); Rgb: wall; Position: {0, y, 0}; Cylinder: {radius: 4.3 - f * 0.3, length: 0.35, segments: 8} }
      { (IsA, CanopyLeaf); Position: {0, y + 0.35, 0}; Tube: {radius: 4.05 - f * 0.3, thickness: 0.6, length: 0.3, segments: 8} }
      { (IsA, CanopyMetal); Position: {0, y + 1, 0}; Torus: {radius: 4.2 - f * 0.3, tube: 0.025, segments: 8, rings: 4} }
      for i in 0..4 {
        const a = i * math.PI / 2
        { Position: {math.sin(a) * (4.3 - f * 0.3), y + 0.3, math.cos(a) * (4.3 - f * 0.3)}; Rotation: {0, a, 0}; CanopyVine(length: 2.8, phase: variant) {} }
        if windows.f(1) > 0.4 {
          { Position: {math.sin(a + 0.8) * (3.75 - f * 0.3), y + 0.17, math.cos(a + 0.8) * (3.75 - f * 0.3)}; Rotation: {0, a + 0.8, 0}; CanopyBalconyProp(kind: windows.u(5), seed: variant + f + i) {} }
        }
      }
    }
    if roof_style == 3 {
      crown : CanopyWood { Position: {0, height + 2.075, 0}; Frustum: {radius_bottom: 2, radius_top: 4.6, length: 1.4, segments: 6} }
      solar_canopy : CanopySolar { Position: {0, height + 2.825, 0}; Cylinder: {radius: 4.65, length: 0.14, segments: 6} }
      rim : CanopyIvory { Position: {0, height + 2.855, 0}; Torus: {radius: 4.65, tube: 0.1, segments: 6, rings: 6} }
      for i in 0..6 {
        const a = i * math.PI / 3
        { (IsA, CanopyIvory); Rgb: wall; Position: {math.sin(a) * 2.3, height + 2.925, math.cos(a) * 2.3}; Rotation: {0, a, 0}; Box: {0.06, 0.05, 4.5} }
      }
    } else {
      CanopyRoof(style: roof_style, variant: variant, sx: sx, sz: sz) { Position: {0, height + 1.375, 0} }
    }
  }
}
