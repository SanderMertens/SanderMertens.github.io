canopy_tex_bark_normal { TexturePath: {path: "etc/scenes/jungle_city/textures/bark_normal.jpg"} }
canopy_tex_ground { TexturePath: {path: "etc/scenes/jungle_city/textures/ground.jpg"} }
canopy_tex_ground_normal { TexturePath: {path: "etc/scenes/jungle_city/textures/ground_normal.jpg"} }
canopy_tex_strata { TexturePath: {path: "etc/scenes/jungle_city/textures/strata.jpg"} }
canopy_tex_strata_normal { TexturePath: {path: "etc/scenes/jungle_city/textures/strata_normal.jpg"} }
canopy_tex_water_normal { TexturePath: {path: "etc/scenes/jungle_city/textures/water_normal.jpg"} }
canopy_tex_facade { TexturePath: {path: "etc/scenes/jungle_city/textures/facade.jpg"} }
