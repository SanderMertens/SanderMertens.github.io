using flecs.script
using box.transform
using box.geometry
using box.material
using box.text

assets {
  template CanopySign {
    prop label: string = "GARDENS"
    prop color: Rgb = {112, 235, 196}
    frame : CanopyWood { Position: {0, 1.2, 0}; RoundedBox: {2.5, 1, 0.16, 0.12} }
    panel : CanopyGlass { Position: {0, 1.2, 0.1}; RoundedBox: {2.3, 0.8, 0.08, 0.08} }
    for side in 0..2 {
      { Position: {(side - 0.5) * 2.25, 1.2, 0.16}; Box: {0.035, 0.65, 0.04}; Rgb: color; Emissive: {strength: 1.8, color: color} }
      { (IsA, CanopyWood); Position: {(side - 0.5) * 1.9, 0.4, 0}; Box: {0.08, 0.8, 0.08} }
    }
    text { Position: {0, 1.2, 0.16}; Scale: {0.009, 0.009, 0.009}; Text: {value: label, size: 30}; Rgb: color; Emissive: {strength: 1.2, color: color} }
  }
}
