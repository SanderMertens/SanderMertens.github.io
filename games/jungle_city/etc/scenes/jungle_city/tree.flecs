using flecs.script
using box.transform
using box.geometry
using box.material

template CanopyCrownLobe {
  prop rx: f32 = 1
  prop ry: f32 = 0.8
  prop rz: f32 = 1
  prop count: i32 = 7
  prop card: f32 = 1.5
  prop seed: f32 = 0
  prop tint: Rgb = {64, 118, 54}
  prop blossom: bool = false

  for i in 0..count {
    const up = 1 - 2 * (i + 0.5) / count
    const flat = math.sqrt(1 - up * up)
    const az = i * 2.399963 + seed
    const elevation = math.atan2(up, flat)
    const nudge = math.sin(i * 12.9 + seed) * 0.2
    const size = card * (0.85 + (i % 3) * 0.16)
    { (IsA, CanopyLeafCard); Rgb: tint; Position: {math.sin(az) * flat * rx, up * ry, math.cos(az) * flat * rz}; Rotation: {-elevation + nudge, az + nudge, nudge * 3}; Quad: {size, size} }
    if blossom && i % 2 == 0 {
      { (IsA, CanopyBlossomCard); Position: {math.sin(az) * flat * rx * 1.08, up * ry * 1.08, math.cos(az) * flat * rz * 1.08}; Rotation: {-elevation - nudge, az - nudge, nudge}; Quad: {size * 0.9, size * 0.9} }
    }
  }
}

template CanopyTree {
  prop height: f32 = 9
  prop variant: i32 = 0
  prop species: i32 = -1
  const rng: math.Rng = {seed: variant + 3217}
  const draw: i32 = rng.u(8)
  const kind: i32 = species < 0 ? draw : species
  const raw_lean = rng.f(0.9) - 0.45
  const girth = height * 0.03
  if kind < 2 {
    const bucket: i32 = math.clamp(math.round(raw_lean / height / 0.02) + 2, 0, 4)
    const lean = (bucket - 2) * 0.02 * height
    const side = (bucket - 2) * 0.5 * height
    const ys = [0, 0.3, 0.62, 0.92]
    const xs = [0, 0.004, 0.018, 0.04]
    for k in 0..3 {
      const ax = xs[k] * side
      const bx = xs[k + 1] * side
      const ay = ys[k] * height
      const by = ys[k + 1] * height
      const dx = bx - ax
      const dy = by - ay
      const length = math.sqrt(dx * dx + dy * dy)
      { (IsA, CanopyBark)
        Position: {(ax + bx) / 2, (ay + by) / 2, 0}
        Rotation: {math.acos(dy / length), math.atan2(dx, 0), 0}
        Frustum: {length: length, radius_bottom: height * 0.0246 * (1 - 0.62 * ys[k] / 0.92), radius_top: height * 0.0246 * (1 - 0.62 * ys[k + 1] / 0.92), segments: 4, smooth: true}
        TextureMapping: {mode: MappingUv}
        TextureTransform: {scale_x: 1, scale_y: 5 * (ys[k + 1] - ys[k]) / 0.92, offset_y: 5 * (0.92 - ys[k + 1]) / 0.92}
      }
    }
    for i in 0..4 {
      const a = i * math.PI / 2 + rng.f(0.6)
      CanopyBranch(ax: math.sin(a) * girth * 2.4, ay: 0, az: math.cos(a) * girth * 2.4, by: height * 0.05, radius: girth * 0.45) {}
    }
    for f in 0..11 {
      const a = f * 2.399963 + rng.f(0.3)
      const size = height * (0.42 + rng.f(0.14))
      const lift = (f % 3 - 1) * 0.28
      { (IsA, CanopyPalmFrond);
        Position: {lean, height * 0.92, 0}
        Rotation: {lift, a, 0}
        Scale: {size * 0.95, size, size}
        Rgb: {62 + rng.u(30), 118 + rng.u(32), 44 + rng.u(18)}
      }
    }
    for i in 0..3 {
      { (IsA, CanopyBark); Position: {lean + math.sin(i * 2.1) * girth * 0.8, height * 0.89, math.cos(i * 2.1) * girth * 0.8}; IcoSphere: {radius: girth * 0.5, segments: 1}; Rgb: {96, 72, 40} }
    }
  } else {
    const lean = raw_lean
    const deep: Rgb = {58, 112, 50}
    const fresh: Rgb = {76, 128, 56}
    const lime: Rgb = {100, 142, 58}
    const dusky: Rgb = {44, 96, 54}
    const tints = [deep, fresh, lime, dusky]
    const tint: Rgb = tints[rng.u(4)]
    const flowering = kind == 7
    const flat = kind == 6
    const squash = flat ? 0.62 : 1.0
    const spread = flat ? 0.36 : 0.25
    CanopyBranch(ay: 0, bx: lean, by: height * 0.62, radius: girth) {}
    for i in 0..5 {
      const a = i * 1.2566 + rng.f(0.6)
      CanopyBranch(ax: math.sin(a) * girth * 3.2, ay: 0, az: math.cos(a) * girth * 3.2, by: height * 0.09, radius: girth * 0.52) {}
    }
    for b in 0..5 {
      const a = b * 1.2566 + rng.f(0.7)
      const reach = height * (spread * 0.8 + rng.f(spread * 0.5))
      const y = height * (0.66 + rng.f(0.14))
      const bx = lean + math.sin(a) * reach
      const bz = math.cos(a) * reach
      CanopyBranch(ax: lean * 0.8, ay: height * 0.5, bx: bx, by: y, bz: bz, radius: girth * 0.42) {}
      CanopyCrownLobe(rx: height * 0.2, ry: height * 0.15 * squash, rz: height * 0.2, count: 7, card: height * 0.25, seed: a, tint: tint, blossom: flowering) { Position: {bx, y + height * 0.05, bz} }
    }
    CanopyCrownLobe(rx: height * 0.24, ry: height * 0.17 * squash, rz: height * 0.24, count: 10, card: height * 0.27, seed: lean, tint: tint, blossom: flowering) { Position: {lean, height * 0.86, 0} }
    if variant % 3 == 0 {
      { (IsA, CanopyVineCard); Position: {lean * 0.5 + girth, height * 0.32, girth}; Rotation: {0, 0.6, 0}; Quad: {height * 0.14, height * 0.6} }
    }
  }
}
