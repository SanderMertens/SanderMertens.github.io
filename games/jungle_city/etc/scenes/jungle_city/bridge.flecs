using flecs.script
using box.transform
using box.geometry
using box.material

template CanopyWalk {
  prop length: f32 = 12
  prop width: f32 = 2.4
  prop seed: i32 = 0
  prop opening: f32 = 1000
  prop clearance: f32 = 4.52
  prop piers: bool = true
  const stuff: math.Rng = {seed: seed + 8191}
  const half = length / 2
  const edge = width / 2
  const has_opening = opening < 999
  deck : CanopyDeck { Position: {0, -0.05, 0}; Box: {length, 0.1, width} }
  for side in 0..2 {
    const z = (side - 0.5) * (width - 0.1)
    { (IsA, CanopyTimberDark); Position: {0, -0.21, z}; Box: {length, 0.24, 0.12} }
    { (IsA, CanopyGlow); Position: {0, -0.1, (side - 0.5) * (width + 0.03)}; Box: {length, 0.025, 0.015} }
  }
  for i in 0..math.floor(length / 2.4) + 1 {
    { (IsA, CanopyTimberDark); Position: {-half + 0.3 + i * (length - 0.6) / math.floor(length / 2.4), -0.17, 0}; Box: {0.14, 0.16, width - 0.2} }
  }
  CanopyRail(length: length) { Position: {0, 0, edge - 0.04} }
  if has_opening {
    const left = opening - 1.25 + half
    const right = half - opening - 1.25
    if left > 0.3 {
      CanopyRail(length: left) { Position: {-half + left / 2, 0, -edge + 0.04} }
    }
    if right > 0.3 {
      CanopyRail(length: right) { Position: {half - right / 2, 0, -edge + 0.04} }
    }
  } else {
    CanopyRail(length: length) { Position: {0, 0, -edge + 0.04} }
  }
  if piers && length > 5 {
    const posts = length > 11 ? 2 : 1
    for p in 0..posts {
      const x = (p + 0.5) / posts * length - half
      cross_beam : CanopyTimberDark { Position: {x, -0.42, 0}; Box: {0.24, 0.2, width + 0.5} }
      for side in 0..2 {
        const z = (side - 0.5) * (width + 0.34)
        { (IsA, CanopyConcrete); Position: {x, -(clearance + 0.3) / 2, z}; Box: {0.2, clearance - 0.3, 0.2} }
        { (IsA, CanopyConcrete); Position: {x, -clearance + 0.12, z}; Box: {0.42, 0.24, 0.42} }
      }
      if (seed + p) % 2 == 0 {
        CanopyVine(length: clearance * 0.8, phase: seed + p) { Position: {x + 0.14, -0.4, (seed % 2 - 0.5) * (width + 0.34)} }
      }
    }
  }
  const slots: i32 = math.floor(length / 2.6)
  for i in 0..slots {
    const x = -half + (i + 0.5) * length / slots
    const side = i % 2
    const z_sign = side - 0.5
    const kind = stuff.u(9)
    const far_from_opening = !has_opening || side == 1 || x < opening - 2 || x > opening + 2
    if far_from_opening {
      if kind < 3 {
        CanopyPlanter(length: 1.5, seed: seed + i, bloom: kind == 0) { Position: {x, -0.16, z_sign * (width + 0.52)} }
        CanopyVine(length: 1.2 + stuff.f(1.4), phase: seed + i) { Position: {x, -0.1, z_sign * (width + 0.92)} }
      } else if kind == 3 {
        CanopyBench() { Position: {x, 0, z_sign * (width - 0.8)}; Rotation: {0, math.PI * (0.5 - side), 0} }
      } else if kind == 4 {
        CanopyPotted(size: 0.72, seed: seed + i) { Position: {x, 0, z_sign * (width - 0.6)} }
      } else if kind == 5 {
        CanopyHangingLantern() { Position: {x, 2.16, z_sign * (width - 0.4)} }
        { (IsA, CanopyMetal); Position: {x, 1.12, z_sign * (width - 0.1)}; Box: {0.05, 2.24, 0.05} }
        { (IsA, CanopyMetal); Position: {x, 2.2, z_sign * (width - 0.25)}; Box: {0.04, 0.04, 0.5} }
      }
    }
    if i % 3 == 1 {
      CanopyStreetlight() { Position: {x, 0, z_sign * (width - 0.2)}; Rotation: {0, z_sign * math.PI, 0} }
    }
    if stuff.u(4) == 0 {
      CanopyPerson(seed: seed + i) { Position: {x + stuff.f(0.8), 0, stuff.f(1.2) - 0.6} }
    }
  }
}

prefab CanopyRibShape {
  Path2D: {
    start: {0.5, 0.5},
    segments: [{kind: Line, end: {-0.5, 0.5}}, {kind: Line, end: {-0.5, -0.5}}, {kind: Line, end: {0.5, -0.5}}],
    closed: true
  }
}
prefab CanopyRibProfile { Profile2D: {outer: CanopyRibShape} }

template CanopyCanalSpan {
  prop length: f32 = 10
  prop width: f32 = 2.4
  prop seed: i32 = 0
  CanopyWalk(length: length, width: width, seed: seed, piers: false) {}
  for side in 0..2 {
    const z = (side - 0.5) * (width - 0.1)
    { (IsA, CanopyIron)
      Position: {0, 0, z}
      rib {
        Path3D: {
          start: {-length / 2 - 0.02, -1.9, 0},
          segments: [{kind: CubicBezier, end: {length / 2 + 0.02, -1.9, 0}, control1: {-length / 6, 0.1, 0}, control2: {length / 6, 0.1, 0}}]
        }
      }
      Sweep: {path: rib, profile: CanopyRibProfile, scale: {0.14, 0.16}, rings: 32}
    }
    for i in 1..8 {
      const t0 = i / 8.0
      const x0 = (t0 - 0.5) * length
      const y0 = 1.5 * (1 - 4 * (t0 - 0.5) * (t0 - 0.5)) - 1.9
      { (IsA, CanopyIron); Position: {x0, (y0 - 0.24) / 2, z}; Box: {0.06, -y0 - 0.24, 0.06} }
    }
  }
}

template CanopyStair {
  prop rise: f32 = 4.52
  prop width: f32 = 1.2
  const steps: i32 = math.floor(rise / 0.2)
  const run = 0.27
  const total = steps * run
  const slope = math.atan2(rise, total)
  const stringer = math.sqrt(rise * rise + total * total)
  for i in 0..steps {
    { (IsA, CanopyDeck); Position: {0, -(i + 0.5) * rise / steps, -(i + 0.5) * run}; Box: {width, 0.05, run + 0.04} }
  }
  for side in 0..2 {
    const x = (side - 0.5) * width
    { (IsA, CanopyTimberDark); Position: {x, -rise / 2 - 0.06, -total / 2}; Rotation: {-slope, 0, 0}; Box: {0.08, 0.2, stringer} }
    { (IsA, CanopyIron); Position: {x, -rise / 2 + 0.95, -total / 2}; Rotation: {-slope, 0, 0}; Box: {0.05, 0.05, stringer} }
    for p in 0..4 {
      const t = (p + 0.5) / 4.0
      { (IsA, CanopyMetal); Position: {x, -rise * t + 0.48, -total * t}; Box: {0.04, 0.95, 0.04} }
    }
  }
  foot : CanopyConcrete { Position: {0, -rise + 0.05, -total - 0.3}; Box: {width + 0.3, 0.12, 0.7} }
}

template CanopyJunction {
  prop size: f32 = 5
  prop width: f32 = 2.4
  prop east: bool = false
  prop west: bool = false
  prop back: bool = false
  prop front: bool = false
  prop stair_x: f32 = 0
  prop clearance: f32 = 4.52
  prop seed: i32 = 0
  prop column: bool = true
  const half = size / 2
  const stub = (size - width) / 2
  const stuff: math.Rng = {seed: seed + 4099}
  plate : CanopyPaver { Position: {0, -0.06, 0}; RoundedBox: {size, 0.12, size, 0.05, segments: 1} }
  fascia : CanopyTimberDark { Position: {0, -0.22, 0}; Box: {size - 0.1, 0.24, size - 0.1} }
  for i in 0..2 {
    { (IsA, CanopyTimberDark); Position: {0, -0.42, 0}; Rotation: {0, i * math.PI / 2 + 0.78, 0}; Box: {size * 1.1, 0.24, 0.22} }
  }
  if column {
    shaft : CanopyConcrete { Position: {0, -clearance / 2, 0}; Cylinder: {radius: 0.26, length: clearance, segments: 12, smooth: true} }
    capital : CanopyConcrete { Position: {0, -0.72, 0}; Frustum: {radius_bottom: 0.26, radius_top: 0.72, length: 0.5, segments: 12} }
    footing : CanopyAshlar { Position: {0, -clearance + 0.2, 0}; Cylinder: {radius: 0.62, length: 0.4, segments: 12} }
    CanopyVine(length: clearance * 0.72, phase: seed) { Position: {0.28, -0.8, 0.1} }
  }
  for i in 0..4 {
    const open = match i { 0: front; 1: east; 2: back; _: west }
    {
      Rotation: {0, i * math.PI / 2, 0}
      if open {
        if !(i == 2 && stair_x < 0) {
          CanopyRail(length: stub) { Position: {half - stub / 2, 0, half - 0.05} }
        }
        if !(i == 2 && stair_x > 0) {
          CanopyRail(length: stub) { Position: {-half + stub / 2, 0, half - 0.05} }
        }
      } else {
        CanopyRail(length: size) { Position: {0, 0, half - 0.05} }
        CanopyBench(length: 1.6) { Position: {0, 0, half - 0.5}; Rotation: {0, math.PI, 0} }
      }
      { (IsA, CanopyGlow); Position: {0, -0.08, half + 0.008}; Box: {size, 0.025, 0.015} }
      lamp_post : CanopyMetal { Position: {half - 0.12, 0.8, half - 0.12}; Cylinder: {radius: 0.05, length: 1.6, segments: 6} }
      lamp_cap : CanopyLampGlow { Position: {half - 0.12, 1.66, half - 0.12}; Sphere: {radius: 0.09, segments: 8} }
    }
  }
  const feature = stuff.u(4)
  ring : CanopyAshlar { Position: {0, 0.24, 0}; Cylinder: {radius: 0.86, length: 0.48, segments: 18} }
  rim : CanopyTrim { Position: {0, 0.5, 0}; Torus: {radius: 0.84, tube: 0.05, segments: 18, rings: 5} }
  if feature == 0 {
    { (IsA, CanopyWater); Position: {0, 0.49, 0}; Cylinder: {radius: 0.8, length: 0.02, segments: 18} }
    { (IsA, CanopyTerracotta); Position: {0, 0.8, 0}; Cylinder: {radius: 0.08, length: 0.62, segments: 8} }
    { (IsA, CanopyVerdigris); Position: {0, 1.14, 0}; Frustum: {radius_bottom: 0.08, radius_top: 0.3, length: 0.12, segments: 12} }
  } else {
    soil : CanopySoil { Position: {0, 0.49, 0}; Cylinder: {radius: 0.8, length: 0.02, segments: 18} }
    if feature == 1 {
      CanopyTree(height: 4.4, variant: seed, species: 0) { Position: {0, 0.48, 0} }
    } else if feature == 2 {
      CanopyBanana(height: 2.8, seed: seed) { Position: {0, 0.48, 0} }
      CanopyFern(size: 0.7) { Position: {0.35, 0.48, -0.3} }
    } else {
      CanopyTree(height: 3.6, variant: seed, species: 7) { Position: {0, 0.48, 0} }
    }
  }
  if stuff.u(3) == 0 {
    CanopyPerson(seed: seed) { Position: {1.4, 0, 1.2} }
  }
  if stuff.u(3) == 0 {
    CanopyPerson(seed: seed + 1) { Position: {-1.3, 0, -1.4} }
    CanopyPerson(seed: seed + 3) { Position: {-1.75, 0, -1.2} }
  }
}

template CanopyGangway {
  prop length: f32 = 2.5
  prop width: f32 = 2.2
  prop variant: i32 = 0
  const lift_at = length / 2
  deck : CanopyDeck { Position: {0, -0.05, length / 2}; Box: {width, 0.1, length + 0.2} }
  for side in 0..2 {
    const x = (side - 0.5) * (width - 0.1)
    { (IsA, CanopyTimberDark); Position: {x, -0.21, length / 2}; Box: {0.12, 0.24, length + 0.2} }
  }
  { Position: {width / 2 - 0.04, 0, length / 2}; Rotation: {0, math.PI / 2, 0}; CanopyRail(length: length) {} }
  if lift_at > 0.95 {
    { Position: {-width / 2 + 0.04, 0, (lift_at - 0.75) / 2}; Rotation: {0, math.PI / 2, 0}; CanopyRail(length: lift_at - 0.75) {} }
    { Position: {-width / 2 + 0.04, 0, length - (lift_at - 0.75) / 2}; Rotation: {0, math.PI / 2, 0}; CanopyRail(length: lift_at - 0.75) {} }
  }
  for side in 0..2 {
    const x = (side - 0.5) * 1.5
    { (IsA, CanopyTimberDark); Position: {x, 1.25, 0.02}; Box: {0.16, 2.5, 0.2} }
    CanopyPotted(size: 0.6, seed: variant + side) { Position: {x * 0.96, 0, 0.42} }
  }
  door : CanopyTimberDark { Position: {0, 1.15, -0.02}; Box: {1.4, 2.3, 0.08} }
  door_glass : CanopyGlass { Position: {0, 1.3, 0.03}; Box: {1.1, 1.7, 0.02} }
  lintel : CanopyTrim { Position: {0, 2.54, 0.04}; Box: {1.9, 0.16, 0.24} }
  CanopyAwning(width: 2.2, depth: 1.1, stripes: 6, style: variant) { Position: {0, 2.74, 0.04} }
  CanopyHangingLantern() { Position: {0, 2.5, 0.5} }
}

template CanopyLift {
  prop height: f32 = 4.52
  prop variant: i32 = 0
  const tall = height + 2.7
  foot : CanopyConcrete { Position: {0, 0.1, 0}; Box: {1.5, 0.24, 1.5} }
  shaft : CanopyPalmGlass { Position: {0, tall / 2, 0}; Box: {1.16, tall, 1.16} }
  for x in 0..2 {
    for z in 0..2 {
      { (IsA, CanopyTrim); Position: {(x - 0.5) * 1.24, tall / 2, (z - 0.5) * 1.24}; Box: {0.09, tall, 0.09} }
    }
  }
  for i in 0..math.floor(tall / 2.2) + 1 {
    { (IsA, CanopyTrim); Position: {0, 0.1 + i * 2.2, 0}; Box: {1.3, 0.06, 1.3} }
  }
  roof : CanopyTrim { Position: {0, tall + 0.08, 0}; RoundedBox: {1.5, 0.16, 1.5, 0.05, segments: 1} }
  motor : CanopyMetal { Position: {0, tall + 0.32, 0}; Box: {0.8, 0.34, 0.7} }
  cab : CanopyTimberDark { Position: {0, 1.5 + variant % 3 * 1.6, 0}; Box: {0.98, 2, 0.98} }
  cab_glow : CanopyLampGlow { Position: {0, 2.42 + variant % 3 * 1.6, 0}; Box: {0.8, 0.04, 0.8} }
}

template CanopyPath {
  prop length: f32 = 12
  prop width: f32 = 2.4
  slab : CanopyMossPaver { Position: {0, 0.015, 0}; Box: {length, 0.05, width} }
  for side in 0..2 {
    { (IsA, CanopyConcrete); Position: {0, 0.035, (side - 0.5) * (width + 0.14)}; Box: {length, 0.11, 0.14} }
  }
}

template CanopyPathNode {
  prop size: f32 = 5
  slab : CanopyMossPaver { Position: {0, 0.015, 0}; Box: {size, 0.05, size} }
  for i in 0..4 {
    const a = i * math.PI / 2 + 0.78
    CanopyBollard() { Position: {math.sin(a) * size * 0.62, 0, math.cos(a) * size * 0.62} }
  }
}
