using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template CanopyCourtyard {
    prop floors: i32 = 3
    prop variant: i32 = 0
    prop wall: Rgb = {226, 235, 211}
    prop timber: Rgb = {143, 91, 48}
    prop roof_style: i32 = 0
    prop facade_style: i32 = 0
    prop sx: f32 = 1
    prop sz: f32 = 1
    const windows: math.Rng = {seed: variant + 314159}
    const levels: i32 = math.min(floors, 5)
    Scale: {sx, 1, sz}
    for side in 0..2 {
      const x = (side - 0.5) * 6
      CanopyPlinth(width: 3, depth: 7.6, variant: variant + side) { Position: {x, 0, 0} }
      for f in 0..levels {
        const y = 1.2 + f * 3.2
        { (IsA, CanopyIvory); Rgb: wall; Position: {x, y + 1.6, 0}; Box: {2.6, 3.2, 7.2}; Bevel: {front_left: 0.3, front_right: 0.3, back_left: 0.3, back_right: 0.3} }
        { (IsA, CanopyWood); Rgb: timber; Position: {x, y + 3.05, 0}; Box: {3.2, 0.18, 7.8} }
        { (IsA, CanopyFacade); Position: {x, y + 1.55, 3.62}; Box: {2.3, 2.8, 0.06}; TextureMapping: {mode: MappingObject, size: 22.4}; TextureTransform: {scale_x: 1, scale_y: 1, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0 + 0.0625} }
        { (IsA, CanopyFacade); Position: {x + (0.5 - side) * 2.64, y + 1.55, 0}; Box: {0.06, 2.8, 6.6}; TextureMapping: {mode: MappingObject, size: 22.4}; TextureTransform: {scale_x: 1, scale_y: 1, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0 + 0.0625} }
        { (IsA, CanopyFacade); Position: {x - (0.5 - side) * 2.64, y + 1.55, 0}; Box: {0.06, 2.8, 6.6}; TextureMapping: {mode: MappingObject, size: 22.4}; TextureTransform: {scale_x: 1, scale_y: 1, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0 + 0.0625} }
        { (IsA, CanopyLeaf); Position: {x, y + 3.23, 3.3}; Box: {2.8, 0.3, 0.65}; Bevel: {top: 0.12, front_left: 0.12, front_right: 0.12, back_left: 0.12, back_right: 0.12} }
        CanopyVine(length: 1.8, phase: variant + f + side) { Position: {x + 0.9, y + 3.3, 3.7} }
      }
      CanopyRoof(style: roof_style, variant: variant + side, sx: sx * 0.48, sy: 0.7, sz: sz) { Position: {x, 1.2 + levels * 3.2, 0}; Scale: {0.48, 0.7, 1} }
    }
    rear_plinth : CanopyAshlar { Position: {0, 0.55, -2.5}; Box: {4.2, 1.5, 2.4} }
    rear : CanopyIvory { Rgb: wall; Position: {0, 2.7, -2.5}; Box: {4, 3, 2.2}; Bevel: {top_front: 0.3, top_back: 0.3} }
    court_floor : CanopyPaver { Position: {0, 0.02, 1}; Box: {3.4, 0.05, 5} }
    pool : CanopyAshlar { Position: {0, 0.16, 2.4}; Cylinder: {radius: 0.8, length: 0.3, segments: 8} }
    pool_water : CanopyWater { Position: {0, 0.31, 2.4}; Cylinder: {radius: 0.72, length: 0.02, segments: 8} }
    gallery : CanopyWood { Rgb: timber; Position: {0, 4.4, 2.8}; Box: {4, 0.2, 1.8} }
    CanopyTree(height: 5.5 + variant % 3, variant: variant) { Position: {0, 0.045, -0.4} }
    for side in 0..2 {
      CanopyFern(size: 1.2) { Position: {(side - 0.5) * 2.7, 0.045, 1.6} }
    }
  }
}
