using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyCourtyard {
  prop floors: i32 = 3
  prop variant: i32 = 0
  prop wall: Rgb = {226, 235, 211}
  prop timber: Rgb = {143, 91, 48}
  prop roof_style: i32 = 0
  prop facade_style: i32 = 0
  const windows: math.Rng = {seed: variant + 314159}
  const levels: i32 = math.min(floors, 5)
  for side in 0..2 {
    const x = (side - 0.5) * 6
    CanopyPlinth(width: 3, depth: 7.6, variant: variant + side) { Position: {x, 0, 0} }
    for f in 0..levels {
      const y = 1.2 + f * 3.2
      { (IsA, CanopyIvory); Rgb: wall; Position: {x, y + 1.5, 0}; RoundedBox: {2.6, 3, 7.2, 0.3} }
      { (IsA, CanopyWood); Rgb: timber; Position: {x, y + 3.05, 0}; Box: {3.2, 0.18, 7.8} }
      { (IsA, CanopyFacade); Position: {x, y + 1.55, 3.62}; Box: {2.3, 2.8, 0.06}; TextureTransform: {scale_x: 0.18, scale_y: 0.125, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0} }
      { (IsA, CanopyFacade); Position: {x + (0.5 - side) * 2.64, y + 1.55, 0}; Box: {0.06, 2.8, 6.6}; TextureTransform: {scale_x: 0.5, scale_y: 0.125, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0} }
      { (IsA, CanopyFacade); Position: {x - (0.5 - side) * 2.64, y + 1.55, 0}; Box: {0.06, 2.8, 6.6}; TextureTransform: {scale_x: 0.5, scale_y: 0.125, offset_x: windows.f(1), offset_y: windows.u(8) / 8.0} }
      { (IsA, CanopyLeaf); Position: {x, y + 3.23, 3.3}; RoundedBox: {2.8, 0.3, 0.65, 0.12} }
      CanopyVine(length: 1.8, phase: variant + f + side) { Position: {x + 0.9, y + 3.3, 3.7} }
    }
    CanopyRoof(style: roof_style, variant: variant + side) { Position: {x, 1.3 + levels * 3.2, 0}; Scale: {0.48, 0.7, 1} }
  }
  rear_plinth : CanopyAshlar { Position: {0, 0.55, -2.5}; Box: {4.2, 1.5, 2.4}; TextureTransform: {scale_x: 1.4, scale_y: 0.5} }
  rear : CanopyIvory { Rgb: wall; Position: {0, 2.7, -2.5}; RoundedBox: {4, 3, 2.2, 0.3} }
  court_floor : CanopyPaver { Position: {0, 0.02, 1}; Box: {3.4, 0.05, 5}; TextureTransform: {scale_x: 1.3, scale_y: 2} }
  pool : CanopyAshlar { Position: {0, 0.16, 2.4}; Cylinder: {radius: 0.8, length: 0.3, segments: 16}; TextureTransform: {scale_x: 2, scale_y: 0.2} }
  pool_water : CanopyWater { Position: {0, 0.31, 2.4}; Cylinder: {radius: 0.72, length: 0.02, segments: 16} }
  gallery : CanopyWood { Rgb: timber; Position: {0, 4.4, 2.8}; Box: {4, 0.2, 1.8} }
  CanopyTree(height: 5.5 + variant % 3, variant: variant) { Position: {0, 0.2, -0.4} }
  for side in 0..2 {
    CanopyFern(size: 1.2) { Position: {(side - 0.5) * 2.7, 0.2, 1.6} }
  }
}
