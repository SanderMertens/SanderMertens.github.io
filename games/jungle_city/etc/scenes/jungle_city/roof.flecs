using flecs.script
using box.transform
using box.geometry
using box.material

assets {
  template CanopyRoof {
    prop style: i32 = 0
    prop variant: i32 = 0
    prop sx: f32 = 1
    prop sy: f32 = 1
    prop sz: f32 = 1
    CanopyRoofKit(variant: variant) {}
    if style == 0 {
      const tilt = 0.2
      const lift = 0.45
      CanopyTree(height: 3.5, variant: variant) { Position: {-1, 0, -0.5} }
      for i in 0..3 {
        const z = -1.5 + i * 1.3
        { (IsA, CanopySolar); Position: {1.5, lift, z}; Rotation: {0, 0, tilt}; Box: {1.6, 0.1, 1.1} }
        for leg in 0..2 {
          const lx = (leg - 0.5) * 1.3
          const lh = lift + lx * math.tan(tilt) - 0.05 / math.cos(tilt)
          { (IsA, CanopyMetal); Position: {1.5 + lx, lh / 2, z}; Box: {0.05, lh, 0.9} }
        }
      }
    } else if style == 1 {
      for x in 0..2 {
        for z in 0..2 {
          { (IsA, CanopyWood); Position: {(x - 0.5) * 4.2, 1.1, (z - 0.5) * 3.6}; Box: {0.16, 2.2, 0.16} }
        }
      }
      for i in 0..9 {
        { (IsA, CanopyWood); Position: {-2.3 + i * 0.575, 2.25, 0}; Box: {0.22, 0.12, 4.2} }
      }
      for i in 0..3 {
        CanopyFern(size: 0.9) { Position: {-1.5 + i * 1.5, 0, 0} }
      }
    } else if style == 2 {
      const k = math.min(sx, sz)
      dome {
        Scale: {k / sx, k / sy, k / sz}
        glass : CanopyGlass { Position: {0, 0, 0}; HemiSphere: {radius: 2.3, segments: 8} }
        for i in 0..6 {
          { (IsA, CanopyIvory); Rotation: {-math.PI / 2, i * math.PI / 6, 0}; Tube: {radius: 2.34, thickness: 0.06, length: 0.06, arc: math.PI, segments: 8} }
        }
      }
    } else if style == 3 {
      for i in 0..3 {
        const x = -1.7 + i * 1.7
        const y = 2.2 + i * 0.3
        { (IsA, CanopyIvory); Position: {x, (y - 0.06) / 2, 0}; Cylinder: {radius: 0.06, length: y - 0.06, segments: 3} }
        { (IsA, CanopySolar); Position: {x, y, 0}; Rotation: {0, 0, 0.22}; Box: {1.5, 0.12, 4.1} }
      }
    } else if style == 4 {
      basin : CanopyIvory { Position: {0, 0.18, 0}; Box: {4.6, 0.36, 3.8}; Bevel: {top: 0.18, front_left: 0.18, front_right: 0.18, back_left: 0.18, back_right: 0.18} }
      water : CanopyWater { Position: {0, 0.38, 0}; Box: {4.1, 0.08, 3.3} }
      for side in 0..2 {
        CanopyFern(size: 1.1) { Position: {(side - 0.5) * 5.2, 0, 0} }
        { (IsA, CanopyWindow); Position: {(side - 0.5) * 4.3, 0.39, 0}; Box: {0.06, 0.06, 2.8} }
      }
    } else {
      const tilt = 0.12
      for side in 0..2 {
        const x = (side - 0.5) * 4.5
        const h = 2.8 + x * math.tan(tilt) - 0.06 / math.cos(tilt)
        { (IsA, CanopyWood); Position: {x, h / 2, 0}; Box: {0.16, h, 0.16} }
        CanopyFern(size: 1.2) { Position: {(side - 0.5) * 3.8, 0, 1.4} }
      }
      sail {
        Position: {0, 2.8, 0}
        Rotation: {0, 0, tilt}
        canvas : CanopyIvory { Position: {0, 0, 0}; Box: {5.4, 0.12, 4.4} }
        for i in 0..6 {
          { (IsA, CanopyWood); Position: {-2.3 + i * 0.92, 0.09, 0}; Box: {0.12, 0.06, 4.4} }
          if i % 2 == 0 {
            { (IsA, CanopySolar); Position: {-1.84 + i * 0.92, 0.075, 0}; Box: {0.74, 0.03, 3.8} }
          }
        }
        soffit : CanopyWindow { Position: {0, -0.09, 0}; Box: {2.8, 0.06, 0.35} }
      }
    }
  }
}
