using flecs.script
using box.transform
using box.geometry
using box.material

@tree Parent
template CanopyRoof {
  prop style: i32 = 0
  prop variant: i32 = 0
  CanopyRoofKit(variant: variant) {}
  if style == 0 {
    CanopyTree(height: 3.5, variant: variant) { Position: {-1, 0, -0.5} }
    for i in 0..3 {
      { (IsA, CanopySolar); Position: {1.5, 0.7, -1.5 + i * 1.3}; Rotation: {0, 0, -0.2}; Box: {1.6, 0.1, 1.1} }
    }
  } else if style == 1 {
    for x in 0..2 {
      for z in 0..2 {
        { (IsA, CanopyWood); Position: {(x - 0.5) * 4.2, 1.1, (z - 0.5) * 3.6}; Box: {0.16, 2.2, 0.16} }
      }
    }
    for i in 0..9 {
      { (IsA, CanopyWood); Position: {-2.3 + i * 0.575, 2.25, 0}; Box: {0.22, 0.12, 4.2} }
    }
    for i in 0..3 {
      CanopyFern(size: 0.9) { Position: {-1.5 + i * 1.5, 0, 0} }
    }
  } else if style == 2 {
    dome : CanopyGlass { Position: {0, 0.1, 0}; Scale: {1, 0.8, 1}; HemiSphere: {radius: 2.3, segments: 16} }
    for i in 0..6 {
      { (IsA, CanopyIvory); Position: {0, 0.1, 0}; Rotation: {-math.PI / 2, i * math.PI / 6, 0}; Scale: {1, 1, 0.8}; Tube: {radius: 2.34, thickness: 0.06, length: 0.06, arc: math.PI, segments: 16} }
    }
  } else if style == 3 {
    for i in 0..3 {
      { (IsA, CanopyIvory); Position: {-1.7 + i * 1.7, 1.1 + i * 0.3, 0}; Cylinder: {radius: 0.06, length: 2.2 + i * 0.6, segments: 6} }
      { (IsA, CanopySolar); Position: {-1.7 + i * 1.7, 2.2 + i * 0.3, 0}; Rotation: {0, 0, -0.22}; Box: {1.5, 0.12, 4.1} }
    }
  } else if style == 4 {
    basin : CanopyIvory { Position: {0, 0.18, 0}; RoundedBox: {4.6, 0.36, 3.8, 0.5} }
    water : CanopyWater { Position: {0, 0.38, 0}; RoundedBox: {4.1, 0.08, 3.3, 0.4} }
    for side in 0..2 {
      CanopyFern(size: 1.1) { Position: {(side - 0.5) * 5.2, 0, 0} }
      { (IsA, CanopyWindow); Position: {(side - 0.5) * 4.3, 0.4, 0}; Box: {0.06, 0.06, 2.8} }
    }
  } else {
    for side in 0..2 {
      { (IsA, CanopyWood); Position: {(side - 0.5) * 4.5, 1.4, 0}; Box: {0.16, 2.8, 0.16} }
      CanopyFern(size: 1.2) { Position: {(side - 0.5) * 3.8, 0, 1.4} }
    }
    sail : CanopyIvory { Position: {0, 2.8, 0}; Rotation: {0, 0, 0.12}; Box: {5.4, 0.12, 4.4}; TextureTransform: {scale_x: 1.3, scale_y: 1.1} }
    for i in 0..6 {
      { (IsA, CanopyWood); Position: {-2.3 + i * 0.92, 2.87 - (-2.3 + i * 0.92) * 0.12, 0}; Rotation: {0, 0, 0.12}; Box: {0.12, 0.06, 4.4} }
      if i % 2 == 0 {
        { (IsA, CanopySolar); Position: {-1.84 + i * 0.92, 2.89 - (-1.84 + i * 0.92) * 0.12, 0}; Rotation: {0, 0, 0.12}; Box: {0.74, 0.03, 3.8} }
      }
    }
    soffit : CanopyWindow { Position: {0, 2.65, 0}; Box: {2.8, 0.06, 0.35} }
  }
}
